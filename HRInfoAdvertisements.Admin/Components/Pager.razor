@* Reusable pager. Usage:
   <Pager @bind-CurrentPage="_page" @bind-PageSize="_pageSize" TotalCount="_items.Count" Id="somePageSize" /> *@

@if (TotalCount > MinPageSize)
{
    <div class="hr-pager">

        <div class="hr-pager-info">
            Showing
            <strong>@FirstRecord</strong> –
            <strong>@LastRecord</strong>
            of
            <strong>@TotalCount</strong>
        </div>

        <div class="hr-pager-controls">
            <button type="button" class="hr-pager-button" disabled="@(CurrentPage <= 1)"
                    @onclick="() => GoTo(1)" title="First page" aria-label="First page">
                <i class="bi bi-chevron-double-left"></i>
            </button>

            <button type="button" class="hr-pager-button" disabled="@(CurrentPage <= 1)"
                    @onclick="() => GoTo(CurrentPage - 1)" title="Previous page" aria-label="Previous page">
                <i class="bi bi-chevron-left"></i>
            </button>

            @foreach (var pageNumber in GetPageNumbers())
            {
                <button type="button" class="hr-pager-button @(pageNumber == CurrentPage ? "active" : "")"
                        @onclick="() => GoTo(pageNumber)">
                    @pageNumber
                </button>
            }

            <button type="button" class="hr-pager-button" disabled="@(CurrentPage >= TotalPages)"
                    @onclick="() => GoTo(CurrentPage + 1)" title="Next page" aria-label="Next page">
                <i class="bi bi-chevron-right"></i>
            </button>

            <button type="button" class="hr-pager-button" disabled="@(CurrentPage >= TotalPages)"
                    @onclick="() => GoTo(TotalPages)" title="Last page" aria-label="Last page">
                <i class="bi bi-chevron-double-right"></i>
            </button>
        </div>

        <div class="hr-pager-size">
            <label for="@Id">Show</label>
            <select id="@Id" value="@PageSize" @onchange="HandlePageSizeChanged">
                @foreach (var option in PageSizeOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
            <span>per page</span>
        </div>

    </div>
}

@code {

    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }

    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter] public int TotalCount { get; set; }

    [Parameter] public int[] PageSizeOptions { get; set; } = { 10, 20, 50 };

    [Parameter] public string Id { get; set; } = $"pager-{Guid.NewGuid():N}";

    private int MinPageSize => PageSizeOptions.Length > 0 ? PageSizeOptions.Min() : PageSize;

    private int TotalPages =>
        TotalCount == 0 ? 1 : (int)Math.Ceiling(TotalCount / (double)Math.Max(1, PageSize));

    private int FirstRecord =>
        TotalCount == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;

    private int LastRecord =>
        Math.Min(CurrentPage * PageSize, TotalCount);

    private Task GoTo(int page)
    {
        page = Math.Clamp(page, 1, TotalPages);

        return page == CurrentPage
            ? Task.CompletedTask
            : CurrentPageChanged.InvokeAsync(page);
    }

    private async Task HandlePageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            await PageSizeChanged.InvokeAsync(size);
            await CurrentPageChanged.InvokeAsync(1);
        }
    }

    private IEnumerable<int> GetPageNumbers()
    {
        const int visible = 5;

        if (TotalPages <= visible)
        {
            return Enumerable.Range(1, TotalPages);
        }

        var start = Math.Max(1, CurrentPage - 2);
        var end = Math.Min(TotalPages, start + visible - 1);
        start = Math.Max(1, end - visible + 1);

        return Enumerable.Range(start, end - start + 1);
    }
}
