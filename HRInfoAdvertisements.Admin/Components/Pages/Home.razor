    // ============================================================
    // LOGIN
    // ============================================================

    private async Task HandleLogin()
    {
        errorMessage = null;
        otpErrorMessage = null;

        isLoginLoading = true;

        try
        {
            var result =
                await AuthApiService.LoginAsync(
                    loginModel.Email,
                    loginModel.Password);

            if (result is null)
            {
                errorMessage =
                    "Invalid email address or password.";

                return;
            }

            /*
             * Existing account but email has not yet been verified.
             *
             * AuthService generates/sends the OTP during LoginAsync.
             */
            if (result.RequiresEmailVerification)
            {
                verificationEmail =
                    string.IsNullOrWhiteSpace(result.Email)
                        ? loginModel.Email
                        : result.Email;

                otpCode = string.Empty;
                otpErrorMessage = null;

                authStep = AuthStep.VerifyEmail;

                return;
            }

            if (!result.Success)
            {
                errorMessage =
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Login failed. Please check your credentials."
                        : result.Message;

                return;
            }

            AuthenticationStateProvider.SignIn(
                result.UserID,
                result.UserName,
                result.Email,
                result.Roles,
                result.Permissions,
                result.AccessToken,
                result.RefreshToken,
                result.ExpiresAt);

            isAuthenticated = true;

            currentUserName =
                result.UserName;

            await LoadMyFavoritesAsync();

            showAuthModal = false;

            errorMessage = null;

            showPassword = false;

            StateHasChanged();
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Unable to connect to the authentication service. Please try again.";
        }
        catch
        {
            errorMessage =
                "An unexpected error occurred while signing in.";
        }
        finally
        {
            isLoginLoading = false;
        }
    }


    // ============================================================
    // REGISTRATION
    // ============================================================

    private async Task HandleRegistration()
    {
        signupErrorMessage = null;
        otpErrorMessage = null;

        isSignupLoading = true;

        try
        {
            var fullName =
                (signupModel.FullName ?? string.Empty)
                    .Trim();

            var nameParts =
                fullName
                    .Split(
                        ' ',
                        StringSplitOptions.RemoveEmptyEntries);

            var firstName =
                nameParts.Length > 0
                    ? nameParts[0]
                    : string.Empty;

            var lastName =
                nameParts.Length > 1
                    ? string.Join(
                        " ",
                        nameParts.Skip(1))
                    : string.Empty;

            /*
             * RegisterAsync uses the existing Application DTO:
             *
             * UserName
             * Email
             * MobileNo
             * Password
             * FirstName
             * LastName
             */
            var result =
                await AuthApiService.RegisterAsync(
                    new HRInfoAdvertisements.Application.DTOs.Authentication.RegisterRequest
                    {
                        UserName = fullName,
                        Email = signupModel.Email.Trim(),
                        MobileNo = signupModel.MobileNo?.Trim(),
                        Password = signupModel.Password,
                        FirstName = firstName,
                        LastName = lastName
                    });

            if (result is null)
            {
                signupErrorMessage =
                    "Unable to create your account. Please try again.";

                return;
            }

            if (!result.Success)
            {
                signupErrorMessage =
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Registration failed. Please check your information and try again."
                        : result.Message;

                return;
            }

            /*
             * Registration intentionally does not authenticate the user.
             * The account must first be verified through email OTP.
             */
            verificationEmail =
                string.IsNullOrWhiteSpace(result.Email)
                    ? signupModel.Email.Trim()
                    : result.Email;

            otpCode = string.Empty;

            otpErrorMessage = null;
            signupErrorMessage = null;

            authStep = AuthStep.VerifyEmail;
        }
        catch (HttpRequestException)
        {
            signupErrorMessage =
                "Unable to connect to the authentication service. Please try again.";
        }
        catch
        {
            signupErrorMessage =
                "An unexpected error occurred while creating your account.";
        }
        finally
        {
            isSignupLoading = false;
        }
    }


    // ============================================================
    // VERIFY EMAIL OTP
    // ============================================================

    private async Task HandleVerifyEmailOtp()
    {
        otpErrorMessage = null;

        var email =
            (verificationEmail ?? string.Empty)
                .Trim();

        var otp =
            (otpCode ?? string.Empty)
                .Trim();

        if (string.IsNullOrWhiteSpace(email))
        {
            otpErrorMessage =
                "Email address is missing. Please return to Sign Up and try again.";

            return;
        }

        if (string.IsNullOrWhiteSpace(otp))
        {
            otpErrorMessage =
                "Please enter the 6-digit verification code.";

            return;
        }

        if (otp.Length != 6 ||
            !otp.All(char.IsDigit))
        {
            otpErrorMessage =
                "Please enter a valid 6-digit verification code.";

            return;
        }

        isOtpLoading = true;

        try
        {
            var result =
                await AuthApiService.VerifyEmailOtpAsync(
                    email,
                    otp);

            if (result is null)
            {
                otpErrorMessage =
                    "Unable to verify the email address. Please try again.";

                return;
            }

            if (!result.Success)
            {
                otpErrorMessage =
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "The verification code is invalid or has expired."
                        : result.Message;

                return;
            }

            /*
             * VerifyEmailOtpAsync returns authentication tokens after
             * successful email verification.
             */
            AuthenticationStateProvider.SignIn(
                result.UserID,
                result.UserName,
                result.Email,
                result.Roles,
                result.Permissions,
                result.AccessToken,
                result.RefreshToken,
                result.ExpiresAt);

            isAuthenticated = true;

            currentUserName =
                result.UserName;

            await LoadMyFavoritesAsync();

            showAuthModal = false;

            authStep = AuthStep.SignIn;

            otpCode = string.Empty;
            verificationEmail = string.Empty;

            otpErrorMessage = null;

            showPassword = false;
            showSignupPassword = false;
            showConfirmPassword = false;

            StateHasChanged();
        }
        catch (HttpRequestException)
        {
            otpErrorMessage =
                "Unable to connect to the authentication service. Please try again.";
        }
        catch
        {
            otpErrorMessage =
                "An unexpected error occurred while verifying your email.";
        }
        finally
        {
            isOtpLoading = false;
        }
    }


    private async Task HandleResendEmailOtp()
{
    otpErrorMessage = null;
    otpInfoMessage = null;

    var email = (verificationEmail ?? string.Empty).Trim();

    if (string.IsNullOrWhiteSpace(email))
    {
        otpErrorMessage = "Email address is missing. Please return to Sign Up and try again.";
        return;
    }

    isResendOtpLoading = true;

    try
    {
        var sent = await AuthApiService.ResendEmailVerificationAsync(email);

        if (!sent)
        {
            otpErrorMessage = "Unable to resend the verification code. Please try again.";
            return;
        }

        otpCode = string.Empty;
        otpInfoMessage = "A new verification code has been sent to your email.";   // <-- was otpErrorMessage
    }
    catch (HttpRequestException)
    {
        otpErrorMessage = "Unable to connect to the authentication service. Please try again.";
    }
    catch
    {
        otpErrorMessage = "An unexpected error occurred while resending the verification code.";
    }
    finally
    {
        isResendOtpLoading = false;
    }
}


