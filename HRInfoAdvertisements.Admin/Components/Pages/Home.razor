    private int GetImageIndex(long id)
    {
        return imageIndexByAd.TryGetValue(
            id,
            out var index)
            ? index
            : 0;
    }

    private void SetImageIndex(
        long id,
        int index)
    {
        imageIndexByAd[id] = index;
    }

    private void NextImage(
        long id,
        int total)
    {
        if (total <= 0)
        {
            return;
        }

        imageIndexByAd[id] =
            (GetImageIndex(id) + 1) % total;
    }

    private void PreviousImage(
        long id,
        int total)
    {
        if (total <= 0)
        {
            return;
        }

        imageIndexByAd[id] =
            (GetImageIndex(id) - 1 + total) % total;
    }


    // ============================================================
    // LOAD ADVERTISEMENTS
    // ============================================================

    private async Task LoadAdvertisementsAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        loadError = false;

        try
        {
            var result =
                await AdvertisementApiService
                    .GetPublishedAdvertisementsAsync(
                        pageNumber: currentPage,
                        pageSize: PageSize,
                        search: searchText,
                        categoryId: categoryId,
                        typeId: typeId,
                        countryId: countryId,
                        stateId: stateId,
                        cityId: cityId,
                        areaId: areaId,
                        minPrice: minPrice,
                        maxPrice: maxPrice);

            if (result is null)
            {
                Advertisements = new();
                loadError = true;
                return;
            }

            Advertisements = result;

            BuildFilterOptions();

            ApplyClientSideFilters();

            ApplySortOrder();
        }
        catch
        {
            Advertisements = new();

            loadError = true;
        }
        finally
        {
            isLoading = false;
        }
    }


    // ============================================================
    // FILTER OPTIONS
    // ============================================================

    private void BuildFilterOptions()
    {
        var items = Advertisements.Items;

        if (items is null ||
            items.Count == 0)
        {
            return;
        }

        foreach (var x in items.Where(
                     x =>
                         x.CategoryID > 0 &&
                         !string.IsNullOrWhiteSpace(
                             x.CategoryName)))
        {
            if (Categories.All(
                    c =>
                        c.CategoryID != x.CategoryID))
            {
                Categories.Add(
                    new CategoryOption
                    {
                        CategoryID = x.CategoryID,
                        CategoryName = x.CategoryName
                    });
            }
        }

        foreach (var x in items.Where(
                     x =>
                         x.AdvertisementTypeID > 0 &&
                         !string.IsNullOrWhiteSpace(
                             x.AdvertisementTypeName)))
        {
            if (AdvertisementTypes.All(
                    t =>
                        t.AdvertisementTypeID !=
                        x.AdvertisementTypeID))
            {
                AdvertisementTypes.Add(
                    new AdvertisementTypeOption
                    {
                        AdvertisementTypeID =
                            x.AdvertisementTypeID,

                        TypeName =
                            x.AdvertisementTypeName
                    });
            }
        }

        Categories =
            Categories
                .OrderBy(x => x.CategoryName)
                .ToList();

        AdvertisementTypes =
            AdvertisementTypes
                .OrderBy(x => x.TypeName)
                .ToList();
    }

    private void ApplyClientSideFilters()
    {
        if (Advertisements.Items is null ||
            Advertisements.Items.Count == 0)
        {
            return;
        }

        IEnumerable<AdvertisementResponse> filtered =
            Advertisements.Items;

        if (negotiableFilterEnabled)
        {
            filtered =
                filtered.Where(
                    x => x.IsNegotiable);
        }

        if (featuredFilterEnabled)
        {
            filtered =
                filtered.Where(
                    x => x.IsFeatured);
        }

        if (minBedrooms.HasValue)
        {
            filtered =
                filtered.Where(
                    x =>
                        x.Bedrooms.HasValue &&
                        x.Bedrooms.Value >=
                        minBedrooms.Value);
        }

        if (minBathrooms.HasValue)
        {
            filtered =
                filtered.Where(
                    x =>
                        x.Bathrooms.HasValue &&
                        x.Bathrooms.Value >=
                        minBathrooms.Value);
        }

        Advertisements.Items =
            filtered.ToList();
    }

    private void ApplySortOrder()
    {
        if (Advertisements.Items is null ||
            Advertisements.Items.Count == 0)
        {
            return;
        }

        IEnumerable<AdvertisementResponse> sorted =
            sortBy switch
            {
                "price" =>
                    Advertisements.Items
                        .OrderBy(x => x.Price ?? 0),

                "title" =>
                    Advertisements.Items
                        .OrderBy(
                            x => x.Title,
                            StringComparer.OrdinalIgnoreCase),

                "bedrooms" =>
                    Advertisements.Items
                        .OrderBy(x => x.Bedrooms ?? 0),

                "landarea" =>
                    Advertisements.Items
                        .OrderBy(x => x.LandArea ?? 0),

                "builtuparea" =>
                    Advertisements.Items
                        .OrderBy(x => x.BuiltUpArea ?? 0),

                _ =>
                    Advertisements.Items
                        .OrderBy(x => x.CreatedDate)
            };

        if (sortDirection == "desc")
        {
            sorted = sorted.Reverse();
        }

        Advertisements.Items =
            sorted.ToList();
    }


