    // SIGN UP TAB
    // ============================================================

    private void ShowSignUp()
    {
        authMode = AuthMode.SignUp;

        errorMessage = null;

        signupMessage = null;

        showPassword = false;
    }


    // ============================================================
    // PASSWORD
    // ============================================================

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }


    // ============================================================
    // LOGIN
    // ============================================================

    private async Task HandleLogin()
{
    errorMessage = null;
    isLoginLoading = true;

    try
    {
        var result =
            await AuthApiService.LoginAsync(
                loginModel.Email,
                loginModel.Password);

        if (result is null)
        {
            errorMessage =
                "Invalid email address or password.";

            return;
        }

        if (!result.Success)
        {
            errorMessage =
                string.IsNullOrWhiteSpace(result.Message)
                    ? "Login failed. Please check your credentials."
                    : result.Message;

            return;
        }

        AuthenticationStateProvider.SignIn(
            result.UserID,
            result.UserName,
            result.Email,
            result.Roles,
            result.Permissions,
            result.AccessToken,
            result.RefreshToken,
            result.ExpiresAt);

            Console.WriteLine(
    $"HOME AFTER SIGN-IN TOKEN AVAILABLE: " +
    $"{!string.IsNullOrWhiteSpace(AuthenticationStateProvider.AccessToken)}");

Console.WriteLine(
    $"HOME AFTER SIGN-IN TOKEN LENGTH: " +
    $"{AuthenticationStateProvider.AccessToken?.Length ?? 0}");

        isAuthenticated = true;
        currentUserName = result.UserName;

        showAuthModal = false;
        errorMessage = null;
        showPassword = false;

        StateHasChanged();
    }
    catch (HttpRequestException)
    {
        errorMessage =
            "Unable to connect to the authentication service. Please try again.";
    }
    catch
    {
        errorMessage =
            "An unexpected error occurred while signing in.";
    }
    finally
    {
        isLoginLoading = false;
    }
}

