private void HandleSignOut()
{
    AuthenticationStateProvider.SignOut();

    isAuthenticated = false;
    currentUserName = string.Empty;

    showAuthModal = false;
    errorMessage = null;
    signupMessage = null;
    showPassword = false;
}
