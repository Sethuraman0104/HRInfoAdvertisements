@page "/"

@layout HRInfoAdvertisements.Admin.Components.Layout.PublicLayout

@using System.ComponentModel.DataAnnotations
@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.Advertisements
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

@inject AdvertisementApiService AdvertisementApiService
@inject AuthApiService AuthApiService
@inject PublicAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>HR INFO ADs - Find What You Need</PageTitle>

<div class="marketplace">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <header class="site-header">

        <div class="header-inner">

            <a href="/"
               class="brand"
               aria-label="HR INFO ADs Home">

                <div class="brand-logo">
                    HR
                </div>

                <div class="brand-text">

                    <span class="brand-title">
                        HR INFO ADs
                    </span>

                    <span class="brand-subtitle">
                        Your marketplace for everything
                    </span>

                </div>

            </a>


            <nav class="main-navigation"
                 aria-label="Main navigation">

                <a href="/"
                   class="nav-link active">
                    Home
                </a>

                <a href="#browse"
                   class="nav-link">
                    Browse Ads
                </a>

                <a href="#categories"
                   class="nav-link">
                    Categories
                </a>

                <a href="#how-it-works"
                   class="nav-link">
                    How It Works
                </a>

            </nav>


            <div class="header-actions">

                <!-- Favorites -->
                <button type="button"
                        class="header-icon-button"
                        title="Favorites"
                        aria-label="Favorites">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M20.8 8.7c0 5.1-8.8 10.3-8.8 10.3S3.2 13.8 3.2 8.7A4.7 4.7 0 0 1 12 6.2a4.7 4.7 0 0 1 8.8 2.5Z" />

                    </svg>

                </button>


                <!-- Sign In -->
                @if (isAuthenticated)
{
    <!-- My Advertisements -->
    <button type="button"
            class="my-ads-header-button"
            @onclick="OpenMyAdvertisements">

        <span class="action-icon">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">

                <path d="M4 5h16v12H4z" />

                <path d="M8 21h8" />

                <path d="M12 17v4" />

                <path d="M8 9h8" />

                <path d="M8 12h5" />

            </svg>

        </span>

        <span>
            My Advertisements
        </span>

    </button>


    <!-- User Account -->
    <button type="button"
            class="header-login-button"
            @onclick="OpenAccount">

        <span class="action-icon">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">

                <circle cx="12"
                        cy="8"
                        r="4" />

                <path d="M4 21c.8-4 3.4-6 8-6s7.2 2 8 6" />

            </svg>

        </span>

        <span>
            @currentUserName
        </span>

    </button>


    <!-- Sign Out -->
    <button type="button"
            class="header-signup-button"
            @onclick="HandleSignOut">

        <span>
            Sign Out
        </span>

    </button>
}
else
{
    <button type="button"
            class="header-login-button"
            @onclick="OpenLogin">

        <span class="action-icon">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">

                <path d="M15 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9" />

                <path d="M10 12h10" />

                <path d="m17 8 4 4-4 4" />

            </svg>

        </span>

        <span>
            Sign In
        </span>

    </button>

    <button type="button"
            class="header-signup-button"
            @onclick="OpenSignup">

        <svg viewBox="0 0 24 24"
             aria-hidden="true">

            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />

            <circle cx="9"
                    cy="7"
                    r="4" />

            <path d="M19 8v6" />

            <path d="M22 11h-6" />

        </svg>

        <span>
            Sign Up
        </span>

    </button>
}


                <!-- Post Advertisement -->
                <button type="button"
        class="post-ad-button"
        @onclick="HandlePostAdvertisement">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M12 5v14" />

                        <path d="M5 12h14" />

                    </svg>

                    <span>
                        Post Advertisement
                    </span>

                </button>

            </div>

        </div>

    </header>


    <!-- ============================================================
         HERO
         ============================================================ -->

    <section class="hero-section">

        <div class="hero-container">

            <div class="hero-content">

                <span class="hero-eyebrow">
                    HR INFO ADs
                </span>


                <h1>

                    Find what you're looking for.

                    <span>
                        Sell what you no longer need.
                    </span>

                </h1>


                <p>
                    Discover trusted advertisements across properties,
                    vehicles, services and more.
                </p>

            </div>


            <!-- MAIN SEARCH -->

            <div class="hero-search-card">

                <div class="hero-search-input">

                    <span class="search-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24">

                            <circle cx="11"
                                    cy="11"
                                    r="7" />

                            <path d="m20 20-4-4" />

                        </svg>

                    </span>


                    <input @bind="searchText"
                           @bind:event="oninput"
                           @onkeydown="HandleSearchKeyDown"
                           placeholder="Search advertisements, products, locations..."
                           aria-label="Search advertisements" />

                </div>


                <button type="button"
                        class="hero-search-button"
                        @onclick="SearchAdvertisements"
                        disabled="@isLoading">

                    @if (isLoading)
                    {
                        <span class="button-loading-spinner"></span>

                        <span>
                            Searching...
                        </span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <circle cx="11"
                                    cy="11"
                                    r="7" />

                            <path d="m20 20-4-4" />

                        </svg>

                        <span>
                            Search
                        </span>
                    }

                </button>

            </div>


            <!-- POPULAR SEARCHES -->

            <div class="popular-searches">

                <span>
                    Popular searches:
                </span>


                <button type="button"
                        @onclick="@(() => SetSearch("Property"))">

                    Property

                </button>


                <button type="button"
                        @onclick="@(() => SetSearch("Car"))">

                    Cars

                </button>


                <button type="button"
                        @onclick="@(() => SetSearch("Apartment"))">

                    Apartments

                </button>


                <button type="button"
                        @onclick="@(() => SetSearch("Villa"))">

                    Villas

                </button>

            </div>

        </div>

    </section>


    <!-- ============================================================
         MAIN CONTENT
         ============================================================ -->

    <main class="marketplace-content"
          id="browse">

        <div class="content-container">


            <!-- ====================================================
                 FILTER PANEL
                 ==================================================== -->

            <section class="filter-panel">

                <div class="filter-header">

                    <div>

                        <span class="section-label">
                            SEARCH &amp; FILTER
                        </span>

                        <h2>
                            Refine your search
                        </h2>

                    </div>


                    <button type="button"
                            class="clear-filters-button"
                            @onclick="ClearFilters"
                            disabled="@isLoading">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M3 6h18" />

                            <path d="M8 6V4h8v2" />

                            <path d="m19 6-1 15H6L5 6" />

                            <path d="M10 11v6" />

                            <path d="M14 11v6" />

                        </svg>

                        <span>
                            Clear all
                        </span>

                    </button>

                </div>


                <div class="filter-grid">


                    <!-- CATEGORY -->

                    <div class="filter-field">

                        <label for="category-filter">
                            Category
                        </label>


                        <select id="category-filter"
                                @bind="categoryId">

                            <option value="">
                                All Categories
                            </option>


                            @foreach (var category in Categories)
                            {
                                <option value="@category.CategoryID">
                                    @category.CategoryName
                                </option>
                            }

                        </select>

                    </div>


                    <!-- ADVERTISEMENT TYPE -->

                    <div class="filter-field">

                        <label for="type-filter">
                            Advertisement Type
                        </label>


                        <select id="type-filter"
                                @bind="typeId">

                            <option value="">
                                All Types
                            </option>


                            @foreach (var type in AdvertisementTypes)
                            {
                                <option value="@type.AdvertisementTypeID">
                                    @type.TypeName
                                </option>
                            }

                        </select>

                    </div>


                    <!-- COUNTRY -->

                    <div class="filter-field">

                        <label for="country-filter">
                            Country
                        </label>


                        <input id="country-filter"
                               type="number"
                               @bind="countryId"
                               placeholder="Country ID" />

                    </div>


                    <!-- STATE -->

                    <div class="filter-field">

                        <label for="state-filter">
                            State / Region
                        </label>


                        <input id="state-filter"
                               type="number"
                               @bind="stateId"
                               placeholder="State ID" />

                    </div>


                    <!-- CITY -->

                    <div class="filter-field">

                        <label for="city-filter">
                            City
                        </label>


                        <input id="city-filter"
                               type="number"
                               @bind="cityId"
                               placeholder="City ID" />

                    </div>


                    <!-- AREA -->

                    <div class="filter-field">

                        <label for="area-filter">
                            Area
                        </label>


                        <input id="area-filter"
                               type="number"
                               @bind="areaId"
                               placeholder="Area ID" />

                    </div>


                    <!-- MINIMUM PRICE -->

                    <div class="filter-field">

                        <label for="minimum-price">
                            Minimum Price
                        </label>


                        <input id="minimum-price"
                               type="number"
                               step="0.001"
                               @bind="minPrice"
                               placeholder="Min price" />

                    </div>


                    <!-- MAXIMUM PRICE -->

                    <div class="filter-field">

                        <label for="maximum-price">
                            Maximum Price
                        </label>


                        <input id="maximum-price"
                               type="number"
                               step="0.001"
                               @bind="maxPrice"
                               placeholder="Max price" />

                    </div>


                    <!-- BEDROOMS -->

                    <div class="filter-field">

                        <label for="bedrooms-filter">
                            Bedrooms
                        </label>


                        <select id="bedrooms-filter"
                                @bind="minBedrooms">

                            <option value="">
                                Any bedrooms
                            </option>

                            <option value="1">
                                1+
                            </option>

                            <option value="2">
                                2+
                            </option>

                            <option value="3">
                                3+
                            </option>

                            <option value="4">
                                4+
                            </option>

                            <option value="5">
                                5+
                            </option>

                        </select>

                    </div>


                    <!-- BATHROOMS -->

                    <div class="filter-field">

                        <label for="bathrooms-filter">
                            Bathrooms
                        </label>


                        <select id="bathrooms-filter"
                                @bind="minBathrooms">

                            <option value="">
                                Any bathrooms
                            </option>

                            <option value="1">
                                1+
                            </option>

                            <option value="2">
                                2+
                            </option>

                            <option value="3">
                                3+
                            </option>

                            <option value="4">
                                4+
                            </option>

                        </select>

                    </div>

                </div>


                <!-- FILTER FOOTER -->

                <div class="filter-footer">

                    <label class="check-filter">

                        <input type="checkbox"
                               @bind="negotiableFilterEnabled" />

                        <span class="custom-checkbox"></span>

                        <span>
                            Negotiable price
                        </span>

                    </label>


                    <label class="check-filter">

                        <input type="checkbox"
                               @bind="featuredFilterEnabled" />

                        <span class="custom-checkbox"></span>

                        <span>
                            Featured only
                        </span>

                    </label>


                    <button type="button"
                            class="apply-filter-button"
                            @onclick="ApplyFilters"
                            disabled="@isLoading">

                        @if (isLoading)
                        {
                            <span class="button-loading-spinner"></span>

                            <span>
                                Loading...
                            </span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M4 6h16" />

                                <path d="M7 12h10" />

                                <path d="M10 18h4" />

                            </svg>

                            <span>
                                Apply Filters
                            </span>
                        }

                    </button>

                </div>

            </section>


            <!-- ====================================================
                 RESULTS
                 ==================================================== -->

            <section class="results-section">

                <div class="results-header">

                    <div>

                        <span class="section-label">
                            MARKETPLACE
                        </span>


                        <h2>
                            Latest Advertisements
                        </h2>


                        @if (Advertisements is not null)
                        {
                            <p class="results-count">

                                @Advertisements.TotalRecords
                                advertisements available

                            </p>
                        }

                    </div>


                    <!-- SORT -->

                    <div class="sort-control">

                        <label for="sort-by">
                            Sort by
                        </label>


                        <select id="sort-by"
                                @bind="sortBy">

                            <option value="createddate">
                                Newest
                            </option>

                            <option value="price">
                                Price
                            </option>

                            <option value="title">
                                Title
                            </option>

                            <option value="bedrooms">
                                Bedrooms
                            </option>

                            <option value="landarea">
                                Land Area
                            </option>

                            <option value="builtuparea">
                                Built-up Area
                            </option>

                        </select>


                        <select @bind="sortDirection"
                                aria-label="Sort direction">

                            <option value="desc">
                                Descending
                            </option>

                            <option value="asc">
                                Ascending
                            </option>

                        </select>


                        <button type="button"
                                class="sort-apply-button"
                                @onclick="ApplyFilters"
                                disabled="@isLoading">

                            Apply

                        </button>

                    </div>

                </div>


                <!-- RESULTS STATE -->

                @if (isLoading)
                {
                    <div class="loading-state">

                        <div class="loading-spinner"
                             aria-hidden="true">
                        </div>

                        <p>
                            Loading advertisements...
                        </p>

                    </div>
                }
                else if (loadError)
                {
                    <div class="empty-state error-state">

                        <div class="empty-icon">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M12 3 2.5 20h19L12 3Z" />

                                <path d="M12 9v5" />

                                <path d="M12 17h.01" />

                            </svg>

                        </div>


                        <h3>
                            Unable to load advertisements
                        </h3>


                        <p>
                            We could not retrieve the advertisements
                            at the moment. Please try again.
                        </p>


                        <button type="button"
                                @onclick="LoadAdvertisementsAsync">

                            Try Again

                        </button>

                    </div>
                }
                else if (Advertisements?.Items is null ||
                         Advertisements.Items.Count == 0)
                {
                    <div class="empty-state">

                        <div class="empty-icon">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <circle cx="11"
                                        cy="11"
                                        r="7" />

                                <path d="m20 20-4-4" />

                            </svg>

                        </div>


                        <h3>
                            No advertisements found
                        </h3>


                        <p>
                            Try changing your search criteria or filters.
                        </p>


                        <button type="button"
                                @onclick="ClearFilters">

                            Clear Filters

                        </button>

                    </div>
                }
                else
                {
                    <div class="advertisement-grid">

                        @foreach (var advertisement in Advertisements.Items)
                        {
                            <article class="advertisement-card">


                                <!-- IMAGE -->

                                <div class="advertisement-image">

                                    @if (advertisement.IsFeatured)
                                    {
                                        <span class="featured-badge">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" />

                                            </svg>

                                            Featured

                                        </span>
                                    }


                                    <div class="image-placeholder">

                                        <span>
                                            HR
                                        </span>

                                    </div>


                                    <button type="button"
                                            class="favorite-button"
                                            title="Add to favorites"
                                            aria-label="Add to favorites">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M20.8 8.7c0 5.1-8.8 10.3-8.8 10.3S3.2 13.8 3.2 8.7A4.7 4.7 0 0 1 12 6.2a4.7 4.7 0 0 1 8.8 2.5Z" />

                                        </svg>

                                    </button>

                                </div>


                                <!-- BODY -->

                                <div class="advertisement-body">


                                    <!-- CATEGORY -->

                                    <div class="advertisement-category">

                                        @if (!string.IsNullOrWhiteSpace(
                                            advertisement.CategoryName))
                                        {
                                            <span>
                                                @advertisement.CategoryName
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Advertisement
                                            </span>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(
                                            advertisement.AdvertisementTypeName))
                                        {
                                            <span class="category-separator">
                                                •
                                            </span>

                                            <span>
                                                @advertisement.AdvertisementTypeName
                                            </span>
                                        }

                                    </div>


                                    <!-- TITLE -->

                                    <h3>

                                        @if (!string.IsNullOrWhiteSpace(
                                            advertisement.Title))
                                        {
                                            @advertisement.Title
                                        }
                                        else
                                        {
                                            <span>
                                                Untitled Advertisement
                                            </span>
                                        }

                                    </h3>


                                    <!-- LOCATION -->

                                    @if (!string.IsNullOrWhiteSpace(
                                        advertisement.AddressLine))
                                    {
                                        <div class="advertisement-location">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />

                                                <circle cx="12"
                                                        cy="10"
                                                        r="2.5" />

                                            </svg>

                                            <span>
                                                @advertisement.AddressLine
                                            </span>

                                        </div>
                                    }


                                    <!-- DETAILS -->

                                    <div class="advertisement-details">

                                        @if (advertisement.Bedrooms.HasValue)
                                        {
                                            <span>

                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="M3 11v8" />

                                                    <path d="M21 11v8" />

                                                    <path d="M3 15h18" />

                                                    <path d="M5 11V8a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3" />

                                                    <path d="M12 11V8a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3" />

                                                </svg>

                                                @advertisement.Bedrooms Beds

                                            </span>
                                        }


                                        @if (advertisement.Bathrooms.HasValue)
                                        {
                                            <span>

                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="M4 12h16" />

                                                    <path d="M6 12v4a4 4 0 0 0 4 4h4a4 4 0 0 0 4-4v-4" />

                                                    <path d="M6 12V7a3 3 0 0 1 6 0v1" />

                                                </svg>

                                                @advertisement.Bathrooms Baths

                                            </span>
                                        }


                                        @if (advertisement.BuiltUpArea.HasValue)
                                        {
                                            <span>

                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="M4 4h16v16H4z" />

                                                    <path d="M8 8h8v8H8z" />

                                                </svg>

                                                @advertisement.BuiltUpArea

                                            </span>
                                        }

                                    </div>


                                    <!-- FOOTER -->

                                    <div class="advertisement-footer">


                                        <!-- PRICE -->

                                        <div class="advertisement-price">

                                            @if (advertisement.Price.HasValue)
                                            {
                                                <span class="price-value">
                                                    @advertisement.Price.Value.ToString("N0")
                                                </span>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    advertisement.CurrencyCode))
                                                {
                                                    <span class="price-currency">
                                                        @advertisement.CurrencyCode
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="price-on-request">
                                                    Price on request
                                                </span>
                                            }

                                        </div>


                                        <!-- NEGOTIABLE -->

                                        @if (advertisement.IsNegotiable)
                                        {
                                            <span class="negotiable">
                                                Negotiable
                                            </span>
                                        }

                                    </div>

                                </div>

                            </article>
                        }

                    </div>


                    <!-- PAGINATION -->

                    @if (Advertisements.TotalPages > 1)
                    {
                        <div class="pagination">

                            <button type="button"
                                    disabled="@(currentPage <= 1 || isLoading)"
                                    @onclick="PreviousPage"
                                    aria-label="Previous page">

                                ‹

                            </button>


                            @for (var page = 1;
                                  page <= Advertisements.TotalPages;
                                  page++)
                            {
                                var pageNumber = page;

                                <button type="button"
                                        class="@(pageNumber == currentPage ? "active" : "")"
                                        disabled="@isLoading"
                                        @onclick="@(() => GoToPage(pageNumber))"
                                        aria-label="@($"Go to page {pageNumber}")">

                                    @pageNumber

                                </button>
                            }


                            <button type="button"
                                    disabled="@(currentPage >= Advertisements.TotalPages || isLoading)"
                                    @onclick="NextPage"
                                    aria-label="Next page">

                                ›

                            </button>

                        </div>
                    }

                }

            </section>


            <!-- ====================================================
                 CATEGORIES
                 ==================================================== -->

            <section class="categories-section"
                     id="categories">

                <div class="section-heading-centered">

                    <span class="section-label">
                        EXPLORE
                    </span>


                    <h2>
                        Browse by category
                    </h2>


                    <p>
                        Explore advertisements based on what you are
                        looking for.
                    </p>

                </div>


                <div class="category-cards">

                    @foreach (var category in Categories)
                    {
                        <button type="button"
                                class="category-card"
                                @onclick="@(() => SelectCategory(category.CategoryID))">

                            <span class="category-card-icon"
                                  aria-hidden="true">

                                <svg viewBox="0 0 24 24">

                                    <path d="M4 4h7v7H4z" />

                                    <path d="M13 4h7v7h-7z" />

                                    <path d="M4 13h7v7H4z" />

                                    <path d="M13 13h7v7h-7z" />

                                </svg>

                            </span>

                            <span class="category-card-name">
                                @category.CategoryName
                            </span>

                        </button>
                    }


                    @if (Categories.Count == 0)
                    {
                        <div class="category-empty">

                            Categories will appear here when
                            advertisements are available.

                        </div>
                    }

                </div>

            </section>


            <!-- ====================================================
                 HOW IT WORKS
                 ==================================================== -->

            <section class="how-it-works"
                     id="how-it-works">

                <div class="section-heading-centered">

                    <span class="section-label">
                        SIMPLE &amp; CONVENIENT
                    </span>


                    <h2>
                        How HR INFO ADs works
                    </h2>


                    <p>
                        Everything you need to discover or publish
                        advertisements in one place.
                    </p>

                </div>


                <div class="steps-grid">


                    <!-- STEP 1 -->

                    <div class="step-card">

                        <div class="step-number">
                            01
                        </div>


                        <h3>
                            Search
                        </h3>


                        <p>
                            Find advertisements using keywords,
                            categories, prices and locations.
                        </p>

                    </div>


