@code {

    // ============================================================
    // DATA
    // ============================================================

    private AdvertisementListResponse Advertisements { get; set; } = new();


    // ============================================================
    // PAGE STATE
    // ============================================================

    private bool isLoading;

    private bool loadError;


    // ============================================================
    // SEARCH
    // ============================================================

    private string searchText = string.Empty;


    // ============================================================
    // FILTERS
    // ============================================================

    private int? categoryId;

    private int? typeId;

    private int? countryId;

    private int? stateId;

    private int? cityId;

    private int? areaId;

    private decimal? minPrice;

    private decimal? maxPrice;

    private int? minBedrooms;

    private int? minBathrooms;


    // ============================================================
    // OPTIONAL FILTER FLAGS
    // ============================================================

    private bool negotiableFilterEnabled;

    private bool featuredFilterEnabled;


    // ============================================================
    // SORT
    // ============================================================

    private string sortBy = "createddate";

    private string sortDirection = "desc";


    // ============================================================
    // PAGINATION
    // ============================================================

    private int currentPage = 1;

    private const int PageSize = 12;


    // ============================================================
    // LOOKUP OPTIONS
    // ============================================================

    private List<CategoryOption> Categories { get; set; } = new();

    private List<AdvertisementTypeOption> AdvertisementTypes { get; set; } = new();


    // ============================================================
    // AUTHENTICATION MODAL
    // ============================================================

    private bool showAuthModal;

    private AuthMode authMode = AuthMode.SignIn;

    private bool isLoginLoading;

    private bool showPassword;

    private string? errorMessage;

    private string? signupMessage;


    private readonly LoginModel loginModel = new();

    private readonly SignupModel signupModel = new();

    private bool isAuthenticated;

private string currentUserName = string.Empty;


    // ============================================================
    // INITIALIZE
    // ============================================================

    protected override async Task OnInitializedAsync()
{
    await LoadAuthenticationStateAsync();

    await LoadAdvertisementsAsync();
}


private async Task LoadAuthenticationStateAsync()
{
    var authenticationState =
        await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

    var user = authenticationState.User;

    isAuthenticated =
        user.Identity?.IsAuthenticated == true;

    currentUserName =
        user.Identity?.Name ?? string.Empty;
}

private void HandlePostAdvertisement()
{
    if (isAuthenticated)
    {
        Navigation.NavigateTo("/my-ads/create");
        return;
    }

    OpenLogin();
}

private void OpenAccount()
{
    Navigation.NavigateTo("/account");
}

private void OpenMyAdvertisements()
{
    Navigation.NavigateTo("/my-ads");
}
    // ============================================================
    // LOAD ADVERTISEMENTS
    // ============================================================

    private async Task LoadAdvertisementsAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;

        loadError = false;

        try
        {
            var result =
                await AdvertisementApiService
                    .GetPublishedAdvertisementsAsync(
                        pageNumber: currentPage,
                        pageSize: PageSize,
                        search: searchText,
                        categoryId: categoryId,
                        typeId: typeId,
                        countryId: countryId,
                        stateId: stateId,
                        cityId: cityId,
                        areaId: areaId,
                        minPrice: minPrice,
                        maxPrice: maxPrice);

            if (result is null)
            {
                Advertisements = new();

                Categories = new();

                AdvertisementTypes = new();

                loadError = true;

                return;
            }


            Advertisements = result;


            BuildFilterOptions();


            ApplyClientSideFilters();

        }
        catch (HttpRequestException)
        {
            Advertisements = new();

            Categories = new();

            AdvertisementTypes = new();

            loadError = true;
        }
        catch (TaskCanceledException)
        {
            Advertisements = new();

            Categories = new();

            AdvertisementTypes = new();

            loadError = true;
        }
        catch
        {
            Advertisements = new();

            Categories = new();

            AdvertisementTypes = new();

            loadError = true;
        }
        finally
        {
            isLoading = false;
        }
    }


    // ============================================================
    // BUILD FILTER OPTIONS
    // ============================================================

    private void BuildFilterOptions()
    {
        var items = Advertisements.Items;

        if (items is null ||
            items.Count == 0)
        {
            Categories = new();

            AdvertisementTypes = new();

            return;
        }


        Categories =
            items
                .Where(x =>
                    x.CategoryID > 0 &&
                    !string.IsNullOrWhiteSpace(
                        x.CategoryName))
                .GroupBy(x => new
                {
                    x.CategoryID,
                    x.CategoryName
                })
                .Select(x =>
                    new CategoryOption
                    {
                        CategoryID =
                            x.Key.CategoryID,

                        CategoryName =
                            x.Key.CategoryName
                    })
                .OrderBy(x =>
                    x.CategoryName)
                .ToList();


        AdvertisementTypes =
            items
                .Where(x =>
                    x.AdvertisementTypeID > 0 &&
                    !string.IsNullOrWhiteSpace(
                        x.AdvertisementTypeName))
                .GroupBy(x => new
                {
                    x.AdvertisementTypeID,
                    x.AdvertisementTypeName
                })
                .Select(x =>
                    new AdvertisementTypeOption
                    {
                        AdvertisementTypeID =
                            x.Key.AdvertisementTypeID,

                        TypeName =
                            x.Key.AdvertisementTypeName
                    })
                .OrderBy(x =>
                    x.TypeName)
                .ToList();
    }


    // ============================================================
    // CLIENT-SIDE FILTERS
    // ============================================================

    private void ApplyClientSideFilters()
    {
        if (Advertisements.Items is null ||
            Advertisements.Items.Count == 0)
        {
            return;
        }


        IEnumerable<AdvertisementResponse> filteredItems =
            Advertisements.Items;


        if (negotiableFilterEnabled)
        {
            filteredItems =
                filteredItems
                    .Where(x =>
                        x.IsNegotiable);
        }


        if (featuredFilterEnabled)
        {
            filteredItems =
                filteredItems
                    .Where(x =>
                        x.IsFeatured);
        }


        if (minBedrooms.HasValue)
        {
            filteredItems =
                filteredItems
                    .Where(x =>
                        x.Bedrooms.HasValue &&
                        x.Bedrooms.Value >=
                        minBedrooms.Value);
        }


        if (minBathrooms.HasValue)
        {
            filteredItems =
                filteredItems
                    .Where(x =>
                        x.Bathrooms.HasValue &&
                        x.Bathrooms.Value >=
                        minBathrooms.Value);
        }


        Advertisements.Items =
            filteredItems.ToList();
    }


    // ============================================================
    // SEARCH
    // ============================================================

    private async Task SearchAdvertisements()
    {
        currentPage = 1;

        await LoadAdvertisementsAsync();
    }


    // ============================================================
    // APPLY FILTERS
    // ============================================================

    private async Task ApplyFilters()
    {
        currentPage = 1;

        await LoadAdvertisementsAsync();
    }


    // ============================================================
    // CLEAR FILTERS
    // ============================================================

    private async Task ClearFilters()
    {
        searchText = string.Empty;

        categoryId = null;

        typeId = null;

        countryId = null;

        stateId = null;

        cityId = null;

        areaId = null;

        minPrice = null;

        maxPrice = null;

        minBedrooms = null;

        minBathrooms = null;

        negotiableFilterEnabled = false;

        featuredFilterEnabled = false;

        sortBy = "createddate";

        sortDirection = "desc";

        currentPage = 1;

        await LoadAdvertisementsAsync();
    }


    // ============================================================
    // CATEGORY
    // ============================================================

    private async Task SelectCategory(
        int selectedCategoryId)
    {
        categoryId = selectedCategoryId;

        currentPage = 1;

        await LoadAdvertisementsAsync();
    }


    // ============================================================
    // PAGINATION
    // ============================================================

    private async Task GoToPage(int page)
    {
        if (page < 1 ||
            page > Advertisements.TotalPages)
        {
            return;
        }


        if (isLoading)
        {
            return;
        }


        currentPage = page;

        await LoadAdvertisementsAsync();
    }


    private async Task PreviousPage()
    {
        if (currentPage <= 1 ||
            isLoading)
        {
            return;
        }


        currentPage--;

        await LoadAdvertisementsAsync();
    }


    private async Task NextPage()
    {
        if (currentPage >= Advertisements.TotalPages ||
            isLoading)
        {
            return;
        }


        currentPage++;

        await LoadAdvertisementsAsync();
    }


    // ============================================================
    // POPULAR SEARCH
    // ============================================================

    private async Task SetSearch(string value)
    {
        searchText = value;

        currentPage = 1;

        await LoadAdvertisementsAsync();
    }


    // ============================================================
    // SEARCH KEYBOARD
    // ============================================================

    private async Task HandleSearchKeyDown(
        KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAdvertisements();
        }
    }


    // ============================================================
    // OPEN LOGIN
    // ============================================================

    private void OpenLogin()
    {
        errorMessage = null;

        signupMessage = null;

        showPassword = false;

        authMode = AuthMode.SignIn;

        showAuthModal = true;
    }


    // ============================================================
    // OPEN SIGN UP
    // ============================================================

    private void OpenSignup()
    {
        errorMessage = null;

        signupMessage = null;

        showPassword = false;

        authMode = AuthMode.SignUp;

        showAuthModal = true;
    }


    // ============================================================
    // CLOSE AUTH MODAL
    // ============================================================

    private void CloseAuthModal()
    {
        if (isLoginLoading)
        {
            return;
        }


        showAuthModal = false;

        errorMessage = null;

        signupMessage = null;

        showPassword = false;
    }


    // ============================================================
    // SIGN IN TAB
    // ============================================================

    private void ShowSignIn()
    {
        authMode = AuthMode.SignIn;

        errorMessage = null;

        signupMessage = null;

        showPassword = false;
    }


