    .ed-alert{display:flex;align-items:center;gap:10px;padding:13px 15px;border-radius:10px;margin-bottom:16px;font-size:12px}.ed-alert span{flex:1}.ed-alert-error{border:1px solid #fecaca;background:#fef2f2;color:#991b1b}.ed-alert-success{border:1px solid #bbf7d0;background:#f0fdf4;color:#166534}.ed-alert button{border:0;background:transparent;color:inherit;cursor:pointer}
    .ed-state{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:280px;padding:30px;border:1px solid #e5eaf2;border-radius:15px;background:#fff;text-align:center}.ed-state h1{font-size:21px;margin:12px 0 8px}.ed-state p{max-width:480px;color:#64748b;font-size:13px;line-height:1.7}.ed-state-icon{font-size:30px;color:#dc2626}
    .ed-spinner{width:30px;height:30px;border:3px solid #dbeafe;border-top-color:#2563eb;border-radius:50%;animation:ed-spin .7s linear infinite}.ed-button-spinner{width:12px;height:12px;border:2px solid rgba(255,255,255,.5);border-top-color:#fff;border-radius:50%;animation:ed-spin .7s linear infinite}
