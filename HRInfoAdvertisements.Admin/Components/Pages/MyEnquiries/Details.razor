    .ed-ad-card,.ed-participants,.ed-conversation-card{border:1px solid #e5eaf2;border-radius:15px;background:#fff;box-shadow:0 3px 12px rgba(15,23,42,.025)}
    .ed-ad-card{display:flex;align-items:center;gap:15px;padding:19px;margin-bottom:16px}
    .ed-ad-icon,.ed-conversation-heading-icon{display:flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px;height:44px;border-radius:12px;background:#eff6ff;color:#2563eb;font-size:20px}
    .ed-ad-info{flex:1;min-width:0}.ed-ad-info h2{margin:6px 0;font-size:15px;font-weight:800;overflow-wrap:anywhere}.ed-ad-info p{margin:0;color:#64748b;font-size:12px}
    .ed-secondary-button,.ed-primary-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:10px 14px;border-radius:9px;font-size:12px;font-weight:750;cursor:pointer}
