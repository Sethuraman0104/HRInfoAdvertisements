    @@media(max-width:680px){.enquiry-details-container{width:calc(100% - 24px);padding-top:20px}.ed-page-header{flex-direction:column}.ed-ad-card{align-items:flex-start;flex-wrap:wrap}.ed-ad-card .ed-secondary-button{width:100%}.ed-participants{align-items:flex-start;flex-direction:column;gap:14px}.ed-participant-divider{display:none}.ed-date-info{padding:0;border:0}.ed-message-list{padding:16px;max-height:unset}.ed-message-row{max-width:100%}.ed-reply-form{padding:16px}.ed-reply-footer,.ed-page-footer{align-items:flex-start;flex-direction:column}.ed-reply-footer .ed-primary-button{width:100%}.ed-closed-note{margin-left:auto}}
</style>

@code {
    [Parameter]
    public long EnquiryId { get; set; }

    private AdvertisementEnquiryDetailResponse? Enquiry { get; set; }
    private string replyMessage = string.Empty;
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;
    private bool isSending;
    private bool isClosing;
    private long CurrentUserId;

    private List<AdvertisementEnquiryMessageResponse> ConversationMessages =>
        Enquiry?.Messages?.OrderBy(x => x.CreatedDate).ToList()
        ?? new List<AdvertisementEnquiryMessageResponse>();

    private bool IsClosed =>
        string.Equals(Enquiry?.Status, "CLOSED", StringComparison.OrdinalIgnoreCase);

    private bool CanSendReply =>
        !isSending && !IsClosed && !string.IsNullOrWhiteSpace(replyMessage)
        && replyMessage.Trim().Length <= 4000;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEnquiryAsync();
    }

    private async Task LoadEnquiryAsync()
    {
        if (isLoading)
            return;

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = state.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/");
                return;
            }

            var userIdClaim = user.FindFirst(
                System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? user.FindFirst("sub")?.Value
                ?? user.FindFirst("UserID")?.Value;

            if (!long.TryParse(userIdClaim, out CurrentUserId))
                CurrentUserId = 0;

            Enquiry = await AdvertisementApiService.GetEnquiryByIdAsync(EnquiryId);

            if (Enquiry is null)
            {
                errorMessage = "This enquiry could not be found or you do not have permission to view it.";
                return;
            }

            // The API must enforce ownership/participant authorization as the security boundary.
            // This client-side check is an additional safeguard.
            if (CurrentUserId > 0 &&
                Enquiry.SenderUserID != CurrentUserId &&
                Enquiry.RecipientUserID != CurrentUserId)
            {
                Enquiry = null;
                errorMessage = "You do not have permission to view this enquiry.";
                return;
            }

            try
            {
                await AdvertisementApiService.MarkEnquiryAsReadAsync(EnquiryId);
            }
            catch (Exception ex)
            {
                // Read receipts are non-critical; do not block viewing the conversation.
                Console.WriteLine($"Could not mark enquiry {EnquiryId} as read: {ex.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ENQUIRY DETAILS LOAD ERROR ({EnquiryId}): {ex}");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SendReplyAsync()
    {
        if (!CanSendReply || Enquiry is null)
            return;

        isSending = true;
        errorMessage = null;
        successMessage = null;
        var messageText = replyMessage.Trim();

        try
        {
            var sentMessage = await AdvertisementApiService.ReplyToEnquiryAsync(
                EnquiryId,
                new ReplyAdvertisementEnquiryRequest { Message = messageText });

            Enquiry.Messages ??= new List<AdvertisementEnquiryMessageResponse>();
            Enquiry.Messages.Add(sentMessage);
            Enquiry.LastRepliedDate = sentMessage.CreatedDate;
            replyMessage = string.Empty;
            successMessage = "Your reply has been sent.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ENQUIRY REPLY ERROR ({EnquiryId}): {ex}");
            errorMessage = ex.Message;
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task CloseEnquiryAsync()
    {
        if (Enquiry is null || IsClosed || isClosing)
            return;

        isClosing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await AdvertisementApiService.CloseEnquiryAsync(EnquiryId);
            Enquiry.Status = "CLOSED";
            Enquiry.ClosedDate = DateTime.Now;
            successMessage = "The enquiry has been closed.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ENQUIRY CLOSE ERROR ({EnquiryId}): {ex}");
            errorMessage = ex.Message;
        }
        finally
        {
            isClosing = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/my-enquiries");

    private void OpenAdvertisement()
    {
        if (Enquiry is not null)
            Navigation.NavigateTo($"/advertisements/{Enquiry.AdvertisementID}");
    }

    private static string GetStatusLabel(string? status)
    {
        if (string.Equals(status, "OPEN", StringComparison.OrdinalIgnoreCase))
            return "Open";
        if (string.Equals(status, "CLOSED", StringComparison.OrdinalIgnoreCase))
            return "Closed";

        return string.IsNullOrWhiteSpace(status)
            ? "Unknown"
            : CultureInfo.CurrentCulture.TextInfo.ToTitleCase(status.ToLowerInvariant());
    }

    private static string GetStatusClass(string? status)
    {
        var stateClass = string.Equals(status, "OPEN", StringComparison.OrdinalIgnoreCase)
            ? "open"
            : string.Equals(status, "CLOSED", StringComparison.OrdinalIgnoreCase)
                ? "closed"
                : "other";

        return $"ed-status ed-status-{stateClass}";
    }
}
