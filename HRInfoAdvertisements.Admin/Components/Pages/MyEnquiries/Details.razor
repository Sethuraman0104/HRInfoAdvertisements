@page "/enquiries/{EnquiryId:long}"

@using System.Globalization
@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.Enquiries.DTOs

@layout HRInfoAdvertisements.Admin.Components.Layout.PublicLayout

@inject AdvertisementApiService AdvertisementApiService
@inject PublicAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(Enquiry?.Subject ?? "Enquiry Conversation")</PageTitle>

<div class="enquiry-details-page">
    <PublicTopBar />

    <main class="enquiry-details-container">
        <button type="button" class="ed-back-link" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
            Back to My Enquiries
        </button>

        @if (isLoading)
        {
            <section class="ed-state">
                <span class="ed-spinner"></span>
                <h1>Loading conversation</h1>
                <p>Please wait while we retrieve this enquiry.</p>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage) && Enquiry is null)
        {
            <section class="ed-state ed-error-state" role="alert">
                <i class="bi bi-exclamation-circle ed-state-icon"></i>
                <h1>Unable to open enquiry</h1>
                <p>@errorMessage</p>
                <button type="button" class="ed-primary-button" @onclick="LoadEnquiryAsync">
                    Try again
                </button>
            </section>
        }
        else if (Enquiry is not null)
        {
            <header class="ed-page-header">
                <div>
                    <span class="ed-eyebrow">MY MARKETPLACE · ENQUIRY #@Enquiry.AdvertisementEnquiryID</span>
                    <h1>@Enquiry.Subject</h1>
                    <p>Review the enquiry and continue your conversation with the other party.</p>
                </div>
                <span class="@GetStatusClass(Enquiry.Status)">@GetStatusLabel(Enquiry.Status)</span>
            </header>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="ed-alert ed-alert-error" role="alert">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@errorMessage</span>
                    <button type="button" aria-label="Dismiss error" @onclick="() => errorMessage = null">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="ed-alert ed-alert-success" role="status">
                    <i class="bi bi-check-circle"></i>
                    <span>@successMessage</span>
                </div>
            }

            <section class="ed-ad-card">
                <div class="ed-ad-icon"><i class="bi bi-tag"></i></div>
                <div class="ed-ad-info">
                    <span class="ed-card-eyebrow">ADVERTISEMENT</span>
                    <h2>@(string.IsNullOrWhiteSpace(Enquiry.AdvertisementTitle) ? "Advertisement" : Enquiry.AdvertisementTitle)</h2>
                    @if (!string.IsNullOrWhiteSpace(Enquiry.AdvertisementNumber))
                    {
                        <p>Reference: @Enquiry.AdvertisementNumber</p>
                    }
                </div>
                <button type="button" class="ed-secondary-button" @onclick="OpenAdvertisement">
                    View Advertisement <i class="bi bi-arrow-up-right"></i>
                </button>
            </section>

            <section class="ed-participants">
                <div class="ed-participant">
                    <span class="ed-avatar"><i class="bi bi-person"></i></span>
                    <div><span class="ed-card-eyebrow">SENT BY</span><strong>@(string.IsNullOrWhiteSpace(Enquiry.SenderName) ? "Customer" : Enquiry.SenderName)</strong></div>
                </div>
                <div class="ed-participant-divider"><i class="bi bi-arrow-left-right"></i></div>
                <div class="ed-participant">
                    <span class="ed-avatar ed-avatar-recipient"><i class="bi bi-person-badge"></i></span>
                    <div><span class="ed-card-eyebrow">TO</span><strong>@(string.IsNullOrWhiteSpace(Enquiry.RecipientName) ? "Advertiser" : Enquiry.RecipientName)</strong></div>
                </div>
                <div class="ed-date-info">
                    <span class="ed-card-eyebrow">CREATED</span>
                    <strong>@Enquiry.CreatedDate.ToString("dd MMM yyyy, h:mm tt", CultureInfo.CurrentCulture)</strong>
                </div>
            </section>

            <section class="ed-conversation-card">
                <header class="ed-conversation-header">
                    <div class="ed-conversation-heading-icon"><i class="bi bi-chat-square-text"></i></div>
                    <div>
                        <h2>Conversation</h2>
                        <p>@ConversationMessages.Count message(s)</p>
                    </div>
                    @if (IsClosed)
                    {
                        <span class="ed-closed-note"><i class="bi bi-lock"></i> Conversation closed</span>
                    }
                </header>

                <div class="ed-message-list">
                    @if (ConversationMessages.Count == 0)
                    {
                        <div class="ed-empty-messages">
                            <i class="bi bi-chat-dots"></i>
                            <p>No conversation messages were returned for this enquiry.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var message in ConversationMessages)
                        {
                            var isCurrentUser = message.SenderUserID == CurrentUserId;
                            <article class="ed-message-row @(isCurrentUser ? "ed-message-row-mine" : "")" @key="message.AdvertisementEnquiryMessageID">
                                <span class="ed-message-avatar @(isCurrentUser ? "ed-message-avatar-mine" : "")">
                                    <i class="bi bi-person"></i>
                                </span>
                                <div class="ed-message-content">
                                    <div class="ed-message-meta">
                                        <strong>@(isCurrentUser ? "You" : (string.IsNullOrWhiteSpace(message.SenderName) ? "Participant" : message.SenderName))</strong>
                                        <time>@message.CreatedDate.ToString("dd MMM yyyy, h:mm tt", CultureInfo.CurrentCulture)</time>
                                    </div>
                                    <div class="ed-message-bubble @(isCurrentUser ? "ed-message-bubble-mine" : "")">@message.Message</div>
                                </div>
                            </article>
                        }
                    }
                </div>

                @if (!IsClosed)
                {
                    <form class="ed-reply-form" @onsubmit="SendReplyAsync" @onsubmit:preventDefault>
                        <label for="ed-reply">Your reply</label>
                        <textarea id="ed-reply"
                                  @bind="replyMessage"
                                  @bind:event="oninput"
                                  rows="4"
                                  maxlength="4000"
                                  placeholder="Write your message here..."
                                  disabled="@isSending"></textarea>
                        <div class="ed-reply-footer">
                            <span>Keep your message clear and relevant.</span>
                            <button type="submit" class="ed-primary-button" disabled="@(!CanSendReply)">
                                @if (isSending)
{
    <span class="ed-button-spinner"></span>
    <span>Sending...</span>
}
else
{
    <i class="bi bi-send"></i>
    <span>Send Reply</span>
}
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="ed-closed-banner">
                        <i class="bi bi-lock"></i>
                        This enquiry is closed, so no further replies can be sent.
                    </div>
                }
            </section>

            <footer class="ed-page-footer">
                <span><i class="bi bi-shield-check"></i> Keep communication respectful and relevant.</span>
                @if (!IsClosed)
                {
                    <button type="button" class="ed-close-button" disabled="@isClosing" @onclick="CloseEnquiryAsync">
                        <i class="bi bi-check2-circle"></i>
                        @(isClosing ? "Closing..." : "Close Enquiry")
                    </button>
                }
            </footer>
        }
    </main>
</div>

<style>
