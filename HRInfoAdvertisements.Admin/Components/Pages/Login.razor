@page "/login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.SystemSettings

@layout HRInfoAdvertisements.Admin.Components.Layout.PublicLayout

@inject AuthApiService AuthApiService
@inject PublicAuthenticationStateProvider PublicAuthenticationStateProvider
@inject SiteSettingsService SiteSettingsService
@inject NavigationManager Navigation

<PageTitle>Sign In | @Site.SiteName</PageTitle>

<div class="public-auth-page">

    <div class="public-auth-card">

        <div class="public-auth-header">

            <div class="public-auth-logo">
                @BrandInitials()
            </div>

            <div class="public-auth-brand">
                <strong>@Site.SiteName</strong>
                <span>ADs</span>
            </div>

        </div>

        <div class="public-auth-heading">

            <span class="public-auth-eyebrow">
                ACCOUNT ACCESS
            </span>

            <h1>
                Welcome back
            </h1>

            <p>
                Sign in to manage your advertisements,
                enquiries, favorites and messages.
            </p>

        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="public-auth-error"
                 role="alert">

                @errorMessage

                @if (showVerifyLink)
                {
                    <div>
                        <a href="/?auth=signin">
                            Go to sign in and verify your email
                        </a>
                    </div>
                }

            </div>
        }

        <EditForm Model="@loginModel"
                  OnValidSubmit="@HandleLogin"
                  FormName="PublicLoginForm">

            <DataAnnotationsValidator />

            <div class="public-form-group">

                <label for="login-email">
                    Email address
                </label>

                <InputText id="login-email"
                           class="public-form-input"
                           @bind-Value="loginModel.Email"
                           autocomplete="username"
                           placeholder="Enter your email address" />

                <ValidationMessage
                    For="@(() => loginModel.Email)" />

            </div>

            <div class="public-form-group">

                <label for="login-password">
                    Password
                </label>

                <InputText id="login-password"
                           class="public-form-input"
                           type="password"
                           @bind-Value="loginModel.Password"
                           autocomplete="current-password"
                           placeholder="Enter your password" />

                <ValidationMessage
                    For="@(() => loginModel.Password)" />

            </div>

            <button type="submit"
                    class="public-auth-submit"
                    disabled="@isLoading">

                @if (isLoading)
                {
                    <span>
                        Signing in...
                    </span>
                }
                else
                {
                    <span>
                        Sign in
                    </span>

                    <span>
                        →
                    </span>
                }

            </button>

        </EditForm>

        <!-- SUPPORT_EMAIL -->
        <div class="public-auth-register">

            <span>
                Forgot your password?
            </span>

            @if (!string.IsNullOrWhiteSpace(Site.SupportEmail))
            {
                <a href="@($"mailto:{Site.SupportEmail}")">
                    Contact @Site.SupportEmail
                </a>
            }
            else
            {
                <span>
                    Please contact the @Site.SiteName administrator.
                </span>
            }

        </div>

        <div class="public-auth-register">

            <span>
                Don't have an account?
            </span>

            <a href="/register">
                Create an account
            </a>

        </div>

        <div class="public-auth-back">

            <a href="/">
                ← Return to @Site.SiteName
            </a>

        </div>

    </div>

</div>

@code
{
    // Loaded from /api/v1/system-settings/public (cached).
    // Defaults are used if the API is unavailable.
    private PublicSiteSettingsResponse Site { get; set; } = new();

    private readonly LoginModel loginModel = new();

    private bool isLoading;

    private bool showVerifyLink;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        Site = await SiteSettingsService.GetAsync();
    }

    // "AdMind" -> "AM"
    private string BrandInitials()
    {
        var name = Site.SiteName ?? string.Empty;

        var capitals =
            new string(name.Where(char.IsUpper).Take(2).ToArray());

        if (capitals.Length >= 2)
        {
            return capitals;
        }

        return name.Length >= 2
            ? name[..2].ToUpperInvariant()
            : name.ToUpperInvariant();
    }

    private async Task HandleLogin()
    {
        if (isLoading)
        {
            return;
        }

        errorMessage = null;
        showVerifyLink = false;
        isLoading = true;

        try
        {
            var result =
                await AuthApiService.LoginAsync(
                    loginModel.Email.Trim(),
                    loginModel.Password);

            if (result == null)
            {
                errorMessage =
                    "The authentication service is currently unavailable.";

                return;
            }

            // Account exists but the email is not verified yet.
            // The OTP step lives in the home page sign-in modal.
            if (result.RequiresEmailVerification)
            {
                errorMessage =
                    "Your email address has not been verified yet.";

                showVerifyLink = true;

                return;
            }

            if (!result.Success)
            {
                errorMessage =
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Invalid email address or password."
                        : result.Message;

                return;
            }

            // Prevent administrators from using
            // the public user portal.
            var isAdministrator =
                result.Roles.Any(role =>
                    string.Equals(
                        role,
                        "Admin",
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    string.Equals(
                        role,
                        "SuperAdmin",
                        StringComparison.OrdinalIgnoreCase));

            if (isAdministrator)
            {
                errorMessage =
                    "Administrator accounts must use the administration portal.";

                return;
            }

            PublicAuthenticationStateProvider.SignIn(
                result.UserID,
                result.UserName,
                result.Email,
                result.Roles,
                result.Permissions,
                result.AccessToken,
                result.RefreshToken,
                result.ExpiresAt);

            Navigation.NavigateTo(
                "/",
                replace: true);
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "The authentication service is currently unavailable.";
        }
        catch
        {
            // Do not show raw exception text to visitors.
            errorMessage =
                "An unexpected error occurred while signing in.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class LoginModel
    {
        [Required(
            ErrorMessage = "Email address is required.")]

        [EmailAddress(
            ErrorMessage = "Please enter a valid email address.")]

        public string Email { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage = "Password is required.")]

        public string Password { get; set; } =
            string.Empty;
    }
}
