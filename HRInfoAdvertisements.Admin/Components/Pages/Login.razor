@page "/login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

@layout HRInfoAdvertisements.Admin.Components.Layout.PublicLayout

@inject HRInfoAdvertisements.Admin.Services.AuthApiService AuthApiService
@inject HRInfoAdvertisements.Admin.Services.PublicAuthenticationStateProvider PublicAuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Sign In | HR INFO ADs</PageTitle>

<div class="public-auth-page">

    <div class="public-auth-card">

        <div class="public-auth-header">

            <div class="public-auth-logo">
                HR
            </div>

            <div class="public-auth-brand">
                <strong>HR INFO</strong>
                <span>ADs</span>
            </div>

        </div>

        <div class="public-auth-heading">

            <span class="public-auth-eyebrow">
                ACCOUNT ACCESS
            </span>

            <h1>
                Welcome back
            </h1>

            <p>
                Sign in to manage your advertisements,
                enquiries, favorites and messages.
            </p>

        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="public-auth-error"
                 role="alert">

                @errorMessage

            </div>
        }

        <EditForm Model="@loginModel"
                  OnValidSubmit="@HandleLogin"
                  FormName="PublicLoginForm">

            <DataAnnotationsValidator />

            <div class="public-form-group">

                <label for="login-email">
                    Email address
                </label>

                <InputText id="login-email"
                           class="public-form-input"
                           @bind-Value="loginModel.Email"
                           autocomplete="username"
                           placeholder="Enter your email address" />

                <ValidationMessage
                    For="@(() => loginModel.Email)" />

            </div>

            <div class="public-form-group">

                <label for="login-password">
                    Password
                </label>

                <InputText id="login-password"
                           class="public-form-input"
                           type="password"
                           @bind-Value="loginModel.Password"
                           autocomplete="current-password"
                           placeholder="Enter your password" />

                <ValidationMessage
                    For="@(() => loginModel.Password)" />

            </div>

            <button type="submit"
                    class="public-auth-submit"
                    disabled="@isLoading">

                @if (isLoading)
                {
                    <span>
                        Signing in...
                    </span>
                }
                else
                {
                    <span>
                        Sign in
                    </span>

                    <span>
                        →
                    </span>
                }

            </button>

        </EditForm>

        <div class="public-auth-register">

            <span>
                Don't have an account?
            </span>

            <a href="/register">
                Create an account
            </a>

        </div>

        <div class="public-auth-back">

            <a href="/">
                ← Return to HR INFO ADs
            </a>

        </div>

    </div>

</div>

@code
{
    private readonly LoginModel loginModel = new();

    private bool isLoading;

    private string? errorMessage;

    private async Task HandleLogin()
    {
        if (isLoading)
        {
            return;
        }

        errorMessage = null;
        isLoading = true;

        try
        {
            var result =
                await AuthApiService.LoginAsync(
                    loginModel.Email.Trim(),
                    loginModel.Password);

            if (result == null)
            {
                errorMessage =
                    "The authentication service is currently unavailable.";

                return;
            }

            if (!result.Success)
            {
                errorMessage =
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Invalid email address or password."
                        : result.Message;

                return;
            }

            // Prevent administrators from using
            // the public user portal.
            var isAdministrator =
                result.Roles.Any(role =>
                    string.Equals(
                        role,
                        "Admin",
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    string.Equals(
                        role,
                        "SuperAdmin",
                        StringComparison.OrdinalIgnoreCase));

            if (isAdministrator)
            {
                errorMessage =
                    "Administrator accounts must use the administration portal.";

                return;
            }

            PublicAuthenticationStateProvider.SignIn(
                result.UserID,
                result.UserName,
                result.Email,
                result.Roles,
                result.Permissions,
                result.AccessToken,
                result.RefreshToken,
                result.ExpiresAt);

            Navigation.NavigateTo(
                "/",
                replace: true);
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "The authentication service is currently unavailable.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Sign-in failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class LoginModel
    {
        [Required(
            ErrorMessage = "Email address is required.")]

        [EmailAddress(
            ErrorMessage = "Please enter a valid email address.")]

        public string Email { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage = "Password is required.")]

        public string Password { get; set; } =
            string.Empty;
    }
}