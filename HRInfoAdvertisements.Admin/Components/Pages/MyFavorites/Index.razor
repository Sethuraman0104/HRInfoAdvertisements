@page "/my-favorites"

@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.Favorite

@layout HRInfoAdvertisements.Admin.Components.Layout.PublicLayout

@inject PublicFavoritesApiService PublicFavoritesApiService
@inject PublicAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>My Favorites | HR INFO ADs</PageTitle>

<div class="my-favorites-page">

    <PublicTopBar />

    <!-- ============================================================
         PUBLIC PAGE CONTEXT
         ============================================================ -->

    <section class="my-favorites-context">

        <div class="my-favorites-context-inner">

            <div class="my-favorites-context-left">

                <button type="button"
                        class="favorites-context-back"
                        @onclick="BackToMarketplace">

                    <i class="bi bi-arrow-left"></i>

                    <span>Back to Marketplace</span>

                </button>

                <span class="favorites-context-separator">
                    /
                </span>

                <span class="favorites-context-current">
                    My Favorites
                </span>

            </div>

            <div class="favorites-context-right">

                <span class="favorites-context-count">
                    <i class="bi bi-heart-fill"></i>

                    @allFavorites.Count
                    @(allFavorites.Count == 1
                        ? "Saved Advertisement"
                        : "Saved Advertisements")
                </span>

            </div>

        </div>

    </section>


    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <header class="my-favorites-header">

        <div class="my-favorites-header-inner">

            <div class="my-favorites-header-content">

                <span class="favorites-eyebrow">
                    MY COLLECTION
                </span>

                <div class="favorites-heading-row">

                    <div class="favorites-title-icon">

                        <i class="bi bi-heart-fill"></i>

                    </div>

                    <div>

                        <h1>
                            My Favorites
                        </h1>

                        <p>
                            Keep track of advertisements you have saved
                            and return to them whenever you need.
                        </p>

                    </div>

                </div>

            </div>


            <div class="favorites-header-summary">

                <div class="favorites-summary-icon">

                    <i class="bi bi-bookmark-heart-fill"></i>

                </div>

                <div class="favorites-summary-content">

                    <span>
                        SAVED ADVERTISEMENTS
                    </span>

                    <strong>
                        @allFavorites.Count.ToString("N0")
                    </strong>

                    <small>
                        In your favorites
                    </small>

                </div>

            </div>

        </div>

    </header>


    <!-- ============================================================
         MAIN CONTENT
         ============================================================ -->

    <main class="my-favorites-content">

        @if (isLoading)
        {
            <section class="favorites-state-card">

                <div class="favorites-loading-spinner"></div>

                <span class="favorites-state-eyebrow">
                    MY FAVORITES
                </span>

                <h2>
                    Loading your favorites
                </h2>

                <p>
                    Please wait while we retrieve your saved
                    advertisements.
                </p>

            </section>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <section class="favorites-state-card favorites-error-card">

                <div class="favorites-state-icon error">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                </div>

                <span class="favorites-state-eyebrow">
                    SOMETHING WENT WRONG
                </span>

                <h2>
                    Unable to load favorites
                </h2>

                <p>
                    @errorMessage
                </p>

                <button type="button"
                        class="favorites-primary-button"
                        @onclick="LoadFavoritesAsync">

                    <i class="bi bi-arrow-clockwise"></i>

                    <span>Try Again</span>

                </button>

            </section>
        }
        else
        {
            <!-- ====================================================
                 TOOLBAR
                 ==================================================== -->

            <section class="favorites-toolbar">

                <div class="favorites-toolbar-heading">

                    <div class="favorites-toolbar-icon">

                        <i class="bi bi-heart-fill"></i>

                    </div>

                    <div>

                        <strong>
                            Saved Advertisements
                        </strong>

                        <span>
                            @filteredFavorites.Count
                            @(filteredFavorites.Count == 1
                                ? "advertisement"
                                : "advertisements")
                            @(string.IsNullOrWhiteSpace(searchText)
                                ? "in your collection"
                                : "matching your search")
                        </span>

                    </div>

                </div>


                <div class="favorites-toolbar-actions">

                    <div class="favorites-search">

                        <i class="bi bi-search favorites-search-icon"></i>

                        <input type="text"
                               placeholder="Search favorites..."
                               aria-label="Search favorites"
                               @bind="searchText"
                               @bind:event="oninput"
                               @onkeyup="HandleSearchKeyUp" />

                        @if (!string.IsNullOrWhiteSpace(searchText))
                        {
                            <button type="button"
                                    class="favorites-search-clear"
                                    title="Clear search"
                                    aria-label="Clear search"
                                    @onclick="ClearSearch">

                                <i class="bi bi-x-lg"></i>

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="favorites-refresh-button"
                            title="Refresh favorites"
                            aria-label="Refresh favorites"
                            @onclick="LoadFavoritesAsync"
                            disabled="@isLoading">

                        <i class="bi bi-arrow-clockwise @(isLoading ? "favorites-spin" : "")"></i>

                    </button>

                </div>

            </section>


            <!-- ====================================================
                 SEARCH RESULT MESSAGE
                 ==================================================== -->

            @if (!string.IsNullOrWhiteSpace(searchText)
                 && filteredFavorites.Count > 0)
            {
                <div class="favorites-search-result">

                    <div>

                        <i class="bi bi-search"></i>

                        <span>
                            Showing results for
                            <strong>"@searchText"</strong>
                        </span>

                    </div>

                    <button type="button"
                            @onclick="ClearSearch">

                        Clear Search

                    </button>

                </div>
            }


            <!-- ====================================================
                 EMPTY STATE
                 ==================================================== -->

            @if (filteredFavorites.Count == 0)
            {
                <section class="favorites-empty-state">

                    <div class="favorites-empty-visual">

                        <div class="favorites-empty-circle">

                            <i class="bi bi-heart"></i>

                        </div>

                        <span class="favorites-empty-dot dot-one"></span>
                        <span class="favorites-empty-dot dot-two"></span>
                        <span class="favorites-empty-dot dot-three"></span>

                    </div>


                    @if (allFavorites.Count == 0)
                    {
                        <span class="favorites-state-eyebrow">
                            YOUR COLLECTION IS EMPTY
                        </span>

                        <h2>
                            No favorites yet
                        </h2>

                        <p>
                            When you find an advertisement you like,
                            click the heart icon to save it here.
                            Your saved advertisements will appear
                            in this collection.
                        </p>

                        <button type="button"
                                class="favorites-primary-button"
                                @onclick="BackToMarketplace">

                            <i class="bi bi-grid"></i>

                            <span>Browse Advertisements</span>

                        </button>
                    }
                    else
                    {
                        <span class="favorites-state-eyebrow">
                            SEARCH RESULTS
                        </span>

                        <h2>
                            No matching favorites
                        </h2>

                        <p>
                            We couldn't find any saved advertisements
                            matching
                            <strong>"@searchText"</strong>.
                        </p>

                        <button type="button"
                                class="favorites-secondary-button"
                                @onclick="ClearSearch">

                            <i class="bi bi-x-circle"></i>

                            <span>Clear Search</span>

                        </button>

                    }

                </section>
            }
            else
            {
                <!-- =================================================
                     FAVORITES GRID
                     ================================================= -->

                <section class="favorites-grid">

                    @foreach (var favorite in filteredFavorites)
                    {
                        <article class="favorite-card">

                            <!-- =====================================
                                 CARD TOP
                                 ===================================== -->

                            <div class="favorite-card-top">

                                <div class="favorite-card-badges">

                                    @if (favorite.IsFeatured)
                                    {
                                        <span class="favorite-featured-badge">

                                            <i class="bi bi-star-fill"></i>

                                            Featured

                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                            favorite.StatusName))
                                    {
                                        <span class="favorite-status-badge">

                                            <span class="favorite-status-dot"></span>

                                            @favorite.StatusName

                                        </span>
                                    }

                                </div>


                                <button type="button"
                                        class="favorite-remove-button"
                                        title="Remove from favorites"
                                        aria-label="Remove from favorites"
                                        disabled="@removingFavoriteIds.Contains(favorite.AdvertisementID)"
                                        @onclick="@(() => RemoveFavoriteAsync(favorite.AdvertisementID))">

                                    @if (removingFavoriteIds.Contains(
                                            favorite.AdvertisementID))
                                    {
                                        <span class="favorite-button-spinner"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-heart-fill"></i>
                                    }

                                </button>

                            </div>


                            <!-- =====================================
                                 CARD BODY
                                 ===================================== -->

                            <div class="favorite-card-body">

                                <!-- CATEGORY -->

                                <div class="favorite-card-category">

                                    @if (!string.IsNullOrWhiteSpace(
                                            favorite.CategoryName))
                                    {
                                        <span>
                                            @favorite.CategoryName
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                            favorite.AdvertisementTypeName))
                                    {
                                        <span class="favorite-category-separator">
                                            /
                                        </span>

                                        <span class="favorite-type">
                                            @favorite.AdvertisementTypeName
                                        </span>
                                    }

                                </div>


                                <!-- TITLE -->

                                <h2 class="favorite-card-title">

                                    @(string.IsNullOrWhiteSpace(
                                        favorite.Title)
                                        ? "Untitled Advertisement"
                                        : favorite.Title)

                                </h2>


                                <!-- ADVERTISEMENT NUMBER -->

                                <div class="favorite-ad-number">

                                    <span class="favorite-ad-number-label">
                                        AD
                                    </span>

                                    <span>
                                        @favorite.AdvertisementNumber
                                    </span>

                                </div>


                                <!-- LOCATION -->

                                @if (!string.IsNullOrWhiteSpace(
                                        favorite.AddressLine))
                                {
                                    <div class="favorite-card-location">

                                        <i class="bi bi-geo-alt-fill"></i>

                                        <span>
                                            @favorite.AddressLine
                                        </span>

                                    </div>
                                }


                                <!-- PRICE -->

                                <div class="favorite-card-price-section">

                                    <span class="favorite-price-label">
                                        PRICE
                                    </span>

                                    <div class="favorite-card-price">

                                        @if (favorite.Price.HasValue)
                                        {
                                            <strong>
                                                @favorite.Price.Value.ToString("N3")
                                            </strong>

                                            <span>
                                                @favorite.CurrencyCode
                                            </span>
                                        }
                                        else
                                        {
                                            <strong class="price-on-request">
                                                Price on request
                                            </strong>
                                        }

                                    </div>

                                </div>


                                <!-- META -->

                                <div class="favorite-card-meta">

                                    <div class="favorite-meta-item">

                                        <div class="favorite-meta-icon heart">

                                            <i class="bi bi-heart-fill"></i>

                                        </div>

                                        <div>

                                            <span>
                                                FAVORITED
                                            </span>

                                            <strong>
                                                @FormatDate(
                                                    favorite.FavoritedDate)
                                            </strong>

                                        </div>

                                    </div>


                                    @if (favorite.PublishedDate.HasValue)
                                    {
                                        <div class="favorite-meta-item">

                                            <div class="favorite-meta-icon">

                                                <i class="bi bi-calendar-check"></i>

                                            </div>

                                            <div>

                                                <span>
                                                    PUBLISHED
                                                </span>

                                                <strong>
                                                    @FormatDate(
                                                        favorite.PublishedDate.Value)
                                                </strong>

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>


                            <!-- =====================================
                                 CARD FOOTER
                                 ===================================== -->

                            <div class="favorite-card-footer">

                                <button type="button"
                                        class="favorite-view-button"
                                        @onclick="@(() => ViewAdvertisement(favorite.AdvertisementID))">

                                    <span>
                                        View Advertisement
                                    </span>

                                    <i class="bi bi-arrow-right"></i>

                                </button>

                            </div>

                        </article>
                    }

                </section>
            }

        }

    </main>

</div>


@code {

    // ============================================================
    // STATE
    // ============================================================

    private List<FavoriteResponse> allFavorites = new();

    private List<FavoriteResponse> filteredFavorites = new();

    private readonly HashSet<long> removingFavoriteIds = new();

    private string searchText = string.Empty;

    private bool isLoading;

    private string? errorMessage;


    // ============================================================
    // INITIALIZATION
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user =
            authenticationState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo(
                "/",
                forceLoad: false);

            return;
        }

        await LoadFavoritesAsync();
    }


    // ============================================================
    // LOAD FAVORITES
    // ============================================================

    private async Task LoadFavoritesAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var result =
                await PublicFavoritesApiService
                    .GetMyFavoritesAsync();

            allFavorites =
                result?
                    .OrderByDescending(
                        x => x.FavoritedDate)
                    .ToList()
                ?? new List<FavoriteResponse>();

            ApplySearch();
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(
                $"MY FAVORITES HTTP ERROR: {ex}");

            allFavorites = new();
            filteredFavorites = new();

            errorMessage =
                "Your favorites could not be loaded. " +
                "Please try again.";
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"MY FAVORITES ERROR: {ex}");

            allFavorites = new();
            filteredFavorites = new();

            errorMessage =
                "Something went wrong while loading your favorites. " +
                "Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }


    // ============================================================
    // SEARCH
    // ============================================================

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredFavorites =
                allFavorites.ToList();

            return;
        }

        var search =
            searchText.Trim();

        filteredFavorites =
            allFavorites
                .Where(x =>
                    Contains(
                        x.Title,
                        search)
                    ||
                    Contains(
                        x.TitleAr,
                        search)
                    ||
                    Contains(
                        x.AdvertisementNumber,
                        search)
                    ||
                    Contains(
                        x.CategoryName,
                        search)
                    ||
                    Contains(
                        x.AdvertisementTypeName,
                        search)
                    ||
                    Contains(
                        x.AddressLine,
                        search)
                    ||
                    Contains(
                        x.StatusName,
                        search))
                .ToList();
    }


    private static bool Contains(
        string? value,
        string search)
    {
        return !string.IsNullOrWhiteSpace(value)
            &&
            value.Contains(
                search,
                StringComparison.OrdinalIgnoreCase);
    }


    private void ClearSearch()
    {
        searchText = string.Empty;

        ApplySearch();
    }


    private void HandleSearchKeyUp(
        Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        ApplySearch();
    }


    // ============================================================
    // REMOVE FAVORITE
    // ============================================================

    private async Task RemoveFavoriteAsync(
        long advertisementId)
    {
        if (removingFavoriteIds.Contains(
                advertisementId))
        {
            return;
        }

        removingFavoriteIds.Add(
            advertisementId);

        try
        {
            await PublicFavoritesApiService
                .RemoveFavoriteAsync(
                    advertisementId);

            allFavorites =
                allFavorites
                    .Where(x =>
                        x.AdvertisementID !=
                        advertisementId)
                    .ToList();

            ApplySearch();
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(
                $"REMOVE FAVORITE HTTP ERROR: {ex}");

            errorMessage =
                "The advertisement could not be removed " +
                "from your favorites. Please try again.";
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"REMOVE FAVORITE ERROR: {ex}");

            errorMessage =
                "Something went wrong while removing " +
                "the favorite.";
        }
        finally
        {
            removingFavoriteIds.Remove(
                advertisementId);
        }
    }


    // ============================================================
    // NAVIGATION
    // ============================================================

    private void BackToMarketplace()
    {
        Navigation.NavigateTo("/");
    }


    private void ViewAdvertisement(
        long advertisementId)
    {
        // Keep the existing behavior until
        // the public advertisement-detail route
        // is confirmed.

        Navigation.NavigateTo("/");
    }


    // ============================================================
    // FORMATTING
    // ============================================================

    private static string FormatDate(
        DateTime date)
    {
        return date
            .ToLocalTime()
            .ToString("dd MMM yyyy");
    }

}