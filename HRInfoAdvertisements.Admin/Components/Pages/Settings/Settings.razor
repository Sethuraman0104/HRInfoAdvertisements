@page "/admin/settings"

@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Web
@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.SystemSettings

@layout HRInfoAdvertisements.Admin.Components.Layout.MainLayout

@inject SystemSettingsApiService SystemSettingsApiService
@inject SiteSettingsService SiteSettingsService
@inject NavigationManager Navigation
@inject AdminAuthenticationStateProvider AdminAuthenticationStateProvider

<PageTitle>System Settings | @Site.SiteName</PageTitle>

<div class="st-page">

    <PageHeader Icon="bi-gear-fill"
                Eyebrow="SYSTEM SETTINGS"
                Title="Settings"
                DescriptionContent="@HeaderDescription"
                ActionContent="@HeaderActions" />

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="st-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>Unable to load settings</strong>
                <span>@_error</span>
            </div>
            <button type="button" class="st-btn" @onclick="RefreshAsync" disabled="@_isLoading">Retry</button>
        </div>
    }

    <div class="st-layout">

        <!-- ===================== CATEGORY NAVIGATION ===================== -->
        <aside class="st-sidebar">

            <nav class="st-nav" aria-label="Setting categories">
                <button type="button" class="st-nav-item @(_group == "all" ? "active" : "")"
                        @onclick='() => SelectGroup("all")'>
                    <i class="bi bi-grid"></i>
                    <span>All settings</span>
                    <em>@Filter(ignoreGroup: true).Count()</em>
                </button>

                @foreach (var g in Groups)
                {
                    if (g.Id == "custom" && !_rows.Any(r => r.Group == "custom"))
                    {
                        continue;
                    }

                    <button type="button" class="st-nav-item @(_group == g.Id ? "active" : "")"
                            @onclick="() => SelectGroup(g.Id)">
                        <i class="bi @g.Icon"></i>
                        <span>@g.Label</span>
                        <em>@Filter(ignoreGroup: true).Count(r => r.Group == g.Id)</em>
                    </button>
                }
            </nav>

            <div class="st-related">
                <span class="st-related-title">Related data</span>
                <a href="/admin/users"><i class="bi bi-person-gear"></i> Users &amp; admins</a>
                <a href="/admin/categories"><i class="bi bi-grid"></i> Categories</a>
                <a href="/admin/advertisement-types"><i class="bi bi-tags"></i> Advertisement types</a>
            </div>

        </aside>


        <!-- ===================== CONTENT ===================== -->
        <section class="st-content">

            <div class="st-toolbar">

                <div class="st-search">
                    <i class="bi bi-search"></i>
                    <input type="text" @bind="Search" @bind:event="oninput"
                           placeholder="Search by name, key or description..."
                           aria-label="Search settings" />
                    @if (!string.IsNullOrEmpty(_search))
                    {
                        <button type="button" class="st-search-clear" aria-label="Clear search" @onclick="ClearSearch">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>

                <div class="st-segment" role="group" aria-label="Filter by state">
                    @foreach (var s in States)
                    {
                        var count = StateCount(s.Id);

                        if (s.Id == "unsaved" && count == 0 && _state != "unsaved")
                        {
                            continue;
                        }

                        <button type="button" class="@(_state == s.Id ? "active" : "")"
                                @onclick="() => SetState(s.Id)">
                            @s.Label <em>@count</em>
                        </button>
                    }
                </div>

                <button type="button" class="st-btn" @onclick="ResetFilters" disabled="@(!HasActiveFilters)">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset</span>
                </button>

            </div>

            <p class="st-summary">
                <strong>@_rows.Count(r => r.InUse)</strong> configured ·
                <strong>@_rows.Count(r => !r.InUse)</strong> using built-in defaults.
                Changes apply immediately.
            </p>

            @if (_isLoading && _rows.Count == 0)
            {
                <div class="st-state">
                    <div class="st-state-icon"><i class="bi bi-arrow-repeat hr-spin"></i></div>
                    <strong>Loading settings</strong>
                    <span>Retrieving configuration from the application database...</span>
                </div>
            }
            else if (!Filter().Any())
            {
                <div class="st-state">
                    <div class="st-state-icon"><i class="bi bi-sliders2"></i></div>
                    <strong>No settings match</strong>
                    <span>Try a different search, category or state filter.</span>
                    <button type="button" class="st-btn" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset filters
                    </button>
                </div>
            }
            else
            {
                foreach (var g in Groups)
                {
                    var rows = VisibleRows(g.Id);

                    if (rows.Count == 0)
                    {
                        continue;
                    }

                    <section class="st-card" aria-labelledby="@($"st-h-{g.Id}")">

                        <header class="st-card-header">
                            <div class="st-card-icon @g.Id"><i class="bi @g.Icon"></i></div>
                            <div>
                                <h2 id="@($"st-h-{g.Id}")">@g.Label</h2>
                                <p>@g.Hint</p>
                            </div>
                            <span class="st-card-count">@rows.Count</span>
                        </header>

                        <div class="st-rows">

                            @foreach (var row in rows)
                            {
                                var dirty = IsDirty(row);
                                var busy = _busyKey == row.Key;
                                var anyBusy = _busyKey is not null;
                                var muted = row.DependsOn is not null && !IsOn(row.DependsOn);
                                var draft = DraftValue(row);
                                _rowErrors.TryGetValue(row.Key, out var rowError);

                                <div class="st-row @(dirty ? "is-dirty" : "") @(row.InUse ? "" : "is-default") @(muted ? "is-muted" : "")"
                                     @key="row.Key">

                                    <div class="st-row-info">

                                        <div class="st-row-title">
                                            <strong>@row.Label</strong>

                                            @if (PublicKeys.Contains(row.Key))
                                            {
                                                <span class="st-tag public" title="Read by the public site">
                                                    <i class="bi bi-globe2"></i> Public site
                                                </span>
                                            }

                                            @if (row.Encrypted)
                                            {
                                                <span class="st-tag secret"><i class="bi bi-shield-lock-fill"></i> Encrypted</span>
                                            }

                                            @if (!row.InUse)
                                            {
                                                <span class="st-tag default">@(row.Exists ? "Inactive · default used" : "Using default")</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(row.Description))
                                        {
                                            <p>@row.Description</p>
                                        }

                                        @if (muted)
                                        {
                                            <p class="st-row-hint"><i class="bi bi-info-circle"></i> Has no effect while “@LabelOf(row.DependsOn)” is off.</p>
                                        }

                                        <div class="st-row-meta">
                                            <code>@row.Key</code>

                                            @if (row.IsKnown && row.Exists && row.Active)
                                            {
                                                <button type="button" class="st-link" disabled="@anyBusy"
                                                        @onclick="() => SetActiveAsync(row, false)">Use default</button>
                                            }
                                            else if (!row.IsKnown && row.Exists && row.Active)
                                            {
                                                <button type="button" class="st-link" disabled="@anyBusy"
                                                        @onclick="() => SetActiveAsync(row, false)">Deactivate</button>
                                            }
                                            else if (row.Exists && !row.Active)
                                            {
                                                <button type="button" class="st-link" disabled="@anyBusy"
                                                        @onclick="() => SetActiveAsync(row, true)">Re-enable</button>
                                            }

                                            @if (!row.IsKnown)
                                            {
                                                <button type="button" class="st-link" disabled="@anyBusy"
                                                        @onclick="() => OpenEdit(row)">Edit details</button>
                                            }
                                        </div>

                                    </div>

                                    <div class="st-row-control">

                                        @if (row.Encrypted)
                                        {
                                            <div class="st-input-wrap">
                                                <i class="bi bi-shield-lock-fill st-input-icon"></i>
                                                <input type="password" class="st-input has-icon" autocomplete="new-password"
                                                       value="@draft" disabled="@busy"
                                                       placeholder="Enter a new value to replace it"
                                                       aria-label="@row.Label"
                                                       @oninput="e => SetDraft(row, e.Value?.ToString())"
                                                       @onkeydown="e => HandleKeyAsync(e, row)" />
                                            </div>
                                        }
                                        else if (row.Kind == SettingKind.Toggle)
                                        {
                                            var on = ToggleValue(row);

                                            <button type="button" class="st-toggle @(on ? "is-on" : "")"
                                                    role="switch" aria-checked="@(on ? "true" : "false")"
                                                    aria-label="@row.Label" disabled="@anyBusy"
                                                    @onclick="() => SetToggleAsync(row, !on)">
                                                <span class="st-toggle-track"><span class="st-toggle-thumb"></span></span>
                                                <span class="st-toggle-label">@ToggleLabel(row)</span>
                                            </button>
                                        }
                                        else if (row.Kind == SettingKind.Number)
                                        {
                                            <div class="st-input-wrap">
                                                <input type="number" class="st-input @(string.IsNullOrEmpty(row.Unit) ? "" : "has-unit")"
                                                       min="@(row.IsKnown ? "1" : null)" step="1" inputmode="numeric"
                                                       value="@draft" disabled="@busy" aria-label="@row.Label"
                                                       @oninput="e => SetDraft(row, e.Value?.ToString())"
                                                       @onkeydown="e => HandleKeyAsync(e, row)" />
                                                @if (!string.IsNullOrEmpty(row.Unit))
                                                {
                                                    <span class="st-unit">@row.Unit</span>
                                                }
                                            </div>
                                        }
                                        else if (row.Kind == SettingKind.Currency)
                                        {
                                            <select class="st-input" value="@draft" disabled="@busy" aria-label="@row.Label"
                                                    @onchange="e => SetDraft(row, e.Value?.ToString())">
                                                @foreach (var c in Currencies)
                                                {
                                                    <option value="@c.Code">@c.Code — @c.Name</option>
                                                }
                                                @if (!string.IsNullOrEmpty(draft) && !Currencies.Any(x => x.Code == draft))
                                                {
                                                    <option value="@draft">@draft</option>
                                                }
                                            </select>
                                        }
                                        else if (row.Kind == SettingKind.Text && (draft.Length > 80 || draft.Contains('\n')))
                                        {
                                            <textarea class="st-input st-textarea" rows="3" maxlength="4000"
                                                      value="@draft" disabled="@busy" aria-label="@row.Label"
                                                      @oninput="e => SetDraft(row, e.Value?.ToString())"></textarea>
                                        }
                                        else
                                        {
                                            <input type="@InputType(row.Kind)" class="st-input" maxlength="4000"
                                                   value="@draft" disabled="@busy" aria-label="@row.Label"
                                                   placeholder="@(row.Optional ? "Optional" : "")"
                                                   @oninput="e => SetDraft(row, e.Value?.ToString())"
                                                   @onkeydown="e => HandleKeyAsync(e, row)" />
                                        }

                                        @if (dirty)
                                        {
                                            <div class="st-row-actions">
                                                <button type="button" class="st-btn primary" disabled="@anyBusy"
                                                        @onclick="() => SaveRowAsync(row)">
                                                    @if (busy)
                                                    {
                                                        <i class="bi bi-arrow-repeat hr-spin"></i>
                                                        <span>Saving...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-check-lg"></i>
                                                        <span>Save</span>
                                                    }
                                                </button>
                                                <button type="button" class="st-btn" disabled="@busy"
                                                        @onclick="() => DiscardDraft(row)">Cancel</button>
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(rowError))
                                        {
                                            <div class="st-row-error" role="alert">
                                                <i class="bi bi-exclamation-circle"></i>
                                                <span>@rowError</span>
                                            </div>
                                        }

                                    </div>
                                </div>
                            }

                        </div>
                    </section>
                }
            }

        </section>
    </div>
</div>


<!-- ===================== NOTICE TOAST ===================== -->
@if (!string.IsNullOrWhiteSpace(_notice))
{
    <div class="st-toast" role="status">
        <i class="bi bi-check-circle-fill"></i>
        <span>@_notice</span>
        <button type="button" aria-label="Close" @onclick="ClearNotice"><i class="bi bi-x-lg"></i></button>
    </div>
}


<!-- ===================== CUSTOM SETTING MODAL ===================== -->
@if (_showModal)
{
    <div class="st-modal-backdrop" @onclick="RequestCloseModal">

        <div class="st-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">

            <div class="st-modal-header">
                <div class="st-modal-icon"><i class="bi @(_mIsEdit ? "bi-pencil-square" : "bi-plus-lg")"></i></div>
                <div>
                    <h2>@(_mIsEdit ? "Edit custom setting" : "Add custom setting")</h2>
                    <p>@(_mIsEdit ? "Change the value, description or status." : "Create a setting that is not part of the standard list.")</p>
                </div>
                <button type="button" class="st-modal-close" aria-label="Close" @onclick="RequestCloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="st-modal-body">

                @if (!string.IsNullOrWhiteSpace(_mError))
                {
                    <div class="st-row-error" role="alert">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@_mError</span>
                    </div>
                }

                <div class="st-field">
                    <label for="mKey">Setting key <span>*</span></label>
                    <input id="mKey" type="text" class="st-input" maxlength="150" @bind="_mKey"
                           readonly="@_mIsEdit" placeholder="Example: MAX_LOGIN_ATTEMPTS" />
                    <small>@(_mIsEdit ? "Keys cannot be renamed." : "Letters, numbers and underscores. Saved in capitals.")</small>
                </div>

                <div class="st-field">
                    <label for="mKind">Value type</label>
                    <select id="mKind" class="st-input" value="@_mKind" disabled="@(_mIsEdit)"
                            @onchange="OnModalKindChanged">
                        <option value="text">Text</option>
                        <option value="number">Number</option>
                        <option value="toggle">On / Off</option>
                    </select>
                </div>

                <div class="st-field">
                    <label for="mValue">Value</label>

                    @if (_mKind == "toggle")
                    {
                        var on = string.Equals(_mValue, "true", StringComparison.OrdinalIgnoreCase);

                        <button type="button" class="st-toggle @(on ? "is-on" : "")" role="switch"
                                aria-checked="@(on ? "true" : "false")"
                                @onclick='() => _mValue = on ? "false" : "true"'>
                            <span class="st-toggle-track"><span class="st-toggle-thumb"></span></span>
                            <span class="st-toggle-label">@(on ? "ON" : "OFF")</span>
                        </button>
                    }
                    else if (_mKind == "number")
                    {
                        <input id="mValue" type="number" step="1" inputmode="numeric" class="st-input" @bind="_mValue" />
                    }
                    else if (_mEncrypted)
                    {
                        <input id="mValue" type="password" autocomplete="new-password" class="st-input" maxlength="4000"
                               @bind="_mValue"
                               placeholder="@(_mHadSecret ? "Leave empty to keep the existing value" : "Enter the value to protect")" />
                    }
                    else
                    {
                        <textarea id="mValue" class="st-input st-textarea" rows="3" maxlength="4000" @bind="_mValue"
                                  placeholder="Enter value..."></textarea>
                    }
                </div>

                <div class="st-field">
                    <label for="mDesc">Description</label>
                    <textarea id="mDesc" class="st-input st-textarea" rows="2" maxlength="500" @bind="_mDescription"
                              placeholder="What does this setting control?"></textarea>
                </div>

                <div class="st-options">

                    @if (_mKind != "toggle")
                    {
                        <label class="st-check">
                            <input type="checkbox" checked="@_mEncrypted" @onchange="e => _mEncrypted = (bool)(e.Value ?? false)" />
                            <span class="st-check-box"><i class="bi bi-check"></i></span>
                            <span><strong>Encrypted</strong><small>Store the value as protected data.</small></span>
                        </label>
                    }

                    <label class="st-check">
                        <input type="checkbox" checked="@_mActive" @onchange="e => _mActive = (bool)(e.Value ?? false)" />
                        <span class="st-check-box"><i class="bi bi-check"></i></span>
                        <span><strong>Active</strong><small>Make this setting available to the application.</small></span>
                    </label>

                </div>

            </div>

            <div class="st-modal-footer">
                <button type="button" class="st-btn" @onclick="RequestCloseModal" disabled="@_mSaving">Cancel</button>
                <button type="button" class="st-btn primary" @onclick="SaveModalAsync" disabled="@_mSaving">
                    @if (_mSaving)
                    {
                        <i class="bi bi-arrow-repeat hr-spin"></i>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>@(_mIsEdit ? "Save changes" : "Create setting")</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


@code {

    // ============================================================
    // CATALOG  (single source of truth for known settings)
    // ============================================================
    //
    // Add or edit a standard setting here. The control shown on the
    // page is chosen from Kind. "Default" is shown while the setting
    // is not stored (or is inactive); set it to the value your
    // application actually falls back to, or leave it null if unknown.
    // ============================================================

    private enum SettingKind { Text, Email, Url, Number, Toggle, Currency }

    private sealed record SettingDef(
        string Key,
        string Label,
        string Group,
        SettingKind Kind,
        string Description,
        string? Default = null,
        string? Unit = null,
        bool Optional = false,
        string? DependsOn = null);

    private sealed record GroupInfo(string Id, string Label, string Icon, string Hint);

    private static readonly GroupInfo[] Groups =
    {
        new("general",  "General",              "bi-sliders",       "Site identity, currency and contact details"),
        new("ads",      "Advertisements",       "bi-megaphone",     "Approval, validity and media limits"),
        new("accounts", "Accounts & security",  "bi-shield-lock",   "Sign-up verification and admin sign-in"),
        new("email",    "Email & notifications","bi-envelope-check","Sender details and optional automated emails"),
        new("custom",   "Custom settings",      "bi-braces",        "Settings added manually")
    };

    private static readonly SettingDef[] Defs =
    {
        // ---- General ----
        new("SITE_NAME", "Site name", "general", SettingKind.Text,
            "Shown in the header, page titles and emails.", "AdMind"),
        new("SITE_TAGLINE", "Tagline", "general", SettingKind.Text,
            "Short line shown under the site name."),
        new("SITE_URL", "Site address", "general", SettingKind.Url,
            "Public web address used for links in emails."),
        new("DEFAULT_CURRENCY", "Default currency", "general", SettingKind.Currency,
            "Used when an advertisement has no currency of its own.", "INR"),
        new("SUPPORT_EMAIL", "Support email", "general", SettingKind.Email,
            "Contact address shown to users who need help.", Optional: true),

        // ---- Advertisements ----
        new("REQUIRE_ADMIN_APPROVAL", "Require admin approval", "ads", SettingKind.Toggle,
            "New advertisements wait in Pending review until an admin approves them.", "true"),
        new("ADVERTISEMENT_EXPIRY_DAYS", "Advertisement validity", "ads", SettingKind.Number,
            "How long an advertisement stays live after it is published.", Unit: "days"),
        new("MAX_IMAGES_PER_ADVERTISEMENT", "Maximum images", "ads", SettingKind.Number,
            "Number of photos allowed on one advertisement.", "5", "images"),
        new("MAX_VIDEO_SIZE_MB", "Maximum video size", "ads", SettingKind.Number,
            "Largest video file a user can upload.", Unit: "MB"),

        // ---- Accounts & security ----
        new("REQUIRE_EMAIL_VERIFICATION", "Require email verification", "accounts", SettingKind.Toggle,
            "Users must confirm their email address before they can sign in."),
        new("REQUIRE_MOBILE_VERIFICATION", "Require mobile verification", "accounts", SettingKind.Toggle,
            "Users must confirm their mobile number during sign-up."),
        new("ADMIN_MFA_REQUIRED", "Require admin MFA", "accounts", SettingKind.Toggle,
            "Administrators must complete a second step when signing in."),
        new("EMAIL_OTP_EXPIRY_MINUTES", "Verification code lifetime", "accounts", SettingKind.Number,
            "How long a one-time code stays valid.", Unit: "minutes"),

        // ---- Email & notifications ----
        new("EMAIL_ENABLED", "Send emails", "email", SettingKind.Toggle,
            "Turns outgoing email on or off for the whole application."),
        new("EMAIL_FROM_NAME", "Sender name", "email", SettingKind.Text,
            "Name shown in the “From” field of emails."),
        new("EMAIL_LOGO_URL", "Email logo", "email", SettingKind.Url,
            "Full web address of the logo shown at the top of emails."),
        new("EMAIL_VERIFICATION_SUBJECT", "Verification email subject", "email", SettingKind.Text,
            "Subject line of the email verification message."),
        new("EMAIL_PASSWORD_RESET_SUBJECT", "Password reset email subject", "email", SettingKind.Text,
            "Subject line of the password reset message."),
        new("AUTOMATED_EMAIL_ENABLED", "Automated marketplace emails", "email", SettingKind.Toggle,
            "Master switch for optional emails. Verification, OTP and password-reset emails are not affected.", "false"),
        new("ACCOUNT_EMAIL_ENABLED", "Account emails", "email", SettingKind.Toggle,
            "Optional account-related marketplace updates.", "true", DependsOn: "AUTOMATED_EMAIL_ENABLED"),
        new("ADVERTISEMENT_EMAIL_ENABLED", "Advertisement emails", "email", SettingKind.Toggle,
            "Updates about approval, rejection, suspension or reactivation.", "true", DependsOn: "AUTOMATED_EMAIL_ENABLED"),
        new("FAVORITE_ADVERTISEMENT_EMAIL_ENABLED", "Favorite advertisement emails", "email", SettingKind.Toggle,
            "Optional emails when users favorite advertisements.", "true", DependsOn: "AUTOMATED_EMAIL_ENABLED")
    };

    // Keys the public site reads (must match the API whitelist).
    private static readonly HashSet<string> PublicKeys =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "SITE_NAME", "SITE_TAGLINE", "DEFAULT_CURRENCY",
            "ADVERTISEMENT_EXPIRY_DAYS", "MAX_IMAGES_PER_ADVERTISEMENT",
            "MAX_VIDEO_SIZE_MB", "REQUIRE_ADMIN_APPROVAL",
            "REQUIRE_EMAIL_VERIFICATION", "EMAIL_ENABLED",
            "EMAIL_OTP_EXPIRY_MINUTES", "SUPPORT_EMAIL"
        };

    private static readonly (string Code, string Name)[] Currencies =
    {
        ("AED", "UAE Dirham"),
        ("BHD", "Bahraini Dinar"),
        ("EUR", "Euro"),
        ("GBP", "Pound Sterling"),
        ("INR", "Indian Rupee"),
        ("KWD", "Kuwaiti Dinar"),
        ("OMR", "Omani Rial"),
        ("QAR", "Qatari Riyal"),
        ("SAR", "Saudi Riyal"),
        ("USD", "US Dollar")
    };

    private static readonly (string Id, string Label)[] States =
    {
        ("all",        "All"),
        ("configured", "Configured"),
        ("default",    "Using default"),
        ("unsaved",    "Unsaved")
    };


    // ============================================================
    // ROW MODEL  (catalog entry + stored value, or a custom setting)
    // ============================================================

    private sealed class SettingRow
    {
        public string Key { get; init; } = string.Empty;
        public string Label { get; init; } = string.Empty;
        public string Group { get; init; } = string.Empty;
        public SettingKind Kind { get; init; }
        public string Description { get; init; } = string.Empty;
        public string? Default { get; init; }
        public string? Unit { get; init; }
        public bool Optional { get; init; }
        public string? DependsOn { get; init; }
        public bool IsKnown { get; init; }
        public SystemSettingListItemResponse? Item { get; init; }

        public bool Exists => Item is not null;
        public bool Active => Item?.IsActive == true;
        public bool InUse => Exists && Active;
        public bool Encrypted => Item?.IsEncrypted == true;
    }


    // ============================================================
    // STATE
    // ============================================================

    private PublicSiteSettingsResponse Site { get; set; } = new();

    private List<SettingRow> _rows = new();
    private Dictionary<string, SettingRow> _rowMap = new(StringComparer.OrdinalIgnoreCase);

    private readonly Dictionary<string, string> _drafts = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _rowErrors = new(StringComparer.OrdinalIgnoreCase);

    private bool _isLoading;
    private string? _busyKey;
    private string? _error;
    private string? _notice;
    private int _noticeToken;

    private string _search = string.Empty;
    private string _group = "all";
    private string _state = "all";

    private string Search
    {
        get => _search;
        set => _search = value ?? string.Empty;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) || _group != "all" || _state != "all";


    // custom-setting modal
    private bool _showModal;
    private bool _mIsEdit;
    private bool _mSaving;
    private bool _mHadSecret;
    private int _mId;
    private string _mKey = string.Empty;
    private string _mKind = "text";
    private string _mValue = string.Empty;
    private string _mDescription = string.Empty;
    private bool _mEncrypted;
    private bool _mActive = true;
    private string? _mError;


    // ============================================================
    // INITIALIZATION / LOAD
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        Site = await SiteSettingsService.GetAsync();

        var authenticationState =
            await AdminAuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/admin", replace: true);
            return;
        }

        await LoadAllAsync();
    }

    private RenderFragment HeaderDescription => @<text>
        Configure the site, advertisements, accounts and email.
        Each setting uses the control that fits its value.
    </text>;

    private RenderFragment HeaderActions => @<text>

        <button type="button" class="hr-page-btn" @onclick="RefreshAsync" disabled="@_isLoading">
            <i class="bi @(_isLoading ? "bi-arrow-repeat hr-spin" : "bi-arrow-clockwise")"></i>
            <span>Refresh</span>
        </button>

        <button type="button" class="hr-page-btn settings-header-add" @onclick="OpenCreate" disabled="@_isLoading">
            <i class="bi bi-plus-lg"></i>
            <span>Add custom setting</span>
        </button>

    </text>;

    private async Task RefreshAsync()
    {
        await LoadAllAsync();
    }

    // Loads every stored setting once (all pages) and merges it
    // with the catalog. Grouping and filtering happen in memory.
    private async Task LoadAllAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var all = new List<SystemSettingListItemResponse>();
            var page = 1;
            var totalPages = 1;

            do
            {
                var result =
                    await SystemSettingsApiService.GetSystemSettingsAsync(
                        new SystemSettingListRequest
                        {
                            PageNumber = page,
                            PageSize = 100
                        });

                all.AddRange(result.Items ?? new List<SystemSettingListItemResponse>());

                totalPages = Math.Max(1, result.TotalPages);
                page++;
            }
            while (page <= totalPages && page <= 50);

            BuildRows(all);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/admin", replace: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SYSTEM SETTINGS LOAD ERROR: {ex}");

            _error = "The system settings could not be loaded. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BuildRows(List<SystemSettingListItemResponse> items)
    {
        // One entry per key, so the same setting never appears twice.
        var byKey =
            items
                .Where(i => !string.IsNullOrWhiteSpace(i.SettingKey))
                .GroupBy(i => i.SettingKey.Trim().ToUpperInvariant())
                .ToDictionary(g => g.Key, g => g.First());

        var rows = new List<SettingRow>();

        foreach (var d in Defs)
        {
            byKey.TryGetValue(d.Key, out var item);

            rows.Add(new SettingRow
            {
                Key = d.Key,
                Label = d.Label,
                Group = d.Group,
                Kind = d.Kind,
                Description = d.Description,
                Default = d.Default,
                Unit = d.Unit,
                Optional = d.Optional,
                DependsOn = d.DependsOn,
                IsKnown = true,
                Item = item
            });
        }

        var known = Defs.Select(d => d.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var pair in byKey.Where(p => !known.Contains(p.Key)).OrderBy(p => p.Key))
        {
            var item = pair.Value;

            rows.Add(new SettingRow
            {
                Key = item.SettingKey.Trim(),
                Label = ToTitle(item.SettingKey),
                Group = "custom",
                Kind = InferKind(item),
                Description = item.Description ?? string.Empty,
                Item = item
            });
        }

        _rows = rows;
        _rowMap = rows.ToDictionary(r => r.Key, StringComparer.OrdinalIgnoreCase);

        // Drop drafts for rows that no longer exist
        foreach (var key in _drafts.Keys.Where(k => !_rowMap.ContainsKey(k)).ToList())
        {
            _drafts.Remove(key);
        }

        if (_group != "all" && !_rows.Any(r => r.Group == _group))
        {
            _group = "all";
        }
    }

    private static SettingKind InferKind(SystemSettingListItemResponse item)
    {
        if (item.IsEncrypted)
        {
            return SettingKind.Text;
        }

        var value = (item.SettingValue ?? string.Empty).Trim();

        if (bool.TryParse(value, out _))
        {
            return SettingKind.Toggle;
        }

        return int.TryParse(value, out _) ? SettingKind.Number : SettingKind.Text;
    }

    private static string ToTitle(string key)
    {
        var words =
            key.Trim()
               .Split('_', StringSplitOptions.RemoveEmptyEntries)
               .Select(w => w.Length == 0
                   ? w
                   : char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant());

        return string.Join(' ', words);
    }

    private string LabelOf(string? key)
    {
        return key is not null && _rowMap.TryGetValue(key, out var row)
            ? row.Label
            : key ?? string.Empty;
    }


    // ============================================================
    // FILTERING
    // ============================================================

    private bool SearchMatches(SettingRow row)
    {
        var q = _search.Trim();

        return q.Length == 0 ||
               row.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
               row.Key.Contains(q, StringComparison.OrdinalIgnoreCase) ||
               row.Description.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private bool StateMatches(SettingRow row, string state)
    {
        return state switch
        {
            "configured" => row.InUse,
            "default"    => !row.InUse,
            "unsaved"    => IsDirty(row),
            _            => true
        };
    }

    private IEnumerable<SettingRow> Filter(bool ignoreGroup = false, bool ignoreState = false)
    {
        return _rows.Where(r =>
            (ignoreGroup || _group == "all" || r.Group == _group) &&
            (ignoreState || StateMatches(r, _state)) &&
            SearchMatches(r));
    }

    private List<SettingRow> VisibleRows(string groupId)
    {
        return Filter().Where(r => r.Group == groupId).ToList();
    }

    private int StateCount(string state)
    {
        return Filter(ignoreState: true).Count(r => StateMatches(r, state));
    }

    private void SelectGroup(string group) => _group = group;

    private void SetState(string state) => _state = state;

    private void ClearSearch() => _search = string.Empty;

    private void ResetFilters()
    {
        _search = string.Empty;
        _group = "all";
        _state = "all";
    }


    // ============================================================
    // VALUES / DRAFTS
    // ============================================================

    // Value currently stored, or the built-in default when the
    // setting is not stored or inactive.
    private static string StoredValue(SettingRow row)
    {
        if (row.Encrypted)
        {
            return string.Empty;
        }

        var value =
            row.InUse
                ? row.Item!.SettingValue ?? string.Empty
                : row.Default ?? string.Empty;

        value = value.Trim();

        return row.Kind == SettingKind.Currency
            ? value.ToUpperInvariant()
            : value;
    }

    private string DraftValue(SettingRow row)
    {
        return _drafts.TryGetValue(row.Key, out var draft)
            ? draft
            : StoredValue(row);
    }

    private bool IsDirty(SettingRow row)
    {
        if (!_drafts.TryGetValue(row.Key, out var draft))
        {
            return false;
        }

        return row.Encrypted
            ? draft.Length > 0
            : draft.Trim() != StoredValue(row);
    }

    private void SetDraft(SettingRow row, string? value)
    {
        _drafts[row.Key] = value ?? string.Empty;
        _rowErrors.Remove(row.Key);
    }

    private void DiscardDraft(SettingRow row)
    {
        _drafts.Remove(row.Key);
        _rowErrors.Remove(row.Key);
    }

    private async Task HandleKeyAsync(KeyboardEventArgs e, SettingRow row)
    {
        if (e.Key == "Enter" && IsDirty(row))
        {
            await SaveRowAsync(row);
        }
        else if (e.Key == "Escape")
        {
            DiscardDraft(row);
        }
    }

    private static string InputType(SettingKind kind) => kind switch
    {
        SettingKind.Email => "email",
        SettingKind.Url   => "url",
        _                 => "text"
    };

    private bool ToggleValue(SettingRow row)
    {
        return bool.TryParse(StoredValue(row), out var value) && value;
    }

    private bool IsOn(string key)
    {
        return _rowMap.TryGetValue(key, out var row) && ToggleValue(row);
    }

    private string ToggleLabel(SettingRow row)
    {
        var on = ToggleValue(row);

        if (row.InUse)
        {
            return on ? "ON" : "OFF";
        }

        return row.Default is null
            ? "Not set"
            : on ? "ON · default" : "OFF · default";
    }


    // ============================================================
    // VALIDATION
    // ============================================================

    private static string? ValidateValue(SettingRow row, string value)
    {
        if (row.Encrypted)
        {
            return value.Length == 0
                ? "Enter the new value to replace the protected one."
                : null;
        }

        switch (row.Kind)
        {
            case SettingKind.Toggle:
                return bool.TryParse(value, out _) ? null : "Choose On or Off.";

            case SettingKind.Number:
                if (!int.TryParse(value, out var number))
                {
                    return "Enter a whole number.";
                }

                return row.IsKnown && number <= 0
                    ? "Enter a whole number greater than 0."
                    : null;

            case SettingKind.Currency:
                return value.Length == 3 && value.All(char.IsLetter)
                    ? null
                    : "Choose a 3-letter currency code.";

            case SettingKind.Email:
                if (value.Length == 0)
                {
                    return row.Optional ? null : "Enter an email address.";
                }

                return new EmailAddressAttribute().IsValid(value)
                    ? null
                    : "Enter a valid email address.";

            case SettingKind.Url:
                if (value.Length == 0)
                {
                    return row.Optional ? null : "Enter a web address.";
                }

                return Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
                       (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                    ? null
                    : "Enter a full web address starting with http:// or https://.";

            default:
                if (value.Length == 0 && row.IsKnown && !row.Optional)
                {
                    return "Enter a value, or use the default instead.";
                }

                return value.Length > 4000 ? "Maximum 4,000 characters." : null;
        }
    }


    // ============================================================
    // SAVE / TOGGLE / ACTIVATE
    // ============================================================

    private async Task SaveRowAsync(SettingRow row)
    {
        if (_busyKey is not null)
        {
            return;
        }

        var value = DraftValue(row).Trim();

        var validationError = ValidateValue(row, value);

        if (validationError is not null)
        {
            _rowErrors[row.Key] = validationError;
            return;
        }

        if (await PersistAsync(row, value))
        {
            ShowNotice(SavedMessage(row, $"{row.Label} saved."));
        }
    }

    private async Task SetToggleAsync(SettingRow row, bool on)
    {
        if (_busyKey is not null)
        {
            return;
        }

        if (await PersistAsync(row, on ? "true" : "false"))
        {
            ShowNotice(SavedMessage(row, $"{row.Label} turned {(on ? "on" : "off")}."));
        }
    }

    private async Task SetActiveAsync(SettingRow row, bool active)
    {
        if (row.Item is null || _busyKey is not null)
        {
            return;
        }

        _busyKey = row.Key;
        _rowErrors.Remove(row.Key);

        try
        {
            await SystemSettingsApiService.UpdateSystemSettingStatusAsync(
                row.Item.SystemSettingID,
                active);

            _drafts.Remove(row.Key);

            await AfterChangedAsync();
            await LoadAllAsync();

            ShowNotice(
                active
                    ? $"{row.Label} re-enabled."
                    : row.IsKnown
                        ? $"{row.Label} now uses its default."
                        : $"{row.Label} deactivated.");
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/admin", replace: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SYSTEM SETTING STATUS ERROR: {ex}");

            _rowErrors[row.Key] = "The setting status could not be updated.";
        }
        finally
        {
            _busyKey = null;
        }
    }

    // Creates the setting when it is not stored yet, otherwise updates it
    // (saving also re-activates an inactive setting).
    private async Task<bool> PersistAsync(SettingRow row, string value)
    {
        _busyKey = row.Key;
        _rowErrors.Remove(row.Key);

        try
        {
            if (row.Item is null)
            {
                var created =
                    await SystemSettingsApiService.CreateSystemSettingAsync(
                        new CreateSystemSettingRequest
                        {
                            SettingKey = row.Key,
                            SettingValue = value,
                            Description = row.Description,
                            IsEncrypted = false,
                            IsActive = true
                        });

                if (created is null)
                {
                    throw new InvalidOperationException($"Could not create setting {row.Key}.");
                }
            }
            else
            {
                await SystemSettingsApiService.UpdateSystemSettingAsync(
                    row.Item.SystemSettingID,
                    new UpdateSystemSettingRequest
                    {
                        SettingKey = row.Item.SettingKey,
                        SettingValue = value,
                        Description = row.Item.Description,
                        IsEncrypted = row.Item.IsEncrypted,
                        IsActive = true
                    });
            }

            _drafts.Remove(row.Key);

            await AfterChangedAsync();
            await LoadAllAsync();

            return true;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/admin", replace: true);
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SYSTEM SETTING SAVE ERROR: {ex}");

            _rowErrors[row.Key] =
                "The setting could not be saved. Please try again.";

            return false;
        }
        finally
        {
            _busyKey = null;
        }
    }

    // Shared cache: the next visitor / page load gets fresh values.
    private async Task AfterChangedAsync()
    {
        SiteSettingsService.Invalidate();

        Site = await SiteSettingsService.GetAsync();
    }

    private static string SavedMessage(SettingRow row, string message)
    {
        return PublicKeys.Contains(row.Key)
            ? message + " The public site uses the new value; this admin header and sidebar update at your next sign-in."
            : message;
    }


    // ============================================================
    // NOTICE TOAST
    // ============================================================

    private void ShowNotice(string message)
    {
        _notice = message;

        var token = ++_noticeToken;

        _ = Task.Delay(5000).ContinueWith(async _ =>
        {
            if (token != _noticeToken)
            {
                return;
            }

            try
            {
                _notice = null;
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException)
            {
                // page was left before the toast timed out
            }
        });
    }

    private void ClearNotice()
    {
        _notice = null;
        _noticeToken++;
    }


    // ============================================================
    // CUSTOM SETTING MODAL
    // ============================================================

    private void OpenCreate()
    {
        _mIsEdit = false;
        _mId = 0;
        _mHadSecret = false;
        _mKey = string.Empty;
        _mKind = "text";
        _mValue = string.Empty;
        _mDescription = string.Empty;
        _mEncrypted = false;
        _mActive = true;
        _mError = null;
        _showModal = true;
    }

    private void OpenEdit(SettingRow row)
    {
        if (row.Item is null)
        {
            return;
        }

        _mIsEdit = true;
        _mId = row.Item.SystemSettingID;
        _mHadSecret = row.Item.IsEncrypted;
        _mKey = row.Item.SettingKey;
        _mKind = row.Kind switch
        {
            SettingKind.Toggle => "toggle",
            SettingKind.Number => "number",
            _                  => "text"
        };
        _mValue = row.Item.IsEncrypted ? string.Empty : row.Item.SettingValue ?? string.Empty;
        _mDescription = row.Item.Description ?? string.Empty;
        _mEncrypted = row.Item.IsEncrypted;
        _mActive = row.Item.IsActive;
        _mError = null;
        _showModal = true;
    }

    private void OnModalKindChanged(ChangeEventArgs e)
    {
        _mKind = e.Value?.ToString() ?? "text";
        _mValue = _mKind == "toggle" ? "false" : string.Empty;

        if (_mKind == "toggle")
        {
            _mEncrypted = false;
        }
    }

    private void RequestCloseModal()
    {
        if (!_mSaving)
        {
            _showModal = false;
        }
    }

    private async Task SaveModalAsync()
    {
        if (_mSaving)
        {
            return;
        }

        _mError = null;

        var key = _mKey.Trim().ToUpperInvariant().Replace(' ', '_');
        var value = (_mValue ?? string.Empty).Trim();

        if (!_mIsEdit)
        {
            if (key.Length == 0)
            {
                _mError = "Enter a setting key.";
                return;
            }

            if (key.Length > 150 || !Regex.IsMatch(key, "^[A-Z][A-Z0-9_]*$"))
            {
                _mError = "The key must start with a letter and use only letters, numbers and underscores.";
                return;
            }

            if (_rowMap.ContainsKey(key))
            {
                _mError = "A setting with this key already exists. Edit it from the list instead.";
                return;
            }
        }

        var keepSecret = _mIsEdit && _mHadSecret && _mEncrypted && value.Length == 0;

        if (!keepSecret)
        {
            if (_mEncrypted && value.Length == 0)
            {
                _mError = "Enter the value to protect.";
                return;
            }

            if (_mKind == "toggle" && !bool.TryParse(value, out _))
            {
                _mError = "Choose On or Off.";
                return;
            }

            if (_mKind == "number" && !int.TryParse(value, out _))
            {
                _mError = "Enter a whole number.";
                return;
            }

            if (value.Length > 4000)
            {
                _mError = "The value is limited to 4,000 characters.";
                return;
            }
        }

        if (_mDescription.Length > 500)
        {
            _mError = "The description is limited to 500 characters.";
            return;
        }

        _mSaving = true;

        try
        {
            if (_mIsEdit)
            {
                await SystemSettingsApiService.UpdateSystemSettingAsync(
                    _mId,
                    new UpdateSystemSettingRequest
                    {
                        SettingKey = key,
                        SettingValue = value,
                        Description = _mDescription,
                        IsEncrypted = _mEncrypted,
                        IsActive = _mActive
                    });
            }
            else
            {
                await SystemSettingsApiService.CreateSystemSettingAsync(
                    new CreateSystemSettingRequest
                    {
                        SettingKey = key,
                        SettingValue = value,
                        Description = _mDescription,
                        IsEncrypted = _mEncrypted,
                        IsActive = _mActive
                    });
            }

            _showModal = false;

            await AfterChangedAsync();
            await LoadAllAsync();

            if (!_mIsEdit)
            {
                _group = "custom";
            }

            ShowNotice(_mIsEdit ? $"{key} updated." : $"{key} created.");
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/admin", replace: true);
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"SYSTEM SETTING SAVE ERROR: {ex}");

            _mError = "The setting could not be saved. The key may already exist or the server rejected the request.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SYSTEM SETTING SAVE ERROR: {ex}");

            _mError = "An unexpected error occurred while saving the setting.";
        }
        finally
        {
            _mSaving = false;
        }
    }
}
