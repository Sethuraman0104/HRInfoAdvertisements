    // ============================================================
    // IMAGE SELECTION
    // ============================================================

    private async Task HandleImageSelection(
        InputFileChangeEventArgs e)
    {
        errorMessage = null;
        successMessage = null;

        var availableSlots =
            RemainingPhotoSlots;

        if (availableSlots <= 0)
        {
            errorMessage =
                $"You can upload a maximum of {MaxImages} photos " +
                "for one advertisement.";

            return;
        }

        IReadOnlyList<IBrowserFile> files;

        try
        {
            files =
                e.GetMultipleFiles(
                    availableSlots);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"IMAGE SELECTION ERROR: {ex}");

            errorMessage =
                "We couldn’t read the selected photos. " +
                "Please try selecting them again.";

            return;
        }

        var addedCount = 0;
        var rejectedCount = 0;

        foreach (var file in files)
        {
            if (file.Size <= 0)
            {
                rejectedCount++;
                continue;
            }

            if (file.Size > MaxImageSize)
            {
                rejectedCount++;

                errorMessage =
                    $"'{file.Name}' was not added because it exceeds " +
                    "the maximum file size of 10 MB.";

                continue;
            }


            if (!IsSupportedImageType(
                    file.ContentType,
                    file.Name))
            {
                rejectedCount++;

                errorMessage =
                    $"'{file.Name}' was not added because it is not " +
                    "a supported image format. Please use JPG, PNG or WEBP.";

                continue;
            }


            var duplicate =
                selectedImages.Any(x =>
                    string.Equals(
                        x.FileName,
                        file.Name,
                        StringComparison.OrdinalIgnoreCase) &&
                    x.FileSize == file.Size);

            if (duplicate)
            {
                rejectedCount++;

                errorMessage =
                    $"'{file.Name}' is already selected.";

                continue;
            }


            try
            {
                await using var browserStream =
                    file.OpenReadStream(
                        maxAllowedSize: MaxImageSize);

                using var memoryStream =
                    new MemoryStream();

                await browserStream.CopyToAsync(
                    memoryStream);

                var bytes =
                    memoryStream.ToArray();


                var mimeType =
                    GetImageMimeType(
                        file.ContentType,
                        file.Name);


                var previewUrl =
                    $"data:{mimeType};base64," +
                    Convert.ToBase64String(bytes);


                var hasExistingPrimary =
                    savedImages.Any(
                        x => x.IsPrimary);

                var hasSelectedPrimary =
                    selectedImages.Any(
                        x => x.IsPrimary);

                var makePrimary =
                    !hasExistingPrimary &&
                    !hasSelectedPrimary &&
                    selectedImages.Count == 0;


                selectedImages.Add(
                    new SelectedImage
                    {
                        FileName =
                            file.Name,

                        ContentType =
                            mimeType,

                        FileBytes =
                            bytes,

                        PreviewUrl =
                            previewUrl,

                        IsPrimary =
                            makePrimary
                    });


                addedCount++;
            }
            catch (Exception ex)
            {
                rejectedCount++;

                Console.WriteLine(
                    $"Unable to prepare image: {file.Name}");

                Console.WriteLine(ex);

                errorMessage =
                    $"We couldn’t prepare '{file.Name}'. " +
                    "Please try selecting the image again.";
            }
        }


        if (addedCount > 0)
        {
            successMessage =
                $"{addedCount} photo" +
                $"{(addedCount == 1 ? "" : "s")} added successfully. " +
                $"{TotalPhotoCount} of {MaxImages} photos are ready.";
        }


        if (rejectedCount > 0 &&
            addedCount == 0 &&
            string.IsNullOrWhiteSpace(errorMessage))
        {
            errorMessage =
                "None of the selected photos could be added. " +
                "Please check the file type and size.";
        }
    }


    // ============================================================
    // SET PRIMARY SELECTED IMAGE
    // ============================================================

    private void SetPrimarySelectedImage(
        SelectedImage image)
    {
        if (IsBusy)
        {
            return;
        }

        if (savedImages.Any(x => x.IsPrimary))
        {
            errorMessage =
                "Please change the main photo from the existing " +
                "advertisement photos first.";

            return;
        }

        foreach (var item in selectedImages)
        {
            item.IsPrimary = false;
        }

        image.IsPrimary = true;

        errorMessage = null;

        successMessage =
            $"'{image.FileName}' has been selected as the main photo.";
    }


    // ============================================================
    // REMOVE SELECTED IMAGE
    // ============================================================

    private void RemoveSelectedImage(
        SelectedImage image)
    {
        if (IsBusy)
        {
            return;
        }

        var wasPrimary =
            image.IsPrimary;

        selectedImages.Remove(image);


        if (wasPrimary &&
            !savedImages.Any(x => x.IsPrimary) &&
            selectedImages.Count > 0)
        {
            foreach (var item in selectedImages)
            {
                item.IsPrimary = false;
            }

            selectedImages[0].IsPrimary = true;
        }

        errorMessage = null;

        successMessage =
            selectedImages.Count == 0
                ? "All newly selected photos have been removed."
                : $"{selectedImages.Count} new photo" +
                  $"{(selectedImages.Count == 1 ? "" : "s")} ready to upload.";
    }


    // ============================================================
    // SET PRIMARY SAVED IMAGE
    // ============================================================

    private async Task SetPrimarySavedImage(
        SavedAdvertisementImage image)
    {
        if (IsBusy)
        {
            return;
        }

        if (image.AdvertisementImageID <= 0)
        {
            errorMessage =
                "The selected photo could not be identified.";

            return;
        }

        errorMessage = null;
        successMessage = null;

        try
        {
            isSubmitting = true;

            var success =
                await AdvertisementApiService
                    .SetPrimaryImageAsync(
                        AdvertisementId,
                        image.AdvertisementImageID);

            if (!success)
            {
                errorMessage =
                    "The main photo could not be changed. " +
                    "Please try again.";

                return;
            }


            foreach (var savedImage in savedImages)
            {
                savedImage.IsPrimary =
                    savedImage.AdvertisementImageID ==
                    image.AdvertisementImageID;
            }


            foreach (var selectedImage in selectedImages)
            {
                selectedImage.IsPrimary = false;
            }


            successMessage =
                $"'{image.FileName}' is now the main advertisement photo.";
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"SET PRIMARY IMAGE ERROR: {ex}");

            errorMessage =
                "The main photo could not be changed right now. " +
                "Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }


    // ============================================================
    // DELETE SAVED IMAGE
    // ============================================================

    private async Task DeleteSavedImage(
        SavedAdvertisementImage image)
    {
        if (IsBusy)
        {
            return;
        }

        if (image.AdvertisementImageID <= 0)
        {
            return;
        }


        if (savedImages.Count <= 1 &&
            image.IsPrimary)
        {
            errorMessage =
                "An advertisement must keep at least one main photo. " +
                "Add another photo and set it as main before deleting this photo.";

            return;
        }


        errorMessage = null;
        successMessage = null;

        try
        {
            isSubmitting = true;

            var success =
                await AdvertisementApiService
                    .DeleteAdvertisementImageAsync(
                        AdvertisementId,
                        image.AdvertisementImageID);

            if (!success)
            {
                errorMessage =
                    "The photo could not be deleted. " +
                    "Please try again.";

                return;
            }


            savedImages.Remove(image);

            successMessage =
                $"'{image.FileName}' has been removed.";
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"DELETE IMAGE ERROR: {ex}");

            errorMessage =
                "The photo could not be deleted right now. " +
                "Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }


    // ============================================================
    // SAVE CHANGES
    // ============================================================

    private async Task<bool> SaveChanges()
    {
        if (IsBusy)
        {
            return false;
        }

        errorMessage = null;
        successMessage = null;

        isSaving = true;

        try
        {
            model.CountryID =
                selectedCountryId > 0
                    ? selectedCountryId
                    : null;

            model.StateID =
                selectedStateId > 0
                    ? selectedStateId
                    : null;

            model.CityID =
                selectedCityId > 0
                    ? selectedCityId
                    : null;

            model.AreaID =
                selectedAreaId > 0
                    ? selectedAreaId
                    : null;


            var updatedAdvertisement =
    await AdvertisementApiService
        .UpdateAdvertisementAsync(
            AdvertisementId,
            model);

if (updatedAdvertisement is null)
{
    errorMessage =
        "The advertisement could not be updated. " +
        "Please review the information and try again.";

    return false;
}


            if (selectedImages.Count > 0)
            {
                await UploadSelectedImagesAsync();

                if (string.IsNullOrWhiteSpace(errorMessage))
                {
                    successMessage =
                        "Your advertisement has been updated successfully.";
                }
            }
            else
            {
                successMessage =
                    "Your advertisement has been updated successfully.";
            }


            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                "================================================");

            Console.WriteLine(
                "UPDATE ADVERTISEMENT ERROR");

            Console.WriteLine(ex);

            Console.WriteLine(
                "================================================");

            errorMessage =
                "We couldn’t update your advertisement right now. " +
                "Please try again.";

            return false;
        }
        finally
        {
            isSaving = false;
        }
    }


    // ============================================================
    // UPLOAD SELECTED IMAGES
    // ============================================================

    private async Task UploadSelectedImagesAsync()
    {
        if (selectedImages.Count == 0)
        {
            return;
        }

        isUploadingImages = true;

        uploadedImageCount = 0;

        totalImagesToUpload =
            selectedImages.Count;

        var failedImages =
            new List<SelectedImage>();

        try
        {
            var imagesToUpload =
                selectedImages.ToList();

            foreach (var selectedImage in imagesToUpload)
            {
                try
                {
                    await using var stream =
                        new MemoryStream(
                            selectedImage.FileBytes,
                            writable: false);

                    var success =
                        await AdvertisementApiService
                            .UploadAdvertisementImageAsync(
                                AdvertisementId,
                                stream,
                                selectedImage.FileName,
                                selectedImage.ContentType,
                                selectedImage.IsPrimary);

                    if (success)
                    {
                        uploadedImageCount++;
                    }
                    else
                    {
                        failedImages.Add(
                            selectedImage);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine(
                        $"IMAGE UPLOAD FAILED: {selectedImage.FileName}");

                    Console.WriteLine(ex);

                    failedImages.Add(
                        selectedImage);
                }

                await InvokeAsync(
                    StateHasChanged);
            }


            // ----------------------------------------------------
            // RELOAD EXISTING IMAGES
            // ----------------------------------------------------

            await ReloadSavedImagesAsync();


            if (failedImages.Count == 0)
            {
                selectedImages.Clear();

                errorMessage = null;

                successMessage =
                    uploadedImageCount > 0
                        ? $"{uploadedImageCount} photo" +
                          $"{(uploadedImageCount == 1 ? "" : "s")} uploaded successfully."
                        : successMessage;
            }
            else
            {
                selectedImages.Clear();

                selectedImages.AddRange(
                    failedImages);

                errorMessage =
                    $"{failedImages.Count} photo" +
                    $"{(failedImages.Count == 1 ? "" : "s")} could not be uploaded. " +
                    "Please try again.";

                if (uploadedImageCount > 0)
                {
                    successMessage =
                        $"{uploadedImageCount} photo" +
                        $"{(uploadedImageCount == 1 ? "" : "s")} uploaded successfully.";
                }
            }
        }
        finally
        {
            isUploadingImages = false;
        }
    }


    // ============================================================
    // RELOAD SAVED IMAGES
    // ============================================================

    private async Task ReloadSavedImagesAsync()
    {
        try
        {
            var advertisement =
                await AdvertisementApiService
                    .GetAdvertisementByIdAsync(
                        AdvertisementId);

            if (advertisement is null)
            {
                return;
            }

            LoadSavedImagesFromAdvertisement(
                advertisement);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"RELOAD IMAGES ERROR: {ex}");
        }
    }


    // ============================================================
    // SAVE AND SUBMIT
    // ============================================================

    private async Task SaveAndSubmit()
    {
        if (IsBusy)
        {
            return;
        }

        var saved =
            await SaveChanges();

        if (!saved)
        {
            return;
        }


        if (isUploadingImages)
        {
            errorMessage =
                "Please wait until all photos finish uploading.";

            return;
        }


        errorMessage = null;

        successMessage = null;

        isSubmitting = true;

        try
        {
            var success =
                await AdvertisementApiService
                    .SubmitAdvertisementAsync(
                        AdvertisementId);

            if (!success)
            {
                errorMessage =
                    "The advertisement was saved, but it could not " +
                    "be submitted for approval. Please try again.";

                return;
            }


            successMessage =
                "Your advertisement has been updated and submitted for approval.";


            await Task.Delay(900);

            Navigation.NavigateTo(
                $"/my-ads/{AdvertisementId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"SUBMIT ADVERTISEMENT ERROR: {ex}");

            errorMessage =
                "The advertisement was saved, but submission failed. " +
                "Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }


    // ============================================================
    // IMAGE TYPE VALIDATION
    // ============================================================

    private static bool IsSupportedImageType(
        string? contentType,
        string fileName)
    {
        if (!string.IsNullOrWhiteSpace(contentType))
        {
            var normalized =
                contentType
                    .Trim()
                    .ToLowerInvariant();

            if (normalized is
                "image/jpeg" or
                "image/jpg" or
                "image/png" or
                "image/webp")
            {
                return true;
            }
        }


        var extension =
            Path.GetExtension(fileName)
                .ToLowerInvariant();

        return extension is
            ".jpg" or
            ".jpeg" or
            ".png" or
            ".webp";
    }


    // ============================================================
    // MIME TYPE
    // ============================================================

    private static string GetImageMimeType(
        string? contentType,
        string fileName)
    {
        if (!string.IsNullOrWhiteSpace(contentType))
        {
            var normalized =
                contentType
                    .Trim()
                    .ToLowerInvariant();

            if (normalized is
                "image/jpeg" or
                "image/jpg" or
                "image/png" or
                "image/webp")
            {
                return normalized == "image/jpg"
                    ? "image/jpeg"
                    : normalized;
            }
        }


        var extension =
            Path.GetExtension(fileName)
                .ToLowerInvariant();

        return extension switch
        {
            ".jpg" or ".jpeg" =>
                "image/jpeg",

            ".png" =>
                "image/png",

            ".webp" =>
                "image/webp",

            _ =>
                "image/jpeg"
        };
    }


    // ============================================================
    // UPLOAD PROGRESS
    // ============================================================

    private int GetUploadProgressPercentage()
    {
        if (totalImagesToUpload <= 0)
        {
            return 0;
        }

        return
            (int)Math.Round(
                uploadedImageCount *
                100d /
                totalImagesToUpload);
    }


    // ============================================================
    // BACK
    // ============================================================

    private void GoBack()
    {
        if (IsBusy)
        {
            return;
        }

        Navigation.NavigateTo(
            $"/my-ads/{AdvertisementId}");
    }
}