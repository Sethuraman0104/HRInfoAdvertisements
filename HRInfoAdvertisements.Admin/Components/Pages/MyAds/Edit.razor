@page "/my-ads/{AdvertisementId:long}/edit"

@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.Advertisements
@using Microsoft.AspNetCore.Components.Forms

@layout HRInfoAdvertisements.Admin.Components.Layout.PublicLayout

@inject AdvertisementApiService AdvertisementApiService
@inject PublicAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Edit Advertisement | HR INFO ADs</PageTitle>

<style>

    /* ============================================================
       PAGE
       ============================================================ */

    .my-ad-edit-page {
        min-height: calc(100vh - 70px);
        background:
            linear-gradient(
                180deg,
                #f6f8fc 0%,
                #ffffff 45%,
                #f7f9fc 100%
            );
        padding-bottom: 70px;
        color: #172033;
    }


    /* ============================================================
       TOP BAR
       ============================================================ */

    .my-ad-edit-topbar {
        width: 100%;
        background: rgba(255,255,255,.96);
        border-bottom: 1px solid #e5eaf2;
        box-shadow: 0 4px 20px rgba(20,38,70,.06);
        position: relative;
        z-index: 10;
    }

    .my-ad-edit-topbar-inner {
        width: 100%;
        max-width: 1450px;
        min-height: 82px;
        margin: 0 auto;
        padding: 12px 28px;
        box-sizing: border-box;

        display: grid;

        grid-template-columns:
            minmax(240px, 1fr)
            auto
            minmax(240px, 1fr);

        align-items: center;
        column-gap: 28px;
    }

    .my-ad-edit-brand {
        justify-self: start;
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .my-ad-edit-brand-logo {
        width: 48px;
        height: 48px;
        object-fit: contain;
        flex: 0 0 48px;
    }

    .my-ad-edit-brand-text {
        min-width: 0;
    }

    .my-ad-edit-brand-title {
        margin: 0;
        font-size: 16px;
        line-height: 1.2;
        font-weight: 800;
        color: #0A2C6A;
        letter-spacing: -.2px;
    }

    .my-ad-edit-brand-subtitle {
        display: block;
        margin-top: 3px;
        color: #718096;
        font-size: 12px;
        font-weight: 600;
    }

    .my-ad-edit-page-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 11px;

        margin: 0;
        justify-self: center;
        min-width: max-content;

        color: #13264A;
        font-size: 22px;
        font-weight: 850;
        letter-spacing: -.4px;
        white-space: nowrap;
    }

    .my-ad-edit-page-title-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        color: #ffffff;

        background:
            linear-gradient(
                135deg,
                #0A2C6A,
                #1B5FC7
            );

        box-shadow:
            0 7px 18px rgba(27,95,199,.22);
    }

    .my-ad-edit-page-title-icon i {
        font-size: 18px;
    }

    .my-ad-edit-back-button {
        justify-self: end;

        min-height: 44px;
        padding: 0 17px;

        border: 1px solid #dce3ee;
        border-radius: 12px;

        background: #ffffff;
        color: #31415c;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        font-size: 13px;
        font-weight: 750;

        cursor: pointer;

        transition:
            transform .2s ease,
            box-shadow .2s ease,
            border-color .2s ease,
            color .2s ease;
    }

    .my-ad-edit-back-button:hover {
        transform: translateY(-2px);
        border-color: #b8c7df;
        color: #0A2C6A;
        box-shadow: 0 8px 20px rgba(25,50,90,.10);
    }


    /* ============================================================
       MAIN
       ============================================================ */

    .my-ad-edit-main {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 34px 24px 0;
        box-sizing: border-box;
    }

    .my-ad-edit-intro {
        margin-bottom: 24px;
    }

    .my-ad-edit-intro h2 {
        margin: 0;
        color: #172033;
        font-size: 26px;
        font-weight: 850;
        letter-spacing: -.6px;
    }

    .my-ad-edit-intro p {
        margin: 7px 0 0;
        color: #718096;
        font-size: 14px;
        line-height: 1.6;
    }


    /* ============================================================
       ALERTS
       ============================================================ */

    .edit-alert {
        display: flex;
        align-items: flex-start;
        gap: 11px;

        padding: 14px 16px;
        margin-bottom: 18px;

        border-radius: 13px;
        font-size: 13px;
        line-height: 1.55;
    }

    .edit-alert i {
        margin-top: 2px;
        font-size: 17px;
        flex: 0 0 auto;
    }

    .edit-alert-error {
        background: #fff4f4;
        border: 1px solid #f4cccc;
        color: #a32929;
    }

    .edit-alert-success {
        background: #f0fbf5;
        border: 1px solid #c8ead6;
        color: #23784a;
    }


    /* ============================================================
       LOADING
       ============================================================ */

    .edit-loading-card {
        background: #ffffff;
        border: 1px solid #e5eaf2;
        border-radius: 18px;
        padding: 55px 25px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(30,50,90,.06);
    }

    .edit-loading-spinner {
        width: 44px;
        height: 44px;
        margin: 0 auto 15px;

        border: 4px solid #e4ebf5;
        border-top-color: #1B5FC7;
        border-radius: 50%;

        animation: editSpin .8s linear infinite;
    }

    @@keyframes editSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .edit-loading-card strong {
        display: block;
        color: #26344d;
        font-size: 15px;
    }

    .edit-loading-card span {
        display: block;
        margin-top: 5px;
        color: #8190a6;
        font-size: 12px;
    }


    /* ============================================================
       FORM SECTION
       ============================================================ */

    .edit-form-section {
        background: #ffffff;
        border: 1px solid #e4e9f1;
        border-radius: 19px;
        margin-bottom: 20px;
        padding: 25px;

        box-shadow:
            0 9px 30px rgba(31,52,90,.055);
    }

    .edit-section-heading {
        display: flex;
        align-items: center;
        gap: 13px;

        padding-bottom: 18px;
        margin-bottom: 22px;

        border-bottom: 1px solid #edf0f5;
    }

    .edit-section-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #edf4ff;
        color: #175ab8;

        flex: 0 0 42px;
    }

    .edit-section-icon i {
        font-size: 18px;
    }

    .edit-section-heading h3 {
        margin: 0;
        color: #1d2a40;
        font-size: 17px;
        font-weight: 800;
    }

    .edit-section-heading p {
        margin: 3px 0 0;
        color: #8490a3;
        font-size: 12px;
    }


    /* ============================================================
       FORM GRID
       ============================================================ */

    .edit-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 19px;
    }

    .edit-form-grid.three {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }

    .edit-form-group {
        min-width: 0;
    }

    .edit-form-group.full {
        grid-column: 1 / -1;
    }

    .edit-form-group label {
        display: block;
        margin-bottom: 7px;

        color: #3d4a60;
        font-size: 12px;
        font-weight: 750;
    }

    .edit-required {
        color: #d44949;
        margin-left: 2px;
    }

    .edit-input-wrap {
        position: relative;
    }

    .edit-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);

        color: #7e8da5;
        font-size: 15px;

        pointer-events: none;
        z-index: 2;
    }

    .edit-input,
    .edit-select,
    .edit-textarea {
        width: 100%;
        box-sizing: border-box;

        border: 1px solid #dce3ed !important;
        border-radius: 11px !important;

        background:
            linear-gradient(
                180deg,
                #ffffff,
                #fbfcfe
            ) !important;

        color: #202d42 !important;

        font-size: 13px !important;
        font-weight: 550 !important;

        outline: none !important;

        transition:
            border-color .2s ease,
            box-shadow .2s ease,
            background .2s ease;
    }

    .edit-input,
    .edit-select {
        min-height: 48px;
        padding: 0 14px 0 42px !important;
    }

    .edit-input:focus,
    .edit-select:focus,
    .edit-textarea:focus {
        border-color: #4b86d9 !important;

        box-shadow:
            0 0 0 4px rgba(27,95,199,.09) !important;

        background: #ffffff !important;
    }

    .edit-textarea {
        min-height: 135px;
        padding: 14px !important;
        resize: vertical;
        line-height: 1.65;
    }

    .edit-select-wrap {
        position: relative;
    }

    .edit-select-wrap::after {
        content: "\F282";
        font-family: "bootstrap-icons";
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);

        color: #718096;
        font-size: 12px;
        pointer-events: none;
    }

    .edit-select {
        appearance: none;
        padding-right: 38px !important;
    }

    .edit-input.rtl,
    .edit-textarea.rtl {
        direction: rtl;
        text-align: right;
    }

    .edit-input-icon-right {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);

        color: #7e8da5;
        pointer-events: none;
    }

    .edit-input.rtl {
        padding-left: 14px !important;
        padding-right: 42px !important;
    }

    .edit-help {
        display: block;
        margin-top: 6px;

        color: #8a96a8;
        font-size: 11px;
        line-height: 1.45;
    }

    .validation-message {
        margin-top: 5px;
        color: #c53636;
        font-size: 11px;
    }


    /* ============================================================
       CURRENCY
       ============================================================ */

    .currency-readonly {
        background: #f5f7fa !important;
        color: #536176 !important;
        cursor: not-allowed;
    }


    /* ============================================================
       NEGOTIABLE
       ============================================================ */

    .edit-negotiable-card {
        grid-column: 1 / -1;

        display: flex;
        align-items: center;
        gap: 12px;

        padding: 14px 16px;

        border: 1px solid #e3e9f2;
        border-radius: 13px;

        background: #fafbfd;

        cursor: pointer;

        transition:
            background .2s ease,
            border-color .2s ease,
            transform .2s ease;
    }

    .edit-negotiable-card:hover {
        background: #f5f8fd;
        border-color: #cbd8eb;
        transform: translateY(-1px);
    }

    .edit-negotiable-card input {
        width: 18px;
        height: 18px;
        accent-color: #1B5FC7;
        flex: 0 0 auto;
    }

    .edit-negotiable-content strong {
        display: block;
        color: #334057;
        font-size: 13px;
    }

    .edit-negotiable-content span {
        display: block;
        margin-top: 2px;
        color: #8894a7;
        font-size: 11px;
    }


    /* ============================================================
       PHOTOS
       ============================================================ */

    .edit-photo-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 18px;
        padding: 12px 14px;

        border-radius: 12px;
        background: #f7f9fc;
        border: 1px solid #e6ebf2;
    }

    .edit-photo-summary-left {
        display: flex;
        align-items: center;
        gap: 9px;

        color: #4e5c72;
        font-size: 12px;
        font-weight: 700;
    }

    .edit-photo-summary-left i {
        color: #1B5FC7;
        font-size: 16px;
    }

    .edit-photo-count {
        color: #0A2C6A;
        font-weight: 850;
    }

    .edit-photo-grid {
        display: grid;
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 18px;
    }

    .edit-photo-card {
        position: relative;
        overflow: hidden;

        border: 1px solid #e0e6ef;
        border-radius: 14px;

        background: #ffffff;

        box-shadow:
            0 5px 16px rgba(28,47,80,.05);
    }

    .edit-photo-image-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
        background: #f0f3f8;
        overflow: hidden;
    }

    .edit-photo-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform .3s ease;
    }

    .edit-photo-card:hover .edit-photo-image {
        transform: scale(1.035);
    }

    .edit-primary-badge {
        position: absolute;
        left: 9px;
        top: 9px;

        display: inline-flex;
        align-items: center;
        gap: 5px;

        padding: 5px 8px;
        border-radius: 999px;

        background: rgba(10,44,106,.93);
        color: #ffffff;

        font-size: 10px;
        font-weight: 800;

        box-shadow: 0 4px 10px rgba(0,0,0,.15);
    }

    .edit-photo-card-body {
        padding: 11px;
    }

    .edit-photo-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;

        color: #3b485e;
        font-size: 11px;
        font-weight: 700;
    }

    .edit-photo-actions {
        display: flex;
        gap: 7px;
        margin-top: 9px;
    }

    .edit-photo-action {
        min-height: 32px;
        padding: 0 9px;

        border-radius: 8px;
        border: 1px solid #dce3ed;

        background: #ffffff;
        color: #536176;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;

        font-size: 10px;
        font-weight: 750;

        cursor: pointer;

        transition:
            .2s ease;
    }

    .edit-photo-action:hover {
        border-color: #9fb6d8;
        color: #0A2C6A;
        background: #f6f9fd;
    }

    .edit-photo-action.delete:hover {
        color: #bd3838;
        border-color: #edbcbc;
        background: #fff6f6;
    }

    .edit-photo-action:disabled {
        opacity: .5;
        cursor: not-allowed;
    }


    /* ============================================================
       NEW PHOTO CARDS
       ============================================================ */

    .edit-new-photo {
        position: relative;
        overflow: hidden;

        border: 1px solid #dbe5f2;
        border-radius: 14px;

        background: #f9fbfe;
    }

    .edit-new-photo .edit-photo-image-wrap {
        background: #eef4fb;
    }

    .edit-new-photo-badge {
        position: absolute;
        left: 9px;
        top: 9px;

        padding: 5px 8px;
        border-radius: 999px;

        background: rgba(27,95,199,.93);
        color: #ffffff;

        font-size: 10px;
        font-weight: 800;
    }


    /* ============================================================
       UPLOAD
       ============================================================ */

    .edit-upload-area {
        position: relative;

        min-height: 155px;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 22px;

        border: 2px dashed #c9d7ea;
        border-radius: 15px;

        background:
            linear-gradient(
                180deg,
                #fbfdff,
                #f6f9fd
            );

        cursor: pointer;

        transition:
            border-color .2s ease,
            background .2s ease,
            transform .2s ease;
    }

    .edit-upload-area:hover {
        border-color: #79a4dc;
        background: #f3f8ff;
        transform: translateY(-1px);
    }

    .edit-upload-file-input {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;

        opacity: 0;
        cursor: pointer;
    }

    .edit-upload-content {
        text-align: center;
        pointer-events: none;
    }

    .edit-upload-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 10px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 14px;

        background: #eaf2ff;
        color: #1B5FC7;
    }

    .edit-upload-icon i {
        font-size: 22px;
    }

    .edit-upload-content strong {
        display: block;
        color: #31415a;
        font-size: 13px;
    }

    .edit-upload-content span {
        display: block;
        margin-top: 5px;
        color: #8995a8;
        font-size: 11px;
    }


    /* ============================================================
       UPLOAD PROGRESS
       ============================================================ */

    .edit-upload-progress {
        margin-top: 16px;
        padding: 14px 16px;

        border-radius: 13px;

        background: #f3f8ff;
        border: 1px solid #d6e4f8;
    }

    .edit-upload-progress-top {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .edit-upload-progress-icon {
        width: 34px;
        height: 34px;

        border-radius: 9px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #dceaff;
        color: #1B5FC7;
    }

    .edit-upload-progress-content {
        flex: 1;
    }

    .edit-upload-progress-content strong {
        display: block;
        color: #30415c;
        font-size: 12px;
    }

    .edit-upload-progress-content span {
        display: block;
        margin-top: 2px;
        color: #8090a6;
        font-size: 10px;
    }

    .edit-upload-progress-count {
        color: #175ab8;
        font-size: 12px;
        font-weight: 800;
    }

    .edit-progress-track {
        width: 100%;
        height: 6px;
        margin-top: 12px;

        border-radius: 999px;
        background: #dfe8f5;
        overflow: hidden;
    }

    .edit-progress-value {
        height: 100%;

        border-radius: inherit;

        background:
            linear-gradient(
                90deg,
                #0A2C6A,
                #1B5FC7
            );

        transition: width .25s ease;
    }


    /* ============================================================
       ACTION BAR
       ============================================================ */

    .edit-action-bar {
        position: sticky;
        bottom: 0;
        z-index: 20;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        padding: 16px 20px;

        background: rgba(255,255,255,.96);
        border: 1px solid #e1e7f0;
        border-radius: 17px;

        box-shadow:
            0 -8px 30px rgba(25,46,82,.08);

        backdrop-filter: blur(12px);
    }

    .edit-action-left {
        color: #8792a5;
        font-size: 11px;
    }

    .edit-action-buttons {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .edit-button {
        min-height: 44px;
        padding: 0 16px;

        border-radius: 10px;
        border: 1px solid transparent;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        font-size: 12px;
        font-weight: 800;

        cursor: pointer;

        transition:
            transform .2s ease,
            box-shadow .2s ease,
            background .2s ease;
    }

    .edit-button:hover:not(:disabled) {
        transform: translateY(-2px);
    }

    .edit-button:disabled {
        opacity: .55;
        cursor: not-allowed;
    }

    .edit-button-cancel {
        border-color: #dce3ed;
        background: #ffffff;
        color: #556277;
    }

    .edit-button-cancel:hover:not(:disabled) {
        background: #f7f9fc;
        box-shadow: 0 5px 15px rgba(30,50,90,.07);
    }

    .edit-button-save {
        background:
            linear-gradient(
                135deg,
                #0A2C6A,
                #1B5FC7
            );

        color: #ffffff;

        box-shadow:
            0 7px 17px rgba(27,95,199,.22);
    }

    .edit-button-submit {
        background:
            linear-gradient(
                135deg,
                #137844,
                #20a65e
            );

        color: #ffffff;

        box-shadow:
            0 7px 17px rgba(32,166,94,.20);
    }

    .edit-button-save:hover:not(:disabled),
    .edit-button-submit:hover:not(:disabled) {
        box-shadow:
            0 10px 23px rgba(27,95,199,.28);
    }

    .edit-button-spinner {
        width: 14px;
        height: 14px;

        border: 2px solid rgba(255,255,255,.45);
        border-top-color: #ffffff;
        border-radius: 50%;

        animation: editSpin .7s linear infinite;
    }


    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 1050px) {

        .edit-photo-grid {
            grid-template-columns:
                repeat(3, minmax(0, 1fr));
        }

        .edit-form-grid.three {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 800px) {

        .my-ad-edit-topbar-inner {
            min-height: auto;
            padding: 12px 18px;

            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .my-ad-edit-brand {
            flex: 1;
            min-width: 0;
        }

        .my-ad-edit-page-title {
            width: 100%;
            order: 3;

            justify-content: flex-start;

            min-width: 0;

            padding-top: 4px;

            white-space: normal;
            text-align: left;
        }

        .my-ad-edit-back-button {
            width: 42px;
            min-width: 42px;
            padding: 0;

            justify-content: center;
        }

        .my-ad-edit-back-button span {
            display: none;
        }

        .my-ad-edit-main {
            padding: 24px 15px 0;
        }

        .edit-form-section {
            padding: 20px 17px;
            border-radius: 16px;
        }

        .edit-form-grid,
        .edit-form-grid.three {
            grid-template-columns: 1fr;
        }

        .edit-form-group.full,
        .edit-negotiable-card {
            grid-column: auto;
        }

        .edit-photo-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

        .edit-action-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .edit-action-left {
            text-align: center;
        }

        .edit-action-buttons {
            width: 100%;
            flex-wrap: wrap;
        }

        .edit-button {
            flex: 1;
        }
    }


    @@media (max-width: 500px) {

        .my-ad-edit-brand-subtitle {
            display: none;
        }

        .my-ad-edit-brand-logo {
            width: 42px;
            height: 42px;
            flex-basis: 42px;
        }

        .my-ad-edit-brand-title {
            font-size: 14px;
        }

        .my-ad-edit-page-title {
            font-size: 19px;
        }

        .my-ad-edit-page-title-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
        }

        .edit-photo-grid {
            grid-template-columns: 1fr;
        }

        .edit-action-buttons {
            flex-direction: column;
        }

        .edit-button {
            width: 100%;
        }
    }

</style>


<div class="my-ad-edit-page">

    <!-- =========================================================
         TOP BAR
         ========================================================= -->

    <header class="my-ad-edit-topbar">

        <div class="my-ad-edit-topbar-inner">

            <div class="my-ad-edit-brand">

                <img src="images/hr-info-ads-logo.png"
                     class="my-ad-edit-brand-logo"
                     alt="HR INFO ADs" />

                <div class="my-ad-edit-brand-text">

                    <div class="my-ad-edit-brand-title">
                        HR INFO ADs
                    </div>

                    <span class="my-ad-edit-brand-subtitle">
                        Advertisement Marketplace
                    </span>

                </div>

            </div>


            <h1 class="my-ad-edit-page-title">

                <span class="my-ad-edit-page-title-icon">
                    <i class="bi bi-pencil-square"></i>
                </span>

                <span>
                    Edit Advertisement
                </span>

            </h1>


            <button type="button"
                    class="my-ad-edit-back-button"
                    @onclick="GoBack"
                    disabled="@IsBusy">

                <i class="bi bi-arrow-left"></i>

                <span>
                    Back to Advertisement
                </span>

            </button>

        </div>

    </header>


    <!-- =========================================================
         MAIN
         ========================================================= -->

    <main class="my-ad-edit-main">

        <div class="my-ad-edit-intro">

            <h2>
                Update your advertisement
            </h2>

            <p>
                Review your information, update the details or manage
                your photos before saving the advertisement.
            </p>

        </div>


        <!-- =====================================================
             ALERTS
             ===================================================== -->

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="edit-alert edit-alert-error">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <div>
                    @errorMessage
                </div>

            </div>
        }


        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="edit-alert edit-alert-success">

                <i class="bi bi-check-circle-fill"></i>

                <div>
                    @successMessage
                </div>

            </div>
        }


        <!-- =====================================================
             LOADING
             ===================================================== -->

        @if (isLoading)
        {
            <div class="edit-loading-card">

                <div class="edit-loading-spinner"></div>

                <strong>
                    Loading advertisement
                </strong>

                <span>
                    Please wait while we load your advertisement details.
                </span>

            </div>
        }
        else if (advertisementLoaded)
        {

            <EditForm Model="model"
                      OnValidSubmit="SaveChanges">

                <DataAnnotationsValidator />


                <!-- =================================================
                     BASIC INFORMATION
                     ================================================= -->

                <section class="edit-form-section">

                    <div class="edit-section-heading">

                        <div class="edit-section-icon">
                            <i class="bi bi-card-text"></i>
                        </div>

                        <div>

                            <h3>
                                Basic Information
                            </h3>

                            <p>
                                Update the main information of your advertisement.
                            </p>

                        </div>

                    </div>


                    <div class="edit-form-grid">


                        <!-- CATEGORY -->

                        <div class="edit-form-group">

                            <label>
                                Category
                                <span class="edit-required">*</span>
                            </label>

                            <div class="edit-input-wrap edit-select-wrap">

                                <i class="bi bi-grid input-icon edit-input-icon"></i>

                                <InputSelect class="edit-select"
                                             @bind-Value="model.CategoryID">

                                    <option value="0">
                                        Select category
                                    </option>

                                    @foreach (var item in categories)
                                    {
                                        <option value="@item.ID">
                                            @item.Name
                                        </option>
                                    }

                                </InputSelect>

                            </div>

                            <ValidationMessage For="@(() => model.CategoryID)"
                                               class="validation-message" />

                        </div>


                        <!-- ADVERTISEMENT TYPE -->

                        <div class="edit-form-group">

                            <label>
                                Advertisement Type
                                <span class="edit-required">*</span>
                            </label>

                            <div class="edit-input-wrap edit-select-wrap">

                                <i class="bi bi-megaphone edit-input-icon"></i>

                                <InputSelect class="edit-select"
                                             @bind-Value="model.AdvertisementTypeID">

                                    <option value="0">
                                        Select advertisement type
                                    </option>

                                    @foreach (var item in advertisementTypes)
                                    {
                                        <option value="@item.ID">
                                            @item.Name
                                        </option>
                                    }

                                </InputSelect>

                            </div>

                            <ValidationMessage For="@(() => model.AdvertisementTypeID)"
                                               class="validation-message" />

                        </div>


                        <!-- ENGLISH TITLE -->

                        <div class="edit-form-group">

                            <label>
                                Advertisement Title
                                <span class="edit-required">*</span>
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-type edit-input-icon"></i>

                                <InputText class="edit-input"
                                           @bind-Value="model.Title"
                                           placeholder="Enter a clear advertisement title" />

                            </div>

                            <ValidationMessage For="@(() => model.Title)"
                                               class="validation-message" />

                        </div>


                        <!-- ARABIC TITLE -->

                        <div class="edit-form-group">

                            <label>
                                Arabic Title
                            </label>

                            <div class="edit-input-wrap">

                                <InputText class="edit-input rtl"
                                           @bind-Value="model.TitleAr"
                                           placeholder="أدخل عنوان الإعلان"
                                           dir="rtl" />

                                <i class="bi bi-translate edit-input-icon-right"></i>

                            </div>

                        </div>


                        <!-- ENGLISH DESCRIPTION -->

                        <div class="edit-form-group full">

                            <label>
                                Description
                                <span class="edit-required">*</span>
                            </label>

                            <div class="edit-input-wrap">

                                <InputTextArea class="edit-textarea"
                                               @bind-Value="model.Description"
                                               rows="6"
                                               placeholder="Provide detailed information about your advertisement" />

                            </div>

                            <ValidationMessage For="@(() => model.Description)"
                                               class="validation-message" />

                        </div>


                        <!-- ARABIC DESCRIPTION -->

                        <div class="edit-form-group full">

                            <label>
                                Arabic Description
                            </label>

                            <div class="edit-input-wrap">

                                <InputTextArea class="edit-textarea rtl"
                                               @bind-Value="model.DescriptionAr"
                                               rows="6"
                                               placeholder="أدخل وصفاً تفصيلياً للإعلان"
                                               dir="rtl" />

                            </div>

                        </div>


                        <!-- PRICE -->

                        <div class="edit-form-group">

                            <label>
                                Price
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-cash-stack edit-input-icon"></i>

                                <InputNumber class="edit-input"
                                             @bind-Value="model.Price"
                                             placeholder="Enter price" />

                            </div>

                        </div>


                        <!-- CURRENCY -->

                        <div class="edit-form-group">

                            <label>
                                Currency
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-currency-exchange edit-input-icon"></i>

                                <InputText class="edit-input currency-readonly"
                                           @bind-Value="model.CurrencyCode"
                                           readonly />

                            </div>

                            <small class="edit-help">
                                Currency is controlled by the advertisement system.
                            </small>

                        </div>


                        <!-- NEGOTIABLE -->

                        <label class="edit-negotiable-card">

                            <InputCheckbox @bind-Value="model.IsNegotiable" />

                            <div class="edit-negotiable-content">

                                <strong>
                                    Price is negotiable
                                </strong>

                                <span>
                                    Let buyers know that the listed price can be discussed.
                                </span>

                            </div>

                        </label>

                    </div>

                </section>


                <!-- =================================================
                     LOCATION
                     ================================================= -->

                <section class="edit-form-section">

                    <div class="edit-section-heading">

                        <div class="edit-section-icon">
                            <i class="bi bi-geo-alt"></i>
                        </div>

                        <div>

                            <h3>
                                Location
                            </h3>

                            <p>
                                Update the location and address information.
                            </p>

                        </div>

                    </div>


                    <div class="edit-form-grid">


                        <!-- COUNTRY -->

                        <div class="edit-form-group">

                            <label>
                                Country
                            </label>

                            <div class="edit-select-wrap">

                                <i class="bi bi-globe2 edit-input-icon"></i>

                                <InputSelect TValue="int"
             class="edit-select"
             Value="selectedCountryId"
             ValueChanged="OnCountryChanged"
             ValueExpression="@(() => selectedCountryId)">

                                    <option value="0">
                                        Select country
                                    </option>

                                    @foreach (var item in countries)
                                    {
                                        <option value="@item.ID">
                                            @item.Name
                                        </option>
                                    }

                                </InputSelect>

                            </div>

                        </div>


                        <!-- STATE -->

                        <div class="edit-form-group">

                            <label>
                                State / Governorate
                            </label>

                            <div class="edit-select-wrap">

                                <i class="bi bi-map edit-input-icon"></i>

                                <InputSelect TValue="int"
             class="edit-select"
             Value="selectedStateId"
             ValueChanged="OnStateChanged"
             ValueExpression="@(() => selectedStateId)"
             disabled="@(selectedCountryId <= 0)">

                                    <option value="0">
                                        Select state
                                    </option>

                                    @foreach (var item in states)
                                    {
                                        <option value="@item.ID">
                                            @item.Name
                                        </option>
                                    }

                                </InputSelect>

                            </div>

                        </div>


                        <!-- CITY -->

                        <div class="edit-form-group">

                            <label>
                                City
                            </label>

                            <div class="edit-select-wrap">

                                <i class="bi bi-buildings edit-input-icon"></i>

                                <InputSelect TValue="int"
             class="edit-select"
             Value="selectedCityId"
             ValueChanged="OnCityChanged"
             ValueExpression="@(() => selectedCityId)"
             disabled="@(selectedCountryId <= 0)">

                                    <option value="0">
                                        Select city
                                    </option>

                                    @foreach (var item in cities)
                                    {
                                        <option value="@item.ID">
                                            @item.Name
                                        </option>
                                    }

                                </InputSelect>

                            </div>

                        </div>


                        <!-- AREA -->

                        <div class="edit-form-group">

                            <label>
                                Area
                            </label>

                            <div class="edit-select-wrap">

                                <i class="bi bi-pin-map edit-input-icon"></i>

                                <InputSelect class="edit-select"
                                             @bind-Value="selectedAreaId"
                                             disabled="@(selectedCountryId <= 0)">

                                    <option value="0">
                                        Select area
                                    </option>

                                    @foreach (var item in areas)
                                    {
                                        <option value="@item.ID">
                                            @item.Name
                                        </option>
                                    }

                                </InputSelect>

                            </div>

                        </div>


                        <!-- ADDRESS -->

                        <div class="edit-form-group full">

                            <label>
                                Address
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-signpost-2 edit-input-icon"></i>

                                <InputText class="edit-input"
                                           @bind-Value="model.AddressLine"
                                           placeholder="Building, road, block or other address details" />

                            </div>

                        </div>


                        <!-- PLOT -->

                        <div class="edit-form-group">

                            <label>
                                Plot Number
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-hash edit-input-icon"></i>

                                <InputText class="edit-input"
                                           @bind-Value="model.PlotNumber"
                                           placeholder="Enter plot number" />

                            </div>

                        </div>


                        <!-- LATITUDE -->

                        <div class="edit-form-group">

                            <label>
                                Latitude
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-crosshair edit-input-icon"></i>

                                <InputNumber class="edit-input"
                                             @bind-Value="model.Latitude"
                                             placeholder="Latitude" />

                            </div>

                        </div>


                        <!-- LONGITUDE -->

                        <div class="edit-form-group">

                            <label>
                                Longitude
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-crosshair2 edit-input-icon"></i>

                                <InputNumber class="edit-input"
                                             @bind-Value="model.Longitude"
                                             placeholder="Longitude" />

                            </div>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     PROPERTY DETAILS
                     ================================================= -->

                <section class="edit-form-section">

                    <div class="edit-section-heading">

                        <div class="edit-section-icon">
                            <i class="bi bi-house-door"></i>
                        </div>

                        <div>

                            <h3>
                                Property Details
                            </h3>

                            <p>
                                Update property specifications where applicable.
                            </p>

                        </div>

                    </div>


                    <div class="edit-form-grid three">


                        <!-- LAND AREA -->

                        <div class="edit-form-group">

                            <label>
                                Land Area
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-bounding-box edit-input-icon"></i>

                                <InputNumber class="edit-input"
                                             @bind-Value="model.LandArea"
                                             placeholder="Land area" />

                            </div>

                            <small class="edit-help">
                                Enter the land area in square metres.
                            </small>

                        </div>


                        <!-- BUILT UP -->

                        <div class="edit-form-group">

                            <label>
                                Built-up Area
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-aspect-ratio edit-input-icon"></i>

                                <InputNumber class="edit-input"
                                             @bind-Value="model.BuiltUpArea"
                                             placeholder="Built-up area" />

                            </div>

                            <small class="edit-help">
                                Enter the built-up area in square metres.
                            </small>

                        </div>


                        <!-- BEDROOMS -->

                        <div class="edit-form-group">

                            <label>
                                Bedrooms
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-door-open edit-input-icon"></i>

                                <InputNumber class="edit-input"
                                             @bind-Value="model.Bedrooms"
                                             placeholder="Bedrooms" />

                            </div>

                        </div>


                        <!-- BATHROOMS -->

                        <div class="edit-form-group">

                            <label>
                                Bathrooms
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-droplet edit-input-icon"></i>

                                <InputNumber class="edit-input"
                                             @bind-Value="model.Bathrooms"
                                             placeholder="Bathrooms" />

                            </div>

                        </div>


                        <!-- PROPERTY AGE -->

                        <div class="edit-form-group">

                            <label>
                                Property Age
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-calendar3 edit-input-icon"></i>

                                <InputNumber class="edit-input"
                                             @bind-Value="model.PropertyAge"
                                             placeholder="Age in years" />

                            </div>

                        </div>


                        <!-- EXPIRY -->

                        <div class="edit-form-group">

                            <label>
                                Expiry Date
                            </label>

                            <div class="edit-input-wrap">

                                <i class="bi bi-calendar-event edit-input-icon"></i>

                                <InputDate class="edit-input"
                                            @bind-Value="model.ExpiryDate" />

                            </div>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     PHOTOS
                     ================================================= -->

                <section class="edit-form-section">

                    <div class="edit-section-heading">

                        <div class="edit-section-icon">
                            <i class="bi bi-images"></i>
                        </div>

                        <div>

                            <h3>
                                Advertisement Photos
                            </h3>

                            <p>
                                Manage existing photos or add new photos to your advertisement.
                            </p>

                        </div>

                    </div>


                    <div class="edit-photo-summary">

                        <div class="edit-photo-summary-left">

                            <i class="bi bi-images"></i>

                            <span>
                                Photos
                            </span>

                            <span class="edit-photo-count">
                                @TotalPhotoCount / @MaxImages
                            </span>

                        </div>

                        <span>
                            Maximum 10 MB per photo
                        </span>

                    </div>


                    @if (savedImages.Count > 0)
                    {
                        <div class="edit-photo-grid">

                            @foreach (var image in savedImages)
                            {
                                <div class="edit-photo-card">

                                    <div class="edit-photo-image-wrap">

                                        <img src="@image.FileURL"
                                             class="edit-photo-image"
                                             alt="@image.FileName" />

                                        @if (image.IsPrimary)
                                        {
                                            <div class="edit-primary-badge">

                                                <i class="bi bi-star-fill"></i>

                                                Main Photo

                                            </div>
                                        }

                                    </div>


                                    <div class="edit-photo-card-body">

                                        <div class="edit-photo-name"
                                             title="@image.FileName">

                                            @image.FileName

                                        </div>


                                        <div class="edit-photo-actions">

                                            @if (!image.IsPrimary)
                                            {
                                                <button type="button"
                                                        class="edit-photo-action"
                                                        @onclick="() => SetPrimarySavedImage(image)"
                                                        disabled="@IsBusy">

                                                    <i class="bi bi-star"></i>

                                                    Main

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="edit-photo-action"
                                                        disabled>

                                                    <i class="bi bi-star-fill"></i>

                                                    Main

                                                </button>
                                            }


                                            <button type="button"
                                                    class="edit-photo-action delete"
                                                    @onclick="() => DeleteSavedImage(image)"
                                                    disabled="@IsBusy">

                                                <i class="bi bi-trash3"></i>

                                                Delete

                                            </button>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="edit-upload-area"
                             style="margin-bottom:18px;">

                            <span class="edit-upload-content">

                                <span class="edit-upload-icon">

                                    <i class="bi bi-images"></i>

                                </span>

                                <strong>
                                    No photos uploaded yet
                                </strong>

                                <span>
                                    Add photos below to make your advertisement more attractive.
                                </span>

                            </span>

                        </div>
                    }


                    <!-- NEW SELECTED PHOTOS -->

                    @if (selectedImages.Count > 0)
                    {
                        <div class="edit-photo-grid">

                            @foreach (var image in selectedImages)
                            {
                                <div class="edit-new-photo">

                                    <div class="edit-photo-image-wrap">

                                        <img src="@image.PreviewUrl"
                                             class="edit-photo-image"
                                             alt="@image.FileName" />

                                        @if (image.IsPrimary)
                                        {
                                            <div class="edit-primary-badge">

                                                <i class="bi bi-star-fill"></i>

                                                Main Photo

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="edit-new-photo-badge">
                                                New
                                            </div>
                                        }

                                    </div>


                                    <div class="edit-photo-card-body">

                                        <div class="edit-photo-name"
                                             title="@image.FileName">

                                            @image.FileName

                                        </div>


                                        <div class="edit-photo-actions">

                                            <button type="button"
                                                    class="edit-photo-action"
                                                    @onclick="() => SetPrimarySelectedImage(image)"
                                                    disabled="@IsBusy">

                                                <i class="bi @(image.IsPrimary ? "bi-star-fill" : "bi-star")"></i>

                                                @(image.IsPrimary ? "Main" : "Set Main")

                                            </button>


                                            <button type="button"
                                                    class="edit-photo-action delete"
                                                    @onclick="() => RemoveSelectedImage(image)"
                                                    disabled="@IsBusy">

                                                <i class="bi bi-x-lg"></i>

                                                Remove

                                            </button>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }


                    <!-- UPLOAD AREA -->

                    @if (RemainingPhotoSlots > 0)
                    {
                        <label class="edit-upload-area">

                            <InputFile class="edit-upload-file-input"
                                       OnChange="HandleImageSelection"
                                       multiple
                                       accept="image/jpeg,image/png,image/webp" />

                            <span class="edit-upload-content">

                                <span class="edit-upload-icon">

                                    <i class="bi bi-cloud-arrow-up"></i>

                                </span>

                                <strong>
                                    Add more photos
                                </strong>

                                <span>
                                    JPG, PNG or WEBP · Maximum 10 MB per photo
                                </span>

                            </span>

                        </label>
                    }


                    @if (RemainingPhotoSlots == 0)
                    {
                        <div class="edit-alert edit-alert-success"
                             style="margin-top:16px;margin-bottom:0;">

                            <i class="bi bi-check-circle-fill"></i>

                            <div>
                                You have reached the maximum of @MaxImages photos.
                            </div>

                        </div>
                    }


                    @if (isUploadingImages)
                    {
                        <div class="edit-upload-progress">

                            <div class="edit-upload-progress-top">

                                <div class="edit-upload-progress-icon">

                                    <i class="bi bi-cloud-arrow-up"></i>

                                </div>

                                <div class="edit-upload-progress-content">

                                    <strong>
                                        Uploading your photos
                                    </strong>

                                    <span>
                                        Please keep this page open while the upload completes.
                                    </span>

                                </div>

                                <div class="edit-upload-progress-count">

                                    @uploadedImageCount /
                                    @totalImagesToUpload

                                </div>

                            </div>


                            <div class="edit-progress-track">

                                <div class="edit-progress-value"
                                     style="width:@GetUploadProgressPercentage()%;">

                                </div>

                            </div>

                        </div>
                    }

                </section>


                <!-- =================================================
                     ACTION BAR
                     ================================================= -->

                <div class="edit-action-bar">

                    <div class="edit-action-left">

                        <i class="bi bi-shield-check"></i>

                        Your changes will be saved securely.

                    </div>


                    <div class="edit-action-buttons">


                        <button type="button"
                                class="edit-button edit-button-cancel"
                                @onclick="GoBack"
                                disabled="@IsBusy">

                            <i class="bi bi-x-lg"></i>

                            Cancel

                        </button>


                        <button type="submit"
                                class="edit-button edit-button-save"
                                disabled="@IsBusy">

                            @if (isSaving || isUploadingImages)
                            {
                                <span class="edit-button-spinner"></span>

                                <span>
                                    Saving...
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle"></i>

                                <span>
                                    Save Changes
                                </span>
                            }

                        </button>


                        <button type="button"
                                class="edit-button edit-button-submit"
                                @onclick="SaveAndSubmit"
                                disabled="@IsBusy">

                            @if (isSubmitting)
                            {
                                <span class="edit-button-spinner"></span>

                                <span>
                                    Submitting...
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-send"></i>

                                <span>
                                    Save & Submit
                                </span>
                            }

                        </button>

                    </div>

                </div>

            </EditForm>
        }

    </main>

</div>


@code {

    // ============================================================
    // ROUTE
    // ============================================================

    [Parameter]
    public long AdvertisementId { get; set; }


    // ============================================================
    // AUTHENTICATION
    // ============================================================

    private bool isAuthenticated;


    // ============================================================
    // LOADING
    // ============================================================

    private bool isLoading = true;

    private bool advertisementLoaded;


