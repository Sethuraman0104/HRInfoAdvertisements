    // ============================================================
    // INITIALIZE
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            isAuthenticated =
                authenticationState.User.Identity?.IsAuthenticated == true;

            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/");
                return;
            }


            await LoadLookupsAsync();

            await LoadAdvertisementAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"EDIT PAGE INITIALIZATION ERROR: {ex}");

            errorMessage =
                "We couldn’t load the advertisement right now. " +
                "Please refresh the page and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }


