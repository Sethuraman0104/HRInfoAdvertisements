    // ============================================================
    // LOAD ADVERTISEMENT
    // ============================================================

    private async Task LoadAdvertisementAsync()
    {
        errorMessage = null;

        try
        {
            var advertisement =
                await AdvertisementApiService
                    .GetAdvertisementByIdAsync(
                        AdvertisementId);

            if (advertisement is null)
            {
                errorMessage =
                    "The advertisement could not be found.";

                advertisementLoaded = false;

                return;
            }


            // ----------------------------------------------------
            // BASIC INFORMATION
            // ----------------------------------------------------

            model.CategoryID =
                advertisement.CategoryID;

            model.AdvertisementTypeID =
                advertisement.AdvertisementTypeID;

            model.Title =
                advertisement.Title ?? string.Empty;

            model.TitleAr =
                advertisement.TitleAr;

            model.Description =
                advertisement.Description ?? string.Empty;

            model.DescriptionAr =
                advertisement.DescriptionAr;

            model.Price =
                advertisement.Price;

            model.CurrencyCode =
                string.IsNullOrWhiteSpace(
                    advertisement.CurrencyCode)
                    ? "BHD"
                    : advertisement.CurrencyCode;

            model.IsNegotiable =
                advertisement.IsNegotiable;


            // ----------------------------------------------------
            // LOCATION
            // ----------------------------------------------------

            selectedCountryId =
                advertisement.CountryID ?? 0;

            selectedStateId =
                advertisement.StateID ?? 0;

            selectedCityId =
                advertisement.CityID ?? 0;

            selectedAreaId =
                advertisement.AreaID ?? 0;


            model.CountryID =
                advertisement.CountryID;

            model.StateID =
                advertisement.StateID;

            model.CityID =
                advertisement.CityID;

            model.AreaID =
                advertisement.AreaID;

            model.AddressLine =
                advertisement.AddressLine;

            model.PlotNumber =
                advertisement.PlotNumber;

            model.Latitude =
                advertisement.Latitude;

            model.Longitude =
                advertisement.Longitude;


            // ----------------------------------------------------
            // PROPERTY DETAILS
            // ----------------------------------------------------

            model.LandArea =
                advertisement.LandArea;

            model.BuiltUpArea =
                advertisement.BuiltUpArea;

            model.Bedrooms =
                advertisement.Bedrooms;

            model.Bathrooms =
                advertisement.Bathrooms;

            model.PropertyAge =
                advertisement.PropertyAge;

            model.ExpiryDate =
                advertisement.ExpiryDate;


            // ----------------------------------------------------
            // LOAD CASCADING LOCATIONS
            // ----------------------------------------------------

            if (selectedCountryId > 0)
            {
                states =
                    await AdvertisementApiService
                        .GetStatesAsync(
                            selectedCountryId);
            }

            if (selectedCountryId > 0)
            {
                cities =
                    await AdvertisementApiService
                        .GetCitiesAsync(
                            selectedCountryId,
                            selectedStateId > 0
                                ? selectedStateId
                                : null);
            }

            if (selectedCountryId > 0)
            {
                areas =
                    await AdvertisementApiService
                        .GetAreasAsync(
                            selectedCountryId,
                            selectedStateId > 0
                                ? selectedStateId
                                : null,
                            selectedCityId > 0
                                ? selectedCityId
                                : null);
            }


            // ----------------------------------------------------
            // LOAD EXISTING PHOTOS
            // ----------------------------------------------------

            LoadSavedImagesFromAdvertisement(
                advertisement);


            advertisementLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"LOAD ADVERTISEMENT ERROR: {ex}");

            errorMessage =
                "We couldn’t load the advertisement details. " +
                "Please refresh the page and try again.";

            advertisementLoaded = false;
        }
    }


    // ============================================================
    // LOAD SAVED IMAGES
    // ============================================================

    private void LoadSavedImagesFromAdvertisement(
    AdvertisementResponse advertisement)
    {
        savedImages.Clear();

        if (advertisement.Images is null)
        {
            return;
        }

        foreach (var image in advertisement.Images
                     .OrderBy(x => x.DisplayOrder))
        {
            savedImages.Add(
                new SavedAdvertisementImage
                {
                    AdvertisementImageID =
                        image.AdvertisementImageID,

                    AdvertisementID =
                        image.AdvertisementID,

                    FileName =
                        image.FileName ?? string.Empty,

                    FileURL =
                        image.FileURL ?? string.Empty,

                    FileSize =
                        image.FileSize,

                    IsPrimary =
                        image.IsPrimary,

                    DisplayOrder =
                        image.DisplayOrder,

                    CreatedDate =
                        image.CreatedDate
                });
        }
    }


