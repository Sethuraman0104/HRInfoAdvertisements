    // ============================================================
    // SUBMIT
    // ============================================================

    private async Task SubmitAdvertisementAsync(
    AdvertisementResponse advertisement)
{
    if (isSubmitting)
    {
        return;
    }

    var status =
        NormalizeStatus(
            advertisement.StatusCode);

    // ============================================================
    // REJECTED ADVERTISEMENT
    // ============================================================
    // A rejected advertisement must first be edited and saved.
    // Saving the advertisement moves it back to DRAFT, after which
    // it can be submitted for review again.
    // ============================================================

    if (status == "REJECTED")
{
    infoMessage =
        "This advertisement was previously rejected during review. " +
        "Please review the rejection feedback, make the necessary " +
        "changes, and save the advertisement before submitting it again.";

    errorMessage = null;
    successMessage = null;

    await InvokeAsync(StateHasChanged);

    await Task.Delay(100);

    try
    {
        await JS.InvokeVoidAsync(
            "hrInfoAds.scrollToFeedback");
    }
    catch (JSException jsEx)
    {
        Console.WriteLine(
            "Unable to scroll to feedback message: " +
            jsEx.Message);
    }

    return;
}

    // ============================================================
    // NORMAL SUBMISSION
    // ============================================================

    if (!CanSubmit(advertisement))
    {
        return;
    }

    // Clear previous messages before starting a new submission.
    errorMessage = null;
    infoMessage = null;
    successMessage = null;

    isSubmitting = true;

    submittingAdvertisementId =
        advertisement.AdvertisementID;

    try
    {
        var result =
            await AdvertisementApiService
                .SubmitAdvertisementAsync(
                    advertisement.AdvertisementID);

        // ========================================================
        // SUBMISSION FAILED WITHOUT AN EXCEPTION
        // ========================================================

        if (!result)
{
    errorMessage =
        requireAdminApproval
            ? "The advertisement could not be submitted for approval. Please try again."
            : "The advertisement could not be submitted. Please try again.";

    return;
}

successMessage =
    requireAdminApproval
        ? $"Your advertisement has been submitted for approval. " +
          $"Once approved, it will stay live for {expiryDays} days."
        : $"Your advertisement has been submitted. " +
          $"It will stay live for {expiryDays} days.";

        await LoadAdvertisementsAsync();
    }
    catch (InvalidOperationException ex)
{
    Console.WriteLine(
        "================================================");

    Console.WriteLine(
        "SUBMIT ADVERTISEMENT VALIDATION ERROR");

    Console.WriteLine(
        ex.ToString());

    Console.WriteLine(
        "================================================");

    infoMessage =
        string.IsNullOrWhiteSpace(ex.Message)
            ? "The advertisement cannot be submitted yet. " +
              "Please review the advertisement information " +
              "and try again."
            : ex.Message;

    errorMessage = null;
    successMessage = null;

    await InvokeAsync(StateHasChanged);

    await Task.Delay(100);

    try
    {
        await JS.InvokeVoidAsync(
            "hrInfoAds.scrollToFeedback");
    }
    catch (JSException jsEx)
    {
        Console.WriteLine(
            "Unable to scroll to feedback message: " +
            jsEx.Message);
    }
}
    catch (Exception ex)
{
    // ========================================================
    // UNEXPECTED SYSTEM ERROR
    // ========================================================

    Console.WriteLine(
        "================================================");

    Console.WriteLine(
        "SUBMIT ADVERTISEMENT ERROR");

    Console.WriteLine(
        ex.ToString());

    Console.WriteLine(
        "================================================");

    errorMessage = null;
    infoMessage = null;
    successMessage = null;

    errorMessage =
        "We couldn't submit the advertisement right now. " +
        "Please try again.";

    await InvokeAsync(StateHasChanged);

    await Task.Delay(100);

    try
    {
        await JS.InvokeVoidAsync(
            "hrInfoAds.scrollToFeedback");
    }
    catch (JSException jsEx)
    {
        Console.WriteLine(
            "Unable to scroll to feedback message: " +
            jsEx.Message);
    }
}
    finally
    {
        // ========================================================
        // RESET SUBMISSION STATE
        // ========================================================

        isSubmitting = false;

        submittingAdvertisementId = null;
    }
}


    // ============================================================
    // IMAGE
    // ============================================================

    private string? GetPrimaryImageUrl(
        AdvertisementResponse advertisement)
    {
        if (advertisement.Images is null ||
            advertisement.Images.Count == 0)
        {
            return null;
        }

        var primary =
            advertisement.Images
                .FirstOrDefault(x =>
                    x.IsPrimary);

        if (primary is not null &&
            !string.IsNullOrWhiteSpace(
                primary.FileURL))
        {
            return primary.FileURL;
        }

        var first =
            advertisement.Images
                .OrderBy(x => x.DisplayOrder)
                .FirstOrDefault();

        return first?.FileURL;
    }


    // ============================================================
    // FORMATTING
    // ============================================================

    private string FormatPrice(
    AdvertisementResponse advertisement)
{
    if (!advertisement.Price.HasValue)
    {
        return "Price on request";
    }

    var currency =
        string.IsNullOrWhiteSpace(advertisement.CurrencyCode)
            ? defaultCurrency
            : advertisement.CurrencyCode.Trim().ToUpperInvariant();

    var price = advertisement.Price.Value;

    var format =
        price == decimal.Truncate(price)
            ? "N0"
            : ThreeDecimalCurrencies.Contains(currency)
                ? "N3"
                : "N2";

    return $"{currency} {price.ToString(format, CultureInfo.CurrentCulture)}";
}


    private string FormatDate(
        DateTime date)
    {
        return date.ToString(
            "dd MMM yyyy");
    }


    private static bool ContainsIgnoreCase(
        string? source,
        string value)
    {
        return !string.IsNullOrWhiteSpace(source)
               &&
               source.Contains(
                   value,
                   StringComparison.OrdinalIgnoreCase);
    }
