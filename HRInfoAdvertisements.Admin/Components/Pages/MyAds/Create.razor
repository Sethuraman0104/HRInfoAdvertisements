// ============================================================
// SAVE DRAFT
// ============================================================

private async Task SaveDraft()
{
    if (isSaving ||
        isUploadingImages ||
        isSubmitting ||
        isLoadingAdvertisement)
    {
        return;
    }

    errorMessage = null;
    successMessage = null;


    if (!ValidateContactInformation(
            forSubmission: false))
    {
        return;
    }


    isSaving = true;

    try
    {
        model.CountryID =
            selectedCountryId > 0
                ? selectedCountryId
                : null;

        model.StateID =
            selectedStateId > 0
                ? selectedStateId
                : null;

        model.CityID =
            selectedCityId > 0
                ? selectedCityId
                : null;

        model.AreaID =
            selectedAreaId > 0
                ? selectedAreaId
                : null;


        // ----------------------------------------------------
        // UPDATE EXISTING
        // ----------------------------------------------------

        if (draftAdvertisementId.HasValue)
        {
            var updateRequest =
                BuildUpdateRequest();

            var updateResult =
                await AdvertisementApiService
                    .UpdateAdvertisementAsync(
                        draftAdvertisementId.Value,
                        updateRequest);


            if (updateResult is null)
            {
                errorMessage =
                    "We couldn’t update the advertisement. " +
                    "Please review the information and try again.";

                return;
            }


            draftAdvertisementId =
                updateResult.AdvertisementID;

            isEditMode = true;


            if (selectedImages.Count > 0)
            {
                await UploadSelectedImagesAsync();
            }
            else
            {
                successMessage =
                    "Advertisement updated successfully.";
            }


            return;
        }


        // ----------------------------------------------------
        // CREATE NEW
        // ----------------------------------------------------

        var createResult =
            await AdvertisementApiService
                .CreateAdvertisementAsync(
                    model);


        if (createResult is null)
        {
            errorMessage =
                "We couldn’t save the advertisement right now. " +
                "Please review the information and try again.";

            return;
        }


        draftAdvertisementId =
            createResult.AdvertisementID;

        isEditMode = true;


        if (selectedImages.Count > 0)
        {
            await UploadSelectedImagesAsync();
        }
        else
        {
            successMessage =
                "Advertisement saved successfully as a draft. " +
                "You can add photos before submitting it for approval.";
        }
    }
    catch (InvalidOperationException ex)
    {
        Console.WriteLine(
            $"SAVE VALIDATION ERROR: {ex}");

        errorMessage =
            ex.Message;
    }
    catch (Exception ex)
    {
        Console.WriteLine(
            "================================================");

        Console.WriteLine(
            "SAVE ADVERTISEMENT ERROR");

        Console.WriteLine(
            ex.ToString());

        Console.WriteLine(
            "================================================");

        errorMessage =
            "We couldn’t save your advertisement right now. " +
            "Please review the information and try again.";
    }
    finally
    {
        isSaving = false;
    }
}


// ============================================================
// SET PRIMARY SAVED IMAGE
// ============================================================

private async Task SetPrimarySavedImage(
    SavedAdvertisementImage image)
{
    if (IsBusy)
    {
        return;
    }

    if (draftAdvertisementId is null)
    {
        errorMessage =
            "Please save the advertisement before changing the main photo.";

        return;
    }

    if (image.AdvertisementImageID <= 0)
    {
        errorMessage =
            "The selected photo could not be identified.";

        return;
    }

    errorMessage = null;
    successMessage = null;

    try
    {
        isSubmitting = true;

        var success =
            await AdvertisementApiService
                .SetPrimaryImageAsync(
                    draftAdvertisementId.Value,
                    image.AdvertisementImageID);

        if (!success)
        {
            errorMessage =
                "The main photo could not be changed. " +
                "Please try again.";

            return;
        }

        foreach (var savedImage in savedImages)
        {
            savedImage.IsPrimary =
                savedImage.AdvertisementImageID ==
                image.AdvertisementImageID;
        }

        foreach (var selectedImage in selectedImages)
        {
            selectedImage.IsPrimary = false;
        }

        successMessage =
            $"'{image.FileName}' is now the main advertisement photo.";
    }
    catch (InvalidOperationException ex)
    {
        Console.WriteLine(
            $"SET PRIMARY IMAGE VALIDATION ERROR: {ex}");

        errorMessage =
            ex.Message;
    }
    catch (Exception ex)
    {
        Console.WriteLine(
            "================================================");

        Console.WriteLine(
            "SET PRIMARY SAVED IMAGE ERROR");

        Console.WriteLine(
            ex.ToString());

        Console.WriteLine(
            "================================================");

        errorMessage =
            "The main photo could not be changed right now. " +
            "Please try again.";
    }
    finally
    {
        isSubmitting = false;
    }
}


// ============================================================
// UPLOAD PROGRESS
// ============================================================

private int GetUploadProgressPercentage()
{
    if (totalImagesToUpload <= 0)
    {
        return 0;
    }

    return
        (int)Math.Round(
            uploadedImageCount *
            100d /
            totalImagesToUpload);
}


// ============================================================
// UPLOAD SELECTED IMAGES
// ============================================================

private async Task UploadSelectedImagesAsync()
{
    if (!draftAdvertisementId.HasValue)
    {
        return;
    }

    if (selectedImages.Count == 0)
    {
        return;
    }

    isUploadingImages = true;

    uploadedImageCount = 0;

    totalImagesToUpload =
        selectedImages.Count;

    errorMessage = null;

    successMessage =
        $"Your advertisement has been saved as a draft. " +
        $"Now uploading {totalImagesToUpload} photo" +
        $"{(totalImagesToUpload == 1 ? "" : "s")}...";


    var failedImages =
        new List<SelectedImage>();


    try
    {
        var imagesToUpload =
            selectedImages.ToList();


        foreach (var selectedImage in imagesToUpload)
        {
            try
            {
                await using var stream =
                    new MemoryStream(
                        selectedImage.FileBytes,
                        writable: false);


                var success =
                    await AdvertisementApiService
                        .UploadAdvertisementImageAsync(
                            draftAdvertisementId.Value,
                            stream,
                            selectedImage.FileName,
                            selectedImage.ContentType,
                            selectedImage.IsPrimary);


                if (success)
                {
                    uploadedImageCount++;

                    successMessage =
                        $"Uploading photo " +
                        $"{uploadedImageCount} of " +
                        $"{totalImagesToUpload}...";
                }
                else
                {
                    failedImages.Add(
                        selectedImage);
                }
            }
            catch (Exception ex)
            {
                failedImages.Add(
                    selectedImage);

                Console.WriteLine(
                    $"IMAGE UPLOAD FAILED: {ex}");
            }


            await InvokeAsync(
                StateHasChanged);
        }


        if (failedImages.Count == 0)
        {
            if (draftAdvertisementId.HasValue)
            {
                await LoadSavedImagesAsync(
                    draftAdvertisementId.Value);
            }

            successMessage =
                $"Advertisement saved successfully with " +
                $"{uploadedImageCount} photo" +
                $"{(uploadedImageCount == 1 ? "" : "s")}. " +
                "You can now submit it for approval.";

            errorMessage = null;

            selectedImages.Clear();
        }
        else if (uploadedImageCount > 0)
        {
            if (draftAdvertisementId.HasValue)
            {
                await LoadSavedImagesAsync(
                    draftAdvertisementId.Value);
            }

            successMessage =
                $"Advertisement saved successfully. " +
                $"{uploadedImageCount} of " +
                $"{totalImagesToUpload} photos were uploaded.";

            errorMessage =
                $"{failedImages.Count} photo" +
                $"{(failedImages.Count == 1 ? "" : "s")} " +
                "could not be uploaded. " +
                "You can retry the remaining photo(s).";

            selectedImages.Clear();

            selectedImages.AddRange(
                failedImages);


            if (!savedImages.Any(x => x.IsPrimary))
            {
                if (!selectedImages.Any(
                        x => x.IsPrimary) &&
                    selectedImages.Count > 0)
                {
                    selectedImages[0].IsPrimary = true;
                }
            }
            else
            {
                foreach (var image in selectedImages)
                {
                    image.IsPrimary = false;
                }
            }
        }
        else
        {
            successMessage =
                "Advertisement saved successfully as a draft.";

            errorMessage =
                "We couldn’t upload the selected photos. " +
                "Please try again.";
        }
    }
    finally
    {
        isUploadingImages = false;
    }
}


// ============================================================
// SUBMIT FOR APPROVAL
// ============================================================

private async Task SubmitForApproval()
{
    if (!draftAdvertisementId.HasValue)
    {
        errorMessage =
            "Please save the advertisement before submitting it.";

        return;
    }

    if (isUploadingImages)
    {
        errorMessage =
            "Please wait until all images finish uploading.";

        return;
    }

    if (isSaving ||
        isSubmitting)
    {
        return;
    }

    errorMessage = null;
    successMessage = null;


    if (!ValidateContactInformation(
            forSubmission: true))
    {
        return;
    }


    isSubmitting = true;


    try
    {
        model.CountryID =
            selectedCountryId > 0
                ? selectedCountryId
                : null;

        model.StateID =
            selectedStateId > 0
                ? selectedStateId
                : null;

        model.CityID =
            selectedCityId > 0
                ? selectedCityId
                : null;

        model.AreaID =
            selectedAreaId > 0
                ? selectedAreaId
                : null;


        var updateRequest =
            BuildUpdateRequest();


        var updatedAdvertisement =
            await AdvertisementApiService
                .UpdateAdvertisementAsync(
                    draftAdvertisementId.Value,
                    updateRequest);


        if (updatedAdvertisement is null)
        {
            errorMessage =
                "The latest advertisement changes could not be saved. " +
                "Please try saving the draft first.";

            return;
        }


        var success =
            await AdvertisementApiService
                .SubmitAdvertisementAsync(
                    draftAdvertisementId.Value);


        if (!success)
        {
            errorMessage =
                "The advertisement could not be submitted. " +
                "Please make sure the required information is complete.";

            return;
        }


        successMessage =
    requireAdminApproval
        ? $"Your advertisement has been submitted for approval. " +
          $"Once approved, it will stay live for {expiryDays} days."
        : $"Your advertisement has been submitted. " +
          $"It will stay live for {expiryDays} days.";


        await Task.Delay(1200);


        Navigation.NavigateTo(
            "/my-ads");
    }
    catch (InvalidOperationException ex)
    {
        Console.WriteLine(
            $"SUBMIT VALIDATION ERROR: {ex}");

        errorMessage =
            ex.Message;
    }
    catch (Exception ex)
    {
        Console.WriteLine(
            $"SUBMIT ADVERTISEMENT ERROR: {ex}");

        errorMessage =
            "Unable to submit the advertisement right now. " +
            "Please try again.";
    }
    finally
    {
        isSubmitting = false;
    }
}


// ============================================================
// CANCEL
// ============================================================

private void Cancel()
{
    if (isSaving ||
        isUploadingImages ||
        isSubmitting)
    {
        return;
    }

    Navigation.NavigateTo(
        "/my-ads");
}


// ============================================================
// FILE SIZE
// ============================================================

private static string FormatFileSize(
    long bytes)
{
    if (bytes < 1024)
    {
        return $"{bytes} B";
    }

    if (bytes < 1024 * 1024)
    {
        return $"{bytes / 1024d:0.0} KB";
    }

    return
        $"{bytes / 1024d / 1024d:0.0} MB";
}
