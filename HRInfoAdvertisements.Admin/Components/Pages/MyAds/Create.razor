        {
            <div class="upload-progress-card">

                <div class="upload-progress-top">

                    <div class="upload-progress-icon">

                        <i class="bi bi-cloud-arrow-up"></i>

                    </div>

                    <div class="upload-progress-content">

                        <strong>
                            Uploading your photos
                        </strong>

                        <span>
                            Please keep this page open while
                            the upload completes.
                        </span>

                    </div>

                    <div class="upload-progress-count">

                        @uploadedImageCount
                        /
                        @totalImagesToUpload

                    </div>

                </div>

                <div class="upload-progress-track">

                    <div class="upload-progress-value"
                         style="width:@GetUploadProgressPercentage()%;">

                    </div>

                </div>

            </div>
        }


        <!-- =================================================
             FORM
             ================================================= -->

        <EditForm Model="model"
                  OnSubmit="SaveDraft">

            <DataAnnotationsValidator />


            <!-- =================================================
                 01 BASIC INFORMATION
                 ================================================= -->

            <section class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        01
                    </div>

                    <div class="section-heading-text">

                        <h2>
                            Basic Information
                        </h2>

                        <p>
                            Tell buyers what you are advertising.
                        </p>

                    </div>

                </div>


                <div class="form-grid two-columns">

                    <!-- TYPE -->

                    <div class="form-group">

                        <label>
                            Advertisement Type
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-megaphone input-icon"></i>

                            <InputSelect class="form-control has-icon"
                                         @bind-Value="model.AdvertisementTypeID">

                                <option value="0">
                                    Select advertisement type
                                </option>

                                @foreach (var item in advertisementTypes)
                                {
                                    <option value="@item.ID">
                                        @item.Name
                                    </option>
                                }

                            </InputSelect>

                        </div>

                        <ValidationMessage
                            For="@(() => model.AdvertisementTypeID)" />

                    </div>


                    <!-- CATEGORY -->

                    <div class="form-group">

                        <label>
                            Category
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-tags input-icon"></i>

                            <InputSelect class="form-control has-icon"
                                         @bind-Value="model.CategoryID">

                                <option value="0">
                                    Select category
                                </option>

                                @foreach (var item in categories)
                                {
                                    <option value="@item.ID">
                                        @item.Name
                                    </option>
                                }

                            </InputSelect>

                        </div>

                        <ValidationMessage
                            For="@(() => model.CategoryID)" />

                    </div>

                </div>


                <!-- TITLE -->

                <div class="form-group">

                    <label>
                        Advertisement Title
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-type input-icon"></i>

                        <InputText class="form-control has-icon"
                                   @bind-Value="model.Title"
                                   placeholder="Enter a clear and attractive title" />

                    </div>

                    <ValidationMessage
                        For="@(() => model.Title)" />

                </div>


                <!-- ARABIC TITLE -->

                <div class="form-group">

                    <label>
                        Arabic Title
                    </label>

                    <div class="input-wrapper rtl-wrapper">

                        <InputText class="form-control"
                                   @bind-Value="model.TitleAr"
                                   placeholder="أدخل عنوان الإعلان"
                                   dir="rtl" />

                        <i class="bi bi-translate input-icon-right"></i>

                    </div>

                </div>


                <!-- DESCRIPTION -->

                <div class="form-group">

                    <label>
                        Description
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper textarea-wrapper">

                        <i class="bi bi-card-text textarea-icon"></i>

                        <InputTextArea class="form-control textarea has-icon"
                                       @bind-Value="model.Description"
                                       placeholder="Provide detailed information about your advertisement"
                                       rows="6" />

                    </div>

                    <ValidationMessage
                        For="@(() => model.Description)" />

                </div>


                <!-- ARABIC DESCRIPTION -->

                <div class="form-group">

                    <label>
                        Arabic Description
                    </label>

                    <div class="input-wrapper textarea-wrapper rtl-wrapper">

                        <InputTextArea class="form-control textarea"
                                       @bind-Value="model.DescriptionAr"
                                       placeholder="اكتب وصفاً تفصيلياً للإعلان"
                                       rows="5"
                                       dir="rtl" />

                        <i class="bi bi-translate textarea-icon-right"></i>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 02 PRICING
                 ================================================= -->

            <section class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        02
                    </div>

                    <div class="section-heading-text">

                        <h2>
                            Pricing
                        </h2>

                        <p>
                            Set your asking price and negotiation preference.
                        </p>

                    </div>

                </div>


                <div class="form-grid three-columns">

                    <div class="form-group">

                        <label>
                            Price
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-cash-stack input-icon"></i>

                            <InputNumber class="form-control has-icon"
                                         @bind-Value="model.Price" />

                        </div>

                    </div>


                    <div class="form-group">

                        <label>
                            Currency
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-currency-exchange input-icon"></i>

                            <InputText class="form-control has-icon"
                                       @bind-Value="model.CurrencyCode"
                                       readonly />

                        </div>

                    </div>


                    <div class="form-group checkbox-form-group">

                        <label class="checkbox-label">

                            <InputCheckbox
                                @bind-Value="model.IsNegotiable" />

                            <span class="custom-checkbox">

                                <i class="bi bi-check"></i>

                            </span>

                            <span class="checkbox-text">

                                <strong>
                                    Price is negotiable
                                </strong>

                                <small>
                                    Allow buyers to negotiate
                                </small>

                            </span>

                        </label>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 03 LOCATION
                 ================================================= -->

            <section class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        03
                    </div>

                    <div class="section-heading-text">

                        <h2>
                            Location
                        </h2>

                        <p>
                            Help potential buyers find your advertisement.
                        </p>

                    </div>

                </div>


                <div class="form-grid two-columns">

                    <!-- COUNTRY -->

                    <div class="form-group">

                        <label>
                            Country
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-globe2 input-icon"></i>

                            <InputSelect TValue="int"
                                         class="form-control has-icon"
                                         Value="@selectedCountryId"
                                         ValueChanged="@OnCountryChanged"
                                         ValueExpression="@(() => selectedCountryId)">

                                <option value="0">
                                    Select country
                                </option>

                                @foreach (var item in countries)
                                {
                                    <option value="@item.ID">
                                        @item.Name
                                    </option>
                                }

                            </InputSelect>

                        </div>

                    </div>


                    <!-- STATE -->

                    <div class="form-group">

                        <label>
                            State / Province
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-map input-icon"></i>

                            <InputSelect TValue="int"
                                         class="form-control has-icon"
                                         Value="@selectedStateId"
                                         ValueChanged="@OnStateChanged"
                                         ValueExpression="@(() => selectedStateId)"
                                         disabled="@(selectedCountryId <= 0)">

                                <option value="0">
                                    Select state
                                </option>

                                @foreach (var item in states)
                                {
                                    <option value="@item.ID">
                                        @item.Name
                                    </option>
                                }

                            </InputSelect>

                        </div>

                    </div>


                    <!-- CITY -->

                    <div class="form-group">

                        <label>
                            City
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-buildings input-icon"></i>

                            <InputSelect TValue="int"
                                         class="form-control has-icon"
                                         Value="@selectedCityId"
                                         ValueChanged="@OnCityChanged"
                                         ValueExpression="@(() => selectedCityId)"
                                         disabled="@(selectedCountryId <= 0)">

                                <option value="0">
                                    Select city
                                </option>

                                @foreach (var item in cities)
                                {
                                    <option value="@item.ID">
                                        @item.Name
                                    </option>
                                }

                            </InputSelect>

                        </div>

                    </div>


                    <!-- AREA -->

                    <div class="form-group">

                        <label>
                            Area
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-geo-alt input-icon"></i>

                            <InputSelect class="form-control has-icon"
                                         @bind-Value="selectedAreaId"
                                         disabled="@(selectedCityId <= 0)">

                                <option value="0">
                                    Select area
                                </option>

                                @foreach (var item in areas)
                                {
                                    <option value="@item.ID">
                                        @item.Name
                                    </option>
                                }

                            </InputSelect>

                        </div>

                    </div>

                </div>


                <div class="form-grid two-columns">

                    <div class="form-group">

                        <label>
                            Address
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-signpost-2 input-icon"></i>

                            <InputText class="form-control has-icon"
                                       @bind-Value="model.AddressLine"
                                       placeholder="Building, road or address" />

                        </div>

                    </div>


                    <div class="form-group">

                        <label>
                            Plot Number
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-grid-3x3-gap input-icon"></i>

                            <InputText class="form-control has-icon"
                                       @bind-Value="model.PlotNumber"
                                       placeholder="Optional plot number" />

                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 04 PROPERTY DETAILS
                 ================================================= -->

            <section class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        04
                    </div>

                    <div class="section-heading-text">

                        <h2>
                            Property Details
                        </h2>

                        <p>
                            Add additional information about the property.
                        </p>

                    </div>

                </div>


                <div class="form-grid four-columns">

                    <div class="form-group">

                        <label>
                            Land Area
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-bounding-box input-icon"></i>

                            <InputNumber class="form-control has-icon"
                                         @bind-Value="model.LandArea" />

                        </div>

                        <small class="field-help">

                            <i class="bi bi-info-circle"></i>

                            Square metres

                        </small>

                    </div>


                    <div class="form-group">

                        <label>
                            Built-up Area
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-house input-icon"></i>

                            <InputNumber class="form-control has-icon"
                                         @bind-Value="model.BuiltUpArea" />

                        </div>

                        <small class="field-help">

                            <i class="bi bi-info-circle"></i>

                            Square metres

                        </small>

                    </div>


                    <div class="form-group">

                        <label>
                            Bedrooms
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-door-open input-icon"></i>

                            <InputNumber class="form-control has-icon"
                                         @bind-Value="model.Bedrooms" />

                        </div>

                    </div>


                    <div class="form-group">

                        <label>
                            Bathrooms
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-droplet input-icon"></i>

                            <InputNumber class="form-control has-icon"
                                         @bind-Value="model.Bathrooms" />

                        </div>

                    </div>

                </div>


                <div class="form-grid four-columns">

                    <div class="form-group">

                        <label>
                            Property Age
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-calendar3 input-icon"></i>

                            <InputNumber class="form-control has-icon"
                                         @bind-Value="model.PropertyAge" />

                        </div>

                        <small class="field-help">

                            <i class="bi bi-info-circle"></i>

                            Years

                        </small>

                    </div>

                </div>

            </section>


            <!-- =========================================================
                 05 CONTACT INFORMATION
                 ========================================================= -->

            <section class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        05
                    </div>

                    <div class="section-heading-text">

                        <h2>
                            Contact Information
                        </h2>

                        <p>
                            Choose how interested buyers can contact you.
                        </p>

                    </div>

                </div>


                <div class="contact-intro">

                    <div class="contact-intro-icon">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>

                    <div class="contact-intro-content">

                        <strong>
                            Make it easy for buyers to reach you
                        </strong>

                        <span>
                            Add at least one contact method and choose which
                            details you want to display publicly.
                        </span>

                    </div>

                </div>


                <div class="contact-methods">

                    <!-- WHATSAPP -->

                    <div class="contact-card
                                @(model.ShowWhatsAppToPublic
                                    ? "contact-card-active"
                                    : "")">

                        <div class="contact-card-header">

                            <div class="contact-card-icon whatsapp-icon">

                                <i class="bi bi-whatsapp"></i>

                            </div>

                            <div class="contact-card-title">

                                <div class="contact-card-title-row">

                                    <h3>
                                        WhatsApp
                                    </h3>

                                    @if (model.ShowWhatsAppToPublic)
                                    {
                                        <span class="visibility-badge">

                                            <i class="bi bi-eye-fill"></i>

                                            Public

                                        </span>
                                    }

                                </div>

                                <p>
                                    Let interested buyers contact you directly
                                    through WhatsApp.
                                </p>

                            </div>

                        </div>


                        <div class="contact-card-body">

                            <label class="contact-field-label">
                                WhatsApp Number
                            </label>

                            <div class="contact-input-wrapper">

                                <div class="contact-input-icon">

                                    <i class="bi bi-whatsapp"></i>

                                </div>

                                <InputText
                                    class="form-control contact-input"
                                    @bind-Value="model.WhatsAppNumber"
                                    placeholder="+973 XXXXXXXX"
                                    autocomplete="tel" />

                            </div>


                            <div class="contact-option">

                                <label class="visibility-toggle">

                                    <input
                                        type="checkbox"
                                        @bind="model.ShowWhatsAppToPublic" />

                                    <span class="toggle-slider"></span>

                                </label>


                                <div class="visibility-text">

                                    <strong>
                                        Show WhatsApp to public
                                    </strong>

                                    <span>
                                        Buyers will be able to see this number
                                        on your advertisement.
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="contact-card
                                @(model.ShowEmailToPublic
                                    ? "contact-card-active"
                                    : "")">

                        <div class="contact-card-header">

                            <div class="contact-card-icon email-icon">

                                <i class="bi bi-envelope-fill"></i>

                            </div>

                            <div class="contact-card-title">

                                <div class="contact-card-title-row">

                                    <h3>
                                        Email
                                    </h3>

                                    @if (model.ShowEmailToPublic)
                                    {
                                        <span class="visibility-badge">

                                            <i class="bi bi-eye-fill"></i>

                                            Public

                                        </span>
                                    }

                                </div>

                                <p>
                                    Allow interested buyers to contact you
                                    by email.
                                </p>

                            </div>

                        </div>


                        <div class="contact-card-body">

                            <label class="contact-field-label">
                                Email Address
                            </label>

                            <div class="contact-input-wrapper">

                                <div class="contact-input-icon">

                                    <i class="bi bi-envelope"></i>

                                </div>

                                <InputText
                                    class="form-control contact-input"
                                    @bind-Value="model.ContactEmail"
                                    placeholder="yourname@example.com"
                                    autocomplete="email" />

                            </div>


                            <div class="contact-option">

                                <label class="visibility-toggle">

                                    <input
                                        type="checkbox"
                                        @bind="model.ShowEmailToPublic" />

                                    <span class="toggle-slider"></span>

                                </label>


                                <div class="visibility-text">

                                    <strong>
                                        Show email to public
                                    </strong>

                                    <span>
                                        Buyers will be able to see this email
                                        address on your advertisement.
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- PRIVACY INFORMATION -->

                <div class="contact-privacy-note">

                    <div class="contact-privacy-icon">

                        <i class="bi bi-shield-check"></i>

                    </div>

                    <div class="contact-privacy-content">

                        <strong>
                            Your privacy is in your control
                        </strong>

                        <span>
                            Your contact details are stored securely.
                            Only the contact methods you choose to make public
                            will be displayed to other users.
                        </span>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 06 PHOTOS
                 ================================================= -->

            <section class="form-section photos-section">

                <div class="section-heading">

                    <div class="section-number">
                        06
                    </div>

                    <div class="section-heading-text">

                        <h2>
                            Photos & Media
                        </h2>

                        <p>
                            Add clear photos to make your advertisement stand out.
                        </p>

                    </div>

                </div>


                <!-- PHOTO SUMMARY -->

                <div class="photo-summary">

                    <div class="photo-summary-icon">

                        <i class="bi bi-images"></i>

                    </div>

                    <div class="photo-summary-content">

                        <strong>
                            Add up to @MaxImages photos
                        </strong>

                        <span>
                            Add clear, high-quality photos.
                            JPG, PNG and WEBP are supported.
                        </span>

                    </div>

                    <div class="photo-counter">

                        <strong>
                            @TotalPhotoCount
                        </strong>

                        <span>
                            / @MaxImages
                        </span>

                    </div>

                </div>


                <!-- UPLOAD -->

                @if (RemainingPhotoSlots > 0)
                {
                    <label class="upload-area">

                        <InputFile class="upload-file-input"
                                   OnChange="HandleImageSelection"
                                   multiple
                                   accept="image/jpeg,image/png,image/webp" />

                        <span class="upload-content">

                            <span class="upload-icon">

                                <i class="bi bi-cloud-arrow-up"></i>

                            </span>

                            <strong>
                                Add photos
                            </strong>

                            <span>
                                Select one or multiple photos
                            </span>

                            <span class="upload-hint">

                                JPG, PNG or WEBP

                                <span class="upload-separator">
                                    •
                                </span>

                                Maximum 10 MB per image

                            </span>

                        </span>

                    </label>
                }
                else
                {
                    <div class="upload-limit-message">

                        <span class="upload-limit-icon">

                            <i class="bi bi-check-lg"></i>

                        </span>

                        <div>

                            <strong>
                                Maximum number of photos selected
                            </strong>

                            <span>
                                You have selected all @MaxImages available
                                photos for this advertisement.
                            </span>

                        </div>

                    </div>
                }


                <!-- PHOTO GALLERY -->

                @if (savedImages.Count > 0 ||
                     selectedImages.Count > 0)
                {
                    <div class="photo-gallery-header">

                        <div class="photo-gallery-title">

                            <strong>
                                Advertisement Photos
                            </strong>

                            <span>
                                @TotalPhotoCount
                                photo@(TotalPhotoCount == 1 ? "" : "s")
                            </span>

                        </div>

                        <small>

                            <i class="bi bi-shield-check"></i>

                            Uploaded photos are saved with your advertisement.

                        </small>

                    </div>


                    <div class="photo-grid">

                        <!-- SAVED -->

                        @foreach (var image in savedImages
                            .OrderByDescending(x => x.IsPrimary)
                            .ThenBy(x => x.DisplayOrder))
                        {
                            <div class="photo-card @(image.IsPrimary ? "is-primary" : "")">

                                <div class="photo-preview">

                                    <img src="@image.FileURL"
                                         alt="@image.FileName"
                                         loading="lazy" />

                                    @if (image.IsPrimary)
                                    {
                                        <span class="primary-badge">

                                            <i class="bi bi-star-fill"></i>

                                            Main Photo

                                        </span>
                                    }

                                </div>

                                <div class="photo-details">

                                    <div class="photo-name"
                                         title="@image.FileName">

                                        <i class="bi bi-image"></i>

                                        <span>
                                            @image.FileName
                                        </span>

                                    </div>

                                    <div class="photo-meta">

                                        @if (image.FileSize.HasValue)
                                        {
                                            <span>
                                                @FormatFileSize(image.FileSize.Value)
                                            </span>
                                        }

                                        <span>
                                            Photo @image.DisplayOrder
                                        </span>

                                    </div>

                                    @if (image.IsPrimary)
                                    {
                                        <div class="primary-label">

                                            <i class="bi bi-check-circle"></i>

                                            Main advertisement photo

                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="make-primary-button"
                                                @onclick="() => SetPrimarySavedImage(image)"
                                                disabled="@IsBusy">

                                            <i class="bi bi-star"></i>

                                            Set as main photo

                                        </button>
                                    }

                                </div>

                            </div>
                        }


                        <!-- NEW -->

                        @foreach (var image in selectedImages)
                        {
                            <div class="photo-card @(image.IsPrimary ? "is-primary" : "")">

                                <div class="photo-preview">

                                    <img src="@image.PreviewUrl"
                                         alt="@image.FileName" />

                                    <span class="uploading-badge">

                                        <i class="bi bi-cloud-check"></i>

                                        Ready to upload

                                    </span>

                                    <button type="button"
                                            class="remove-photo-button"
                                            title="Remove photo"
                                            @onclick="() => RemoveSelectedImage(image)"
                                            disabled="@IsBusy">

                                        <i class="bi bi-x-lg"></i>

                                    </button>

                                </div>

                                <div class="photo-details">

                                    <div class="photo-name"
                                         title="@image.FileName">

                                        <i class="bi bi-image"></i>

                                        <span>
                                            @image.FileName
                                        </span>

                                    </div>

                                    <div class="photo-meta">

                                        <span>
                                            @FormatFileSize(image.FileSize)
                                        </span>

                                        @if (image.Width > 0 &&
                                             image.Height > 0)
                                        {
                                            <span>
                                                @image.Width × @image.Height
                                            </span>
                                        }

                                    </div>

                                    @if (image.IsPrimary)
                                    {
                                        <div class="primary-label">

                                            <i class="bi bi-check-circle"></i>

                                            Main advertisement photo

                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="make-primary-button"
                                                @onclick="() => SetPrimaryImage(image)"
                                                disabled="@IsBusy">

                                            <i class="bi bi-star"></i>

                                            Set as main photo

                                        </button>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="photo-empty-state">

                        <div class="photo-empty-icon">

                            <i class="bi bi-images"></i>

                        </div>

                        <strong>
                            No photos added yet
                        </strong>

                        <span>
                            Add photos to make your advertisement
                            more attractive.
                        </span>

                    </div>
                }

            </section>


            <!-- =================================================
                 ACTIONS
                 ================================================= -->

            <div class="form-actions">

                <button type="button"
                        class="form-button secondary"
                        @onclick="Cancel"
                        disabled="@IsBusy">

                    <i class="bi bi-x-lg"></i>

                    <span>
                        Cancel
                    </span>

                </button>


                <button type="submit"
                        class="form-button draft-button"
                        disabled="@IsBusy">

                    @if (isSaving)
                    {
                        <span class="button-spinner"></span>

                        <span>

                            @if (isUploadingImages)
                            {
                                <text>Uploading images...</text>
                            }
                            else if (isEditMode)
                            {
                                <text>Updating...</text>
                            }
                            else
                            {
                                <text>Saving...</text>
                            }

                        </span>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-check"></i>

                        <span>

                            @(isEditMode
                                ? "Save Changes"
                                : "Save as Draft")

                        </span>
                    }

                </button>


                @if (draftAdvertisementId.HasValue &&
                     !isUploadingImages &&
                     !isSaving)
                {
                    <button type="button"
                            class="form-button submit-button"
                            @onclick="SubmitForApproval"
                            disabled="@isSubmitting">

                        @if (isSubmitting)
                        {
                            <span class="button-spinner"></span>

                            <span>
                                Submitting...
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-send"></i>

                            <span>
    @(requireAdminApproval
        ? "Submit for Approval"
        : "Publish Advertisement")
</span>
                        }

                    </button>
                }

            </div>

        </EditForm>

    </main>

</div>


}

