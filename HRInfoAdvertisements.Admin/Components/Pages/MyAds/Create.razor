    // ============================================================
    // IMAGE SELECTION
    // ============================================================

    private async Task HandleImageSelection(
        InputFileChangeEventArgs e)
    {
        errorMessage = null;
        successMessage = null;

        var availableSlots =
            RemainingPhotoSlots;

        if (availableSlots <= 0)
        {
            errorMessage =
                $"You can upload a maximum of {MaxImages} photos " +
                "for one advertisement.";

            return;
        }

        IReadOnlyList<IBrowserFile> files;

        try
        {
            files =
                e.GetMultipleFiles(
                    availableSlots);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"IMAGE SELECTION ERROR: {ex}");

            errorMessage =
                "We couldn’t read the selected photos. " +
                "Please try selecting them again.";

            return;
        }

        if (files.Count == 0)
        {
            errorMessage =
                "Please select at least one photo.";

            return;
        }

        var addedCount = 0;
        var rejectedCount = 0;

        foreach (var file in files)
        {
            if (file.Size <= 0)
            {
                rejectedCount++;
                continue;
            }

            if (file.Size > MaxImageSize)
            {
                rejectedCount++;

                errorMessage =
                    $"'{file.Name}' was not added because it exceeds " +
                    "the maximum file size of 10 MB.";

                continue;
            }


            if (!IsSupportedImageType(
                    file.ContentType,
                    file.Name))
            {
                rejectedCount++;

                errorMessage =
                    $"'{file.Name}' was not added because it is not " +
                    "a supported image format. Please use JPG, PNG or WEBP.";

                continue;
            }


            var duplicate =
                selectedImages.Any(x =>
                    string.Equals(
                        x.FileName,
                        file.Name,
                        StringComparison.OrdinalIgnoreCase) &&
                    x.FileSize == file.Size);

            if (duplicate)
            {
                rejectedCount++;

                errorMessage =
                    $"'{file.Name}' is already selected.";

                continue;
            }


            try
            {
                await using var browserStream =
                    file.OpenReadStream(
                        maxAllowedSize: MaxImageSize);

                using var memoryStream =
                    new MemoryStream();

                await browserStream.CopyToAsync(
                    memoryStream);

                var bytes =
                    memoryStream.ToArray();


                var mimeType =
                    GetImageMimeType(
                        file.ContentType,
                        file.Name);


                var previewUrl =
                    $"data:{mimeType};base64," +
                    Convert.ToBase64String(bytes);


                var hasExistingPrimary =
                    savedImages.Any(
                        x => x.IsPrimary);

                var hasSelectedPrimary =
                    selectedImages.Any(
                        x => x.IsPrimary);

                var makePrimary =
                    !hasExistingPrimary &&
                    !hasSelectedPrimary &&
                    selectedImages.Count == 0;


                selectedImages.Add(
                    new SelectedImage
                    {
                        FileName =
                            file.Name,

                        ContentType =
                            mimeType,

                        FileBytes =
                            bytes,

                        PreviewUrl =
                            previewUrl,

                        IsPrimary =
                            makePrimary
                    });


                addedCount++;


                Console.WriteLine(
                    "================================================");

                Console.WriteLine(
                    "IMAGE PREPARED SUCCESSFULLY");

                Console.WriteLine(
                    $"FILE NAME: {file.Name}");

                Console.WriteLine(
                    $"FILE SIZE: {file.Size}");

                Console.WriteLine(
                    $"CONTENT TYPE: {mimeType}");

                Console.WriteLine(
                    $"MEMORY SIZE: {bytes.Length}");

                Console.WriteLine(
                    $"PRIMARY: {makePrimary}");

                Console.WriteLine(
                    "================================================");
            }
            catch (Exception ex)
            {
                rejectedCount++;

                Console.WriteLine(
                    $"Unable to prepare image: {file.Name}");

                Console.WriteLine(ex);

                errorMessage =
                    $"We couldn’t prepare '{file.Name}'. " +
                    "Please try selecting the image again.";
            }
        }


        if (addedCount > 0)
        {
            successMessage =
                $"{addedCount} photo" +
                $"{(addedCount == 1 ? "" : "s")} added successfully. " +
                $"{TotalPhotoCount} of {MaxImages} photos are ready.";
        }


        if (rejectedCount > 0 &&
            addedCount == 0 &&
            string.IsNullOrWhiteSpace(errorMessage))
        {
            errorMessage =
                "None of the selected photos could be added. " +
                "Please check the file type and size.";
        }
    }


    // ============================================================
    // MIME TYPE
    // ============================================================

    private static string GetImageMimeType(
        string? contentType,
        string fileName)
    {
        if (!string.IsNullOrWhiteSpace(contentType))
        {
            var normalized =
                contentType
                    .Trim()
                    .ToLowerInvariant();

            if (normalized is
                "image/jpeg" or
                "image/jpg" or
                "image/png" or
                "image/webp")
            {
                return normalized == "image/jpg"
                    ? "image/jpeg"
                    : normalized;
            }
        }

        var extension =
            Path.GetExtension(fileName)
                .ToLowerInvariant();

        return extension switch
        {
            ".jpg" or ".jpeg" =>
                "image/jpeg",

            ".png" =>
                "image/png",

            ".webp" =>
                "image/webp",

            _ =>
                "image/jpeg"
        };
    }


    // ============================================================
    // REMOVE SELECTED IMAGE
    // ============================================================

    private void RemoveSelectedImage(
        SelectedImage image)
    {
        if (isSaving ||
            isUploadingImages)
        {
            return;
        }

        var wasPrimary =
            image.IsPrimary;

        selectedImages.Remove(image);


        if (wasPrimary &&
            !savedImages.Any(x => x.IsPrimary) &&
            selectedImages.Count > 0)
        {
            foreach (var item in selectedImages)
            {
                item.IsPrimary = false;
            }

            selectedImages[0].IsPrimary = true;
        }


        errorMessage = null;

        if (selectedImages.Count == 0)
        {
            successMessage =
                "All newly selected photos have been removed.";
        }
        else
        {
            successMessage =
                $"{selectedImages.Count} photo" +
                $"{(selectedImages.Count == 1 ? "" : "s")} " +
                "ready to upload.";
        }
    }


    // ============================================================
    // LOAD SAVED IMAGES
    // ============================================================

    private async Task LoadSavedImagesAsync(
        long advertisementId)
    {
        try
        {
            Console.WriteLine(
                $"LOADING SAVED IMAGES FOR ADVERTISEMENT: " +
                $"{advertisementId}");


            var advertisement =
                await AdvertisementApiService
                    .GetAdvertisementByIdAsync(
                        advertisementId);


            if (advertisement is null)
            {
                savedImages.Clear();
                return;
            }


            savedImages.Clear();


            if (advertisement.Images is not null)
            {
                foreach (var image in advertisement.Images
                             .OrderBy(x => x.DisplayOrder))
                {
                    if (string.IsNullOrWhiteSpace(
                            image.FileURL))
                    {
                        continue;
                    }

                    savedImages.Add(
                        new SavedAdvertisementImage
                        {
                            AdvertisementImageID =
                                image.AdvertisementImageID,

                            AdvertisementID =
                                image.AdvertisementID,

                            FileName =
                                image.FileName,

                            FileURL =
                                image.FileURL,

                            FileSize =
                                image.FileSize,

                            IsPrimary =
                                image.IsPrimary,

                            DisplayOrder =
                                image.DisplayOrder,

                            CreatedDate =
                                image.CreatedDate
                        });
                }
            }


            Console.WriteLine(
                $"LOAD SAVED IMAGES: " +
                $"{savedImages.Count} image(s) loaded.");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                "================================================");

            Console.WriteLine(
                "LOAD SAVED IMAGES ERROR");

            Console.WriteLine(ex);

            Console.WriteLine(
                "================================================");
        }
    }


