    // ============================================================
    // IMAGE SELECTION
    // ============================================================

    private async Task HandleImageSelection(
        InputFileChangeEventArgs e)
    {
        errorMessage = null;
        successMessage = null;

        var availableSlots =
            RemainingPhotoSlots;

        if (availableSlots <= 0)
        {
            errorMessage =
                $"You can upload a maximum of {MaxImages} photos " +
                "for one advertisement.";

            return;
        }

        IReadOnlyList<IBrowserFile> files;

        try
        {
            files =
                e.GetMultipleFiles(
                    availableSlots);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"IMAGE SELECTION ERROR: {ex}");

            errorMessage =
                "We couldn’t read the selected photos. " +
                "Please try selecting them again.";

            return;
        }

        if (files.Count == 0)
        {
            errorMessage =
                "Please select at least one photo.";

            return;
        }

        var addedCount = 0;
        var rejectedCount = 0;

        foreach (var file in files)
        {
            // ----------------------------------------------------
            // FILE SIZE
            // ----------------------------------------------------

            if (file.Size <= 0)
            {
                rejectedCount++;
                continue;
            }

            if (file.Size > MaxImageSize)
            {
                rejectedCount++;

                errorMessage =
                    $"'{file.Name}' was not added because it exceeds " +
                    "the maximum file size of 10 MB.";

                continue;
            }


            // ----------------------------------------------------
            // FILE TYPE
            // ----------------------------------------------------

            if (!IsSupportedImageType(
                    file.ContentType,
                    file.Name))
            {
                rejectedCount++;

                errorMessage =
                    $"'{file.Name}' was not added because it is not " +
                    "a supported image format. Please use JPG, PNG or WEBP.";

                continue;
            }


            // ----------------------------------------------------
            // DUPLICATE CHECK
            // ----------------------------------------------------

            var duplicate =
                selectedImages.Any(x =>
                    string.Equals(
                        x.FileName,
                        file.Name,
                        StringComparison.OrdinalIgnoreCase) &&
                    x.FileSize == file.Size);

            if (duplicate)
            {
                rejectedCount++;

                errorMessage =
                    $"'{file.Name}' is already selected.";

                continue;
            }


            // ----------------------------------------------------
            // COPY FILE INTO MEMORY
            // ----------------------------------------------------

            try
            {
                await using var browserStream =
                    file.OpenReadStream(
                        maxAllowedSize: MaxImageSize);

                using var memoryStream =
                    new MemoryStream();

                await browserStream.CopyToAsync(
                    memoryStream);

                var bytes =
                    memoryStream.ToArray();


                // ------------------------------------------------
                // MIME TYPE
                // ------------------------------------------------

                var mimeType =
                    GetImageMimeType(
                        file.ContentType,
                        file.Name);


                // ------------------------------------------------
                // PREVIEW
                // ------------------------------------------------

                var previewUrl =
                    $"data:{mimeType};base64," +
                    Convert.ToBase64String(bytes);


                // ------------------------------------------------
                // PRIMARY IMAGE
                // ------------------------------------------------
                //
                // If there is already a saved primary image,
                // don't automatically create another primary.
                //
                // If there is no saved image, the first selected
                // image becomes the primary image.
                //
                // ------------------------------------------------

                var hasExistingPrimary =
                    savedImages.Any(
                        x => x.IsPrimary);

                var hasSelectedPrimary =
                    selectedImages.Any(
                        x => x.IsPrimary);

                var makePrimary =
                    !hasExistingPrimary &&
                    !hasSelectedPrimary &&
                    selectedImages.Count == 0;


                // ------------------------------------------------
                // ADD IMAGE
                // ------------------------------------------------

                selectedImages.Add(
                    new SelectedImage
                    {
                        FileName =
                            file.Name,

                        ContentType =
                            mimeType,

                        FileBytes =
                            bytes,

                        PreviewUrl =
                            previewUrl,

                        IsPrimary =
                            makePrimary
                    });


                addedCount++;


                Console.WriteLine(
                    "================================================");

                Console.WriteLine(
                    "IMAGE PREPARED SUCCESSFULLY");

                Console.WriteLine(
                    $"FILE NAME: {file.Name}");

                Console.WriteLine(
                    $"FILE SIZE: {file.Size}");

                Console.WriteLine(
                    $"CONTENT TYPE: {mimeType}");

                Console.WriteLine(
                    $"MEMORY SIZE: {bytes.Length}");

                Console.WriteLine(
                    $"PRIMARY: {makePrimary}");

                Console.WriteLine(
                    "================================================");
            }
            catch (Exception ex)
            {
                rejectedCount++;

                Console.WriteLine(
                    $"Unable to prepare image: {file.Name}");

                Console.WriteLine(ex);

                errorMessage =
                    $"We couldn’t prepare '{file.Name}'. " +
                    "Please try selecting the image again.";
            }
        }


        // ========================================================
        // USER FEEDBACK
        // ========================================================

        if (addedCount > 0)
        {
            successMessage =
                $"{addedCount} photo" +
                $"{(addedCount == 1 ? "" : "s")} added successfully. " +
                $"{TotalPhotoCount} of {MaxImages} photos are ready.";
        }


        if (rejectedCount > 0 &&
            addedCount == 0 &&
            string.IsNullOrWhiteSpace(errorMessage))
        {
            errorMessage =
                "None of the selected photos could be added. " +
                "Please check the file type and size.";
        }


        // ========================================================
        // DIAGNOSTIC LOG
        // ========================================================

        Console.WriteLine(
            "================================================");

        Console.WriteLine(
            $"SAVED IMAGES: {savedImages.Count}");

        Console.WriteLine(
            $"SELECTED IMAGES: {selectedImages.Count}");

        Console.WriteLine(
            $"TOTAL IMAGES: {TotalPhotoCount}");

        foreach (var image in selectedImages)
        {
            Console.WriteLine(
                $"SELECTED IMAGE: {image.FileName}, " +
                $"SIZE={image.FileSize}, " +
                $"TYPE={image.ContentType}, " +
                $"PRIMARY={image.IsPrimary}");
        }

        Console.WriteLine(
            "================================================");
    }


    // ============================================================
    // MIME TYPE
    // ============================================================

    private static string GetImageMimeType(
        string? contentType,
        string fileName)
    {
        if (!string.IsNullOrWhiteSpace(contentType))
        {
            var normalized =
                contentType
                    .Trim()
                    .ToLowerInvariant();

            if (normalized is
                "image/jpeg" or
                "image/jpg" or
                "image/png" or
                "image/webp")
            {
                return normalized == "image/jpg"
                    ? "image/jpeg"
                    : normalized;
            }
        }

        var extension =
            Path.GetExtension(fileName)
                .ToLowerInvariant();

        return extension switch
        {
            ".jpg" or ".jpeg" =>
                "image/jpeg",

            ".png" =>
                "image/png",

            ".webp" =>
                "image/webp",

            _ =>
                "image/jpeg"
        };
    }


    // ============================================================
    // REMOVE SELECTED IMAGE
    // ============================================================

    private void RemoveSelectedImage(
        SelectedImage image)
    {
        if (isSaving ||
            isUploadingImages)
        {
            return;
        }

        var wasPrimary =
            image.IsPrimary;

        selectedImages.Remove(image);


        // --------------------------------------------------------
        // If the removed image was primary:
        //
        // First use an existing saved primary if available.
        // Otherwise make the first remaining selected image primary.
        // --------------------------------------------------------

        if (wasPrimary &&
            !savedImages.Any(x => x.IsPrimary) &&
            selectedImages.Count > 0)
        {
            foreach (var item in selectedImages)
            {
                item.IsPrimary = false;
            }

            selectedImages[0].IsPrimary = true;
        }


        errorMessage = null;

        if (selectedImages.Count == 0)
        {
            successMessage =
                "All newly selected photos have been removed.";
        }
        else
        {
            successMessage =
                $"{selectedImages.Count} photo" +
                $"{(selectedImages.Count == 1 ? "" : "s")} " +
                "ready to upload.";
        }
    }


    // ============================================================
    // LOAD SAVED IMAGES
    // ============================================================

    private async Task LoadSavedImagesAsync(
        long advertisementId)
    {
        try
        {
            Console.WriteLine(
                $"LOADING SAVED IMAGES FOR ADVERTISEMENT: " +
                $"{advertisementId}");


            var advertisement =
                await AdvertisementApiService
                    .GetAdvertisementByIdAsync(
                        advertisementId);


            if (advertisement is null)
            {
                Console.WriteLine(
                    "LOAD SAVED IMAGES: Advertisement not found.");

                savedImages.Clear();

                return;
            }


            savedImages.Clear();


            if (advertisement.Images is not null)
            {
                foreach (var image in advertisement.Images
                             .OrderBy(x => x.DisplayOrder))
                {
                    if (string.IsNullOrWhiteSpace(
                            image.FileURL))
                    {
                        continue;
                    }

                    savedImages.Add(
                        new SavedAdvertisementImage
                        {
                            AdvertisementImageID =
                                image.AdvertisementImageID,

                            AdvertisementID =
                                image.AdvertisementID,

                            FileName =
                                image.FileName,

                            FileURL =
                                image.FileURL,

                            FileSize =
                                image.FileSize,

                            IsPrimary =
                                image.IsPrimary,

                            DisplayOrder =
                                image.DisplayOrder,

                            CreatedDate =
                                image.CreatedDate
                        });
                }
            }


            Console.WriteLine(
                $"LOAD SAVED IMAGES: " +
                $"{savedImages.Count} image(s) loaded.");


            foreach (var image in savedImages)
            {
                Console.WriteLine(
                    $"IMAGE {image.AdvertisementImageID}: " +
                    $"{image.FileName}, " +
                    $"Primary={image.IsPrimary}, " +
                    $"Order={image.DisplayOrder}, " +
                    $"URL={image.FileURL}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                "================================================");

            Console.WriteLine(
                "LOAD SAVED IMAGES ERROR");

            Console.WriteLine(ex);

            Console.WriteLine(
                "================================================");

            // Don't block the advertisement page if image
            // loading fails. The advertisement itself was saved.
        }
    }


    // ============================================================
    // SET PRIMARY IMAGE
    // ============================================================

    private void SetPrimaryImage(
    SelectedImage image)
{
    if (IsBusy)
    {
        return;
    }

    // If a saved image is currently primary,
    // the new selection cannot become primary until
    // the saved primary is changed through the API.
    if (savedImages.Any(x => x.IsPrimary))
    {
        errorMessage =
            "Please save the advertisement first before changing " +
            "the main photo.";

        return;
    }

    foreach (var item in selectedImages)
    {
        item.IsPrimary = false;
    }

    image.IsPrimary = true;

    errorMessage = null;

    successMessage =
        $"'{image.FileName}' has been selected as the main photo.";
}


    // ============================================================
    // IMAGE TYPE VALIDATION
    // ============================================================

    private static bool IsSupportedImageType(
        string? contentType,
        string fileName)
    {
        if (!string.IsNullOrWhiteSpace(contentType))
        {
            var normalized =
                contentType
                    .Trim()
                    .ToLowerInvariant();

            if (normalized is
                "image/jpeg" or
                "image/jpg" or
                "image/png" or
                "image/webp")
            {
                return true;
            }
        }


        var extension =
            Path.GetExtension(fileName)
                .ToLowerInvariant();


        return extension is
            ".jpg" or
            ".jpeg" or
            ".png" or
            ".webp";
    }


    // ============================================================
    // SAVE DRAFT
    // ============================================================

    private async Task SaveDraft()
    {
        if (isSaving ||
        isUploadingImages ||
        isSubmitting)
    {
        return;
    }


        errorMessage = null;
        successMessage = null;

        isSaving = true;


        try
        {
            // ----------------------------------------------------
            // LOCATION
            // ----------------------------------------------------

            model.CountryID =
                selectedCountryId > 0
                    ? selectedCountryId
                    : null;

            model.StateID =
                selectedStateId > 0
                    ? selectedStateId
                    : null;

            model.CityID =
                selectedCityId > 0
                    ? selectedCityId
                    : null;

            model.AreaID =
                selectedAreaId > 0
                    ? selectedAreaId
                    : null;


            // ----------------------------------------------------
            // CREATE ADVERTISEMENT
            // ----------------------------------------------------

            Console.WriteLine(
                "================================================");

            Console.WriteLine(
                "CREATING ADVERTISEMENT...");

            Console.WriteLine(
                $"TITLE: {model.Title}");

            Console.WriteLine(
                $"CATEGORY ID: {model.CategoryID}");

            Console.WriteLine(
                $"TYPE ID: {model.AdvertisementTypeID}");

            Console.WriteLine(
                $"SELECTED IMAGE COUNT: {selectedImages.Count}");

            Console.WriteLine(
                "================================================");


            var result =
                await AdvertisementApiService
                    .CreateAdvertisementAsync(
                        model);


            if (result is null)
            {
                errorMessage =
                    "We couldn’t save the advertisement right now. " +
                    "Please review the highlighted fields and try again.";

                return;
            }


            // ----------------------------------------------------
            // SAVE ADVERTISEMENT ID
            // ----------------------------------------------------

            draftAdvertisementId =
                result.AdvertisementID;


            Console.WriteLine(
                "================================================");

            Console.WriteLine(
                "ADVERTISEMENT CREATED SUCCESSFULLY.");

            Console.WriteLine(
                $"ADVERTISEMENT ID: {draftAdvertisementId}");

            Console.WriteLine(
                $"ADVERTISEMENT NUMBER: {result.AdvertisementNumber}");

            Console.WriteLine(
                $"IMAGES TO UPLOAD: {selectedImages.Count}");

            Console.WriteLine(
                "================================================");


            // ----------------------------------------------------
            // UPLOAD IMAGES
            // ----------------------------------------------------

            if (selectedImages.Count > 0)
            {
                await UploadSelectedImagesAsync();
            }
            else
            {
                successMessage =
                    "Advertisement saved successfully as a draft. " +
                    "You can add photos before submitting it for approval.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                "================================================");

            Console.WriteLine(
                "SAVE ADVERTISEMENT ERROR");

            Console.WriteLine(
                ex.ToString());

            Console.WriteLine(
                "================================================");


            errorMessage =
                "We couldn’t save your advertisement right now. " +
                "Please review the information and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }
private async Task SetPrimarySavedImage(
    SavedAdvertisementImage image)
{
    if (IsBusy)
    {
        return;
    }

    if (draftAdvertisementId is null)
    {
        errorMessage =
            "Please save the advertisement before changing the main photo.";

        return;
    }

    if (image.AdvertisementImageID <= 0)
    {
        errorMessage =
            "The selected photo could not be identified.";

        return;
    }

    errorMessage = null;
    successMessage = null;

    try
    {
        isSubmitting = true;

        var success =
            await AdvertisementApiService
                .SetPrimaryImageAsync(
                    draftAdvertisementId.Value,
                    image.AdvertisementImageID);

        if (!success)
        {
            errorMessage =
                "The main photo could not be changed. " +
                "Please try again.";

            return;
        }

        // Update the local state immediately.
        foreach (var savedImage in savedImages)
        {
            savedImage.IsPrimary =
                savedImage.AdvertisementImageID ==
                image.AdvertisementImageID;
        }

        // Any unsaved image can no longer be the primary
        // image because the saved image is now primary.
        foreach (var selectedImage in selectedImages)
        {
            selectedImage.IsPrimary = false;
        }

        successMessage =
            $"'{image.FileName}' is now the main advertisement photo.";
    }
    catch (InvalidOperationException ex)
    {
        Console.WriteLine(
            $"SET PRIMARY IMAGE VALIDATION ERROR: {ex}");

        errorMessage =
            ex.Message;
    }
    catch (Exception ex)
    {
        Console.WriteLine(
            "================================================");

        Console.WriteLine(
            "SET PRIMARY SAVED IMAGE ERROR");

        Console.WriteLine(
            ex.ToString());

        Console.WriteLine(
            "================================================");

        errorMessage =
            "The main photo could not be changed right now. " +
            "Please try again.";
    }
    finally
    {
        isSubmitting = false;
    }
}

    // ============================================================
    // UPLOAD PROGRESS
    // ============================================================

    private int GetUploadProgressPercentage()
    {
        if (totalImagesToUpload <= 0)
        {
            return 0;
        }

        return
            (int)Math.Round(
                uploadedImageCount *
                100d /
                totalImagesToUpload);
    }


    // ============================================================
    // UPLOAD SELECTED IMAGES
    // ============================================================

    private async Task UploadSelectedImagesAsync()
    {
        if (!draftAdvertisementId.HasValue)
        {
            Console.WriteLine(
                "IMAGE UPLOAD SKIPPED: Advertisement ID is missing.");

            return;
        }


        if (selectedImages.Count == 0)
        {
            Console.WriteLine(
                "IMAGE UPLOAD SKIPPED: No images selected.");

            return;
        }


        isUploadingImages = true;

        uploadedImageCount = 0;

        totalImagesToUpload =
            selectedImages.Count;

        errorMessage = null;

        successMessage =
            $"Your advertisement has been saved as a draft. " +
            $"Now uploading {totalImagesToUpload} photo" +
            $"{(totalImagesToUpload == 1 ? "" : "s")}...";


        var failedImages =
            new List<SelectedImage>();


        Console.WriteLine(
            "================================================");

        Console.WriteLine(
            "STARTING IMAGE UPLOAD");

        Console.WriteLine(
            $"ADVERTISEMENT ID: " +
            $"{draftAdvertisementId.Value}");

        Console.WriteLine(
            $"TOTAL IMAGES: {selectedImages.Count}");

        Console.WriteLine(
            "================================================");


        try
        {
            // ----------------------------------------------------
            // IMPORTANT:
            //
            // Create a snapshot.
            //
            // The selectedImages collection can be changed by
            // the UI after upload starts.
            //
            // ----------------------------------------------------

            var imagesToUpload =
                selectedImages.ToList();


            foreach (var selectedImage in imagesToUpload)
            {
                try
                {
                    Console.WriteLine(
                        "================================================");

                    Console.WriteLine(
                        $"UPLOADING: {selectedImage.FileName}");

                    Console.WriteLine(
                        $"SIZE: {selectedImage.FileSize}");

                    Console.WriteLine(
                        $"TYPE: {selectedImage.ContentType}");

                    Console.WriteLine(
                        $"PRIMARY: {selectedImage.IsPrimary}");

                    Console.WriteLine(
                        "================================================");


                    // ------------------------------------------------
                    // IMPORTANT:
                    //
                    // Upload from byte[].
                    //
                    // No IBrowserFile is retained here.
                    //
                    // ------------------------------------------------

                    await using var stream =
                        new MemoryStream(
                            selectedImage.FileBytes,
                            writable: false);


                    var success =
                        await AdvertisementApiService
                            .UploadAdvertisementImageAsync(
                                draftAdvertisementId.Value,
                                stream,
                                selectedImage.FileName,
                                selectedImage.ContentType,
                                selectedImage.IsPrimary);


                    if (success)
                    {
                        uploadedImageCount++;


                        successMessage =
                            $"Uploading photo " +
                            $"{uploadedImageCount} of " +
                            $"{totalImagesToUpload}...";


                        Console.WriteLine(
                            $"IMAGE UPLOAD SUCCESS: " +
                            $"{selectedImage.FileName}");
                    }
                    else
                    {
                        failedImages.Add(
                            selectedImage);

                        Console.WriteLine(
                            $"IMAGE UPLOAD FAILED: " +
                            $"{selectedImage.FileName}");
                    }
                }
                catch (Exception ex)
                {
                    failedImages.Add(
                        selectedImage);

                    Console.WriteLine(
                        "================================================");

                    Console.WriteLine(
                        $"IMAGE UPLOAD FAILED: " +
                        $"{selectedImage.FileName}");

                    Console.WriteLine(
                        ex.ToString());

                    Console.WriteLine(
                        "================================================");
                }


                await InvokeAsync(
                    StateHasChanged);
            }


            // ====================================================
            // ALL IMAGES SUCCESSFULLY UPLOADED
            // ====================================================

            if (failedImages.Count == 0)
            {
                // Reload images from API.
                //
                // This is important because the database now
                // contains the actual image URLs and primary
                // status.
                //

                if (draftAdvertisementId.HasValue)
                {
                    await LoadSavedImagesAsync(
                        draftAdvertisementId.Value);
                }


                successMessage =
                    $"Advertisement saved successfully with " +
                    $"{uploadedImageCount} photo" +
                    $"{(uploadedImageCount == 1 ? "" : "s")}. " +
                    "You can now submit it for approval.";

                errorMessage = null;


                // The temporary browser-selected images
                // are no longer required.
                selectedImages.Clear();
            }


            // ====================================================
            // PARTIAL SUCCESS
            // ====================================================

            else if (uploadedImageCount > 0)
            {
                // Reload successful uploads.

                if (draftAdvertisementId.HasValue)
                {
                    await LoadSavedImagesAsync(
                        draftAdvertisementId.Value);
                }


                successMessage =
                    $"Advertisement saved successfully. " +
                    $"{uploadedImageCount} of " +
                    $"{totalImagesToUpload} photos were uploaded.";


                errorMessage =
                    $"{failedImages.Count} photo" +
                    $"{(failedImages.Count == 1 ? "" : "s")} " +
                    "could not be uploaded. " +
                    "You can retry the remaining photo(s).";


                // Keep only failed images.

                selectedImages.Clear();

                selectedImages.AddRange(
                    failedImages);


                // If the advertisement already has a primary
                // image, don't create another primary.

                if (!savedImages.Any(x => x.IsPrimary))
                {
                    if (!selectedImages.Any(
                            x => x.IsPrimary) &&
                        selectedImages.Count > 0)
                    {
                        selectedImages[0].IsPrimary = true;
                    }
                }
                else
                {
                    foreach (var image in selectedImages)
                    {
                        image.IsPrimary = false;
                    }
                }
            }


            // ====================================================
            // EVERYTHING FAILED
            // ====================================================

            else
            {
                successMessage =
                    "Advertisement saved successfully as a draft.";

                errorMessage =
                    "We couldn’t upload the selected photos. " +
                    "Please try again.";
            }
        }
        finally
        {
            isUploadingImages = false;
        }
    }


    // ============================================================
    // SUBMIT FOR APPROVAL
    // ============================================================

    private async Task SubmitForApproval()
    {
        if (!draftAdvertisementId.HasValue)
        {
            return;
        }


        if (isUploadingImages)
        {
            errorMessage =
                "Please wait until all images finish uploading.";

            return;
        }


        if (isSaving ||
            isSubmitting)
        {
            return;
        }


        errorMessage = null;
        successMessage = null;

        isSubmitting = true;


        try
        {
            var success =
                await AdvertisementApiService
                    .SubmitAdvertisementAsync(
                        draftAdvertisementId.Value);


            if (!success)
            {
                errorMessage =
                    "The advertisement could not be submitted. " +
                    "Please make sure the required information is complete.";

                return;
            }


            successMessage =
                "Your advertisement has been submitted for approval. " +
                "We’ll process it according to the review workflow.";


            await Task.Delay(1200);


            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"SUBMIT ADVERTISEMENT ERROR: {ex}");

            errorMessage =
                "Unable to submit the advertisement right now. " +
                "Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }


    // ============================================================
    // CANCEL
    // ============================================================

    private void Cancel()
    {
        if (isSaving ||
            isUploadingImages ||
            isSubmitting)
        {
            return;
        }


        Navigation.NavigateTo("/");
    }


    // ============================================================
    // FILE SIZE
    // ============================================================

    private static string FormatFileSize(
        long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }


        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:0.0} KB";
        }


        return
            $"{bytes / 1024d / 1024d:0.0} MB";
    }
}