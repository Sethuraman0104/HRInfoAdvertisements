    .visibility-toggle {
        position: relative;

        width: 44px;
        height: 24px;

        flex: 0 0 44px;

        margin: 0;

        cursor: pointer;
    }


    .visibility-toggle input {
        position: absolute;

        opacity: 0;

        width: 0;
        height: 0;
    }


    .toggle-slider {
        position: absolute;

        inset: 0;

        border-radius: 30px;

        background: #d7cece;

        transition:
            background 0.25s ease,
            box-shadow 0.25s ease;
    }


    .toggle-slider::before {
        content: "";

        position: absolute;

        width: 18px;
        height: 18px;

        left: 3px;
        top: 3px;

        border-radius: 50%;

        background: #ffffff;

        box-shadow:
            0 2px 5px rgba(0, 0, 0, 0.18);

        transition:
            transform 0.25s ease;
    }


    .visibility-toggle input:checked
    + .toggle-slider {
        background:
            linear-gradient(
                90deg,
                #663333,
                #cc3333
            );

        box-shadow:
            0 3px 10px rgba(102, 51, 51, 0.20);
