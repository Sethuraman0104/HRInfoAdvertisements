                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- EMAIL                                              -->
        <!-- ================================================= -->

        <div class="contact-card
                    @(model.ShowEmailToPublic
                        ? "contact-card-active"
                        : "")">

            <div class="contact-card-header">

                <div class="contact-card-icon email-icon">
                    <i class="bi bi-envelope-fill"></i>
                </div>

                <div class="contact-card-title">

                    <div class="contact-card-title-row">

                        <h3>
                            Email
                        </h3>

                        @if (model.ShowEmailToPublic)
                        {
                            <span class="visibility-badge">
                                <i class="bi bi-eye-fill"></i>
                                Public
                            </span>
                        }

                    </div>

                    <p>
                        Allow interested buyers to contact you
                        by email.
                    </p>

                </div>

            </div>


            <div class="contact-card-body">

                <label class="contact-field-label">
                    Email Address
                </label>

                <div class="contact-input-wrapper">

                    <div class="contact-input-icon">
                        <i class="bi bi-envelope"></i>
                    </div>

                    <InputText
                        class="form-control contact-input"
                        @bind-Value="model.ContactEmail"
                        placeholder="yourname@example.com"
                        autocomplete="email" />

                </div>


                <div class="contact-option">

                    <label class="visibility-toggle">

                        <input
                            type="checkbox"
                            @bind="model.ShowEmailToPublic" />

                        <span class="toggle-slider"></span>

                    </label>


                    <div class="visibility-text">

                        <strong>
                            Show email to public
                        </strong>

                        <span>
                            Buyers will be able to see this email
                            address on your advertisement.
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- PRIVACY INFORMATION                                    -->
    <!-- ===================================================== -->

    <div class="contact-privacy-note">

        <div class="contact-privacy-icon">
            <i class="bi bi-shield-check"></i>
        </div>

        <div class="contact-privacy-content">

            <strong>
                Your privacy is in your control
            </strong>

            <span>
                Your contact details are stored securely.
                Only the contact methods you choose to make public
                will be displayed to other users.
            </span>

        </div>

    </div>

</section>


                <!-- =================================================
                     06 PHOTOS
                     ================================================= -->

                <section class="form-section photos-section">

                    <div class="section-heading">

                        <div class="section-number">
                            06
                        </div>

                        <div class="section-heading-text">

                            <h2>
                                Photos & Media
                            </h2>

                            <p>
                                Add clear photos to make your advertisement stand out.
                            </p>

                        </div>

                    </div>


                    <!-- PHOTO SUMMARY -->

                    <div class="photo-summary">

                        <div class="photo-summary-icon">

                            <i class="bi bi-images"></i>

                        </div>

                        <div class="photo-summary-content">

                            <strong>
                                Add up to @MaxImages photos
                            </strong>

                            <span>
                                Add clear, high-quality photos.
                                JPG, PNG and WEBP are supported.
                            </span>

                        </div>

                        <div class="photo-counter">

                            <strong>
                                @TotalPhotoCount
                            </strong>

                            <span>
                                / @MaxImages
                            </span>

                        </div>

                    </div>


                    <!-- UPLOAD -->

                    @if (RemainingPhotoSlots > 0)
                    {
                        <label class="upload-area">

                            <InputFile class="upload-file-input"
                                       OnChange="HandleImageSelection"
                                       multiple
                                       accept="image/jpeg,image/png,image/webp" />

                            <span class="upload-content">

                                <span class="upload-icon">

                                    <i class="bi bi-cloud-arrow-up"></i>

                                </span>

                                <strong>
                                    Add photos
                                </strong>

                                <span>
                                    Select one or multiple photos
                                </span>

                                <span class="upload-hint">
                                    JPG, PNG or WEBP
                                    <span class="upload-separator">•</span>
                                    Maximum 10 MB per image
                                </span>

                            </span>

                        </label>
                    }
                    else
                    {
                        <div class="upload-limit-message">

                            <span class="upload-limit-icon">

                                <i class="bi bi-check-lg"></i>

                            </span>

                            <div>

                                <strong>
                                    Maximum number of photos selected
                                </strong>

                                <span>
                                    You have selected all @MaxImages available
                                    photos for this advertisement.
                                </span>

                            </div>

                        </div>
                    }


                    <!-- PHOTO GALLERY -->

                    @if (savedImages.Count > 0 ||
                         selectedImages.Count > 0)
                    {
                        <div class="photo-gallery-header">

                            <div class="photo-gallery-title">

                                <strong>
                                    Advertisement Photos
                                </strong>

                                <span>
                                    @TotalPhotoCount
                                    photo@(TotalPhotoCount == 1 ? "" : "s")
                                </span>

                            </div>

                            <small>
                                <i class="bi bi-shield-check"></i>
                                Uploaded photos are saved with your advertisement.
                            </small>

                        </div>


                        <div class="photo-grid">

                            <!-- SAVED -->

                            @foreach (var image in savedImages
                                .OrderByDescending(x => x.IsPrimary)
                                .ThenBy(x => x.DisplayOrder))
                            {
                                <div class="photo-card @(image.IsPrimary ? "is-primary" : "")">

                                    <div class="photo-preview">

                                        <img src="@image.FileURL"
                                             alt="@image.FileName"
                                             loading="lazy" />

                                        @if (image.IsPrimary)
                                        {
                                            <span class="primary-badge">

                                                <i class="bi bi-star-fill"></i>

                                                Main Photo

                                            </span>
                                        }

                                    </div>

                                    <div class="photo-details">

                                        <div class="photo-name"
                                             title="@image.FileName">

                                            <i class="bi bi-image"></i>

                                            <span>
                                                @image.FileName
                                            </span>

                                        </div>

                                        <div class="photo-meta">

                                            @if (image.FileSize.HasValue)
                                            {
                                                <span>
                                                    @FormatFileSize(image.FileSize.Value)
                                                </span>
                                            }

                                            <span>
                                                Photo @image.DisplayOrder
                                            </span>

                                        </div>

                                        @if (image.IsPrimary)
                                        {
                                            <div class="primary-label">

                                                <i class="bi bi-check-circle"></i>

                                                Main advertisement photo

                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="make-primary-button"
                                                    @onclick="() => SetPrimarySavedImage(image)"
                                                    disabled="@IsBusy">

                                                <i class="bi bi-star"></i>

                                                Set as main photo

                                            </button>
                                        }

                                    </div>

                                </div>
                            }


                            <!-- NEW -->

                            @foreach (var image in selectedImages)
                            {
                                <div class="photo-card @(image.IsPrimary ? "is-primary" : "")">

                                    <div class="photo-preview">

                                        <img src="@image.PreviewUrl"
                                             alt="@image.FileName" />

                                        <span class="uploading-badge">

                                            <i class="bi bi-cloud-check"></i>

                                            Ready to upload

                                        </span>

                                        <button type="button"
                                                class="remove-photo-button"
                                                title="Remove photo"
                                                @onclick="() => RemoveSelectedImage(image)"
                                                disabled="@IsBusy">

                                            <i class="bi bi-x-lg"></i>

                                        </button>

                                    </div>

                                    <div class="photo-details">

                                        <div class="photo-name"
                                             title="@image.FileName">

                                            <i class="bi bi-image"></i>

                                            <span>
                                                @image.FileName
                                            </span>

                                        </div>

                                        <div class="photo-meta">

                                            <span>
                                                @FormatFileSize(image.FileSize)
                                            </span>

                                            @if (image.Width > 0 &&
                                                 image.Height > 0)
                                            {
                                                <span>
                                                    @image.Width × @image.Height
                                                </span>
                                            }

                                        </div>

                                        @if (image.IsPrimary)
                                        {
                                            <div class="primary-label">

                                                <i class="bi bi-check-circle"></i>

                                                Main advertisement photo

                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="make-primary-button"
                                                    @onclick="() => SetPrimaryImage(image)"
                                                    disabled="@IsBusy">

                                                <i class="bi bi-star"></i>

                                                Set as main photo

                                            </button>
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="photo-empty-state">

                            <div class="photo-empty-icon">

                                <i class="bi bi-images"></i>

                            </div>

                            <strong>
                                No photos added yet
                            </strong>

                            <span>
                                Add photos to make your advertisement
                                more attractive.
                            </span>

                        </div>
                    }

                </section>


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div class="form-actions">

                    <button type="button"
                            class="form-button secondary"
                            @onclick="Cancel"
                            disabled="@IsBusy">

                        <i class="bi bi-x-lg"></i>

                        <span>
                            Cancel
                        </span>

                    </button>


                    <button type="submit"
                            class="form-button draft-button"
                            disabled="@IsBusy">

                        @if (isSaving)
                        {
                            <span class="button-spinner"></span>

                            <span>
                                @if (isUploadingImages)
                                {
                                    <text>Uploading images...</text>
                                }
                                else if (isEditMode)
                                {
                                    <text>Updating...</text>
                                }
                                else
                                {
                                    <text>Saving...</text>
                                }
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-check"></i>

                            <span>
                                @(isEditMode
                                    ? "Save Changes"
                                    : "Save as Draft")
                            </span>
                        }

                    </button>


                    @if (draftAdvertisementId.HasValue &&
                         !isUploadingImages &&
                         !isSaving)
                    {
                        <button type="button"
                                class="form-button submit-button"
                                @onclick="SubmitForApproval"
                                disabled="@isSubmitting">

                            @if (isSubmitting)
                            {
                                <span class="button-spinner"></span>

                                <span>
                                    Submitting...
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-send"></i>

                                <span>
                                    Submit for Approval
                                </span>
                            }

                        </button>
                    }

                </div>

            </EditForm>

        </main>

    </div>
}

@code {

    // ============================================================
    // AUTHENTICATION
    // ============================================================

    private bool isAuthenticated;


    // ============================================================
    // EDIT MODE
    // ============================================================

    private bool isEditMode;

    private bool isLoadingAdvertisement;


    // ============================================================
    // FORM MODEL
    // ============================================================

    private CreateAdvertisementRequest model =
        new()
        {
            CurrencyCode = "BHD"
        };


    // ============================================================
    // LOOKUPS
    // ============================================================

    private List<LookupItemResponse> categories =
        new();

    private List<LookupItemResponse> advertisementTypes =
        new();

    private List<LookupItemResponse> countries =
        new();

    private List<LookupItemResponse> states =
        new();

    private List<LookupItemResponse> cities =
        new();

    private List<LookupItemResponse> areas =
        new();


    // ============================================================
    // LOCATION
    // ============================================================

    private int selectedCountryId;

    private int selectedStateId;

    private int selectedCityId;

    private int selectedAreaId;


    // ============================================================
    // IMAGES
    // ============================================================

    private readonly List<SelectedImage> selectedImages =
        new();

    private readonly List<SavedAdvertisementImage> savedImages =
        new();

    private long? draftAdvertisementId;

    private bool isUploadingImages;

    private int uploadedImageCount;

    private int totalImagesToUpload;


    // ============================================================
    // FORM STATE
    // ============================================================

    private bool isSaving;

    private bool isSubmitting;

    private string? errorMessage;

    private string? successMessage;

    private bool showContactValidation;


    // ============================================================
    // BUSY
    // ============================================================

    private bool IsBusy =>
        isSaving ||
        isUploadingImages ||
        isSubmitting ||
        isLoadingAdvertisement;


    // ============================================================
    // CONSTANTS
    // ============================================================

    private const long MaxImageSize =
        10 * 1024 * 1024;

    private const int MaxImages =
        20;


    // ============================================================
    // CONTACT VALIDATION
    // ============================================================

    private bool HasAnyContactInformation =>
        !string.IsNullOrWhiteSpace(model.WhatsAppNumber) ||
        !string.IsNullOrWhiteSpace(model.ContactEmail);


    private bool HasAnyPublicContact =>
        model.ShowWhatsAppToPublic ||
        model.ShowEmailToPublic;


    // ============================================================
    // IMAGE COUNTERS
    // ============================================================

    private int TotalPhotoCount =>
        savedImages.Count +
        selectedImages.Count;


    private int RemainingPhotoSlots =>
        Math.Max(
            0,
            MaxImages - TotalPhotoCount);


    // ============================================================
    // INITIALIZE
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        isAuthenticated =
            authenticationState.User.Identity?.IsAuthenticated == true;

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadLookupsAsync();

        await LoadAdvertisementFromQueryAsync();
    }


    // ============================================================
    // SELECTED IMAGE MODEL
    // ============================================================

    private sealed class SelectedImage
    {
        public string FileName { get; init; } =
            string.Empty;

        public string ContentType { get; init; } =
            string.Empty;

        public byte[] FileBytes { get; init; } =
            Array.Empty<byte>();

        public string PreviewUrl { get; set; } =
            string.Empty;

        public int Width { get; set; }

        public int Height { get; set; }

        public bool IsPrimary { get; set; }

        public long FileSize =>
            FileBytes.LongLength;
    }


    // ============================================================
    // SAVED IMAGE MODEL
    // ============================================================

    private sealed class SavedAdvertisementImage
    {
        public long AdvertisementImageID { get; init; }

        public long AdvertisementID { get; init; }

        public string FileName { get; init; } =
            string.Empty;

        public string FileURL { get; init; } =
            string.Empty;

        public long? FileSize { get; init; }

        public bool IsPrimary { get; set; }

        public int DisplayOrder { get; init; }

        public DateTime CreatedDate { get; init; }
    }


    // ============================================================
    // LOAD LOOKUPS
    // ============================================================

    private async Task LoadLookupsAsync()
    {
        errorMessage = null;

        try
        {
            categories =
                await AdvertisementApiService
                    .GetCategoriesAsync();

            advertisementTypes =
                await AdvertisementApiService
                    .GetAdvertisementTypesAsync();

            countries =
                await AdvertisementApiService
                    .GetCountriesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"LOAD LOOKUPS ERROR: {ex}");

            errorMessage =
                "We couldn’t load the advertisement options. " +
                "Please refresh the page and try again.";
        }
    }


    // ============================================================
    // LOAD EXISTING ADVERTISEMENT
    //
    // Supports:
    //
    // /my-ads/create?id=123
    //
    // This uses the authenticated API method so the owner can
    // receive private contact information.
    // ============================================================

    private async Task LoadAdvertisementFromQueryAsync()
    {
        try
        {
            var uri =
                Navigation.ToAbsoluteUri(
                    Navigation.Uri);

            var query =
                Microsoft.AspNetCore.WebUtilities
                    .QueryHelpers.ParseQuery(uri.Query);

            if (!query.TryGetValue(
                    "id",
                    out var idValue))
            {
                return;
            }

            if (!long.TryParse(
                    idValue.FirstOrDefault(),
                    out var advertisementId) ||
                advertisementId <= 0)
            {
                errorMessage =
                    "The advertisement ID is invalid.";

                return;
            }

            await LoadExistingAdvertisementAsync(
                advertisementId);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"LOAD QUERY PARAMETER ERROR: {ex}");

            errorMessage =
                "We couldn’t load the advertisement.";
        }
    }


    // ============================================================
    // LOAD EXISTING ADVERTISEMENT
    // ============================================================

    private async Task LoadExistingAdvertisementAsync(
        long advertisementId)
    {
        isLoadingAdvertisement = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            Console.WriteLine(
                "================================================");

            Console.WriteLine(
                "LOADING EXISTING ADVERTISEMENT");

            Console.WriteLine(
                $"ADVERTISEMENT ID: {advertisementId}");

            Console.WriteLine(
                "================================================");


            var advertisement =
                await AdvertisementApiService
                    .GetAdvertisementByIdAsync(
                        advertisementId);


            if (advertisement is null)
            {
                errorMessage =
                    "The advertisement could not be found.";

                return;
            }


            draftAdvertisementId =
                advertisement.AdvertisementID;


            isEditMode = true;


            // ----------------------------------------------------
            // BASIC INFORMATION
            // ----------------------------------------------------

            model.CategoryID =
                advertisement.CategoryID;

            model.AdvertisementTypeID =
                advertisement.AdvertisementTypeID;

            model.Title =
                advertisement.Title;

            model.TitleAr =
                advertisement.TitleAr;

            model.Description =
                advertisement.Description;

            model.DescriptionAr =
                advertisement.DescriptionAr;


            // ----------------------------------------------------
            // PRICING
            // ----------------------------------------------------

            model.Price =
                advertisement.Price;

            model.CurrencyCode =
                advertisement.CurrencyCode;

            model.IsNegotiable =
                advertisement.IsNegotiable;


            // ----------------------------------------------------
            // LOCATION
            // ----------------------------------------------------

            model.CountryID =
                advertisement.CountryID;

            model.StateID =
                advertisement.StateID;

            model.CityID =
                advertisement.CityID;

            model.AreaID =
                advertisement.AreaID;

            model.AddressLine =
                advertisement.AddressLine;

            model.PlotNumber =
                advertisement.PlotNumber;


            selectedCountryId =
                advertisement.CountryID ?? 0;

            selectedStateId =
                advertisement.StateID ?? 0;

            selectedCityId =
                advertisement.CityID ?? 0;

            selectedAreaId =
                advertisement.AreaID ?? 0;


            // ----------------------------------------------------
            // PROPERTY DETAILS
            // ----------------------------------------------------

            model.LandArea =
                advertisement.LandArea;

            model.BuiltUpArea =
                advertisement.BuiltUpArea;

            model.Bedrooms =
                advertisement.Bedrooms;

            model.Bathrooms =
                advertisement.Bathrooms;

            model.PropertyAge =
                advertisement.PropertyAge;


            // ----------------------------------------------------
            // CONTACT INFORMATION
            //
            // Because this method uses the authenticated API,
            // the owner receives the actual stored contact
            // values regardless of the public visibility flags.
            // ----------------------------------------------------

            model.WhatsAppNumber =
                advertisement.WhatsAppNumber;

            model.ContactEmail =
                advertisement.ContactEmail;

            model.ShowWhatsAppToPublic =
                advertisement.ShowWhatsAppToPublic;

            model.ShowEmailToPublic =
                advertisement.ShowEmailToPublic;


            // ----------------------------------------------------
            // LOAD LOCATION LOOKUPS
            // ----------------------------------------------------

            await LoadExistingLocationLookupsAsync();


            // ----------------------------------------------------
            // LOAD SAVED IMAGES
            // ----------------------------------------------------

            await LoadSavedImagesAsync(
                advertisement.AdvertisementID);


            Console.WriteLine(
                "EXISTING ADVERTISEMENT LOADED SUCCESSFULLY.");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                "================================================");

            Console.WriteLine(
                "LOAD ADVERTISEMENT ERROR");

            Console.WriteLine(
                ex.ToString());

            Console.WriteLine(
                "================================================");

            errorMessage =
                "We couldn’t load the advertisement information. " +
                "Please try again.";
        }
        finally
        {
            isLoadingAdvertisement = false;
        }
    }


    // ============================================================
    // LOAD LOCATION LOOKUPS FOR EXISTING ADVERTISEMENT
    // ============================================================

    private async Task LoadExistingLocationLookupsAsync()
    {
        try
        {
            states.Clear();
            cities.Clear();
            areas.Clear();


            if (selectedCountryId > 0)
            {
                states =
                    await AdvertisementApiService
                        .GetStatesAsync(
                            selectedCountryId);
            }


            if (selectedCountryId > 0)
            {
                cities =
                    await AdvertisementApiService
                        .GetCitiesAsync(
                            selectedCountryId,
                            selectedStateId > 0
                                ? selectedStateId
                                : null);
            }


            if (selectedCountryId > 0)
            {
                areas =
                    await AdvertisementApiService
                        .GetAreasAsync(
                            selectedCountryId,
                            selectedStateId > 0
                                ? selectedStateId
                                : null,
                            selectedCityId > 0
                                ? selectedCityId
                                : null);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"LOAD EXISTING LOCATION LOOKUPS ERROR: {ex}");
        }
    }


