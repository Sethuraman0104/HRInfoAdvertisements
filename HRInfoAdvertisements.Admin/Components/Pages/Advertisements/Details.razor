    // ============================================================
    // CONTACT
    // ============================================================

    private bool HasPublicWhatsApp =>
        Advertisement is not null &&
        !string.IsNullOrWhiteSpace(
            Advertisement.WhatsAppNumber);


    private bool HasPublicEmail =>
        Advertisement is not null &&
        !string.IsNullOrWhiteSpace(
            Advertisement.ContactEmail);


    private string GetWhatsAppUrl()
    {
        if (Advertisement is null ||
            string.IsNullOrWhiteSpace(
                Advertisement.WhatsAppNumber))
        {
            return "#";
        }

        var number =
            new string(
                Advertisement.WhatsAppNumber
                    .Where(char.IsDigit)
                    .ToArray());

        return $"https://wa.me/{number}";
    }


    private string GetEmailUrl()
    {
        if (Advertisement is null ||
            string.IsNullOrWhiteSpace(
                Advertisement.ContactEmail))
        {
            return "#";
        }

        return $"mailto:{Advertisement.ContactEmail}";
    }


    // ============================================================
    // LOCATION
    // ============================================================

    private bool HasLocation =>
        Advertisement is not null &&
        (
            !string.IsNullOrWhiteSpace(
                Advertisement.CountryName)
            ||
            !string.IsNullOrWhiteSpace(
                Advertisement.StateName)
            ||
            !string.IsNullOrWhiteSpace(
                Advertisement.CityName)
            ||
            !string.IsNullOrWhiteSpace(
                Advertisement.AreaName)
            ||
            !string.IsNullOrWhiteSpace(
                Advertisement.AddressLine)
        );


    private string GetLocationTitle()
    {
        if (Advertisement is null)
        {
            return "Location not specified";
        }

        if (!string.IsNullOrWhiteSpace(
            Advertisement.AreaName))
        {
            return Advertisement.AreaName;
        }

        if (!string.IsNullOrWhiteSpace(
            Advertisement.CityName))
        {
            return Advertisement.CityName;
        }

        if (!string.IsNullOrWhiteSpace(
            Advertisement.StateName))
        {
            return Advertisement.StateName;
        }

        if (!string.IsNullOrWhiteSpace(
            Advertisement.CountryName))
        {
            return Advertisement.CountryName;
        }

        return "Location not specified";
    }


    private string GetLocationDetails()
    {
        if (Advertisement is null)
        {
            return string.Empty;
        }

        var parts =
            new[]
            {
                Advertisement.AreaName,
                Advertisement.CityName,
                Advertisement.StateName,
                Advertisement.CountryName
            }
            .Where(x =>
                !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .ToList();

        return string.Join(
            ", ",
            parts);
    }


    private string GetShortLocation(
        AdvertisementResponse advertisement)
    {
        var location =
            new[]
            {
                advertisement.AreaName,
                advertisement.CityName,
                advertisement.StateName
            }
            .Where(x =>
                !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .ToList();

        if (location.Count == 0)
        {
            return "Location not specified";
        }

        return string.Join(
            ", ",
            location.Take(2));
    }


