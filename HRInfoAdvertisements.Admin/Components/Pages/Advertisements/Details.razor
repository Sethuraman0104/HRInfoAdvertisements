    private string GetAdvertisementNumber()
    {
        if (Advertisement is null)
        {
            return string.Empty;
        }

        return !string.IsNullOrWhiteSpace(
            Advertisement.AdvertisementNumber)
            ? Advertisement.AdvertisementNumber
            : Advertisement.AdvertisementID.ToString();
    }


    private string GetCategoryDisplay()
    {
        return !string.IsNullOrWhiteSpace(
            Advertisement?.CategoryName)
            ? Advertisement.CategoryName
            : "Advertisements";
    }


    private static readonly HashSet<string> ThreeDecimalCurrencies =
    new(StringComparer.OrdinalIgnoreCase)
    { "BHD", "KWD", "OMR", "JOD", "TND", "LYD" };

private string FormatPrice(
    AdvertisementResponse advertisement)
{
    if (!advertisement.Price.HasValue)
    {
        return "Price on request";
    }

    var currency =
        string.IsNullOrWhiteSpace(advertisement.CurrencyCode)
            ? defaultCurrency
            : advertisement.CurrencyCode.Trim().ToUpperInvariant();

    var price = advertisement.Price.Value;

    var format =
        price == decimal.Truncate(price)
            ? "N0"
            : ThreeDecimalCurrencies.Contains(currency)
                ? "N3"
                : "N2";

    return $"{currency} {price.ToString(format, CultureInfo.CurrentCulture)}";
}


    private string FormatNumber(
        decimal value)
    {
        return value.ToString(
            "N2",
            CultureInfo.CurrentCulture);
    }


    private string FormatDate(
        DateTime date)
    {
        return date.ToString(
            "dd MMM yyyy");
    }


    private IEnumerable<string>
        GetDescriptionParagraphs()
    {
        if (Advertisement is null ||
            string.IsNullOrWhiteSpace(
                Advertisement.Description))
        {
            return Enumerable.Empty<string>();
        }

        return Advertisement.Description
            .Split(
                new[]
                {
                    "\r\n\r\n",
                    "\n\n"
                },
                StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim());
    }


    private string? GetPrimaryImageUrl(
        AdvertisementResponse advertisement)
    {
        if (advertisement.Images is null ||
            advertisement.Images.Count == 0)
        {
            return null;
        }

        var primary =
            advertisement.Images
                .FirstOrDefault(x =>
                    x.IsPrimary);

        if (primary is not null &&
            !string.IsNullOrWhiteSpace(
                primary.FileURL))
        {
            return primary.FileURL;
        }

        return advertisement.Images
            .OrderBy(x => x.DisplayOrder)
            .Select(x => x.FileURL)
            .FirstOrDefault(x =>
                !string.IsNullOrWhiteSpace(x));
    }
