                    <div>
                        <strong>@_selectedRemovalRequest.AdvertisementTitle</strong>
                        <span>@_selectedRemovalRequest.UserName</span>
                    </div>
                </div>

                <div class="hr-ad-removal-review-grid">
                    <div class="hr-ad-removal-review-item">
                        <span>Advertisement</span>
                        <strong>@_selectedRemovalRequest.AdvertisementNumber</strong>
                    </div>
                    <div class="hr-ad-removal-review-item">
                        <span>Current Status</span>
                        <strong>@_selectedRemovalRequest.AdvertisementStatusName</strong>
                    </div>
                    <div class="hr-ad-removal-review-item">
                        <span>Advertiser</span>
                        <strong>@_selectedRemovalRequest.UserName</strong>
                    </div>
                    <div class="hr-ad-removal-review-item">
                        <span>Requested</span>
                        <strong>@(_selectedRemovalRequest.CreatedDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt"))</strong>
