@page "/admin/advertisements"

@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.Admin
@using HRInfoAdvertisements.Application.DTOs.Settings
@using HRInfoAdvertisements.Application.DTOs.AdvertisementRemoval
@using HRInfoAdvertisements.Application.Interfaces

@inject IAdvertisementModerationService AdvertisementModerationService
@inject AdvertisementApiService AdvertisementApiService
@inject SystemSettingsApiService SystemSettingsApiService
@inject AdminAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@layout HRInfoAdvertisements.Admin.Components.Layout.MainLayout

<PageTitle>Advertisements | @(_applicationSettings?.SiteName ?? "AdMind")</PageTitle>

<div class="hr-ad-management">

    <!-- ========================= HEADER ========================= -->
    <header class="hr-ad-page-header">
        <div class="hr-ad-page-heading">
            <div class="hr-ad-page-icon"><i class="bi bi-megaphone-fill"></i></div>
            <div class="hr-ad-page-heading-text">
                <h1>Advertisements</h1>
                <p>Review new submissions and keep track of every advertisement by status.</p>
            </div>
        </div>

        <button type="button" class="hr-ad-refresh-button" @onclick="RefreshAsync" disabled="@_isLoading">
            <i class="bi @(_isLoading ? "bi-arrow-repeat hr-spin" : "bi-arrow-clockwise")"></i>
            <span>Refresh</span>
        </button>
    </header>

    <!-- ========================= NOTICES ========================= -->
    @if (_applicationSettings is not null && !_applicationSettings.RequireAdminApproval)
    {
        <div class="hr-ad-alert hr-ad-alert-warning">
            <div class="hr-ad-alert-icon"><i class="bi bi-info-circle-fill"></i></div>
            <div class="hr-ad-alert-content">
                <strong>Admin approval is turned off</strong>
                <span>New advertisements may publish without review. You can change this in System Settings.</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="hr-ad-alert hr-ad-alert-success" role="status">
            <div class="hr-ad-alert-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div class="hr-ad-alert-content">
                <strong>Action completed</strong>
                <span>@_successMessage</span>
            </div>
            <button type="button" @onclick="ClearMessages" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="hr-ad-alert hr-ad-alert-error" role="alert">
            <div class="hr-ad-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div class="hr-ad-alert-content">
                <strong>Unable to process request</strong>
                <span>@_errorMessage</span>
            </div>
            <button type="button" @onclick="ClearMessages" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    <!-- ========================= STATUS NAVIGATION ========================= -->
    <nav class="hr-ad-status-nav" aria-label="Advertisement status">

        <div class="hr-ad-group-title">Needs your action</div>
        <div class="hr-ad-queue-grid">
            @foreach (var t in QueueTabs)
            {
                <button type="button"
                        class="hr-ad-tab priority @t.Css @(_tab == t.Tab ? "active" : "")"
                        aria-pressed="@(_tab == t.Tab ? "true" : "false")"
                        @onclick="() => SelectTab(t.Tab)">
                    <span class="hr-ad-tab-icon"><i class="bi @t.Icon"></i></span>
                    <span class="hr-ad-tab-text">
                        <span class="hr-ad-tab-label">@t.Label</span>
                        <small>@t.Hint</small>
                    </span>
                    <strong class="hr-ad-tab-count">@GetTabCount(t.Tab)</strong>
                </button>
            }
        </div>

        <div class="hr-ad-group-title">Track other statuses</div>
        <div class="hr-ad-track-grid">
            @foreach (var t in TrackTabs)
            {
                <button type="button"
                        class="hr-ad-tab track @t.Css @(_tab == t.Tab ? "active" : "")"
                        aria-pressed="@(_tab == t.Tab ? "true" : "false")"
                        @onclick="() => SelectTab(t.Tab)">
                    <span class="hr-ad-tab-icon"><i class="bi @t.Icon"></i></span>
                    <span class="hr-ad-tab-text">
                        <span class="hr-ad-tab-label">@t.Label</span>
                    </span>
                    <strong class="hr-ad-tab-count">@GetTabCount(t.Tab)</strong>
                </button>
            }
        </div>
    </nav>

    <!-- ========================= MAIN PANEL ========================= -->
    <section class="hr-ad-panel">

        <div class="hr-ad-panel-header">
            <div class="hr-ad-panel-title">
                <div class="hr-ad-panel-icon @CurrentTab.Css"><i class="bi @CurrentTab.Icon"></i></div>
                <div>
                    <h2>@CurrentTab.Label</h2>
                    <span>@GetResultDescription()</span>
                </div>
            </div>
        </div>

        @if (_tab == AdTab.Removal)
        {
            <!-- ---------------- REMOVAL REQUESTS ---------------- -->
            <div class="hr-ad-note">
                <i class="bi bi-info-circle-fill"></i>
                <span>
                    These advertisements stay <strong>published</strong> until you review the request.
                    Approving a request removes the advertisement from public listings without deleting it.
                </span>
            </div>

            @if (_pendingRemovalRequests.Count == 0)
            {
                <div class="hr-ad-empty">
                    <div class="hr-ad-empty-icon"><i class="bi bi-person-check"></i></div>
                    <h3>No pending removal requests</h3>
                    <p>When an advertiser asks to remove an advertisement, it will appear here for review.</p>
                </div>
            }
            else
            {
                <div class="hr-ad-list" role="list">
                    <div class="hr-ad-list-head removal" aria-hidden="true">
                        <span>Advertisement</span>
                        <span>Advertiser</span>
                        <span>Reason</span>
                        <span>Requested</span>
                        <span class="end">Action</span>
                    </div>

                    @foreach (var request in PagedRemovalRequests)
                    {
                        <article class="hr-ad-row removal is-pending" @key="request.RemovalRequestID" role="listitem">

                            <div class="hr-ad-cell hr-ad-cell-main">
                                <span class="hr-ad-row-icon"><i class="bi bi-megaphone-fill"></i></span>
                                <div class="hr-ad-stack">
                                    <strong title="@request.AdvertisementTitle">@request.AdvertisementTitle</strong>
                                    <small>@request.AdvertisementNumber</small>
                                </div>
                            </div>

                            <div class="hr-ad-cell" data-label="Advertiser">
                                <div class="hr-ad-user">
                                    <div class="hr-ad-avatar">@GetInitials(request.UserName)</div>
                                    <div class="hr-ad-stack">
                                        <strong>@request.UserName</strong>
                                        @if (!string.IsNullOrWhiteSpace(request.Email))
                                        {
                                            <small>@request.Email</small>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="hr-ad-cell hr-ad-cell-wide" data-label="Reason">
                                @if (string.IsNullOrWhiteSpace(request.Reason))
                                {
                                    <span class="hr-ad-reason empty">No reason provided</span>
                                }
                                else
                                {
                                    <span class="hr-ad-reason" title="@request.Reason">@request.Reason</span>
                                }
                            </div>

                            <div class="hr-ad-cell" data-label="Requested">
                                <div class="hr-ad-stack">
                                    <strong>@request.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</strong>
                                    <small>@GetAgeLabel(request.CreatedDate)</small>
                                </div>
                            </div>

                            <div class="hr-ad-cell hr-ad-cell-actions">
                                <button type="button" class="hr-ad-btn review"
                                        disabled="@IsRemovalRequestProcessing(request.RemovalRequestID)"
                                        @onclick="() => OpenRemovalRequestModal(request)">
                                    @if (IsRemovalRequestProcessing(request.RemovalRequestID))
                                    {
                                        <i class="bi bi-arrow-repeat hr-spin"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-eye-fill"></i>
                                    }
                                    <span>Review</span>
                                </button>
                            </div>
                        </article>
                    }
                </div>

                <Pager @bind-CurrentPage="_removalPage"
                       @bind-PageSize="_removalPageSize"
                       TotalCount="_pendingRemovalRequests.Count"
                       PageSizeOptions="@(new[] { 5, 10, 20 })"
                       Id="removalPageSize" />
            }
        }
        else
        {
            <!-- ---------------- SEARCH / SORT ---------------- -->
            <div class="hr-ad-toolbar">
                <div class="hr-ad-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" @bind="Search" @bind:event="oninput"
                           placeholder="Search by number, title, advertiser or email..." />
                    @if (!string.IsNullOrEmpty(_search))
                    {
                        <button type="button" class="hr-ad-search-clear" @onclick="ClearSearch" aria-label="Clear search">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>

                <div class="hr-ad-toolbar-field">
                    <label for="adSort">Sort by</label>
                    <select id="adSort" @bind="SortBy">
                        <option value="newest">Newest first</option>
                        <option value="oldest">Oldest first</option>
                        <option value="expiry">Expiring soonest</option>
                    </select>
                </div>

                <button type="button" class="hr-ad-reset-button" @onclick="ResetFilters" disabled="@(!HasActiveFilters)">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset</span>
                </button>
            </div>

            <!-- ---------------- CATEGORY BREAKDOWN ---------------- -->
            @if (_categoryChips.Count > 1 || _categoryFilter is not null)
            {
                <div class="hr-ad-chips" role="group" aria-label="Filter by category">
                    <span class="hr-ad-chips-label"><i class="bi bi-tags-fill"></i> Category</span>

                    <button type="button" class="hr-ad-chip @(_categoryFilter is null ? "active" : "")"
                            @onclick="() => SetCategory(null)">
                        All <span>@_searchMatchCount</span>
                    </button>

                    @foreach (var chip in _categoryChips)
                    {
                        <button type="button" class="hr-ad-chip @(_categoryFilter == chip.Name ? "active" : "")"
                                @onclick="() => SetCategory(chip.Name)">
                            @chip.Name <span>@chip.Count</span>
                        </button>
                    }
                </div>
            }

            <!-- ---------------- LIST ---------------- -->
            @if (_isLoading && _allAdvertisements.Count == 0)
            {
                <div class="hr-ad-loading">
                    <div class="hr-ad-loading-spinner"><i class="bi bi-arrow-repeat hr-spin"></i></div>
                    <strong>Loading advertisements...</strong>
                    <span>Please wait while the latest records are retrieved.</span>
                </div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="hr-ad-empty">
                    <div class="hr-ad-empty-icon"><i class="bi @CurrentTab.Icon"></i></div>
                    <h3>@(HasActiveFilters ? "No advertisements match your filters" : GetEmptyTitle())</h3>
                    <p>@(HasActiveFilters ? "Try a different search or category, or clear the filters." : CurrentTab.Hint)</p>
                    @if (HasActiveFilters)
                    {
                        <button type="button" @onclick="ResetFilters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Clear filters
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="hr-ad-list" role="list">
                    <div class="hr-ad-list-head" aria-hidden="true">
                        <span>Advertisement</span>
                        <span>Advertiser</span>
                        <span>Category &amp; price</span>
                        <span>Status</span>
                        <span>Submitted</span>
                        <span class="end">Actions</span>
                    </div>

                    @foreach (var ad in PagedAdvertisements)
                    {
                        <article class="hr-ad-row @(IsPending(ad) ? "is-pending" : "")" @key="ad.AdvertisementID" role="listitem">

                            <div class="hr-ad-cell hr-ad-cell-main">
                                <span class="hr-ad-row-icon"><i class="bi bi-megaphone-fill"></i></span>
                                <div class="hr-ad-stack">
                                    <strong title="@ad.Title">@ad.Title</strong>
                                    <small>@ad.AdvertisementNumber · @ad.AdvertisementTypeName</small>
                                </div>
                            </div>

                            <div class="hr-ad-cell" data-label="Advertiser">
                                <div class="hr-ad-user">
                                    <div class="hr-ad-avatar">@GetInitials(ad.UserName)</div>
                                    <div class="hr-ad-stack">
                                        <strong>@ad.UserName</strong>
                                        @if (!string.IsNullOrWhiteSpace(ad.Email))
                                        {
                                            <small>@ad.Email</small>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="hr-ad-cell" data-label="Category &amp; price">
                                <div class="hr-ad-stack">
                                    <span class="hr-ad-category" title="@CategoryOf(ad)">@CategoryOf(ad)</span>
                                    <span class="hr-ad-price">@FormatPrice(ad.Price, ad.CurrencyCode)</span>
                                </div>
                            </div>

                            <div class="hr-ad-cell" data-label="Status">
                                <div class="hr-ad-stack">
                                    <span class="@GetStatusBadgeClass(ad)">
                                        <span class="hr-ad-status-dot"></span>
                                        @GetStatusDisplayName(ad)
                                    </span>
                                    @if (ShowExpiry(ad))
                                    {
                                        <small class="hr-ad-expiry @GetExpiryClass(ad.ExpiryDate)">@GetExpiryLabel(ad.ExpiryDate)</small>
                                    }
                                </div>
                            </div>

                            <div class="hr-ad-cell" data-label="Submitted">
                                <div class="hr-ad-stack">
                                    <strong>@ad.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</strong>
                                    <small class="@(IsPending(ad) && IsOld(ad.CreatedDate) ? "hr-ad-waiting" : "")">@GetAgeLabel(ad.CreatedDate)</small>
                                </div>
                            </div>

                            <div class="hr-ad-cell hr-ad-cell-actions">

                                <button type="button" class="hr-ad-btn view icon-only" title="View details"
                                        aria-label="View advertisement"
                                        @onclick="() => ViewAdvertisement(ad.AdvertisementID)">
                                    <i class="bi bi-eye-fill"></i>
                                </button>

                                @if (IsPending(ad))
                                {
                                    <button type="button" class="hr-ad-btn approve"
                                            disabled="@IsAdvertisementProcessing(ad.AdvertisementID)"
                                            @onclick="() => OpenApproveModal(ad)">
                                        <i class="bi bi-check-lg"></i><span>Approve</span>
                                    </button>

                                    <button type="button" class="hr-ad-btn reject"
                                            disabled="@IsAdvertisementProcessing(ad.AdvertisementID)"
                                            @onclick="() => OpenRejectModal(ad)">
                                        <i class="bi bi-x-lg"></i><span>Reject</span>
                                    </button>
                                }

                                @if (IsLive(ad))
                                {
                                    <button type="button" class="hr-ad-btn suspend"
                                            disabled="@IsAdvertisementProcessing(ad.AdvertisementID)"
                                            @onclick="() => OpenSuspendModal(ad)">
                                        <i class="bi bi-pause-fill"></i><span>Suspend</span>
                                    </button>
                                }

                                @if (IsSuspended(ad))
                                {
                                    <button type="button" class="hr-ad-btn reactivate"
                                            disabled="@IsAdvertisementProcessing(ad.AdvertisementID)"
                                            @onclick="() => OpenReactivateModal(ad)">
                                        <i class="bi bi-play-fill"></i><span>Reactivate</span>
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>

                <Pager @bind-CurrentPage="_page"
                       @bind-PageSize="_pageSize"
                       TotalCount="_filtered.Count"
                       Id="advertisementPageSize" />
            }
        }

    </section>

</div>


<!-- =============================================================
     MODERATION MODAL
     ============================================================= -->

@if (_showModerationModal)
{
    <div class="hr-ad-modal-backdrop" @onclick="HandleModalBackdropClick">

        <div class="hr-ad-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">

            <div class="hr-ad-modal-header">
                <div class="hr-ad-modal-title">
                    <div class="hr-ad-modal-icon @GetModalIconClass()"><i class="@GetModalIcon()"></i></div>
                    <div>
                        <h3>@GetModalTitle()</h3>
                        <span>@_selectedAdvertisement?.AdvertisementNumber</span>
                    </div>
                </div>

                <button type="button" class="hr-ad-modal-close" disabled="@_isModerationProcessing"
                        @onclick="CloseModerationModal" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="hr-ad-modal-body">

                @if (_selectedAdvertisement is not null)
                {
                    <div class="hr-ad-modal-advertisement">
                        <div class="hr-ad-modal-ad-icon"><i class="bi bi-megaphone-fill"></i></div>
                        <div>
                            <strong>@_selectedAdvertisement.Title</strong>
                            <span>@_selectedAdvertisement.UserName</span>
                        </div>
                    </div>
                }

                @if (_moderationAction == ModerationAction.Reject)
                {
                    <div class="hr-ad-modal-field">
                        <label for="rejectionReason">
                            Rejection reason <span class="hr-ad-required">*</span>
                        </label>

                        <select id="rejectionReason" @bind="_selectedRejectionReasonId" disabled="@_isModerationProcessing">
                            <option value="">Select a rejection reason</option>
                            @foreach (var reason in _rejectionReasons)
                            {
                                if (reason.IsActive)
                                {
                                    <option value="@reason.RejectionReasonID">@reason.ReasonName</option>
                                }
                            }
                        </select>

                        @if (_showValidationMessage && !_selectedRejectionReasonId.HasValue)
                        {
                            <small class="hr-ad-modal-validation">Please select a rejection reason.</small>
                        }
                    </div>
                }

                @if (_moderationAction == ModerationAction.Approve)
                {
                    <div class="hr-ad-modal-field">
                        <label class="hr-ad-field-title">Advertisement promotion</label>

                        <label class="hr-ad-featured-option">
                            <input type="checkbox" @bind="_isFeaturedOnApproval" disabled="@_isModerationProcessing" />
                            <span class="hr-ad-featured-check"><i class="bi bi-star-fill"></i></span>
                            <span class="hr-ad-featured-content">
                                <strong>Feature this advertisement</strong>
                                <small>Display this advertisement as a featured listing until its normal expiry date.</small>
                            </span>
                        </label>
                    </div>
                }

                <div class="hr-ad-modal-field">
                    <label for="moderationComments">
                        Comments
                        @if (_moderationAction != ModerationAction.Suspend)
                        {
                            <span class="hr-ad-optional">Optional</span>
                        }
                    </label>

                    <textarea id="moderationComments" @bind="_moderationComments" disabled="@_isModerationProcessing"
                              rows="4" maxlength="1000" placeholder="@GetCommentsPlaceholder()"></textarea>

                    <div class="hr-ad-character-count">@_moderationComments.Length / 1000</div>
                </div>

                @if (_moderationAction == ModerationAction.Approve)
                {
                    <div class="hr-ad-modal-information approve">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>This advertisement will be approved and made available according to its configured publishing rules.</span>
                    </div>
                }
                else if (_moderationAction == ModerationAction.Reject)
                {
                    <div class="hr-ad-modal-information reject">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>The advertisement will be marked as rejected. The selected reason will be recorded in the moderation history.</span>
                    </div>
                }
                else if (_moderationAction == ModerationAction.Suspend)
                {
                    <div class="hr-ad-modal-information suspend">
                        <i class="bi bi-pause-circle-fill"></i>
                        <span>The advertisement will be suspended and will no longer be available as an active advertisement.</span>
                    </div>
                }
                else if (_moderationAction == ModerationAction.Reactivate)
                {
                    <div class="hr-ad-modal-information reactivate">
                        <i class="bi bi-play-circle-fill"></i>
                        <span>The advertisement will be reactivated.</span>
                    </div>
                }

            </div>

            <div class="hr-ad-modal-footer">
                <button type="button" class="hr-ad-modal-cancel" disabled="@_isModerationProcessing"
                        @onclick="CloseModerationModal">
                    Cancel
                </button>

                <button type="button" class="hr-ad-modal-confirm @GetModalConfirmClass()"
                        disabled="@_isModerationProcessing" @onclick="ExecuteModerationAsync">
                    @if (_isModerationProcessing)
                    {
                        <i class="bi bi-arrow-repeat hr-spin"></i>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <i class="@GetModalIcon()"></i>
                        <span>@GetModalConfirmText()</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


<!-- =============================================================
     REMOVAL REQUEST MODAL
     ============================================================= -->

@if (_showRemovalRequestModal && _selectedRemovalRequest is not null)
{
    <div class="hr-ad-modal-backdrop" @onclick="HandleRemovalModalBackdropClick">

        <div class="hr-ad-modal hr-ad-modal-wide" role="dialog" aria-modal="true" @onclick:stopPropagation="true">

            <div class="hr-ad-modal-header">
                <div class="hr-ad-modal-title">
                    <div class="hr-ad-modal-icon removal"><i class="bi bi-person-dash-fill"></i></div>
                    <div>
                        <h3>Review removal request</h3>
                        <span>@_selectedRemovalRequest.AdvertisementNumber</span>
                    </div>
                </div>

                <button type="button" class="hr-ad-modal-close" disabled="@_isRemovalRequestProcessing"
                        @onclick="CloseRemovalRequestModal" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="hr-ad-modal-body">

                <div class="hr-ad-modal-advertisement">
                    <div class="hr-ad-modal-ad-icon"><i class="bi bi-megaphone-fill"></i></div>
                    <div>
                        <strong>@_selectedRemovalRequest.AdvertisementTitle</strong>
                        <span>@_selectedRemovalRequest.UserName</span>
                    </div>
                </div>

                <div class="hr-ad-removal-review-grid">
                    <div class="hr-ad-removal-review-item">
                        <span>Advertisement</span>
                        <strong>@_selectedRemovalRequest.AdvertisementNumber</strong>
                    </div>
                    <div class="hr-ad-removal-review-item">
                        <span>Current status</span>
                        <strong>@_selectedRemovalRequest.AdvertisementStatusName</strong>
                    </div>
                    <div class="hr-ad-removal-review-item">
                        <span>Advertiser</span>
                        <strong>@_selectedRemovalRequest.UserName</strong>
                    </div>
                    <div class="hr-ad-removal-review-item">
                        <span>Requested</span>
                        <strong>@_selectedRemovalRequest.CreatedDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</strong>
                    </div>
                </div>

                <div class="hr-ad-modal-field">
                    <label class="hr-ad-field-title">Advertiser's reason</label>
                    <div class="hr-ad-removal-reason-box @(string.IsNullOrWhiteSpace(_selectedRemovalRequest.Reason) ? "empty" : "")">
                        @(string.IsNullOrWhiteSpace(_selectedRemovalRequest.Reason)
                            ? "No reason was provided by the advertiser."
                            : _selectedRemovalRequest.Reason)
                    </div>
                </div>

                <div class="hr-ad-modal-information removal">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>
                        If approved, this advertisement changes from <strong>PUBLISHED</strong> to
                        <strong>UNPUBLISHED</strong> and no longer appears in public listings.
                        The advertisement and its history stay in the system.
                    </span>
                </div>

                <div class="hr-ad-modal-field hr-ad-field-spaced">
                    <label for="removalComments">
                        Review comments <span class="hr-ad-optional">Optional</span>
                    </label>

                    <textarea id="removalComments" @bind="_removalRequestComments" disabled="@_isRemovalRequestProcessing"
                              rows="4" maxlength="500" placeholder="Optional comments about your decision..."></textarea>

                    <div class="hr-ad-character-count">@_removalRequestComments.Length / 500</div>
                </div>

            </div>

            <div class="hr-ad-modal-footer">
                <button type="button" class="hr-ad-modal-cancel" disabled="@_isRemovalRequestProcessing"
                        @onclick="CloseRemovalRequestModal">
                    Cancel
                </button>

                <button type="button" class="hr-ad-modal-confirm reject" disabled="@_isRemovalRequestProcessing"
                        @onclick="RejectRemovalRequestAsync">
                    @if (_removalRequestDecision == RemovalRequestDecision.Reject)
                    {
                        <i class="bi bi-arrow-repeat hr-spin"></i>
                        <span>Rejecting...</span>
                    }
                    else
                    {
                        <i class="bi bi-x-lg"></i>
                        <span>Reject request</span>
                    }
                </button>

                <button type="button" class="hr-ad-modal-confirm approve" disabled="@_isRemovalRequestProcessing"
                        @onclick="ApproveRemovalRequestAsync">
                    @if (_removalRequestDecision == RemovalRequestDecision.Approve)
                    {
                        <i class="bi bi-arrow-repeat hr-spin"></i>
                        <span>Approving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>Approve &amp; unpublish</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

@code {

    // =============================================================
    // TABS
    // =============================================================

    private enum AdTab
    {
        Pending,
        Removal,
        Published,
        Expired,
        Rejected,
        Suspended,
        Unpublished,
        All
    }

    private sealed record TabInfo(AdTab Tab, string Label, string Icon, string Css, string Hint);

    private static readonly TabInfo[] QueueTabs =
    {
        new(AdTab.Pending, "Pending review", "bi-hourglass-split", "pending",
            "New advertisements waiting for approval"),

        new(AdTab.Removal, "Removal requests", "bi-person-dash-fill", "removal",
            "Advertisers asking to take an advertisement down")
    };

    private static readonly TabInfo[] TrackTabs =
    {
        new(AdTab.Published,   "Published",          "bi-check-circle-fill", "approved",
            "No live advertisements right now."),

        new(AdTab.Expired,     "Expired",            "bi-calendar-x-fill",   "expired",
            "No advertisements have passed their expiry date."),

        new(AdTab.Rejected,    "Rejected",           "bi-x-circle-fill",     "rejected",
            "No advertisements have been rejected."),

        new(AdTab.Suspended,   "Suspended",          "bi-pause-circle-fill", "suspended",
            "No advertisements are suspended."),

        new(AdTab.Unpublished, "Unpublished",        "bi-eye-slash-fill",    "unpublished",
            "Advertisements whose removal requests are approved appear here."),

        new(AdTab.All,         "All advertisements", "bi-grid-fill",         "all",
            "No advertisements have been submitted yet.")
    };

    private TabInfo CurrentTab =>
        QueueTabs.Concat(TrackTabs).First(x => x.Tab == _tab);

    private AdTab _tab = AdTab.Pending;


    // =============================================================
    // DATA
    // =============================================================

    private const string UnpublishedStatusCode = "UNPUBLISHED";

    private List<AdminAdvertisementListResponse> _allAdvertisements = new();

    private List<AdminAdvertisementListResponse> _filtered = new();

    private List<(string Name, int Count)> _categoryChips = new();

    private Dictionary<AdTab, int> _counts = new();

    private int _searchMatchCount;

    private List<RejectionReasonResponse> _rejectionReasons = new();

    private List<AdminAdvertisementRemovalRequestResponse> _pendingRemovalRequests = new();

    private ApplicationSettings? _applicationSettings;


    // =============================================================
    // FILTER STATE
    // =============================================================

    private string _search = string.Empty;

    private string? _categoryFilter;

    private string _sortBy = "oldest";   // Pending is the default tab: oldest submissions first

    private string Search
    {
        get => _search;
        set
        {
            _search = value ?? string.Empty;
            _page = 1;
            ApplyView();
        }
    }

    private string SortBy
    {
        get => _sortBy;
        set
        {
            _sortBy = value;
            _page = 1;
            ApplyView();
        }
    }

    private string DefaultSort =>
        _tab == AdTab.Pending ? "oldest" : "newest";

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) ||
        _categoryFilter is not null ||
        _sortBy != DefaultSort;


    // =============================================================
    // PAGE STATE
    // =============================================================

    private bool _isLoading;

    private string? _errorMessage;

    private string? _successMessage;

    private int _page = 1;

    private int _pageSize = 10;

    private int _removalPage = 1;

    private int _removalPageSize = 5;

    private IEnumerable<AdminAdvertisementListResponse> PagedAdvertisements =>
        _filtered
            .Skip((_page - 1) * _pageSize)
            .Take(_pageSize);

    private IEnumerable<AdminAdvertisementRemovalRequestResponse> PagedRemovalRequests =>
        _pendingRemovalRequests
            .Skip((_removalPage - 1) * _removalPageSize)
            .Take(_removalPageSize);


    // =============================================================
    // MODERATION STATE
    // =============================================================

    private AdminAdvertisementListResponse? _selectedAdvertisement;

    private ModerationAction _moderationAction = ModerationAction.None;

    private long? _selectedRejectionReasonId;

    private string _moderationComments = string.Empty;

    private bool _showModerationModal;

    private bool _showValidationMessage;

    private bool _isFeaturedOnApproval;

    private bool _isModerationProcessing;

    private AdminAdvertisementRemovalRequestResponse? _selectedRemovalRequest;

    private bool _showRemovalRequestModal;

    private bool _isRemovalRequestProcessing;

    private string _removalRequestComments = string.Empty;

    private RemovalRequestDecision _removalRequestDecision = RemovalRequestDecision.None;


    // =============================================================
    // INITIALIZATION / LOAD
    // =============================================================

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadApplicationSettingsAsync(),
            LoadPendingRemovalRequestsAsync(),
            LoadAdvertisementsAsync());
    }

    private async Task LoadApplicationSettingsAsync()
    {
        try
        {
            _applicationSettings =
                await SystemSettingsApiService
                    .GetApplicationSettingsAsync();
        }
        catch (Exception ex)
        {
            _applicationSettings = null;

            Console.WriteLine(
                $"[Admin Advertisements] Settings error: {ex.Message}");
        }
    }

    private async Task LoadPendingRemovalRequestsAsync()
    {
        try
        {
            _pendingRemovalRequests =
                await AdvertisementApiService
                    .GetPendingAdvertisementRemovalRequestsAsync()
                ?? new List<AdminAdvertisementRemovalRequestResponse>();
        }
        catch (Exception ex)
        {
            _pendingRemovalRequests = new();

            Console.WriteLine(
                $"[Admin Advertisements] Removal request error: {ex.Message}");
        }

        var totalPages =
            Math.Max(1,
                (int)Math.Ceiling(
                    _pendingRemovalRequests.Count /
                    (double)_removalPageSize));

        if (_removalPage > totalPages)
        {
            _removalPage = totalPages;
        }
    }

    // Loads every advertisement once. Tabs, counts, search, category
    // and sorting are all applied in memory, so switching is instant.
    private async Task LoadAdvertisementsAsync()
    {
        if (_isLoading)
        {
            return;
        }

        try
        {
            _isLoading = true;
            _errorMessage = null;

            var list =
                (await AdvertisementModerationService
                    .GetAdvertisementsAsync(
                        statusCode: null,
                        search: null,
                        pageNumber: 1,
                        pageSize: 500)
                ?? new List<AdminAdvertisementListResponse>())
                .ToList();

            // Some APIs leave unpublished advertisements out of the
            // unfiltered list, so make sure they are always included.
            if (!list.Any(a => HasStatus(a, UnpublishedStatusCode)))
            {
                try
                {
                    var unpublished =
                        await AdvertisementModerationService
                            .GetAdvertisementsAsync(
                                statusCode: UnpublishedStatusCode,
                                search: null,
                                pageNumber: 1,
                                pageSize: 500)
                        ?? new List<AdminAdvertisementListResponse>();

                    var knownIds =
                        list.Select(a => a.AdvertisementID).ToHashSet();

                    list.AddRange(
                        unpublished.Where(
                            u => !knownIds.Contains(u.AdvertisementID)));
                }
                catch (Exception ex)
                {
                    Console.WriteLine(
                        $"[Admin Advertisements] Unpublished load error: {ex.Message}");
                }
            }

            _allAdvertisements = list;

            ApplyView();
        }
        catch (Exception ex)
        {
            _allAdvertisements = new();
            _filtered = new();

            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        await Task.WhenAll(
            LoadPendingRemovalRequestsAsync(),
            LoadAdvertisementsAsync());
    }


    // =============================================================
    // VIEW (tab + search + category + sort)
    // =============================================================

    private void ApplyView()
    {
        // Counts for every status tab
        var counts = new Dictionary<AdTab, int>();

        foreach (var info in QueueTabs.Concat(TrackTabs))
        {
            if (info.Tab == AdTab.Removal)
            {
                continue;
            }

            counts[info.Tab] =
                _allAdvertisements.Count(a => InTab(a, info.Tab));
        }

        _counts = counts;

        // Current tab + search
        var query = _search.Trim();

        var tabItems =
            _allAdvertisements
                .Where(a => InTab(a, _tab))
                .Where(a => query.Length == 0 || MatchesSearch(a, query))
                .ToList();

        _searchMatchCount = tabItems.Count;

        // Category breakdown (before the category filter is applied)
        _categoryChips =
            tabItems
                .GroupBy(CategoryOf)
                .Select(g => (Name: g.Key, Count: g.Count()))
                .OrderByDescending(c => c.Count)
                .ThenBy(c => c.Name)
                .ToList();

        if (_categoryFilter is not null &&
            !_categoryChips.Any(c => c.Name == _categoryFilter))
        {
            _categoryFilter = null;
        }

        IEnumerable<AdminAdvertisementListResponse> result = tabItems;

        if (_categoryFilter is not null)
        {
            result = result.Where(a => CategoryOf(a) == _categoryFilter);
        }

        _filtered =
            (_sortBy switch
            {
                "oldest" => result.OrderBy(a => a.CreatedDate),
                "expiry" => result.OrderBy(a => a.ExpiryDate ?? DateTime.MaxValue),
                _ => result.OrderByDescending(a => a.CreatedDate)
            }).ToList();

        var totalPages =
            Math.Max(1,
                (int)Math.Ceiling(_filtered.Count / (double)_pageSize));

        if (_page > totalPages)
        {
            _page = totalPages;
        }
    }

    private void SelectTab(AdTab tab)
    {
        _tab = tab;
        _categoryFilter = null;
        _sortBy = DefaultSort;
        _page = 1;
        _removalPage = 1;

        ApplyView();
    }

    private void SetCategory(string? category)
    {
        _categoryFilter = category;
        _page = 1;

        ApplyView();
    }

    private void ClearSearch()
    {
        Search = string.Empty;
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _categoryFilter = null;
        _sortBy = DefaultSort;
        _page = 1;

        ApplyView();
    }

    private int GetTabCount(AdTab tab)
    {
        if (tab == AdTab.Removal)
        {
            return _pendingRemovalRequests.Count;
        }

        return _counts.TryGetValue(tab, out var count) ? count : 0;
    }

    private bool InTab(AdminAdvertisementListResponse ad, AdTab tab)
    {
        return tab switch
        {
            AdTab.Pending     => HasStatus(ad, "PENDING_REVIEW"),
            AdTab.Published   => HasStatus(ad, "PUBLISHED") && !IsExpired(ad),
            AdTab.Expired     => IsExpired(ad),
            AdTab.Rejected    => HasStatus(ad, "REJECTED"),
            AdTab.Suspended   => HasStatus(ad, "SUSPENDED"),
            AdTab.Unpublished => HasStatus(ad, UnpublishedStatusCode),
            AdTab.All         => true,
            _                 => false
        };
    }

    private static bool MatchesSearch(
        AdminAdvertisementListResponse ad,
        string query)
    {
        return ContainsText(ad.AdvertisementNumber, query) ||
               ContainsText(ad.Title, query) ||
               ContainsText(ad.UserName, query) ||
               ContainsText(ad.Email, query) ||
               ContainsText(ad.CategoryName, query);
    }

    private static bool ContainsText(string? value, string query)
    {
        return value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
    }

    private static string CategoryOf(AdminAdvertisementListResponse ad)
    {
        return string.IsNullOrWhiteSpace(ad.CategoryName)
            ? "Uncategorized"
            : ad.CategoryName.Trim();
    }


    // =============================================================
    // STATUS HELPERS
    // =============================================================

    private static bool HasStatus(
        AdminAdvertisementListResponse ad,
        string code)
    {
        return string.Equals(
            ad.StatusCode,
            code,
            StringComparison.OrdinalIgnoreCase);
    }

    // Expired = explicit EXPIRED status, or a PUBLISHED advertisement
    // whose expiry date has already passed.
    private static bool IsExpired(AdminAdvertisementListResponse ad)
    {
        return HasStatus(ad, "EXPIRED") ||
               (HasStatus(ad, "PUBLISHED") &&
                ad.ExpiryDate.HasValue &&
                ad.ExpiryDate.Value.Date < DateTime.Today);
    }

    private static bool IsPending(AdminAdvertisementListResponse ad)
        => HasStatus(ad, "PENDING_REVIEW");

    private static bool IsLive(AdminAdvertisementListResponse ad)
        => HasStatus(ad, "PUBLISHED") && !IsExpired(ad);

    private static bool IsSuspended(AdminAdvertisementListResponse ad)
        => HasStatus(ad, "SUSPENDED");

    private static string GetStatusBadgeClass(AdminAdvertisementListResponse ad)
    {
        if (IsExpired(ad))
        {
            return "hr-ad-status expired";
        }

        return ad.StatusCode?.Trim().ToUpperInvariant() switch
        {
            "PENDING_REVIEW" => "hr-ad-status pending",
            "PUBLISHED"      => "hr-ad-status approved",
            "REJECTED"       => "hr-ad-status rejected",
            "SUSPENDED"      => "hr-ad-status suspended",
            "DRAFT"          => "hr-ad-status draft",
            "UNPUBLISHED"    => "hr-ad-status unpublished",
            _                => "hr-ad-status"
        };
    }

    private static string GetStatusDisplayName(AdminAdvertisementListResponse ad)
    {
        if (IsExpired(ad))
        {
            return "Expired";
        }

        if (!string.IsNullOrWhiteSpace(ad.StatusName))
        {
            return ad.StatusName;
        }

        return ad.StatusCode switch
        {
            "PENDING_REVIEW" => "Pending review",
            "PUBLISHED"      => "Published",
            "REJECTED"       => "Rejected",
            "SUSPENDED"      => "Suspended",
            "DRAFT"          => "Draft",
            "UNPUBLISHED"    => "Unpublished",
            _                => ad.StatusCode ?? "Unknown"
        };
    }

    private string GetEmptyTitle()
    {
        return _tab switch
        {
            AdTab.Pending     => "Nothing waiting for review",
            AdTab.Published   => "No published advertisements",
            AdTab.Expired     => "No expired advertisements",
            AdTab.Rejected    => "No rejected advertisements",
            AdTab.Suspended   => "No suspended advertisements",
            AdTab.Unpublished => "No unpublished advertisements",
            _                 => "No advertisements found"
        };
    }

    private string GetResultDescription()
    {
        if (_tab == AdTab.Removal)
        {
            return _pendingRemovalRequests.Count == 1
                ? "1 request waiting for review"
                : $"{_pendingRemovalRequests.Count} requests waiting for review";
        }

        if (_filtered.Count == 0)
        {
            return "0 advertisements";
        }

        var first = ((_page - 1) * _pageSize) + 1;
        var last = Math.Min(_page * _pageSize, _filtered.Count);

        return $"Showing {first}–{last} of {_filtered.Count}";
    }


    // =============================================================
    // DATE / FORMAT HELPERS
    // =============================================================

    private static bool ShowExpiry(AdminAdvertisementListResponse ad)
    {
        return ad.ExpiryDate.HasValue && (IsLive(ad) || IsExpired(ad));
    }

    private static string GetExpiryLabel(DateTime? expiryDate)
    {
        if (!expiryDate.HasValue)
            return "No expiry date";

        var days = (expiryDate.Value.Date - DateTime.Today).Days;

        if (days < 0)
            return $"Expired {Math.Abs(days)} day(s) ago";

        if (days == 0)
            return "Expires today";

        if (days <= 7)
            return $"Expires in {days} day(s)";

        return $"Expires {expiryDate.Value:dd MMM yyyy}";
    }

    private static string GetExpiryClass(DateTime? expiryDate)
    {
        if (!expiryDate.HasValue)
            return string.Empty;

        var days = (expiryDate.Value.Date - DateTime.Today).Days;

        if (days < 0)
            return "danger";

        return days <= 3 ? "warn" : string.Empty;
    }

    private static int GetAgeInDays(DateTime date)
    {
        return Math.Max(0, (DateTime.Today - date.ToLocalTime().Date).Days);
    }

    private static string GetAgeLabel(DateTime date)
    {
        var days = GetAgeInDays(date);

        return days switch
        {
            0 => "Today",
            1 => "1 day ago",
            _ => $"{days} days ago"
        };
    }

    private static bool IsOld(DateTime date) => GetAgeInDays(date) >= 3;

    private static readonly HashSet<string> ThreeDecimalCurrencies =
        new(StringComparer.OrdinalIgnoreCase)
        { "BHD", "KWD", "OMR", "JOD", "TND", "LYD" };

    private string FormatPrice(decimal? price, string? currency)
    {
        if (!price.HasValue)
        {
            return "—";
        }

        var currencyCode =
            !string.IsNullOrWhiteSpace(currency)
                ? currency.Trim().ToUpperInvariant()
                : _applicationSettings?.DefaultCurrency ?? "INR";

        var format =
            ThreeDecimalCurrencies.Contains(currencyCode)
                ? "N3"
                : "N2";

        return $"{price.Value.ToString(format)} {currencyCode}";
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts =
            name.Trim()
                .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0]
                .Substring(0, Math.Min(2, parts[0].Length))
                .ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }


    // =============================================================
    // NAVIGATION
    // =============================================================

    private void ViewAdvertisement(long advertisementId)
    {
        Navigation.NavigateTo($"/admin/advertisements/{advertisementId}");
    }


    // =============================================================
    // MODERATION - OPEN / CLOSE
    // =============================================================

    private void OpenApproveModal(AdminAdvertisementListResponse ad)
        => OpenModerationModal(ad, ModerationAction.Approve);

    private async Task OpenRejectModal(AdminAdvertisementListResponse ad)
    {
        if (!await EnsureRejectionReasonsLoadedAsync())
        {
            return;
        }

        OpenModerationModal(ad, ModerationAction.Reject);
    }

    private void OpenSuspendModal(AdminAdvertisementListResponse ad)
        => OpenModerationModal(ad, ModerationAction.Suspend);

    private void OpenReactivateModal(AdminAdvertisementListResponse ad)
        => OpenModerationModal(ad, ModerationAction.Reactivate);

    private void OpenModerationModal(
        AdminAdvertisementListResponse advertisement,
        ModerationAction action)
    {
        _selectedAdvertisement = advertisement;
        _moderationAction = action;
        _selectedRejectionReasonId = null;
        _moderationComments = string.Empty;
        _isFeaturedOnApproval = false;
        _showValidationMessage = false;
        _errorMessage = null;
        _successMessage = null;
        _showModerationModal = true;
    }

    private void CloseModerationModal()
    {
        _showModerationModal = false;
        _selectedAdvertisement = null;
        _moderationAction = ModerationAction.None;
        _selectedRejectionReasonId = null;
        _moderationComments = string.Empty;
        _isFeaturedOnApproval = false;
        _showValidationMessage = false;
    }

    private async Task<bool> EnsureRejectionReasonsLoadedAsync()
    {
        if (_rejectionReasons.Count > 0)
        {
            return true;
        }

        try
        {
            _errorMessage = null;

            _rejectionReasons =
                await AdvertisementModerationService
                    .GetRejectionReasonsAsync()
                ?? new List<RejectionReasonResponse>();

            if (_rejectionReasons.Count == 0)
            {
                _errorMessage =
                    "No active rejection reasons are configured. Please configure at least one rejection reason before rejecting an advertisement.";

                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            _rejectionReasons = new();

            _errorMessage =
                $"Unable to load rejection reasons: {ex.Message}";

            return false;
        }
    }


    // =============================================================
    // MODERATION - EXECUTE
    // =============================================================

    private async Task ExecuteModerationAsync()
    {
        if (_selectedAdvertisement is null || _isModerationProcessing)
        {
            return;
        }

        if (_moderationAction == ModerationAction.Reject &&
            !_selectedRejectionReasonId.HasValue)
        {
            _showValidationMessage = true;
            return;
        }

        var adminUserId = await GetCurrentAdminUserIdAsync();

        if (!adminUserId.HasValue)
        {
            _errorMessage =
                "The current administrator identity could not be determined. Please sign in again.";

            return;
        }

        try
        {
            _isModerationProcessing = true;
            _errorMessage = null;
            _successMessage = null;

            var advertisementId = _selectedAdvertisement.AdvertisementID;
            var comments = NormalizeComments(_moderationComments);
            var success = false;

            switch (_moderationAction)
            {
                case ModerationAction.Approve:

                    success =
                        await AdvertisementModerationService
                            .ApproveAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                new ApproveAdvertisementRequest
                                {
                                    IsFeatured = _isFeaturedOnApproval,
                                    Comments = comments
                                });
                    break;

                case ModerationAction.Reject:

                    success =
                        await AdvertisementModerationService
                            .RejectAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                new RejectAdvertisementRequest
                                {
                                    RejectionReasonID = _selectedRejectionReasonId,
                                    Comments = comments
                                });
                    break;

                case ModerationAction.Suspend:

                    success =
                        await AdvertisementModerationService
                            .SuspendAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                new SuspendAdvertisementRequest
                                {
                                    Comments = comments
                                });
                    break;

                case ModerationAction.Reactivate:

                    success =
                        await AdvertisementModerationService
                            .ReactivateAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                comments);
                    break;
            }

            if (!success)
            {
                _errorMessage =
                    $"The {GetModalActionName().ToLowerInvariant()} operation was not completed. The advertisement may have changed or the operation may have been rejected by the server.";

                return;
            }

            var actionName = GetModalActionName();
            var advertisementNumber = _selectedAdvertisement.AdvertisementNumber;

            CloseModerationModal();

            _successMessage =
                $"{actionName} completed successfully for advertisement {advertisementNumber}.";

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isModerationProcessing = false;
        }
    }

    private bool IsAdvertisementProcessing(long advertisementId)
    {
        return _isModerationProcessing &&
               _selectedAdvertisement?.AdvertisementID == advertisementId;
    }


    // =============================================================
    // REMOVAL REQUESTS
    // =============================================================

    private void OpenRemovalRequestModal(
        AdminAdvertisementRemovalRequestResponse request)
    {
        _selectedRemovalRequest = request;
        _removalRequestComments = string.Empty;
        _removalRequestDecision = RemovalRequestDecision.None;
        _isRemovalRequestProcessing = false;
        _errorMessage = null;
        _successMessage = null;
        _showRemovalRequestModal = true;
    }

    private void CloseRemovalRequestModal()
    {
        if (_isRemovalRequestProcessing)
        {
            return;
        }

        _showRemovalRequestModal = false;
        _selectedRemovalRequest = null;
        _removalRequestComments = string.Empty;
        _removalRequestDecision = RemovalRequestDecision.None;
    }

    private async Task ApproveRemovalRequestAsync()
    {
        if (_selectedRemovalRequest is null || _isRemovalRequestProcessing)
        {
            return;
        }

        var request = _selectedRemovalRequest;

        try
        {
            _isRemovalRequestProcessing = true;
            _removalRequestDecision = RemovalRequestDecision.Approve;
            _errorMessage = null;
            _successMessage = null;

            var success =
                await AdvertisementApiService
                    .ApproveAdvertisementRemovalRequestAsync(
                        request.RemovalRequestID,
                        NormalizeComments(_removalRequestComments));

            if (!success)
            {
                _errorMessage = "The removal request could not be approved.";
                return;
            }

            _isRemovalRequestProcessing = false;
            CloseRemovalRequestModal();

            _successMessage =
                $"Removal request approved for advertisement {request.AdvertisementNumber}. " +
                "The advertisement has been removed from public listings.";

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isRemovalRequestProcessing = false;
            _removalRequestDecision = RemovalRequestDecision.None;
        }
    }

    private async Task RejectRemovalRequestAsync()
    {
        if (_selectedRemovalRequest is null || _isRemovalRequestProcessing)
        {
            return;
        }

        var request = _selectedRemovalRequest;

        try
        {
            _isRemovalRequestProcessing = true;
            _removalRequestDecision = RemovalRequestDecision.Reject;
            _errorMessage = null;
            _successMessage = null;

            var success =
                await AdvertisementApiService
                    .RejectAdvertisementRemovalRequestAsync(
                        request.RemovalRequestID,
                        NormalizeComments(_removalRequestComments));

            if (!success)
            {
                _errorMessage = "The removal request could not be rejected.";
                return;
            }

            _isRemovalRequestProcessing = false;
            CloseRemovalRequestModal();

            _successMessage =
                $"Removal request rejected for advertisement {request.AdvertisementNumber}. " +
                "The advertisement remains published.";

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isRemovalRequestProcessing = false;
            _removalRequestDecision = RemovalRequestDecision.None;
        }
    }

    private bool IsRemovalRequestProcessing(long removalRequestId)
    {
        return _isRemovalRequestProcessing &&
               _selectedRemovalRequest?.RemovalRequestID == removalRequestId;
    }

    private void HandleRemovalModalBackdropClick(MouseEventArgs _)
    {
        if (!_isRemovalRequestProcessing)
        {
            CloseRemovalRequestModal();
        }
    }


    // =============================================================
    // AUTHENTICATION
    // =============================================================

    private async Task<long?> GetCurrentAdminUserIdAsync()
    {
        var state =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var value =
            state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        return long.TryParse(value, out var userId)
            ? userId
            : null;
    }


