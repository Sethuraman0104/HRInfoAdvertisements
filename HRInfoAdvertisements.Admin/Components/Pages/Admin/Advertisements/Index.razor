                        If approved, this advertisement will be changed from <strong>PUBLISHED</strong> to
                        <strong>UNPUBLISHED</strong> and will no longer appear in public listings.
                        The advertisement and its history will remain in the system.
                    </span>
                </div>

                <div class="hr-ad-modal-field hr-ad-field-spaced">
                    <label for="removalComments">
                        Review Comments <span class="hr-ad-optional">Optional</span>
                    </label>

                    <textarea id="removalComments" @bind="_removalRequestComments" disabled="@_isRemovalRequestProcessing"
                              rows="4" maxlength="500" placeholder="Optional comments about your decision..."></textarea>

                    <div class="hr-ad-character-count">@_removalRequestComments.Length / 500</div>
                </div>

            </div>

            <div class="hr-ad-modal-footer">
                <button type="button" class="hr-ad-modal-cancel" disabled="@_isRemovalRequestProcessing"
                        @onclick="CloseRemovalRequestModal">
                    Cancel
                </button>

                <button type="button" class="hr-ad-modal-confirm reject" disabled="@_isRemovalRequestProcessing"
                        @onclick="RejectRemovalRequestAsync">
                    @if (_removalRequestDecision == RemovalRequestDecision.Reject)
                    {
                        <i class="bi bi-arrow-repeat hr-spin"></i>
                        <span>Rejecting...</span>
                    }
                    else
                    {
                        <i class="bi bi-x-lg"></i>
                        <span>Reject Request</span>
                    }
                </button>

                <button type="button" class="hr-ad-modal-confirm approve" disabled="@_isRemovalRequestProcessing"
                        @onclick="ApproveRemovalRequestAsync">
                    @if (_removalRequestDecision == RemovalRequestDecision.Approve)
                    {
                        <i class="bi bi-arrow-repeat hr-spin"></i>
                        <span>Approving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>Approve &amp; Unpublish</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

@code {

    // =============================================================
    // DATA
    // =============================================================

    private List<AdminAdvertisementListResponse>
        _advertisements = new();

    private List<RejectionReasonResponse>
        _rejectionReasons = new();

    private List<AdminAdvertisementRemovalRequestResponse>
        _pendingRemovalRequests = new();

    // =============================================================
    // FILTERS
    // =============================================================

    private string _searchText = string.Empty;

    private string? _statusFilter;


    // =============================================================
    // PAGE STATE
    // =============================================================

    private bool _isLoading;

    private bool _isModerationProcessing;

    private string? _errorMessage;

    private string? _successMessage;


    // =============================================================
    // MODERATION STATE
    // =============================================================

    private AdminAdvertisementListResponse?
        _selectedAdvertisement;

    private ModerationAction _moderationAction =
        ModerationAction.None;

    private long? _selectedRejectionReasonId;

    private string _moderationComments =
        string.Empty;

    private bool _showModerationModal;

    private bool _showValidationMessage;

    private bool _isFeaturedOnApproval;

    private ApplicationSettings? _applicationSettings;

    private AdminAdvertisementRemovalRequestResponse?
    _selectedRemovalRequest;

    private bool _showRemovalRequestModal;

    private bool _isRemovalRequestProcessing;

    private string _removalRequestComments =
        string.Empty;

    private RemovalRequestDecision
        _removalRequestDecision =
            RemovalRequestDecision.None;

    // =============================================================
    // PAGINATION
    // =============================================================

    private int _currentPage = 1;

    private int _pageSize = 10;

    private int TotalPages =>
        _advertisements.Count == 0
            ? 1
            : (int)Math.Ceiling(
                _advertisements.Count /
                (double)_pageSize);

    private IEnumerable<AdminAdvertisementListResponse>
        PagedAdvertisements =>
            _advertisements
                .Skip((_currentPage - 1) * _pageSize)
                .Take(_pageSize);

    private int FirstDisplayedRecord =>
        _advertisements.Count == 0
            ? 0
            : ((_currentPage - 1) * _pageSize) + 1;

    private int LastDisplayedRecord =>
        Math.Min(
            _currentPage * _pageSize,
            _advertisements.Count);


    // --- Removal requests pagination ---
private int _removalPage = 1;
private int _removalPageSize = 5;
 
private IEnumerable<AdminAdvertisementRemovalRequestResponse> PagedRemovalRequests =>
    _pendingRemovalRequests
        .Skip((_removalPage - 1) * _removalPageSize)
        .Take(_removalPageSize);

    
// --- Unpublished advertisements list ---
private const string UnpublishedStatusCode = "UNPUBLISHED";   // <- change if your status code differs
 
private List<AdminAdvertisementListResponse> _unpublishedAdvertisements = new();
private bool _isUnpublishedLoading;
private string? _unpublishedError;
 
private int _unpublishedPage = 1;
private int _unpublishedPageSize = 10;
 
private IEnumerable<AdminAdvertisementListResponse> PagedUnpublishedAdvertisements =>
    _unpublishedAdvertisements
        .Skip((_unpublishedPage - 1) * _unpublishedPageSize)
        .Take(_unpublishedPageSize);

    // =============================================================
    // INITIALIZATION
    // =============================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadApplicationSettingsAsync();

        await LoadSecondaryListsAsync();

        await LoadAdvertisementsAsync();
    }

    private async Task LoadApplicationSettingsAsync()
    {
        try
        {
            _applicationSettings =
                await SystemSettingsApiService
                    .GetApplicationSettingsAsync();
        }
        catch (Exception ex)
        {
            _applicationSettings = null;

            Console.WriteLine(
                $"[Admin Advertisements] Settings error: {ex.Message}");
        }
    }

    private async Task LoadPendingRemovalRequestsAsync()
{
    try
    {
        _pendingRemovalRequests =
            await AdvertisementApiService
                .GetPendingAdvertisementRemovalRequestsAsync()
            ?? new List<AdminAdvertisementRemovalRequestResponse>();
    }
    catch (Exception ex)
    {
        _pendingRemovalRequests.Clear();
 
        Console.WriteLine(
            $"[Admin Advertisements] Removal request error: {ex.Message}");
    }
 
    var totalPages = Math.Max(1,
        (int)Math.Ceiling(_pendingRemovalRequests.Count / (double)_removalPageSize));
 
    if (_removalPage > totalPages)
    {
        _removalPage = totalPages;
    }
}

private async Task LoadUnpublishedAdvertisementsAsync()
{
    try
    {
        _isUnpublishedLoading = true;
        _unpublishedError = null;
 
        var result =
            await AdvertisementModerationService
                .GetAdvertisementsAsync(
                    statusCode: UnpublishedStatusCode,
                    search: null,
                    pageNumber: 1,
                    pageSize: 500);
 
        _unpublishedAdvertisements =
            result ?? new List<AdminAdvertisementListResponse>();
 
        var totalPages = Math.Max(1,
            (int)Math.Ceiling(_unpublishedAdvertisements.Count / (double)_unpublishedPageSize));
 
        if (_unpublishedPage > totalPages)
        {
            _unpublishedPage = totalPages;
        }
    }
    catch (Exception ex)
    {
        _unpublishedAdvertisements.Clear();
        _unpublishedError = ex.Message;
    }
    finally
    {
        _isUnpublishedLoading = false;
    }
}
 
// Loads both secondary lists (removal requests + unpublished ads)
private async Task LoadSecondaryListsAsync()
{
    await LoadPendingRemovalRequestsAsync();
    await LoadUnpublishedAdvertisementsAsync();
}
    // =============================================================
    // LOAD
    // =============================================================

    private async Task LoadAdvertisementsAsync()
    {
        if (_isLoading)
        {
            return;
        }

        try
        {
            _isLoading = true;

            _errorMessage = null;

            var result =
                await AdvertisementModerationService
                    .GetAdvertisementsAsync(
                        statusCode:
                            string.IsNullOrWhiteSpace(
                                _statusFilter)
                                ? null
                                : _statusFilter.Trim(),

                        search:
                            string.IsNullOrWhiteSpace(
                                _searchText)
                                ? null
                                : _searchText.Trim(),

                        pageNumber: 1,

                        pageSize: 500);

            _advertisements =
                result ??
                new List<AdminAdvertisementListResponse>();
        }
        catch (Exception ex)
        {
            _advertisements.Clear();

            _errorMessage =
                ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }


    // =============================================================
    // FILTER ACTIONS
    // =============================================================

    private async Task ApplyFiltersAsync()
    {
        _currentPage = 1;
        await LoadAdvertisementsAsync();
    }


    private async Task ResetFilters()
    {
        _searchText = string.Empty;

        _statusFilter = null;

        _currentPage = 1;

        await LoadAdvertisementsAsync();
    }


    private async Task ClearSearch()
    {
        _searchText = string.Empty;

        _currentPage = 1;

        await LoadAdvertisementsAsync();
    }


    private async Task HandleSearchKeyDown(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;

            await LoadAdvertisementsAsync();
        }
    }


    private async Task SetStatusFilter(
        string? status)
    {
        _statusFilter = status;

        _currentPage = 1;

        await LoadAdvertisementsAsync();
    }

    private async Task RefreshAdvertisementsAsync()
    {
        _currentPage = 1;

        await LoadSecondaryListsAsync();
        await LoadAdvertisementsAsync();
    }


    // =============================================================
    // SUMMARY
    // =============================================================

    private string GetSummaryClass(
        string? status)
    {
        return string.Equals(
            _statusFilter,
            status,
            StringComparison.OrdinalIgnoreCase)
            ? "selected"
            : string.Empty;
    }


    private int GetStatusCount(
        string statusCode)
    {
        return _advertisements.Count(
            x => string.Equals(
                x.StatusCode,
                statusCode,
                StringComparison.OrdinalIgnoreCase));
    }

    // =============================================================
    // PAGINATION
    // =============================================================

    private void GoToFirstPage()
    {
        if (_currentPage == 1)
        {
            return;
        }

        _currentPage = 1;
    }


    private void GoToPreviousPage()
    {
        if (_currentPage <= 1)
        {
            return;
        }

        _currentPage--;
    }


    private void GoToNextPage()
    {
        if (_currentPage >= TotalPages)
        {
            return;
        }

        _currentPage++;
    }


    private void GoToLastPage()
    {
        if (_currentPage >= TotalPages)
        {
            return;
        }

        _currentPage = TotalPages;
    }


    private void GoToPage(int page)
    {
        if (page < 1)
        {
            page = 1;
        }

        if (page > TotalPages)
        {
            page = TotalPages;
        }

        _currentPage = page;
    }


    private IEnumerable<int> GetPageNumbers()
    {
        const int visiblePages = 5;

        if (TotalPages <= visiblePages)
        {
            return Enumerable.Range(
                1,
                TotalPages);
        }

        var startPage =
            Math.Max(
                1,
                _currentPage - 2);

        var endPage =
            Math.Min(
                TotalPages,
                startPage + visiblePages - 1);

        if (endPage - startPage + 1 < visiblePages)
        {
            startPage =
                Math.Max(
                    1,
                    endPage - visiblePages + 1);
        }

        return Enumerable.Range(
            startPage,
            endPage - startPage + 1);
    }


    private async Task HandlePageSizeChanged(
        ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var pageSize))
        {
            _pageSize = pageSize;
        }
        else
        {
            _pageSize = 10;
        }

        _currentPage = 1;

        await InvokeAsync(StateHasChanged);
    }

    // =============================================================
    // STATUS HELPERS
    // =============================================================

    private static bool IsPending(
