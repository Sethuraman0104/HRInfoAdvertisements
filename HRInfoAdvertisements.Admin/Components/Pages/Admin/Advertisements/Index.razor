    // =============================================================
    // MODERATION - OPEN MODALS
    // =============================================================

    private void OpenApproveModal(
        AdminAdvertisementListResponse advertisement)
    {
        OpenModerationModal(
            advertisement,
            ModerationAction.Approve);
    }


    private async Task OpenRejectModal(
        AdminAdvertisementListResponse advertisement)
    {
        var loaded =
            await EnsureRejectionReasonsLoadedAsync();

        if (!loaded)
        {
            return;
        }

        OpenModerationModal(
            advertisement,
            ModerationAction.Reject);
    }


    private void OpenSuspendModal(
        AdminAdvertisementListResponse advertisement)
    {
        OpenModerationModal(
            advertisement,
            ModerationAction.Suspend);
    }


    private void OpenReactivateModal(
        AdminAdvertisementListResponse advertisement)
    {
        OpenModerationModal(
            advertisement,
            ModerationAction.Reactivate);
    }


    private void OpenModerationModal(
        AdminAdvertisementListResponse advertisement,
        ModerationAction action)
    {
        _selectedAdvertisement =
            advertisement;

        _moderationAction =
            action;

        _selectedRejectionReasonId =
            null;

        _moderationComments =
            string.Empty;

        _showValidationMessage =
            false;

        _errorMessage =
            null;

        _successMessage =
            null;

        _showModerationModal =
            true;
    }


    private void CloseModerationModal()
{
    _showModerationModal = false;

    _selectedAdvertisement = null;

    _moderationAction =
        ModerationAction.None;

    _selectedRejectionReasonId = null;

    _moderationComments =
        string.Empty;

    _showValidationMessage = false;
}

    // =============================================================
    // REJECTION REASONS
    // =============================================================

    private async Task<bool>
        EnsureRejectionReasonsLoadedAsync()
    {
        if (_rejectionReasons.Count > 0)
        {
            return true;
        }

        try
        {
            _errorMessage = null;

            _rejectionReasons =
                await AdvertisementModerationService
                    .GetRejectionReasonsAsync()
                ?? new List<RejectionReasonResponse>();

            if (_rejectionReasons.Count == 0)
            {
                _errorMessage =
                    "No active rejection reasons are configured. Please configure at least one rejection reason before rejecting an advertisement.";

                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            _rejectionReasons.Clear();

            _errorMessage =
                $"Unable to load rejection reasons: {ex.Message}";

            return false;
        }
    }


    // =============================================================
    // EXECUTE MODERATION
    // =============================================================

    private async Task ExecuteModerationAsync()
    {
        if (_selectedAdvertisement is null ||
            _isModerationProcessing)
        {
            return;
        }

        if (_moderationAction ==
                ModerationAction.Reject &&
            !_selectedRejectionReasonId.HasValue)
        {
            _showValidationMessage =
                true;

            return;
        }

        var adminUserId =
            GetCurrentAdminUserId();

        if (!adminUserId.HasValue)
        {
            _errorMessage =
                "The current administrator identity could not be determined. Please sign in again.";

            return;
        }

        try
        {
            _isModerationProcessing =
                true;

            _errorMessage =
                null;

            _successMessage =
                null;

            var advertisementId =
                _selectedAdvertisement.AdvertisementID;

            var success =
                false;

            switch (_moderationAction)
            {
                case ModerationAction.Approve:

                    success =
                        await AdvertisementModerationService
                            .ApproveAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                new ApproveAdvertisementRequest
                                {
                                    Comments =
                                        NormalizeComments(
                                            _moderationComments)
                                });

                    break;


                case ModerationAction.Reject:

                    success =
                        await AdvertisementModerationService
                            .RejectAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                new RejectAdvertisementRequest
                                {
                                    RejectionReasonID =
                                        _selectedRejectionReasonId,

                                    Comments =
                                        NormalizeComments(
                                            _moderationComments)
                                });

                    break;


                case ModerationAction.Suspend:

                    success =
                        await AdvertisementModerationService
                            .SuspendAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                new SuspendAdvertisementRequest
                                {
                                    Comments =
                                        NormalizeComments(
                                            _moderationComments)
                                });

                    break;


                case ModerationAction.Reactivate:

                    success =
                        await AdvertisementModerationService
                            .ReactivateAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                NormalizeComments(
                                    _moderationComments));

                    break;
            }


            if (!success)
            {
                _errorMessage =
                    $"The {GetModalActionName().ToLowerInvariant()} operation was not completed. The advertisement may have changed or the operation may have been rejected by the server.";

                return;
            }


            var actionName =
                GetModalActionName();

            var advertisementNumber =
                _selectedAdvertisement
                    .AdvertisementNumber;


            CloseModerationModal();


            _successMessage =
                $"{actionName} completed successfully for advertisement {advertisementNumber}.";


            await LoadAdvertisementsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage =
                ex.Message;
        }
        finally
        {
            _isModerationProcessing =
                false;
        }
    }


    // =============================================================
    // AUTHENTICATION
    // =============================================================

    private long? GetCurrentAdminUserId()
    {
        var user =
            GetCurrentPrincipal();

        var value =
            user.FindFirstValue(
                ClaimTypes.NameIdentifier);

        if (long.TryParse(
            value,
            out var userId))
        {
            return userId;
        }

        return null;
    }


    private ClaimsPrincipal GetCurrentPrincipal()
    {
        return AuthenticationStateProvider
            .GetAuthenticationStateAsync()
            .GetAwaiter()
            .GetResult()
            .User;
    }


