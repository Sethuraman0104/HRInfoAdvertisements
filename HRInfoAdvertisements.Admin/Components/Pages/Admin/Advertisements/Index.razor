@page "/admin/advertisements"

@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.Admin
@using HRInfoAdvertisements.Application.DTOs.Settings
@using HRInfoAdvertisements.Application.DTOs.AdvertisementRemoval
@using HRInfoAdvertisements.Application.Interfaces

@inject IAdvertisementModerationService AdvertisementModerationService
@inject AdvertisementApiService AdvertisementApiService
@inject SystemSettingsApiService SystemSettingsApiService
@inject AdminAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@layout HRInfoAdvertisements.Admin.Components.Layout.MainLayout

<PageTitle>Advertisements | @(_applicationSettings?.SiteName ?? "AdMind")</PageTitle>

@{
    // Summary card definitions (status code, label, icon, colour class)
    var summaryCards = new (string? Status, string Label, string Icon, string Css)[]
    {
        (null,             "All Advertisements", "bi-grid-fill",           "all"),
        ("PENDING_REVIEW", "Pending Approval",   "bi-hourglass-split",     "pending"),
        ("PUBLISHED",      "Approved",           "bi-check-circle-fill",   "approved"),
        ("REJECTED",       "Rejected",           "bi-x-circle-fill",       "rejected"),
        ("SUSPENDED",      "Suspended",          "bi-pause-circle-fill",   "suspended")
    };
}

<div class="hr-ad-management">

    <!-- ========================= PAGE HEADER ========================= -->
    <header class="hr-ad-page-header">
        <div class="hr-ad-page-heading">
            <div class="hr-ad-page-icon"><i class="bi bi-megaphone-fill"></i></div>
            <div class="hr-ad-page-heading-text">
                <h1>Advertisements</h1>
                <p>Review, manage and moderate advertisements submitted by users.</p>
            </div>
        </div>

        <div class="hr-ad-page-actions">
            <button type="button" class="hr-ad-refresh-button"
                    @onclick="RefreshAdvertisementsAsync" disabled="@_isLoading">
                <i class="bi @(_isLoading ? "bi-arrow-repeat hr-spin" : "bi-arrow-clockwise")"></i>
                <span>Refresh</span>
            </button>
        </div>
    </header>

    <!-- ========================= APPROVAL NOTICE ========================= -->
    @if (_applicationSettings is not null && !_applicationSettings.RequireAdminApproval)
    {
        <div class="hr-ad-alert hr-ad-alert-warning">
            <div class="hr-ad-alert-icon"><i class="bi bi-info-circle-fill"></i></div>
            <div class="hr-ad-alert-content">
                <strong>Admin approval is turned off</strong>
                <span>New advertisements may publish without review. You can change this in System Settings.</span>
            </div>
        </div>
    }

    <!-- ========================= SUMMARY ========================= -->
    <div class="hr-ad-summary-grid">
        @foreach (var card in summaryCards)
        {
            <button type="button" class="hr-ad-summary-card @GetSummaryClass(card.Status)"
                    @onclick="() => SetStatusFilter(card.Status)">
                <div class="hr-ad-summary-icon @card.Css"><i class="bi @card.Icon"></i></div>
                <div class="hr-ad-summary-content">
                    <span class="hr-ad-summary-label">@card.Label</span>
                    <strong>@(card.Status is null ? _advertisements.Count : GetStatusCount(card.Status))</strong>
                </div>
            </button>
        }
    </div>

    <!-- ========================= PENDING REMOVAL REQUESTS ========================= -->
    @if (_pendingRemovalRequests.Count > 0)
    {
        <section class="hr-ad-removal-card">

            <div class="hr-ad-removal-header">
                <div class="hr-ad-removal-heading">
                    <div class="hr-ad-removal-icon"><i class="bi bi-person-dash-fill"></i></div>
                    <div class="hr-ad-removal-heading-text">
                        <h2>Pending Removal Requests</h2>
                        <p>Advertisers have requested that their advertisements be removed from public listings.</p>
                    </div>
                </div>
                <span class="hr-ad-removal-count">@_pendingRemovalRequests.Count</span>
            </div>

            <div class="hr-ad-removal-notice">
                <i class="bi bi-info-circle-fill"></i>
                <span>
                    These advertisements remain <strong>published</strong> until the request is reviewed.
                    Approving a request will remove the advertisement from public listings without deleting it.
                </span>
            </div>

            <div class="hr-ad-table-wrapper">
                <table class="hr-ad-table hr-ad-removal-table">
                    <thead>
                        <tr>
                            <th>Advertisement</th>
                            <th>Advertiser</th>
                            <th>Reason</th>
                            <th>Requested</th>
                            <th>Status</th>
                            <th class="col-actions">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in PagedRemovalRequests)
                        {
                            <tr @key="request.RemovalRequestID">

                                <td data-label="Advertisement" class="cell-primary">
                                    <div class="hr-ad-title-cell">
                                        <strong title="@request.AdvertisementNumber">@request.AdvertisementNumber</strong>
                                        <span title="@request.AdvertisementTitle">@request.AdvertisementTitle</span>
                                    </div>
                                </td>

                                <td data-label="Advertiser">
                                    <div class="hr-ad-user-cell">
                                        <div class="hr-ad-user-avatar">@GetInitials(request.UserName)</div>
                                        <div>
                                            <strong>@request.UserName</strong>
                                            @if (!string.IsNullOrWhiteSpace(request.Email))
                                            {
                                                <small>@request.Email</small>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Reason">
                                    @if (string.IsNullOrWhiteSpace(request.Reason))
                                    {
                                        <span class="hr-ad-removal-reason empty">No reason provided</span>
                                    }
                                    else
                                    {
                                        <span class="hr-ad-removal-reason" title="@request.Reason">@request.Reason</span>
                                    }
                                </td>

                                <td data-label="Requested">
                                    <div class="hr-ad-date">
                                        <strong>@(request.CreatedDate.ToLocalTime().ToString("dd MMM yyyy"))</strong>
                                        <small>@(request.CreatedDate.ToLocalTime().ToString("hh:mm tt"))</small>
                                    </div>
                                </td>

                                <td data-label="Status">
                                    <span class="hr-ad-status pending">
                                        <span class="hr-ad-status-dot"></span>
                                        Pending Review
                                    </span>
                                </td>

                                <td data-label="Action" class="cell-actions">
                                    <div class="hr-ad-row-actions">
                                        <button type="button" class="hr-ad-removal-review-button"
                                                disabled="@IsRemovalRequestProcessing(request.RemovalRequestID)"
                                                @onclick="() => OpenRemovalRequestModal(request)">
                                            @if (IsRemovalRequestProcessing(request.RemovalRequestID))
                                            {
                                                <i class="bi bi-arrow-repeat hr-spin"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-eye-fill"></i>
                                            }
                                            <span>Review</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pager @bind-CurrentPage="_removalPage"
                   @bind-PageSize="_removalPageSize"
                   TotalCount="_pendingRemovalRequests.Count"
                   PageSizeOptions="@(new[] { 5, 10, 20 })"
                   Id="removalPageSize" />
        </section>
    }

    <!-- ========================= FILTER BAR ========================= -->
    <div class="hr-ad-filter-card">

        <div class="hr-ad-search-box">
            <i class="bi bi-search"></i>
            <input @bind="_searchText" @bind:event="oninput" @onkeydown="HandleSearchKeyDown"
                   placeholder="Search by advertisement number, title or user..." type="text" />
            @if (!string.IsNullOrWhiteSpace(_searchText))
            {
                <button type="button" class="hr-ad-search-clear" @onclick="ClearSearch" aria-label="Clear search">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>

        <div class="hr-ad-filter-group">
            <label for="advertisementStatusFilter">Status</label>
            <select id="advertisementStatusFilter" @bind="_statusFilter">
                <option value="">All Statuses</option>
                <option value="PENDING_REVIEW">Pending Approval</option>
                <option value="PUBLISHED">Approved</option>
                <option value="REJECTED">Rejected</option>
                <option value="SUSPENDED">Suspended</option>
                <option value="DRAFT">Draft</option>
                <option value="UNPUBLISHED">Unpublished</option>
            </select>
        </div>

        <div class="hr-ad-filter-buttons">
            <button type="button" class="hr-ad-filter-button" @onclick="ApplyFiltersAsync" disabled="@_isLoading">
                <i class="bi bi-funnel-fill"></i>
                <span>Apply Filters</span>
            </button>

            <button type="button" class="hr-ad-reset-button" @onclick="ResetFilters" disabled="@_isLoading">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>Reset</span>
            </button>
        </div>

    </div>

    <!-- ========================= MESSAGES ========================= -->
    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="hr-ad-alert hr-ad-alert-success" role="status">
            <div class="hr-ad-alert-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div class="hr-ad-alert-content">
                <strong>Action completed</strong>
                <span>@_successMessage</span>
            </div>
            <button type="button" @onclick="ClearMessages" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="hr-ad-alert hr-ad-alert-error" role="alert">
            <div class="hr-ad-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div class="hr-ad-alert-content">
                <strong>Unable to process request</strong>
                <span>@_errorMessage</span>
            </div>
            <button type="button" @onclick="ClearMessages" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    <!-- ========================= ADVERTISEMENT TABLE ========================= -->
    <section class="hr-ad-table-card">

        <div class="hr-ad-table-header">
            <div>
                <h2>Advertisement List</h2>
                <span>@GetResultDescription()</span>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="hr-ad-loading">
                <div class="hr-ad-loading-spinner"><i class="bi bi-arrow-repeat hr-spin"></i></div>
                <strong>Loading advertisements...</strong>
                <span>Please wait while the latest records are retrieved.</span>
            </div>
        }
        else if (_advertisements.Count == 0)
        {
            <div class="hr-ad-empty">
                <div class="hr-ad-empty-icon"><i class="bi bi-megaphone"></i></div>
                <h3>No advertisements found</h3>
                <p>There are no advertisements matching the current search and filter criteria.</p>
                <button type="button" @onclick="ResetFilters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Clear Filters
                </button>
            </div>
        }
        else
        {
            <div class="hr-ad-table-wrapper">
                <table class="hr-ad-table hr-ad-main-table">
                    <thead>
                        <tr>
                            <th class="col-number">Advertisement</th>
                            <th class="col-title">Details</th>
                            <th>User</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var advertisement in PagedAdvertisements)
                        {
                            <tr @key="advertisement.AdvertisementID">

                                <td data-label="Advertisement" class="cell-primary">
                                    <div class="hr-ad-number">
                                        <span class="hr-ad-number-icon"><i class="bi bi-megaphone-fill"></i></span>
                                        <div>
                                            <strong title="@advertisement.AdvertisementNumber">@advertisement.AdvertisementNumber</strong>
                                            <small>ID @advertisement.AdvertisementID</small>
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Details">
                                    <div class="hr-ad-title-cell">
                                        <strong title="@advertisement.Title">@advertisement.Title</strong>
                                        <span>@advertisement.AdvertisementTypeName</span>
                                    </div>
                                </td>

                                <td data-label="User">
                                    <div class="hr-ad-user-cell">
                                        <div class="hr-ad-user-avatar">@GetInitials(advertisement.UserName)</div>
                                        <div>
                                            <strong>@advertisement.UserName</strong>
                                            @if (!string.IsNullOrWhiteSpace(advertisement.Email))
                                            {
                                                <small>@advertisement.Email</small>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Category">
                                    <span class="hr-ad-category">@advertisement.CategoryName</span>
                                </td>

                                <td data-label="Price">
                                    <span class="hr-ad-price">@FormatPrice(advertisement.Price, advertisement.CurrencyCode)</span>
                                </td>

                                <td data-label="Status">
                                    <span class="@GetStatusBadgeClass(advertisement.StatusCode)">
                                        <span class="hr-ad-status-dot"></span>
                                        @GetStatusDisplayName(advertisement)
                                    </span>
                                </td>

                                <td data-label="Created">
                                    <div class="hr-ad-date">
                                        <strong>@(advertisement.CreatedDate.ToLocalTime().ToString("dd MMM yyyy"))</strong>
                                        <small>@(advertisement.CreatedDate.ToLocalTime().ToString("hh:mm tt"))</small>
                                    </div>
                                </td>

                                <td data-label="Actions" class="cell-actions">
                                    <div class="hr-ad-row-actions">

                                        <button type="button" class="hr-ad-action view" title="View advertisement"
                                                aria-label="View advertisement"
                                                @onclick="() => ViewAdvertisement(advertisement.AdvertisementID)">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>

                                        @if (IsPending(advertisement))
                                        {
                                            <button type="button" class="hr-ad-action approve" title="Approve advertisement"
                                                    aria-label="Approve advertisement"
                                                    disabled="@IsAdvertisementProcessing(advertisement.AdvertisementID)"
                                                    @onclick="() => OpenApproveModal(advertisement)">
                                                <i class="bi bi-check-lg"></i>
                                            </button>

                                            <button type="button" class="hr-ad-action reject" title="Reject advertisement"
                                                    aria-label="Reject advertisement"
                                                    disabled="@IsAdvertisementProcessing(advertisement.AdvertisementID)"
                                                    @onclick="() => OpenRejectModal(advertisement)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }

                                        @if (IsApproved(advertisement))
                                        {
                                            <button type="button" class="hr-ad-action suspend" title="Suspend advertisement"
                                                    aria-label="Suspend advertisement"
                                                    disabled="@IsAdvertisementProcessing(advertisement.AdvertisementID)"
                                                    @onclick="() => OpenSuspendModal(advertisement)">
                                                <i class="bi bi-pause-fill"></i>
                                            </button>
                                        }

                                        @if (IsSuspended(advertisement))
                                        {
                                            <button type="button" class="hr-ad-action reactivate" title="Reactivate advertisement"
                                                    aria-label="Reactivate advertisement"
                                                    disabled="@IsAdvertisementProcessing(advertisement.AdvertisementID)"
                                                    @onclick="() => OpenReactivateModal(advertisement)">
                                                <i class="bi bi-play-fill"></i>
                                            </button>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (TotalPages > 1)
            {
                <div class="hr-ad-pagination">

                    <div class="hr-ad-pagination-info">
                        Showing
                        <strong>@FirstDisplayedRecord</strong> –
                        <strong>@LastDisplayedRecord</strong>
                        of
                        <strong>@_advertisements.Count</strong>
                    </div>

                    <div class="hr-ad-pagination-controls">
                        <button type="button" class="hr-ad-pagination-button" disabled="@(_currentPage == 1)"
                                @onclick="GoToFirstPage" title="First page" aria-label="First page">
                            <i class="bi bi-chevron-double-left"></i>
                        </button>

                        <button type="button" class="hr-ad-pagination-button" disabled="@(_currentPage == 1)"
                                @onclick="GoToPreviousPage" title="Previous page" aria-label="Previous page">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        @foreach (var pageNumber in GetPageNumbers())
                        {
                            <button type="button"
                                    class="hr-ad-pagination-button @(pageNumber == _currentPage ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">
                                @pageNumber
                            </button>
                        }

                        <button type="button" class="hr-ad-pagination-button" disabled="@(_currentPage == TotalPages)"
                                @onclick="GoToNextPage" title="Next page" aria-label="Next page">
                            <i class="bi bi-chevron-right"></i>
                        </button>

                        <button type="button" class="hr-ad-pagination-button" disabled="@(_currentPage == TotalPages)"
                                @onclick="GoToLastPage" title="Last page" aria-label="Last page">
                            <i class="bi bi-chevron-double-right"></i>
                        </button>
                    </div>

                    <div class="hr-ad-pagination-size">
                        <label for="advertisementPageSize">Show</label>
                        <select id="advertisementPageSize" value="@_pageSize" @onchange="HandlePageSizeChanged">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                        <span>per page</span>
                    </div>

                </div>
            }
        }

    </section>

    <!-- ========================= UNPUBLISHED ADVERTISEMENTS ========================= -->
    <section class="hr-ad-table-card hr-ad-section-gap">

        <div class="hr-ad-table-header">
            <div class="hr-ad-table-heading">
                <div class="hr-ad-section-icon unpublished"><i class="bi bi-eye-slash-fill"></i></div>
                <div>
                    <h2>Unpublished Advertisements</h2>
                    <span>Advertisements removed from public listings. They remain in the system with full history.</span>
                </div>
            </div>
            <span class="hr-ad-removal-count neutral">@_unpublishedAdvertisements.Count</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_unpublishedError))
        {
            <div class="hr-ad-alert hr-ad-alert-error hr-ad-inline-alert" role="alert">
                <div class="hr-ad-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="hr-ad-alert-content">
                    <strong>Unable to load unpublished advertisements</strong>
                    <span>@_unpublishedError</span>
                </div>
            </div>
        }

        @if (_isUnpublishedLoading)
        {
            <div class="hr-ad-loading">
                <div class="hr-ad-loading-spinner"><i class="bi bi-arrow-repeat hr-spin"></i></div>
                <strong>Loading unpublished advertisements...</strong>
            </div>
        }
        else if (_unpublishedAdvertisements.Count == 0)
        {
            <div class="hr-ad-empty compact">
                <div class="hr-ad-empty-icon"><i class="bi bi-eye-slash"></i></div>
                <h3>No unpublished advertisements</h3>
                <p>Advertisements whose removal requests are approved will appear here.</p>
            </div>
        }
        else
        {
            <div class="hr-ad-table-wrapper">
                <table class="hr-ad-table hr-ad-main-table">
                    <thead>
                        <tr>
                            <th class="col-number">Advertisement</th>
                            <th class="col-title">Details</th>
                            <th>User</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var advertisement in PagedUnpublishedAdvertisements)
                        {
                            <tr @key="advertisement.AdvertisementID">

                                <td data-label="Advertisement" class="cell-primary">
                                    <div class="hr-ad-number">
                                        <span class="hr-ad-number-icon"><i class="bi bi-megaphone-fill"></i></span>
                                        <div>
                                            <strong title="@advertisement.AdvertisementNumber">@advertisement.AdvertisementNumber</strong>
                                            <small>ID @advertisement.AdvertisementID</small>
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Details">
                                    <div class="hr-ad-title-cell">
                                        <strong title="@advertisement.Title">@advertisement.Title</strong>
                                        <span>@advertisement.AdvertisementTypeName</span>
                                    </div>
                                </td>

                                <td data-label="User">
                                    <div class="hr-ad-user-cell">
                                        <div class="hr-ad-user-avatar">@GetInitials(advertisement.UserName)</div>
                                        <div>
                                            <strong>@advertisement.UserName</strong>
                                            @if (!string.IsNullOrWhiteSpace(advertisement.Email))
                                            {
                                                <small>@advertisement.Email</small>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Category">
                                    <span class="hr-ad-category">@advertisement.CategoryName</span>
                                </td>

                                <td data-label="Price">
                                    <span class="hr-ad-price">@FormatPrice(advertisement.Price, advertisement.CurrencyCode)</span>
                                </td>

                                <td data-label="Status">
                                    <span class="hr-ad-status unpublished">
                                        <span class="hr-ad-status-dot"></span>
                                        Unpublished
                                    </span>
                                </td>

                                <td data-label="Created">
                                    <div class="hr-ad-date">
                                        <strong>@(advertisement.CreatedDate.ToLocalTime().ToString("dd MMM yyyy"))</strong>
                                        <small>@(advertisement.CreatedDate.ToLocalTime().ToString("hh:mm tt"))</small>
                                    </div>
                                </td>

                                <td data-label="Actions" class="cell-actions">
                                    <div class="hr-ad-row-actions">
                                        <button type="button" class="hr-ad-action view" title="View advertisement"
                                                aria-label="View advertisement"
                                                @onclick="() => ViewAdvertisement(advertisement.AdvertisementID)">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pager @bind-CurrentPage="_unpublishedPage"
                   @bind-PageSize="_unpublishedPageSize"
                   TotalCount="_unpublishedAdvertisements.Count"
                   Id="unpublishedPageSize" />
        }

    </section>

</div>


<!-- =============================================================
     MODERATION MODAL
     ============================================================= -->

@if (_showModerationModal)
{
    <div class="hr-ad-modal-backdrop" @onclick="HandleModalBackdropClick">

        <div class="hr-ad-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">

            <div class="hr-ad-modal-header">
                <div class="hr-ad-modal-title">
                    <div class="hr-ad-modal-icon @GetModalIconClass()"><i class="@GetModalIcon()"></i></div>
                    <div>
                        <h3>@GetModalTitle()</h3>
                        <span>@_selectedAdvertisement?.AdvertisementNumber</span>
                    </div>
                </div>

                <button type="button" class="hr-ad-modal-close" disabled="@_isModerationProcessing"
                        @onclick="CloseModerationModal" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="hr-ad-modal-body">

                @if (_selectedAdvertisement is not null)
                {
                    <div class="hr-ad-modal-advertisement">
                        <div class="hr-ad-modal-ad-icon"><i class="bi bi-megaphone-fill"></i></div>
                        <div>
                            <strong>@_selectedAdvertisement.Title</strong>
                            <span>@_selectedAdvertisement.UserName</span>
                        </div>
                    </div>
                }

                @if (_moderationAction == ModerationAction.Reject)
                {
                    <div class="hr-ad-modal-field">
                        <label for="rejectionReason">
                            Rejection Reason <span class="hr-ad-required">*</span>
                        </label>

                        <select id="rejectionReason" @bind="_selectedRejectionReasonId" disabled="@_isModerationProcessing">
                            <option value="">Select a rejection reason</option>
                            @foreach (var reason in _rejectionReasons)
                            {
                                if (reason.IsActive)
                                {
                                    <option value="@reason.RejectionReasonID">@reason.ReasonName</option>
                                }
                            }
                        </select>

                        @if (_showValidationMessage && !_selectedRejectionReasonId.HasValue)
                        {
                            <small class="hr-ad-modal-validation">Please select a rejection reason.</small>
                        }
                    </div>
                }

                @if (_moderationAction == ModerationAction.Approve)
                {
                    <div class="hr-ad-modal-field">
                        <label class="hr-ad-field-title">Advertisement Promotion</label>

                        <label class="hr-ad-featured-option">
                            <input type="checkbox" @bind="_isFeaturedOnApproval" disabled="@_isModerationProcessing" />
                            <span class="hr-ad-featured-check"><i class="bi bi-star-fill"></i></span>
                            <span class="hr-ad-featured-content">
                                <strong>Feature this advertisement</strong>
                                <small>Display this advertisement as a featured listing until its normal expiry date.</small>
                            </span>
                        </label>
                    </div>
                }

                <div class="hr-ad-modal-field">
                    <label for="moderationComments">
                        Comments
                        @if (_moderationAction == ModerationAction.Reject)
                        {
                            <span class="hr-ad-optional">Optional</span>
                        }
                    </label>

                    <textarea id="moderationComments" @bind="_moderationComments" disabled="@_isModerationProcessing"
                              rows="4" maxlength="1000" placeholder="@GetCommentsPlaceholder()"></textarea>

                    <div class="hr-ad-character-count">@_moderationComments.Length / 1000</div>
                </div>

                @if (_moderationAction == ModerationAction.Approve)
                {
                    <div class="hr-ad-modal-information approve">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>This advertisement will be approved and made available according to its configured publishing rules.</span>
                    </div>
                }
                else if (_moderationAction == ModerationAction.Reject)
                {
                    <div class="hr-ad-modal-information reject">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>The advertisement will be marked as rejected. The selected reason will be recorded in the moderation history.</span>
                    </div>
                }
                else if (_moderationAction == ModerationAction.Suspend)
                {
                    <div class="hr-ad-modal-information suspend">
                        <i class="bi bi-pause-circle-fill"></i>
                        <span>The advertisement will be suspended and will no longer be available as an active advertisement.</span>
                    </div>
                }
                else if (_moderationAction == ModerationAction.Reactivate)
                {
                    <div class="hr-ad-modal-information reactivate">
                        <i class="bi bi-play-circle-fill"></i>
                        <span>The advertisement will be reactivated.</span>
                    </div>
                }

            </div>

            <div class="hr-ad-modal-footer">
                <button type="button" class="hr-ad-modal-cancel" disabled="@_isModerationProcessing"
                        @onclick="CloseModerationModal">
                    Cancel
                </button>

                <button type="button" class="hr-ad-modal-confirm @GetModalConfirmClass()"
                        disabled="@_isModerationProcessing" @onclick="ExecuteModerationAsync">
                    @if (_isModerationProcessing)
                    {
                        <i class="bi bi-arrow-repeat hr-spin"></i>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <i class="@GetModalIcon()"></i>
                        <span>@GetModalConfirmText()</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


<!-- =============================================================
     REMOVAL REQUEST MODAL
     ============================================================= -->

@if (_showRemovalRequestModal && _selectedRemovalRequest is not null)
{
    <div class="hr-ad-modal-backdrop" @onclick="HandleRemovalModalBackdropClick">

        <div class="hr-ad-modal hr-ad-modal-wide" role="dialog" aria-modal="true" @onclick:stopPropagation="true">

            <div class="hr-ad-modal-header">
