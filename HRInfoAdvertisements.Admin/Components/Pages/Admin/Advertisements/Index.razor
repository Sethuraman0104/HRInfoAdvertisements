                advertisement.StatusCode
        };
    }


    private static string GetFriendlyStatusName(
        string? statusCode)
    {
        return statusCode?
            .Trim()
            .ToUpperInvariant() switch
        {
            "PENDING_REVIEW" =>
                "pending approval",

            "PUBLISHED" =>
                "approved",

            "REJECTED" =>
                "rejected",

            "SUSPENDED" =>
                "suspended",

            "DRAFT" =>
                "draft",
            "UNPUBLISHED" => "unpublished",

            _ =>
                "advertisement"
        };
    }


    private static readonly HashSet<string> ThreeDecimalCurrencies =
    new(StringComparer.OrdinalIgnoreCase)
    { "BHD", "KWD", "OMR", "JOD", "TND", "LYD" };

    private string FormatPrice(
        decimal? price,
        string? currency)
    {
        if (!price.HasValue)
        {
            return "—";
        }

        var currencyCode =
            !string.IsNullOrWhiteSpace(currency)
                ? currency.Trim().ToUpperInvariant()
                : _applicationSettings?.DefaultCurrency ?? "INR";

        var format =
            ThreeDecimalCurrencies.Contains(currencyCode)
                ? "N3"
                : "N2";

        return $"{price.Value.ToString(format)} {currencyCode}";
    }

    private static string GetInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts =
            name.Trim()
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        parts[0].Length))
                .ToUpperInvariant();
        }

        return string.Concat(
                parts[0][0],
                parts[^1][0])
            .ToUpperInvariant();
    }


    private string GetResultDescription()
    {
        if (_advertisements.Count == 0)
        {
            return "0 advertisements";
        }

        var description =
            !string.IsNullOrWhiteSpace(_searchText)
                ? $"{_advertisements.Count} result(s) for \"{_searchText}\""
                : !string.IsNullOrWhiteSpace(_statusFilter)
                    ? $"{_advertisements.Count} {GetFriendlyStatusName(_statusFilter)} advertisement(s)"
                    : $"{_advertisements.Count} advertisement(s)";

        if (TotalPages > 1)
        {
            description +=
                $" · Page {_currentPage} of {TotalPages}";
        }

        return description;
    }


    // =============================================================
    // NAVIGATION
    // =============================================================

    private void ViewAdvertisement(
        long advertisementId)
    {
        Navigation.NavigateTo(
            $"/admin/advertisements/{advertisementId}");
    }


    // =============================================================
    // MODERATION - OPEN MODALS
    // =============================================================

    private void OpenApproveModal(
        AdminAdvertisementListResponse advertisement)
    {
        OpenModerationModal(
            advertisement,
            ModerationAction.Approve);
    }


    private async Task OpenRejectModal(
        AdminAdvertisementListResponse advertisement)
    {
        var loaded =
            await EnsureRejectionReasonsLoadedAsync();

        if (!loaded)
        {
            return;
        }

        OpenModerationModal(
            advertisement,
            ModerationAction.Reject);
    }


    private void OpenSuspendModal(
        AdminAdvertisementListResponse advertisement)
    {
        OpenModerationModal(
            advertisement,
            ModerationAction.Suspend);
    }


    private void OpenReactivateModal(
        AdminAdvertisementListResponse advertisement)
    {
        OpenModerationModal(
            advertisement,
            ModerationAction.Reactivate);
    }


    private void OpenModerationModal(
    AdminAdvertisementListResponse advertisement,
    ModerationAction action)
    {
        _selectedAdvertisement =
            advertisement;

        _moderationAction =
            action;

        _selectedRejectionReasonId =
            null;

        _moderationComments =
            string.Empty;

        _isFeaturedOnApproval =
            false;

        _showValidationMessage =
            false;

        _errorMessage =
            null;

        _successMessage =
            null;

        _showModerationModal =
            true;
    }


    private void CloseModerationModal()
    {
        _showModerationModal = false;

        _selectedAdvertisement = null;

        _moderationAction =
            ModerationAction.None;

        _selectedRejectionReasonId =
            null;

        _moderationComments =
            string.Empty;

        _isFeaturedOnApproval =
            false;

        _showValidationMessage =
            false;
    }

    // =============================================================
    // REJECTION REASONS
    // =============================================================

    private async Task<bool>
        EnsureRejectionReasonsLoadedAsync()
    {
        if (_rejectionReasons.Count > 0)
        {
            return true;
        }

        try
        {
            _errorMessage = null;

            _rejectionReasons =
                await AdvertisementModerationService
                    .GetRejectionReasonsAsync()
                ?? new List<RejectionReasonResponse>();

            if (_rejectionReasons.Count == 0)
            {
                _errorMessage =
                    "No active rejection reasons are configured. Please configure at least one rejection reason before rejecting an advertisement.";

                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            _rejectionReasons.Clear();

            _errorMessage =
                $"Unable to load rejection reasons: {ex.Message}";

            return false;
        }
    }


    // =============================================================
    // EXECUTE MODERATION
    // =============================================================

    private async Task ExecuteModerationAsync()
    {
        if (_selectedAdvertisement is null ||
            _isModerationProcessing)
        {
            return;
        }

        if (_moderationAction ==
                ModerationAction.Reject &&
            !_selectedRejectionReasonId.HasValue)
        {
            _showValidationMessage =
                true;

            return;
        }

        var adminUserId =
            GetCurrentAdminUserId();

        if (!adminUserId.HasValue)
        {
            _errorMessage =
                "The current administrator identity could not be determined. Please sign in again.";

            return;
        }

        try
        {
            _isModerationProcessing =
                true;

            _errorMessage =
                null;

            _successMessage =
                null;

            var advertisementId =
                _selectedAdvertisement.AdvertisementID;

            var success =
                false;

            switch (_moderationAction)
            {
                case ModerationAction.Approve:

                    success =
    await AdvertisementModerationService
        .ApproveAdvertisementAsync(
            adminUserId.Value,
            advertisementId,
            new ApproveAdvertisementRequest
            {
                IsFeatured =
                    _isFeaturedOnApproval,

                Comments =
                    NormalizeComments(
                        _moderationComments)
            });

                    break;


                case ModerationAction.Reject:

                    success =
                        await AdvertisementModerationService
                            .RejectAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                new RejectAdvertisementRequest
                                {
                                    RejectionReasonID =
                                        _selectedRejectionReasonId,

                                    Comments =
                                        NormalizeComments(
                                            _moderationComments)
                                });

                    break;


                case ModerationAction.Suspend:

                    success =
                        await AdvertisementModerationService
                            .SuspendAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                new SuspendAdvertisementRequest
                                {
                                    Comments =
                                        NormalizeComments(
                                            _moderationComments)
                                });

                    break;


                case ModerationAction.Reactivate:

                    success =
                        await AdvertisementModerationService
                            .ReactivateAdvertisementAsync(
                                adminUserId.Value,
                                advertisementId,
                                NormalizeComments(
                                    _moderationComments));

                    break;
            }


            if (!success)
            {
                _errorMessage =
                    $"The {GetModalActionName().ToLowerInvariant()} operation was not completed. The advertisement may have changed or the operation may have been rejected by the server.";

                return;
            }


            var actionName =
                GetModalActionName();

            var advertisementNumber =
                _selectedAdvertisement
                    .AdvertisementNumber;


            CloseModerationModal();


            _successMessage =
                $"{actionName} completed successfully for advertisement {advertisementNumber}.";

            await LoadSecondaryListsAsync();
            await LoadAdvertisementsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage =
                ex.Message;
        }
        finally
        {
            _isModerationProcessing =
                false;
        }
    }

    private void OpenRemovalRequestModal(
        AdminAdvertisementRemovalRequestResponse request)
    {
        _selectedRemovalRequest = request;

        _removalRequestComments =
            string.Empty;

        _removalRequestDecision =
            RemovalRequestDecision.None;

        _isRemovalRequestProcessing =
            false;

        _errorMessage = null;
        _successMessage = null;

        _showRemovalRequestModal = true;
    }

    private void CloseRemovalRequestModal()
    {
        if (_isRemovalRequestProcessing)
        {
            return;
        }

        _showRemovalRequestModal = false;

        _selectedRemovalRequest = null;

        _removalRequestComments =
            string.Empty;

        _removalRequestDecision =
            RemovalRequestDecision.None;
    }

    private async Task ApproveRemovalRequestAsync()
    {
        if (_selectedRemovalRequest is null ||
            _isRemovalRequestProcessing)
        {
            return;
        }

        var request =
            _selectedRemovalRequest;

        try
        {
            _isRemovalRequestProcessing = true;
            _removalRequestDecision =
                RemovalRequestDecision.Approve;

            _errorMessage = null;
            _successMessage = null;

            var success =
                await AdvertisementApiService
                    .ApproveAdvertisementRemovalRequestAsync(
                        request.RemovalRequestID,
                        NormalizeRemovalComments(
                            _removalRequestComments));

            if (!success)
            {
                _errorMessage =
                    "The removal request could not be approved.";

                return;
            }

            CloseRemovalRequestModal();

            _successMessage =
                $"Removal request approved successfully for advertisement {request.AdvertisementNumber}. " +
                "The advertisement has been removed from public listings.";

            await LoadSecondaryListsAsync();
            await LoadAdvertisementsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage =
                ex.Message;
        }
        finally
        {
            _isRemovalRequestProcessing = false;
            _removalRequestDecision =
                RemovalRequestDecision.None;
        }
    }

    private async Task RejectRemovalRequestAsync()
    {
        if (_selectedRemovalRequest is null ||
            _isRemovalRequestProcessing)
        {
            return;
        }

        var request =
            _selectedRemovalRequest;

        try
        {
            _isRemovalRequestProcessing = true;
            _removalRequestDecision =
                RemovalRequestDecision.Reject;

            _errorMessage = null;
            _successMessage = null;

            var success =
                await AdvertisementApiService
                    .RejectAdvertisementRemovalRequestAsync(
                        request.RemovalRequestID,
                        NormalizeRemovalComments(
                            _removalRequestComments));

            if (!success)
            {
                _errorMessage =
                    "The removal request could not be rejected.";

                return;
            }

            CloseRemovalRequestModal();

            _successMessage =
                $"Removal request rejected successfully for advertisement {request.AdvertisementNumber}. " +
                "The advertisement remains published.";

            await LoadSecondaryListsAsync();
            await LoadAdvertisementsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage =
                ex.Message;
        }
        finally
        {
            _isRemovalRequestProcessing = false;
            _removalRequestDecision =
                RemovalRequestDecision.None;
        }
    }

    private static string NormalizeRemovalComments(
        string? comments)
    {
        return string.IsNullOrWhiteSpace(comments)
            ? string.Empty
            : comments.Trim();
    }

    private bool IsRemovalRequestProcessing(
        long removalRequestId)
    {
        return _isRemovalRequestProcessing &&
               _selectedRemovalRequest?
                   .RemovalRequestID ==
               removalRequestId;
    }

    private void HandleRemovalModalBackdropClick(
        MouseEventArgs _)
    {
        if (!_isRemovalRequestProcessing)
        {
            CloseRemovalRequestModal();
        }
    }


