    private static string NormalizeComments(
        string? comments)
    {
        return string.IsNullOrWhiteSpace(comments)
            ? string.Empty
            : comments.Trim();
    }


    private bool IsAdvertisementProcessing(
        long advertisementId)
    {
        return _isModerationProcessing &&
               _selectedAdvertisement?
                   .AdvertisementID ==
               advertisementId;
    }


