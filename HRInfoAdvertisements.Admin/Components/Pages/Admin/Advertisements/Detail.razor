        background: #f2f0f7;
        color: #592462;
    }

    .admin-ad-card-title h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 800;
        color: #272727;
    }

    .admin-ad-card-title p {
        margin: 3px 0 0;
        font-size: 12px;
        color: #8b8b8b;
    }

    .admin-ad-card-count {
        min-width: 28px;
        height: 28px;
        padding: 0 8px;
        border-radius: 999px;
        background: #f2f3f4;
        color: #666;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
    }

    .admin-ad-card-body {
        padding: 20px;
    }


    /* ============================================================
       FORM
       ============================================================ */

    .admin-ad-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .admin-ad-form-full {
        grid-column: 1 / -1;
    }

    .admin-ad-form-group {
        min-width: 0;
    }

    .admin-ad-form-group > label {
        display: block;
        margin-bottom: 7px;
        font-size: 12px;
        font-weight: 750;
        color: #555;
    }

    .admin-ad-input,
    .admin-ad-select,
    .admin-ad-textarea {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #dcdfe3;
        border-radius: 10px;
        background: #fff;
        color: #292929;
        font-size: 13px;
