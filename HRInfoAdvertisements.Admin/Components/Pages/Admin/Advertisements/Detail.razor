@code {

    [Parameter]
    public long AdvertisementId { get; set; }


    // ============================================================
    // STATE
    // ============================================================

    private AdminAdvertisementDetailResponse? _advertisement;

    private UpdateAdvertisementRequest _editModel =
        new();

    private bool _isLoading;
    private bool _isEditMode;
    private bool _isSaving;
    private bool _isBusy;
    private bool _isModerationProcessing;

    private string? _errorMessage;
    private string? _successMessage;


    // ============================================================
    // LOOKUPS
    // ============================================================

    private List<LookupItemResponse> _categories =
        new();

    private List<LookupItemResponse> _advertisementTypes =
        new();

    private List<LookupItemResponse> _countries =
        new();

    private List<LookupItemResponse> _states =
        new();

    private List<LookupItemResponse> _cities =
        new();

    private List<LookupItemResponse> _areas =
        new();

    private List<RejectionReasonResponse> _rejectionReasons =
        new();


    // ============================================================
    // MODERATION
    // ============================================================

    private bool _showModerationModal;

    private ModerationAction _moderationAction =
        ModerationAction.None;

    private string _moderationComments =
        string.Empty;

    private int? _selectedRejectionReasonId;


    // ============================================================
    // LIFECYCLE
    // ============================================================

    protected override async Task OnParametersSetAsync()
    {
        await LoadAdvertisementAsync();
    }


    // ============================================================
    // LOAD
    // ============================================================

    private async Task LoadAdvertisementAsync()
    {
        _isLoading = true;
        _isBusy = true;

        ClearMessages();

        try
        {
            _advertisement =
                await AdvertisementModerationService
                    .GetAdvertisementAsync(
                        AdvertisementId);

            if (_advertisement == null)
            {
                _errorMessage =
                    "The requested advertisement could not be found.";

                return;
            }

            await LoadLookupsAsync();

            CopyAdvertisementToEditModel();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Admin Advertisement Detail] Load error: {ex}");

            _errorMessage =
                GetFriendlyErrorMessage(ex);
        }
        finally
        {
            _isLoading = false;
            _isBusy = false;
        }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var categoriesTask =
                AdvertisementApiService
                    .GetCategoriesAsync();

            var typesTask =
                AdvertisementApiService
                    .GetAdvertisementTypesAsync();

            var countriesTask =
                AdvertisementApiService
                    .GetCountriesAsync();

            var rejectionTask =
                AdvertisementModerationService
                    .GetRejectionReasonsAsync();

            await Task.WhenAll(
                categoriesTask,
                typesTask,
                countriesTask,
                rejectionTask);

            _categories =
                await categoriesTask;

            _advertisementTypes =
                await typesTask;

            _countries =
                await countriesTask;

            _rejectionReasons =
                await rejectionTask;

            if (_advertisement.CountryID.HasValue)
            {
                _states =
                    await AdvertisementApiService
                        .GetStatesAsync(
                            _advertisement.CountryID.Value);
            }

            if (_advertisement.CountryID.HasValue)
            {
                _cities =
                    await AdvertisementApiService
                        .GetCitiesAsync(
                            _advertisement.CountryID.Value,
                            _advertisement.StateID);
            }

            if (_advertisement.CountryID.HasValue)
            {
                _areas =
                    await AdvertisementApiService
                        .GetAreasAsync(
                            _advertisement.CountryID.Value,
                            _advertisement.StateID,
                            _advertisement.CityID);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Admin Advertisement Detail] Lookup error: {ex}");

            // Lookup failure should not prevent the advertisement
            // itself from being displayed.
        }
    }


    // ============================================================
    // EDIT
    // ============================================================

    private void BeginEdit()
    {
        if (_advertisement == null)
        {
            return;
        }

        ClearMessages();

        CopyAdvertisementToEditModel();

        _isEditMode = true;
    }


    private void CancelEdit()
    {
        if (_advertisement == null)
        {
            return;
        }

        CopyAdvertisementToEditModel();

        _isEditMode = false;

        ClearMessages();
    }


    private void CopyAdvertisementToEditModel()
    {
        if (_advertisement == null)
        {
            return;
        }

        _editModel =
            new UpdateAdvertisementRequest
            {
                CategoryID =
                    _advertisement.CategoryID,

                AdvertisementTypeID =
                    _advertisement.AdvertisementTypeID,

                Title =
                    _advertisement.Title,

                TitleAr =
                    _advertisement.TitleAr,

                Description =
                    _advertisement.Description,

                DescriptionAr =
                    _advertisement.DescriptionAr,

                Price =
                    _advertisement.Price,

                CurrencyCode =
                    _advertisement.CurrencyCode,

                IsNegotiable =
                    _advertisement.IsNegotiable,

                WhatsAppNumber =
                    _advertisement.WhatsAppNumber,

                ContactEmail =
                    _advertisement.ContactEmail,

                ShowWhatsAppToPublic =
                    _advertisement.ShowWhatsAppToPublic,

                ShowEmailToPublic =
                    _advertisement.ShowEmailToPublic,

                CountryID =
                    _advertisement.CountryID,

                StateID =
                    _advertisement.StateID,

                CityID =
                    _advertisement.CityID,

                AreaID =
                    _advertisement.AreaID,

                AddressLine =
                    _advertisement.AddressLine,

                Latitude =
                    _advertisement.Latitude,

                Longitude =
                    _advertisement.Longitude,

                PlotNumber =
                    _advertisement.PlotNumber,

                LandArea =
                    _advertisement.LandArea,

                BuiltUpArea =
                    _advertisement.BuiltUpArea,

                Bedrooms =
                    _advertisement.Bedrooms,

                Bathrooms =
                    _advertisement.Bathrooms,

                PropertyAge =
                    _advertisement.PropertyAge
            };
    }


    private async Task SaveAdvertisementAsync()
    {
        if (_advertisement == null ||
            _isSaving)
        {
            return;
        }

        ClearMessages();

        var validationError =
            ValidateEditModel();

        if (validationError != null)
        {
            _errorMessage = validationError;
            return;
        }

        _isSaving = true;
        _isBusy = true;

        try
        {
            var adminUserId =
    await GetCurrentAdminUserIdAsync();

            var result =
                await AdvertisementModerationService
                    .UpdateAdvertisementAsync(
                        adminUserId,
                        AdvertisementId,
                        _editModel);

            if (result == null)
            {
                _errorMessage =
                    "The advertisement could not be updated.";

                return;
            }

            _advertisement = result;

            CopyAdvertisementToEditModel();

            _isEditMode = false;

            _successMessage =
                "Advertisement changes were saved successfully.";
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Admin Advertisement Detail] Save error: {ex}");

            _errorMessage =
                GetFriendlyErrorMessage(ex);
        }
        finally
        {
            _isSaving = false;
            _isBusy = false;
        }
    }


    private string? ValidateEditModel()
    {
        if (_editModel.CategoryID <= 0)
        {
            return "Please select an advertisement category.";
        }

        if (_editModel.AdvertisementTypeID <= 0)
        {
            return "Please select an advertisement type.";
        }

        if (string.IsNullOrWhiteSpace(_editModel.Title))
        {
            return "Advertisement title is required.";
        }

        if (string.IsNullOrWhiteSpace(_editModel.Description))
        {
            return "Advertisement description is required.";
        }

        var hasContact =
            !string.IsNullOrWhiteSpace(
                _editModel.WhatsAppNumber) ||
            !string.IsNullOrWhiteSpace(
                _editModel.ContactEmail);

        if (!hasContact)
        {
            return "At least one contact method must be entered.";
        }

        var hasPublicContact =
            _editModel.ShowWhatsAppToPublic ||
            _editModel.ShowEmailToPublic;

        if (!hasPublicContact)
        {
            return "At least one contact method must be publicly visible.";
        }

        if (_editModel.ShowWhatsAppToPublic &&
            string.IsNullOrWhiteSpace(
                _editModel.WhatsAppNumber))
        {
            return "A WhatsApp number is required when WhatsApp visibility is enabled.";
        }

        if (_editModel.ShowEmailToPublic &&
            string.IsNullOrWhiteSpace(
                _editModel.ContactEmail))
        {
            return "An email address is required when email visibility is enabled.";
        }

        return null;
    }


