@page "/admin/advertisements/{AdvertisementId:long}"

@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.Advertisement
@using HRInfoAdvertisements.Application.DTOs.Advertisements
@using HRInfoAdvertisements.Application.DTOs.Admin
@using HRInfoAdvertisements.Application.Interfaces
@using System.Security.Claims

@inject IAdvertisementModerationService AdvertisementModerationService
@inject AdvertisementApiService AdvertisementApiService
@inject AdminAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@layout HRInfoAdvertisements.Admin.Components.Layout.MainLayout

<PageTitle>Advertisement Details | AdMind</PageTitle>

<div class="admin-ad-detail-page">

    @if (_isLoading)
    {
        <div class="admin-ad-loading">
            <div class="admin-ad-loading-spinner"></div>
            <h3>Loading advertisement...</h3>
            <p>Please wait while the advertisement details are retrieved.</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage) && _advertisement == null)
    {
        <div class="admin-ad-error-page">

            <div class="admin-ad-error-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h2>Unable to load advertisement</h2>

            <p>@_errorMessage</p>

            <div class="admin-ad-error-actions">
                <button type="button"
                        class="admin-ad-secondary-button"
                        @onclick="BackToAdvertisements">
                    <i class="bi bi-arrow-left"></i>
                    Back to Advertisements
                </button>

                <button type="button"
                        class="admin-ad-primary-button"
                        @onclick="LoadAdvertisementAsync">
                    <i class="bi bi-arrow-clockwise"></i>
                    Try Again
                </button>
            </div>

        </div>
    }
    else if (_advertisement != null)
    {
        <!-- =========================================================
             PAGE HEADER
             ========================================================= -->

        <section class="admin-ad-header">

            <div class="admin-ad-header-left">

                <button type="button"
                        class="admin-ad-back-button"
                        @onclick="BackToAdvertisements">

                    <i class="bi bi-arrow-left"></i>

                    <span>Advertisements</span>

                </button>

                <div class="admin-ad-header-main">

                    <div class="admin-ad-header-icon">
                        <i class="bi bi-megaphone-fill"></i>
                    </div>

                    <div>

                        <div class="admin-ad-eyebrow">
                            ADVERTISEMENT MANAGEMENT
                        </div>

                        <h1>
                            @_advertisement.AdvertisementNumber
                        </h1>

                        <p>
                            Review and manage this advertisement submitted by
                            @_advertisement.UserName.
                        </p>

                    </div>

                </div>

            </div>

            <div class="admin-ad-header-right">

                <span class="admin-ad-status @GetStatusClass(_advertisement.StatusCode)">
                    <span class="admin-ad-status-dot"></span>
                    @_advertisement.StatusName
                </span>

                <button type="button"
                        class="admin-ad-refresh-button"
                        @onclick="LoadAdvertisementAsync"
                        disabled="@_isBusy">

                    <i class="bi @(_isBusy
                        ? "bi-arrow-repeat admin-ad-spin"
                        : "bi-arrow-clockwise")"></i>

                    <span>Refresh</span>

                </button>

            </div>

        </section>


        <!-- =========================================================
             ALERTS
             ========================================================= -->

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="admin-ad-alert admin-ad-alert-success">

                <div class="admin-ad-alert-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <strong>Success</strong>
                    <span>@_successMessage</span>
                </div>

                <button type="button"
                        @onclick="ClearMessages">
                    <i class="bi bi-x"></i>
                </button>

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="admin-ad-alert admin-ad-alert-error">

                <div class="admin-ad-alert-icon">
                    <i class="bi bi-exclamation-circle-fill"></i>
                </div>

                <div>
                    <strong>Action could not be completed</strong>
                    <span>@_errorMessage</span>
                </div>

                <button type="button"
                        @onclick="ClearMessages">
                    <i class="bi bi-x"></i>
                </button>

            </div>
        }


        <!-- =========================================================
             ACTION BAR
             ========================================================= -->

        <section class="admin-ad-action-bar">

            <div class="admin-ad-action-info">

                <div class="admin-ad-action-title">
                    Advertisement Details
                </div>

                <div class="admin-ad-action-subtitle">
                    @( _isEditMode
                        ? "Edit advertisement information and save your changes."
                        : "Review advertisement information and moderation history." )
                </div>

            </div>

            <div class="admin-ad-action-buttons">

                @if (_isEditMode)
                {
                    <button type="button"
                            class="admin-ad-secondary-button"
                            @onclick="CancelEdit"
                            disabled="@_isSaving">

                        <i class="bi bi-x-lg"></i>
                        Cancel

                    </button>

                    <button type="button"
                            class="admin-ad-save-button"
                            @onclick="SaveAdvertisementAsync"
                            disabled="@_isSaving">

                        @if (_isSaving)
                        {
                            <span class="admin-ad-button-spinner"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>Save Changes</span>
                        }

                    </button>
                }
                else
                {
                    <button type="button"
                            class="admin-ad-edit-button"
                            @onclick="BeginEdit">

                        <i class="bi bi-pencil-square"></i>
                        Edit Advertisement

                    </button>
                }

            </div>

        </section>


        <div class="admin-ad-content-grid">

            <!-- =====================================================
                 MAIN CONTENT
                 ===================================================== -->

            <main class="admin-ad-main-column">

                <!-- BASIC INFORMATION -->

                <section class="admin-ad-card">

                    <div class="admin-ad-card-header">

                        <div class="admin-ad-card-title">

                            <div class="admin-ad-section-icon">
                                <i class="bi bi-card-text"></i>
                            </div>

                            <div>
                                <h2>Basic Information</h2>
                                <p>Advertisement title and description.</p>
                            </div>

                        </div>

                    </div>

                    <div class="admin-ad-card-body">

                        <div class="admin-ad-form-grid">

                            <div class="admin-ad-form-group admin-ad-form-full">

                                <label>
                                    Title
                                </label>

                                @if (_isEditMode)
                                {
                                    <InputText class="admin-ad-input"
                                               @bind-Value="_editModel.Title" />
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @DisplayValue(_advertisement.Title)
                                    </div>
                                }

                            </div>

                            <div class="admin-ad-form-group admin-ad-form-full">

                                <label>
                                    Arabic Title
                                </label>

                                @if (_isEditMode)
                                {
                                    <InputText class="admin-ad-input"
                                               dir="rtl"
                                               @bind-Value="_editModel.TitleAr" />
                                }
                                else
                                {
                                    <div class="admin-ad-value arabic-value">
                                        @DisplayValue(_advertisement.TitleAr)
                                    </div>
                                }

                            </div>

                            <div class="admin-ad-form-group admin-ad-form-full">

                                <label>
                                    Description
                                </label>

                                @if (_isEditMode)
                                {
                                    <InputTextArea class="admin-ad-textarea"
                                                   @bind-Value="_editModel.Description" />
                                }
                                else
                                {
                                    <div class="admin-ad-description">
                                        @DisplayValue(_advertisement.Description)
                                    </div>
                                }

                            </div>

                            <div class="admin-ad-form-group admin-ad-form-full">

                                <label>
                                    Arabic Description
                                </label>

                                @if (_isEditMode)
                                {
                                    <InputTextArea class="admin-ad-textarea"
                                                   dir="rtl"
                                                   @bind-Value="_editModel.DescriptionAr" />
                                }
                                else
                                {
                                    <div class="admin-ad-description arabic-value">
                                        @DisplayValue(_advertisement.DescriptionAr)
                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </section>


                <!-- CATEGORY / TYPE / PRICE -->

                <section class="admin-ad-card">

                    <div class="admin-ad-card-header">

                        <div class="admin-ad-card-title">

                            <div class="admin-ad-section-icon">
                                <i class="bi bi-tags-fill"></i>
                            </div>

                            <div>
                                <h2>Advertisement Classification</h2>
                                <p>Category, type and pricing information.</p>
                            </div>

                        </div>

                    </div>

                    <div class="admin-ad-card-body">

                        <div class="admin-ad-form-grid">

                            <div class="admin-ad-form-group">

                                <label>Category</label>

                                @if (_isEditMode)
                                {
                                    <select class="admin-ad-select"
                                            @bind="_editModel.CategoryID">

                                        <option value="0">
                                            Select category
                                        </option>

                                        @foreach (var item in _categories)
                                        {
                                            <option value="@item.ID">
                                                @item.Name
                                            </option>
                                        }

                                    </select>
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @_advertisement.CategoryName
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group">

                                <label>Advertisement Type</label>

                                @if (_isEditMode)
                                {
                                    <select class="admin-ad-select"
                                            @bind="_editModel.AdvertisementTypeID">

                                        <option value="0">
                                            Select type
                                        </option>

                                        @foreach (var item in _advertisementTypes)
                                        {
                                            <option value="@item.ID">
                                                @item.Name
                                            </option>
                                        }

                                    </select>
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @_advertisement.AdvertisementTypeName
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group">

                                <label>Price</label>

                                @if (_isEditMode)
                                {
                                    <InputNumber class="admin-ad-input"
                                                 @bind-Value="_editModel.Price" />
                                }
                                else
                                {
                                    <div class="admin-ad-price-value">
                                        @FormatPrice(_advertisement.Price)
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group">

                                <label>Currency</label>

                                @if (_isEditMode)
                                {
                                    <InputText class="admin-ad-input"
                                               maxlength="3"
                                               @bind-Value="_editModel.CurrencyCode" />
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @_advertisement.CurrencyCode
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group admin-ad-checkbox-group">

                                <label class="admin-ad-checkbox-label">

                                    @if (_isEditMode)
                                    {
                                        <InputCheckbox
                                            @bind-Value="_editModel.IsNegotiable" />
                                    }
                                    else
                                    {
                                        <span class="admin-ad-checkbox-display
                                            @(_advertisement.IsNegotiable
                                                ? "checked"
                                                : "")">
                                            <i class="bi bi-check"></i>
                                        </span>
                                    }

                                    <span>
                                        Price is negotiable
                                    </span>

                                </label>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- CONTACT -->

                <section class="admin-ad-card">

                    <div class="admin-ad-card-header">

                        <div class="admin-ad-card-title">

                            <div class="admin-ad-section-icon">
                                <i class="bi bi-person-lines-fill"></i>
                            </div>

                            <div>
                                <h2>Contact Information</h2>
                                <p>Contact details and public visibility settings.</p>
                            </div>

                        </div>

                    </div>

                    <div class="admin-ad-card-body">

                        <div class="admin-ad-contact-grid">

                            <div class="admin-ad-contact-item">

                                <div class="admin-ad-contact-icon whatsapp">
                                    <i class="bi bi-whatsapp"></i>
                                </div>

                                <div class="admin-ad-contact-content">

                                    <span>WhatsApp Number</span>

                                    @if (_isEditMode)
                                    {
                                        <InputText class="admin-ad-input"
                                                   @bind-Value="_editModel.WhatsAppNumber" />
                                    }
                                    else
                                    {
                                        <strong>
                                            @DisplayValue(_advertisement.WhatsAppNumber)
                                        </strong>
                                    }

                                </div>

                                <div class="admin-ad-visibility">

                                    @if (_isEditMode)
                                    {
                                        <label class="admin-ad-switch-label">

                                            <InputCheckbox
                                                @bind-Value="_editModel.ShowWhatsAppToPublic" />

                                            <span class="admin-ad-switch"></span>

                                            <small>Public</small>

                                        </label>
                                    }
                                    else
                                    {
                                        <span class="admin-ad-visibility-badge
                                            @(_advertisement.ShowWhatsAppToPublic
                                                ? "visible"
                                                : "hidden")">

                                            <i class="bi @(_advertisement.ShowWhatsAppToPublic
                                                ? "bi-eye-fill"
                                                : "bi-eye-slash-fill")"></i>

                                            @(_advertisement.ShowWhatsAppToPublic
                                                ? "Public"
                                                : "Private")

                                        </span>
                                    }

                                </div>

                            </div>


                            <div class="admin-ad-contact-item">

                                <div class="admin-ad-contact-icon email">
                                    <i class="bi bi-envelope-fill"></i>
                                </div>

                                <div class="admin-ad-contact-content">

                                    <span>Email Address</span>

                                    @if (_isEditMode)
                                    {
                                        <InputText class="admin-ad-input"
                                                   type="email"
                                                   @bind-Value="_editModel.ContactEmail" />
                                    }
                                    else
                                    {
                                        <strong>
                                            @DisplayValue(_advertisement.ContactEmail)
                                        </strong>
                                    }

                                </div>

                                <div class="admin-ad-visibility">

                                    @if (_isEditMode)
                                    {
                                        <label class="admin-ad-switch-label">

                                            <InputCheckbox
                                                @bind-Value="_editModel.ShowEmailToPublic" />

                                            <span class="admin-ad-switch"></span>

                                            <small>Public</small>

                                        </label>
                                    }
                                    else
                                    {
                                        <span class="admin-ad-visibility-badge
                                            @(_advertisement.ShowEmailToPublic
                                                ? "visible"
                                                : "hidden")">

                                            <i class="bi @(_advertisement.ShowEmailToPublic
                                                ? "bi-eye-fill"
                                                : "bi-eye-slash-fill")"></i>

                                            @(_advertisement.ShowEmailToPublic
                                                ? "Public"
                                                : "Private")

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                        <div class="admin-ad-contact-note">

                            <i class="bi bi-info-circle-fill"></i>

                            <span>
                                Public visibility controls determine which contact
                                details are shown to other users. Administrators
                                can always view the complete contact information.
                            </span>

                        </div>

                    </div>

                </section>


                <!-- LOCATION -->

                <section class="admin-ad-card">

                    <div class="admin-ad-card-header">

                        <div class="admin-ad-card-title">

                            <div class="admin-ad-section-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>

                            <div>
                                <h2>Location</h2>
                                <p>Advertisement location and address information.</p>
                            </div>

                        </div>

                    </div>

                    <div class="admin-ad-card-body">

                        <div class="admin-ad-form-grid">

                            <div class="admin-ad-form-group">

                                <label>Country</label>

                                @if (_isEditMode)
                                {
                                    <select class="admin-ad-select"
                                            value="@_editModel.CountryID"
                                            @onchange="CountryChangedAsync">

                                        <option value="">
                                            Select country
                                        </option>

                                        @foreach (var item in _countries)
                                        {
                                            <option value="@item.ID">
                                                @item.Name
                                            </option>
                                        }

                                    </select>
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @GetLookupName(
                                            _countries,
                                            _advertisement.CountryID)
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group">

                                <label>State / Governorate</label>

                                @if (_isEditMode)
                                {
                                    <select class="admin-ad-select"
                                            value="@_editModel.StateID"
                                            @onchange="StateChangedAsync"
                                            disabled="@(!_editModel.CountryID.HasValue)">

                                        <option value="">
                                            Select state
                                        </option>

                                        @foreach (var item in _states)
                                        {
                                            <option value="@item.ID">
                                                @item.Name
                                            </option>
                                        }

                                    </select>
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @GetLookupName(
                                            _states,
                                            _advertisement.StateID)
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group">

                                <label>City</label>

                                @if (_isEditMode)
                                {
                                    <select class="admin-ad-select"
                                            value="@_editModel.CityID"
                                            @onchange="CityChangedAsync"
                                            disabled="@(!_editModel.CountryID.HasValue)">

                                        <option value="">
                                            Select city
                                        </option>

                                        @foreach (var item in _cities)
                                        {
                                            <option value="@item.ID">
                                                @item.Name
                                            </option>
                                        }

                                    </select>
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @GetLookupName(
                                            _cities,
                                            _advertisement.CityID)
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group">

                                <label>Area</label>

                                @if (_isEditMode)
                                {
                                    <select class="admin-ad-select"
                                            value="@_editModel.AreaID"
                                            @onchange="AreaChangedAsync"
                                            disabled="@(!_editModel.CityID.HasValue)">

                                        <option value="">
                                            Select area
                                        </option>

                                        @foreach (var item in _areas)
                                        {
                                            <option value="@item.ID">
                                                @item.Name
                                            </option>
                                        }

                                    </select>
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @GetLookupName(
                                            _areas,
                                            _advertisement.AreaID)
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group admin-ad-form-full">

                                <label>Address</label>

                                @if (_isEditMode)
                                {
                                    <InputText class="admin-ad-input"
                                               @bind-Value="_editModel.AddressLine" />
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @DisplayValue(_advertisement.AddressLine)
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group">

                                <label>Plot Number</label>

                                @if (_isEditMode)
                                {
                                    <InputText class="admin-ad-input"
                                               @bind-Value="_editModel.PlotNumber" />
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @DisplayValue(_advertisement.PlotNumber)
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group">

                                <label>Latitude</label>

                                @if (_isEditMode)
                                {
                                    <InputNumber class="admin-ad-input"
                                                 @bind-Value="_editModel.Latitude" />
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @FormatDecimal(_advertisement.Latitude)
                                    </div>
                                }

                            </div>


                            <div class="admin-ad-form-group">

                                <label>Longitude</label>

                                @if (_isEditMode)
                                {
                                    <InputNumber class="admin-ad-input"
                                                 @bind-Value="_editModel.Longitude" />
                                }
                                else
                                {
                                    <div class="admin-ad-value">
                                        @FormatDecimal(_advertisement.Longitude)
                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </section>


                <!-- PROPERTY DETAILS -->

                <section class="admin-ad-card">

                    <div class="admin-ad-card-header">

                        <div class="admin-ad-card-title">

                            <div class="admin-ad-section-icon">
                                <i class="bi bi-house-fill"></i>
                            </div>

                            <div>
                                <h2>Property Details</h2>
                                <p>Additional property information.</p>
                            </div>

                        </div>

                    </div>

                    <div class="admin-ad-card-body">

                        <div class="admin-ad-stat-grid">

                            <div class="admin-ad-stat-item">

                                <i class="bi bi-rulers"></i>

                                <span>Land Area</span>

                                @if (_isEditMode)
                                {
                                    <InputNumber class="admin-ad-input"
                                                 @bind-Value="_editModel.LandArea" />
                                }
                                else
                                {
                                    <strong>
                                        @FormatDecimal(_advertisement.LandArea)
                                    </strong>
                                }

                            </div>


                            <div class="admin-ad-stat-item">

                                <i class="bi bi-building"></i>

                                <span>Built-up Area</span>

                                @if (_isEditMode)
                                {
                                    <InputNumber class="admin-ad-input"
                                                 @bind-Value="_editModel.BuiltUpArea" />
                                }
                                else
                                {
                                    <strong>
                                        @FormatDecimal(_advertisement.BuiltUpArea)
                                    </strong>
                                }

                            </div>


                            <div class="admin-ad-stat-item">

                                <i class="bi bi-door-open-fill"></i>

                                <span>Bedrooms</span>

                                @if (_isEditMode)
                                {
                                    <InputNumber class="admin-ad-input"
                                                 @bind-Value="_editModel.Bedrooms" />
                                }
                                else
                                {
                                    <strong>
                                        @DisplayInt(_advertisement.Bedrooms)
                                    </strong>
                                }

                            </div>


                            <div class="admin-ad-stat-item">

                                <i class="bi bi-droplet-fill"></i>

                                <span>Bathrooms</span>

                                @if (_isEditMode)
                                {
                                    <InputNumber class="admin-ad-input"
                                                 @bind-Value="_editModel.Bathrooms" />
                                }
                                else
                                {
                                    <strong>
                                        @DisplayInt(_advertisement.Bathrooms)
                                    </strong>
                                }

                            </div>


                            <div class="admin-ad-stat-item">

                                <i class="bi bi-calendar3"></i>

                                <span>Property Age</span>

                                @if (_isEditMode)
                                {
                                    <InputNumber class="admin-ad-input"
                                                 @bind-Value="_editModel.PropertyAge" />
                                }
                                else
                                {
                                    <strong>
                                        @DisplayInt(_advertisement.PropertyAge)
                                    </strong>
                                }

                            </div>

                        </div>

                    </div>

                </section>


                <!-- MEDIA -->

                @if (_advertisement.Images?.Any() == true)
                {
                    <section class="admin-ad-card">

                        <div class="admin-ad-card-header">

                            <div class="admin-ad-card-title">

                                <div class="admin-ad-section-icon">
                                    <i class="bi bi-images"></i>
                                </div>

                                <div>
                                    <h2>Photos</h2>
                                    <p>
                                        Advertisement photographs.
                                    </p>
                                </div>

                            </div>

                            <span class="admin-ad-card-count">
                                @_advertisement.Images.Count
                            </span>

                        </div>

                        <div class="admin-ad-card-body">

                            <div class="admin-ad-gallery">

                                @foreach (var image in _advertisement.Images)
                                {
                                    <div class="admin-ad-gallery-item">

                                        @if (!string.IsNullOrWhiteSpace(image.FileURL))
                                        {
                                            <img src="@image.FileURL"
                                                 alt="Advertisement photo"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="admin-ad-gallery-placeholder">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }

                                    </div>
                                }

                            </div>

                        </div>

                    </section>
                }

            </main>


            <!-- =====================================================
                 SIDEBAR
                 ===================================================== -->

            <aside class="admin-ad-sidebar">

                <!-- OWNER -->

                <section class="admin-ad-card admin-ad-owner-card">

                    <div class="admin-ad-card-header">

                        <div class="admin-ad-card-title">

                            <div class="admin-ad-section-icon">
                                <i class="bi bi-person-fill"></i>
                            </div>

                            <div>
                                <h2>Owner</h2>
                                <p>Advertisement owner.</p>
                            </div>

                        </div>

                    </div>

                    <div class="admin-ad-card-body">

                        <div class="admin-ad-owner">

                            <div class="admin-ad-owner-avatar">
                                @GetInitials(_advertisement.UserName)
                            </div>

                            <div class="admin-ad-owner-info">

                                <strong>
                                    @_advertisement.UserName
                                </strong>

                                <span>
                                    User ID: @_advertisement.UserID
                                </span>

                            </div>

                        </div>

                        <div class="admin-ad-owner-details">

                            <div>
                                <i class="bi bi-envelope"></i>
                                <span>
                                    @DisplayValue(_advertisement.Email)
                                </span>
                            </div>

                            <div>
                                <i class="bi bi-phone"></i>
                                <span>
                                    @DisplayValue(_advertisement.MobileNo)
                                </span>
                            </div>

                        </div>

                    </div>

                </section>


                <!-- DATES -->

                <section class="admin-ad-card">

                    <div class="admin-ad-card-header">

                        <div class="admin-ad-card-title">

                            <div class="admin-ad-section-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>

                            <div>
                                <h2>Timeline</h2>
                                <p>Advertisement lifecycle.</p>
                            </div>

                        </div>

                    </div>

                    <div class="admin-ad-card-body">

    <div class="admin-ad-timeline">

        <!-- Created -->
        <div class="admin-ad-timeline-item">

            <span class="admin-ad-timeline-dot"></span>

            <div class="admin-ad-timeline-content">
                <small>Created</small>
                <strong>
                    @_advertisement.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
                    <span class="timeline-time">
                        · @_advertisement.CreatedDate.ToLocalTime().ToString("h:mm tt")
                    </span>
                </strong>
            </div>

        </div>

        <!-- Last Modified -->
        @if (_advertisement.ModifiedDate.HasValue)
        {
            <div class="admin-ad-timeline-item">

                <span class="admin-ad-timeline-dot"></span>

                <div class="admin-ad-timeline-content">
                    <small>Last Modified</small>
                    <strong>
                        @_advertisement.ModifiedDate.Value.ToLocalTime().ToString("dd MMM yyyy")
                        <span class="timeline-time">
                            · @_advertisement.ModifiedDate.Value.ToLocalTime().ToString("h:mm tt")
                        </span>
                    </strong>
                </div>

            </div>
        }

        <!-- Published -->
        @if (_advertisement.PublishedDate.HasValue)
        {
            <div class="admin-ad-timeline-item">

                <span class="admin-ad-timeline-dot published"></span>

                <div class="admin-ad-timeline-content">
                    <small>Published</small>
                    <strong>
                        @_advertisement.PublishedDate.Value.ToLocalTime().ToString("dd MMM yyyy")
                        <span class="timeline-time">
                            · @_advertisement.PublishedDate.Value.ToLocalTime().ToString("h:mm tt")
                        </span>
                    </strong>
                </div>

            </div>
        }

        <!-- Expiry -->
        @if (_advertisement.ExpiryDate.HasValue)
        {
            <div class="admin-ad-timeline-item">

                <span class="admin-ad-timeline-dot expiry"></span>

                <div class="admin-ad-timeline-content">
                    <small>Expiry</small>
                    <strong>
                        @_advertisement.ExpiryDate.Value.ToLocalTime().ToString("dd MMM yyyy")
                        <span class="timeline-time">
                            · @_advertisement.ExpiryDate.Value.ToLocalTime().ToString("h:mm tt")
                        </span>
                    </strong>
                </div>

            </div>
        }

    </div>

</div>

                </section>


                <!-- MODERATION -->

                <section class="admin-ad-card admin-ad-moderation-card">

                    <div class="admin-ad-card-header">

                        <div class="admin-ad-card-title">

                            <div class="admin-ad-section-icon moderation">
                                <i class="bi bi-shield-check"></i>
                            </div>

                            <div>
                                <h2>Moderation</h2>
                                <p>Manage advertisement status.</p>
                            </div>

                        </div>

                    </div>

                    <div class="admin-ad-card-body">

                        <div class="admin-ad-moderation-actions">

                            @if (CanApprove())
                            {
                                <button type="button"
                                        class="admin-ad-moderation-button approve"
                                        @onclick="() => OpenModerationModal(ModerationAction.Approve)"
                                        disabled="@_isBusy">

                                    <i class="bi bi-check-lg"></i>
                                    Approve

                                </button>
                            }

                            @if (CanReject())
                            {
                                <button type="button"
                                        class="admin-ad-moderation-button reject"
                                        @onclick="() => OpenModerationModal(ModerationAction.Reject)"
                                        disabled="@_isBusy">

                                    <i class="bi bi-x-lg"></i>
                                    Reject

                                </button>
                            }

                            @if (CanSuspend())
                            {
                                <button type="button"
                                        class="admin-ad-moderation-button suspend"
                                        @onclick="() => OpenModerationModal(ModerationAction.Suspend)"
                                        disabled="@_isBusy">

                                    <i class="bi bi-pause-fill"></i>
                                    Suspend

                                </button>
                            }

                            @if (CanReactivate())
                            {
                                <button type="button"
                                        class="admin-ad-moderation-button reactivate"
                                        @onclick="() => OpenModerationModal(ModerationAction.Reactivate)"
                                        disabled="@_isBusy">

                                    <i class="bi bi-play-fill"></i>
                                    Reactivate

                                </button>
                            }

                            @if (!CanApprove() &&
                                 !CanReject() &&
                                 !CanSuspend() &&
                                 !CanReactivate())
                            {
                                <div class="admin-ad-no-moderation">
                                    <i class="bi bi-info-circle"></i>
                                    <span>
                                        No moderation actions are available
                                        for the current status.
                                    </span>
                                </div>
                            }

                        </div>

                    </div>

                </section>


                <!-- APPROVAL HISTORY -->

                <section class="admin-ad-card">

                    <div class="admin-ad-card-header">

                        <div class="admin-ad-card-title">

                            <div class="admin-ad-section-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>

                            <div>
                                <h2>Approval History</h2>
                                <p>Moderation activity.</p>
                            </div>

                        </div>

                        @if (_advertisement.ApprovalHistory?.Any() == true)
                        {
                            <span class="admin-ad-card-count">
                                @_advertisement.ApprovalHistory.Count
                            </span>
                        }

                    </div>

                    <div class="admin-ad-card-body">

                        @if (_advertisement.ApprovalHistory?.Any() == true)
                        {
                            <div class="admin-ad-history">

                                @foreach (var history in _advertisement.ApprovalHistory
                                    .OrderByDescending(x => x.ActionDate))
                                {
                                    <div class="admin-ad-history-item">

                                        <div class="admin-ad-history-icon
                                            @GetHistoryClass(history.Action)">

                                            <i class="bi @GetHistoryIcon(history.Action)"></i>

                                        </div>

                                        <div class="admin-ad-history-content">

                                            <strong>
                                                @history.Action
                                            </strong>

                                            <span>
                                                @history.ActionDate
                                                    .ToLocalTime()
                                                    .ToString(
                                                        "dd MMM yyyy, hh:mm tt")
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(history.Comments))
                                            {
                                                <p>
                                                    @history.Comments
                                                </p>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="admin-ad-empty-history">

                                <i class="bi bi-clock-history"></i>

                                <span>
                                    No moderation history is available.
                                </span>

                            </div>
                        }

                    </div>

                </section>

            </aside>

        </div>
    }
</div>


<!-- =============================================================
     MODERATION MODAL
     ============================================================= -->

@if (_showModerationModal)
{
    <div class="admin-ad-modal-backdrop"
         @onclick="HandleModalBackdropClick">

        <div class="admin-ad-modal"
             @onclick:stopPropagation="true">

            <div class="admin-ad-modal-header">

                <div class="admin-ad-modal-icon @GetModalIconClass()">
                    <i class="@GetModalIcon()"></i>
                </div>

                <div>
                    <h2>@GetModalTitle()</h2>
                    <p>
                        Advertisement @_advertisement?.AdvertisementNumber
                    </p>
                </div>

                <button type="button"
                        class="admin-ad-modal-close"
                        @onclick="CloseModerationModal"
                        disabled="@_isModerationProcessing">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

            <div class="admin-ad-modal-body">

                <label class="admin-ad-modal-label">
                    @GetCommentsLabel()
                </label>

                <textarea class="admin-ad-modal-textarea"
                          @bind="_moderationComments"
                          placeholder="@GetCommentsPlaceholder()"></textarea>

                @if (_moderationAction == ModerationAction.Reject)
                {
                    <label class="admin-ad-modal-label">
                        Rejection Reason
                    </label>

                    <select class="admin-ad-select"
                            @bind="_selectedRejectionReasonId">

                        <option value="">
                            Select rejection reason
                        </option>

                        @foreach (var reason in _rejectionReasons)
                        {
                            <option value="@reason.RejectionReasonID">
                                @reason.ReasonName
                            </option>
                        }

                    </select>
                }

            </div>

            <div class="admin-ad-modal-footer">

                <button type="button"
                        class="admin-ad-secondary-button"
                        @onclick="CloseModerationModal"
                        disabled="@_isModerationProcessing">

                    Cancel

                </button>

                <button type="button"
                        class="admin-ad-modal-confirm @GetModalConfirmClass()"
                        @onclick="ConfirmModerationAsync"
                        disabled="@_isModerationProcessing">

                    @if (_isModerationProcessing)
                    {
                        <span class="admin-ad-button-spinner"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <i class="@GetModalIcon()"></i>
                        <span>@GetModalConfirmText()</span>
                    }

                </button>

            </div>

        </div>

    </div>
}


<style>

    /* ============================================================
       PAGE
       ============================================================ */

    .admin-ad-detail-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 28px 32px 60px;
    }


    /* ============================================================
       HEADER
       ============================================================ */

    .admin-ad-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
    }

    .admin-ad-header-left {
        min-width: 0;
    }

    .admin-ad-back-button {
        border: 0;
        background: transparent;
        color: #6b7280;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 0;
        margin-bottom: 18px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: all .2s ease;
    }

    .admin-ad-back-button:hover {
        color: #790000;
        transform: translateX(-3px);
    }

    .admin-ad-header-main {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .admin-ad-header-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #790000, #d30505);
        box-shadow: 0 12px 25px rgba(121, 0, 0, .18);
        flex: 0 0 auto;
        font-size: 23px;
    }

    .admin-ad-eyebrow {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: #996600;
        margin-bottom: 4px;
    }

    .admin-ad-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
        color: #262626;
        letter-spacing: -.5px;
    }

    .admin-ad-header p {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .admin-ad-header-right {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 38px;
    }

    .admin-ad-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
        background: #f3f4f6;
        color: #4b5563;
    }

    .admin-ad-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .admin-ad-status.pending {
        color: #9a6700;
        background: #fff7df;
    }

    .admin-ad-status.published {
        color: #087443;
        background: #eaf9f1;
    }

    .admin-ad-status.rejected {
        color: #a11;
        background: #fff0f0;
    }

    .admin-ad-status.suspended {
        color: #745100;
        background: #fff4df;
    }

    .admin-ad-status.draft {
        color: #59636e;
        background: #eef1f4;
    }


    /* ============================================================
       ACTION BAR
       ============================================================ */

    .admin-ad-action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 18px 20px;
        background: #fff;
        border: 1px solid #ececec;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, .035);
        margin-bottom: 22px;
    }

    .admin-ad-action-title {
        font-size: 16px;
        font-weight: 800;
        color: #252525;
    }

    .admin-ad-action-subtitle {
        margin-top: 3px;
        color: #8a8a8a;
        font-size: 13px;
    }

    .admin-ad-action-buttons {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    /* ============================================================
       BUTTONS
       ============================================================ */

    .admin-ad-refresh-button,
    .admin-ad-edit-button,
    .admin-ad-save-button,
    .admin-ad-primary-button,
    .admin-ad-secondary-button {
        border: 0;
        border-radius: 10px;
        min-height: 40px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        transition: all .2s ease;
    }

    .admin-ad-refresh-button {
        color: #555;
        background: #f4f5f6;
    }

    .admin-ad-refresh-button:hover:not(:disabled) {
        background: #e9eaec;
    }

    .admin-ad-edit-button,
    .admin-ad-save-button,
    .admin-ad-primary-button {
        color: #fff;
        background: linear-gradient(135deg, #790000, #d30505);
        box-shadow: 0 8px 18px rgba(121, 0, 0, .16);
    }

    .admin-ad-edit-button:hover,
    .admin-ad-save-button:hover,
    .admin-ad-primary-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 11px 22px rgba(121, 0, 0, .2);
    }

    .admin-ad-secondary-button {
        color: #555;
        background: #f2f3f4;
    }

    .admin-ad-secondary-button:hover {
        background: #e7e8e9;
    }

    button:disabled {
        opacity: .55;
        cursor: not-allowed;
        transform: none !important;
    }


    /* ============================================================
       GRID
       ============================================================ */

    .admin-ad-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 22px;
        align-items: start;
    }

    .admin-ad-main-column,
    .admin-ad-sidebar {
        min-width: 0;
    }

    .admin-ad-sidebar {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }


