        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .admin-ad-card-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-ad-section-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
