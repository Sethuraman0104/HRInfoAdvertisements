        font-size: 10px;
        font-weight: 800;
    }

    .admin-ad-visibility-badge.visible {
        background: #eaf8f0;
        color: #087443;
    }

    .admin-ad-visibility-badge.hidden {
        background: #f0f1f2;
        color: #777;
    }

