    private bool CanApprove()
    {
        return _advertisement != null &&
               !string.Equals(
                   _advertisement.StatusCode,
                   "PUBLISHED",
                   StringComparison.OrdinalIgnoreCase) &&
               !string.Equals(
                   _advertisement.StatusCode,
                   "SUSPENDED",
                   StringComparison.OrdinalIgnoreCase);
    }


    private bool CanReject()
    {
        return _advertisement != null &&
               !string.Equals(
                   _advertisement.StatusCode,
                   "REJECTED",
                   StringComparison.OrdinalIgnoreCase) &&
               !string.Equals(
                   _advertisement.StatusCode,
                   "PUBLISHED",
                   StringComparison.OrdinalIgnoreCase);
    }


    private bool CanSuspend()
    {
        return _advertisement != null &&
               string.Equals(
                   _advertisement.StatusCode,
                   "PUBLISHED",
                   StringComparison.OrdinalIgnoreCase);
    }


    private bool CanReactivate()
    {
        return _advertisement != null &&
               string.Equals(
                   _advertisement.StatusCode,
                   "SUSPENDED",
                   StringComparison.OrdinalIgnoreCase);
    }


    private void OpenModerationModal(
        ModerationAction action)
    {
        if (_advertisement == null)
        {
            return;
        }

        _moderationAction = action;
        _moderationComments = string.Empty;
        _selectedRejectionReasonId = null;
        _showModerationModal = true;

        ClearMessages();
    }


    private void CloseModerationModal()
    {
        if (_isModerationProcessing)
        {
            return;
        }

        _showModerationModal = false;
        _moderationAction = ModerationAction.None;
        _moderationComments = string.Empty;
        _selectedRejectionReasonId = null;
    }


    private async Task ConfirmModerationAsync()
    {
        if (_advertisement == null ||
            _isModerationProcessing)
        {
            return;
        }

        _isModerationProcessing = true;
        _isBusy = true;

        ClearMessages();

        try
        {
            var adminUserId =
               await GetCurrentAdminUserIdAsync();

            var comments =
                NormalizeComments(
                    _moderationComments);

            bool success;

            switch (_moderationAction)
            {
                case ModerationAction.Approve:

                    success =
                        await AdvertisementModerationService
                            .ApproveAdvertisementAsync(
                                adminUserId,
                                AdvertisementId,
                                new ApproveAdvertisementRequest
                                {
                                    Comments = comments
                                });

                    break;

                case ModerationAction.Reject:

                    success =
                        await AdvertisementModerationService
                            .RejectAdvertisementAsync(
                                adminUserId,
                                AdvertisementId,
                                new RejectAdvertisementRequest
                                {
                                    RejectionReasonID =
                                        _selectedRejectionReasonId,
                                    Comments = comments
                                });

                    break;

                case ModerationAction.Suspend:

                    success =
                        await AdvertisementModerationService
                            .SuspendAdvertisementAsync(
                                adminUserId,
                                AdvertisementId,
                                new SuspendAdvertisementRequest
                                {
                                    Comments = comments
                                });

                    break;

                case ModerationAction.Reactivate:

                    success =
                        await AdvertisementModerationService
                            .ReactivateAdvertisementAsync(
                                adminUserId,
                                AdvertisementId,
                                comments);

                    break;

                default:

                    success = false;

                    break;
            }

            if (!success)
            {
                _errorMessage =
                    "The moderation action could not be completed.";

                return;
            }

            _showModerationModal = false;

            _successMessage =
                $"{GetModalActionName()} completed successfully.";

            _moderationAction =
                ModerationAction.None;

            await ReloadAdvertisementOnlyAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Admin Advertisement Detail] Moderation error: {ex}");

            _errorMessage =
                GetFriendlyErrorMessage(ex);
        }
        finally
        {
            _isModerationProcessing = false;
            _isBusy = false;
        }
    }


    private async Task ReloadAdvertisementOnlyAsync()
    {
        var result =
            await AdvertisementModerationService
                .GetAdvertisementAsync(
                    AdvertisementId);

        if (result != null)
        {
            _advertisement = result;
            CopyAdvertisementToEditModel();
        }
    }


