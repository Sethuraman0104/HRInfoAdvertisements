    private string GetFriendlyErrorMessage(
        Exception ex)
    {
        if (ex is HttpRequestException httpEx &&
            !string.IsNullOrWhiteSpace(
                httpEx.Message))
        {
            return httpEx.Message;
        }

        return string.IsNullOrWhiteSpace(ex.Message)
            ? "An unexpected error occurred."
            : ex.Message;
    }


