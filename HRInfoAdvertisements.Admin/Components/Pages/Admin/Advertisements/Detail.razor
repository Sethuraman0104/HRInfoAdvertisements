    private static string FormatDecimal(
        decimal? value)
    {
        return value.HasValue
            ? value.Value.ToString(
                "0.##",
                CultureInfo.InvariantCulture)
            : "Not provided";
    }


    private static string FormatPrice(
        decimal? value)
    {
        return value.HasValue
            ? value.Value.ToString(
                "#,##0.000",
                CultureInfo.InvariantCulture) +
              " BHD"
            : "Price not specified";
    }


    private static string GetLookupName(
        IEnumerable<LookupItemResponse> items,
        int? id)
    {
        if (!id.HasValue)
        {
            return "Not provided";
        }

        return items
                   .FirstOrDefault(
                       x => x.ID == id.Value)
                   ?.Name
               ?? "Not available";
    }


    private static string GetInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "AD";
        }

        var parts =
            name.Trim()
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        parts[0].Length))
                .ToUpperInvariant();
        }

        return (
            parts[0][0].ToString() +
            parts[^1][0].ToString())
            .ToUpperInvariant();
    }


    private static string GetStatusClass(
        string? status)
    {
        return status?.ToUpperInvariant() switch
        {
            "PUBLISHED" => "published",
            "PENDING_REVIEW" => "pending",
            "REJECTED" => "rejected",
            "SUSPENDED" => "suspended",
            "DRAFT" => "draft",
            _ => string.Empty
        };
    }


    private static string GetHistoryClass(
        string? action)
    {
        if (string.IsNullOrWhiteSpace(action))
        {
            return string.Empty;
        }

        var value =
            action.ToUpperInvariant();

        if (value.Contains("APPROV"))
        {
            return "approve";
        }

        if (value.Contains("REJECT"))
        {
            return "reject";
        }

        if (value.Contains("SUSPEND"))
        {
            return "suspend";
        }

        if (value.Contains("REACTIV"))
        {
            return "reactivate";
        }

        return string.Empty;
    }


    private static string GetHistoryIcon(
        string? action)
    {
        if (string.IsNullOrWhiteSpace(action))
        {
            return "bi-clock-history";
        }

        var value =
            action.ToUpperInvariant();

        if (value.Contains("APPROV"))
        {
            return "bi-check-lg";
        }

        if (value.Contains("REJECT"))
        {
            return "bi-x-lg";
        }

        if (value.Contains("SUSPEND"))
        {
            return "bi-pause-fill";
        }

        if (value.Contains("REACTIV"))
        {
            return "bi-play-fill";
        }

        return "bi-clock-history";
    }


    private static string NormalizeComments(
