    private async Task SaveCategoryAsync()
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;
        dialogErrorMessage = null;

        try
        {
            if (isEditMode)
            {
                var request =
                    new UpdateCategoryRequest
                    {
                        CategoryName =
                            categoryForm.CategoryName,

                        CategoryNameAr =
                            categoryForm.CategoryNameAr,

                        Description =
                            categoryForm.Description,

                        IsActive =
                            categoryForm.IsActive,

                        DisplayOrder =
                            categoryForm.DisplayOrder
                    };

                var updated =
                    await CategoryManagementApiService
                        .UpdateCategoryAsync(
