@page "/admin/categories"

@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.CategoryManagement

@layout HRInfoAdvertisements.Admin.Components.Layout.MainLayout

@inject SiteSettingsService SiteSettingsService
@inject CategoryManagementApiService CategoryManagementApiService
@inject AdminAuthenticationStateProvider AdminAuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Category Management | @siteName</PageTitle>

<div class="admin-categories">

    <PageHeader Icon="bi-tags-fill"
            Eyebrow="CATEGORY MANAGEMENT"
            Title="Categories"
            SetBrowserTitle="true"
            DescriptionContent="@CategoryHeaderDescription"
            ActionContent="@CategoryHeaderActions" />

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="categories-error">
            <div class="categories-error-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div class="categories-error-content">
                <strong>Unable to load categories</strong>
                <span>@errorMessage</span>
            </div>

            <button type="button"
                    @onclick="RefreshAsync"
                    disabled="@isLoading">
                Retry
            </button>
        </div>
    }

    <!-- ============================================================
         FILTER PANEL
         ============================================================ -->

    <section class="categories-filter-panel">

        <div class="categories-filter-header">

            <div class="categories-filter-title">

                <div class="categories-filter-icon">
                    <i class="bi bi-funnel"></i>
                </div>

                <div>
                    <h2>Find Categories</h2>
                    <p>Search and filter advertisement categories.</p>
                </div>

            </div>

            @if (HasActiveFilters)
            {
                <button type="button"
                        class="categories-clear-filters"
                        @onclick="ClearFilters"
                        disabled="@isLoading">

                    <i class="bi bi-x-circle"></i>

                    Clear Filters
                </button>
            }

        </div>

        <div class="categories-filter-grid">

            <!-- SEARCH -->

            <div class="categories-filter-field categories-search-field">

                <label for="categorySearch">
                    Search
                </label>

                <div class="categories-search-wrapper">

                    <i class="bi bi-search"></i>

                    <input id="categorySearch"
                           type="text"
                           class="categories-input"
                           placeholder="Category name, Arabic name or description..."
                           @bind="searchText"
                           @bind:event="oninput"
                           @onkeydown="HandleSearchKeyDown" />

                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <button type="button"
                                class="categories-search-clear"
                                title="Clear search"
                                @onclick="ClearSearch"
                                disabled="@isLoading">

                            <i class="bi bi-x"></i>

                        </button>
                    }

                </div>

            </div>

            <!-- STATUS -->

            <div class="categories-filter-field">

                <label for="categoryStatus">
                    Status
                </label>

                <div class="categories-select-wrapper">

                    <i class="bi bi-toggle-on"></i>

                    <select id="categoryStatus"
                            class="categories-select"
                            @bind="statusFilter">

                        <option value="">All Statuses</option>
                        <option value="ACTIVE">Active</option>
                        <option value="INACTIVE">Inactive</option>

                    </select>

                </div>

            </div>

            <!-- SEARCH BUTTON -->

            <div class="categories-filter-action">

                <button type="button"
                        class="categories-search-button"
                        @onclick="SearchAsync"
                        disabled="@isLoading">

                    <i class="bi bi-search"></i>

                    <span>Search</span>

                </button>

            </div>

        </div>

    </section>


    <!-- ============================================================
     RESULTS
     ============================================================ -->

<section class="categories-results-panel">

    <div class="categories-results-header">

        <div>

            <span class="categories-results-eyebrow">
                CATEGORY DIRECTORY
            </span>

            <h2>Advertisement Categories</h2>

            <p>@GetResultsDescription()</p>

        </div>

        <div class="categories-results-meta">

            @if (totalRecords > 0)
            {
                <span class="categories-result-range">

                    Showing
                    <strong>@FirstRecordNumber</strong>
                    –
                    <strong>@LastRecordNumber</strong>
                    of
                    <strong>@totalRecords</strong>

                </span>
            }
            else
            {
                <span class="categories-result-range">
                    No categories found
                </span>
            }

        </div>

    </div>


    @if (isLoading && !hasLoaded)
    {
        <div class="categories-loading">

            <div class="categories-loading-spinner"></div>

            <strong>Loading categories</strong>

            <span>
                Retrieving advertisement categories...
            </span>

        </div>
    }
    else if (categories.Count == 0)
    {
        <div class="categories-empty">

            <div class="categories-empty-icon">
                <i class="bi bi-tags"></i>
            </div>

            <strong>No categories found</strong>

            <span>
                @GetEmptyMessage()
            </span>

            @if (HasActiveFilters)
            {
                <button type="button"
                        @onclick="ClearFilters">

                    Clear Filters

                </button>
            }

        </div>
    }
    else
    {
        <div class="categories-table-wrapper">

            <table class="categories-table">

                <thead>

                    <tr>

                        <th>Category</th>

                        <th>Arabic Name</th>

                        <th>Description</th>

                        <th>Advertisements</th>

                        <th>Display Order</th>

                        <th>Status</th>

                        <th class="categories-action-column">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var category in categories)
                    {
                        <tr @key="category.CategoryID">

                            <td>

                                <div class="categories-category-cell">

                                    <div class="categories-category-icon">
                                        <i class="bi bi-tag-fill"></i>
                                    </div>

                                    <div class="categories-category-info">

                                        <button type="button"
                                                class="categories-category-name"
                                                @onclick="() => OpenEditDialog(category.CategoryID)">

                                            @category.CategoryName

                                        </button>

                                        <small>
                                            ID #@category.CategoryID
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>

                                @if (!string.IsNullOrWhiteSpace(category.CategoryNameAr))
                                {
                                    <span class="categories-arabic-name"
                                          dir="rtl">

                                        @category.CategoryNameAr

                                    </span>
                                }
                                else
                                {
                                    <span class="categories-not-specified">
                                        Not specified
                                    </span>
                                }

                            </td>


                            <td>

                                <div class="categories-description">

                                    @if (!string.IsNullOrWhiteSpace(category.Description))
                                    {
                                        <span title="@category.Description">
                                            @category.Description
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="categories-not-specified">
                                            No description
                                        </span>
                                    }

                                </div>

                            </td>


                            <td>

                                <div class="categories-ad-count">

                                    <div class="categories-ad-count-icon">
                                        <i class="bi bi-megaphone-fill"></i>
                                    </div>

                                    <strong>
                                        @category.AdvertisementCount
                                    </strong>

                                    <span>
                                        @(category.AdvertisementCount == 1
                                            ? "ad"
                                            : "ads")
                                    </span>

                                </div>

                            </td>


                            <td>

                                <div class="categories-order">

                                    <span>
                                        @category.DisplayOrder
                                    </span>

                                </div>

                            </td>


                            <td>

                                <div class="categories-status-cell">

                                    <span class="@GetStatusClass(category.IsActive)">

                                        <span class="categories-status-dot"></span>

                                        @(category.IsActive
                                            ? "Active"
                                            : "Inactive")

                                    </span>

                                </div>

                            </td>


                            <td class="categories-action-column">

                                <div class="categories-actions">

                                    <button type="button"
                                            class="categories-action-button edit"
                                            title="Edit category"
                                            @onclick="() => OpenEditDialog(category.CategoryID)">

                                        <i class="bi bi-pencil"></i>

                                    </button>

                                    <button type="button"
                                            class="categories-action-button edit"
                                            title="Manage category features"
                                            @onclick="() => OpenFeaturesDialog(category)">

                                        <i class="bi bi-sliders"></i>

                                    </button>
                                    <button type="button"
                                            class="@GetStatusActionClass(category.IsActive)"
                                            title="@(category.IsActive
                                                ? "Deactivate category"
                                                : "Activate category")"
                                            @onclick="() => OpenStatusDialog(category)">

                                        <i class="bi @(category.IsActive
                                            ? "bi-pause-circle"
                                            : "bi-play-circle")">
                                        </i>

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        @if (totalPages > 1)
        {
            <div class="categories-pagination">

                <div class="categories-pagination-info">

                    Page
                    <strong>@pageNumber</strong>
                    of
                    <strong>@totalPages</strong>

                </div>

                <div class="categories-pagination-controls">

                    <button type="button"
                            class="categories-page-button"
                            @onclick="GoToFirstPageAsync"
                            disabled="@(pageNumber <= 1 || isLoading)"
                            title="First page">

                        <i class="bi bi-chevron-double-left"></i>

                    </button>

                    <button type="button"
                            class="categories-page-button"
                            @onclick="GoToPreviousPageAsync"
                            disabled="@(pageNumber <= 1 || isLoading)"
                            title="Previous page">

                        <i class="bi bi-chevron-left"></i>

                    </button>

                    @foreach (var pageNumberValue in GetPageNumbers())
                    {
                        if (pageNumberValue == -1)
                        {
                            <span class="categories-page-ellipsis">
                                …
                            </span>
                        }
                        else
                        {
                            <button type="button"
                                    class="@GetPageButtonClass(pageNumberValue)"
                                    @onclick="() => GoToPageAsync(pageNumberValue)"
                                    disabled="@isLoading">

                                @pageNumberValue

                            </button>
                        }
                    }

                    <button type="button"
                            class="categories-page-button"
                            @onclick="GoToNextPageAsync"
                            disabled="@(pageNumber >= totalPages || isLoading)"
                            title="Next page">

                        <i class="bi bi-chevron-right"></i>

                    </button>

                    <button type="button"
                            class="categories-page-button"
                            @onclick="GoToLastPageAsync"
                            disabled="@(pageNumber >= totalPages || isLoading)"
                            title="Last page">

                        <i class="bi bi-chevron-double-right"></i>

                    </button>

                </div>

            </div>
        }
    }

</section>


    <!-- ============================================================
         ADD / EDIT MODAL
         ============================================================ -->

    @if (showCategoryDialog)
    {
        <div class="categories-modal-backdrop"
             @onclick="CloseCategoryDialog">

            <div class="categories-modal"
                 @onclick:stopPropagation="true">

                <div class="categories-modal-header">

                    <div class="categories-modal-title">

                        <div class="categories-modal-icon">
                            <i class="bi @(isEditMode
                                ? "bi-pencil-square"
                                : "bi-plus-lg")">
                            </i>
                        </div>

                        <div>

                            <span>
                                @(isEditMode
                                    ? "EDIT CATEGORY"
                                    : "NEW CATEGORY")
                            </span>

                            <h2>
                                @(isEditMode
                                    ? "Edit Category"
                                    : "Add Category")
                            </h2>

                        </div>

                    </div>

                    <button type="button"
                            class="categories-modal-close"
                            @onclick="CloseCategoryDialog"
                            disabled="@isSaving">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>


                <EditForm Model="@categoryForm"
                          OnValidSubmit="SaveCategoryAsync">

                    <DataAnnotationsValidator />

                    <div class="categories-modal-body">

                        @if (!string.IsNullOrWhiteSpace(dialogErrorMessage))
                        {
                            <div class="categories-dialog-error">

                                <i class="bi bi-exclamation-circle"></i>

                                <span>
                                    @dialogErrorMessage
                                </span>

                            </div>
                        }

                        <div class="categories-form-grid">

                            <!-- NAME -->

                            <div class="categories-form-field">

                                <label for="categoryName">
                                    Category Name
                                    <span>*</span>
                                </label>

                                <div class="categories-form-input-wrapper">

                                    <i class="bi bi-tag"></i>

                                    <InputText id="categoryName"
                                               class="categories-form-input"
                                               @bind-Value="categoryForm.CategoryName"
                                               placeholder="e.g. Real Estate" />

                                </div>

                                <ValidationMessage For="@(() => categoryForm.CategoryName)" />

                            </div>


                            <!-- ARABIC -->

                            <div class="categories-form-field">

                                <label for="categoryNameAr">
                                    Arabic Category Name
                                </label>

                                <div class="categories-form-input-wrapper arabic">

                                    <i class="bi bi-translate"></i>

                                    <InputText id="categoryNameAr"
                                               class="categories-form-input"
                                               @bind-Value="categoryForm.CategoryNameAr"
                                               placeholder="مثال: العقارات"
                                               dir="rtl" />

                                </div>

                                <ValidationMessage For="@(() => categoryForm.CategoryNameAr)" />

                            </div>


                            <!-- DESCRIPTION -->

                            <div class="categories-form-field full">

                                <label for="categoryDescription">
                                    Description
                                </label>

                                <div class="categories-form-textarea-wrapper">

                                    <i class="bi bi-card-text"></i>

                                    <InputTextArea id="categoryDescription"
                                                   class="categories-form-textarea"
                                                   @bind-Value="categoryForm.Description"
                                                   placeholder="Describe what advertisements belong in this category..."
                                                   rows="4" />

                                </div>

                                <ValidationMessage For="@(() => categoryForm.Description)" />

                            </div>


                            <!-- DISPLAY ORDER -->

                            <div class="categories-form-field">

                                <label for="displayOrder">
                                    Display Order
                                </label>

                                <div class="categories-form-input-wrapper">

                                    <i class="bi bi-sort-numeric-down"></i>

                                    <InputNumber id="displayOrder"
                                                 class="categories-form-input"
                                                 @bind-Value="categoryForm.DisplayOrder" />

                                </div>

                                <small class="categories-form-help">
                                    Lower numbers appear first.
                                </small>

                            </div>


                            <!-- ACTIVE -->

                            <div class="categories-form-field">

                                <label>
                                    Status
                                </label>

                                <label class="categories-toggle">

                                    <InputCheckbox @bind-Value="categoryForm.IsActive" />

                                    <span class="categories-toggle-track">
                                        <span class="categories-toggle-thumb"></span>
                                    </span>

                                    <span class="categories-toggle-text">
                                        @(categoryForm.IsActive
                                            ? "Active"
                                            : "Inactive")
                                    </span>

                                </label>

                            </div>

                        </div>

                    </div>


                    <div class="categories-modal-footer">

                        <button type="button"
                                class="categories-modal-cancel"
                                @onclick="CloseCategoryDialog"
                                disabled="@isSaving">

                            Cancel

                        </button>

                        <button type="submit"
                                class="categories-modal-save"
                                disabled="@isSaving">

                            @if (isSaving)
                            {
                                <span class="categories-button-spinner"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi @(isEditMode
                                    ? "bi-check-lg"
                                    : "bi-plus-lg")">
                                </i>

                                <span>
                                    @(isEditMode
                                        ? "Update Category"
                                        : "Create Category")
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>
    }


    <!-- ============================================================
         STATUS CONFIRMATION
         ============================================================ -->

    @if (showStatusDialog && selectedCategory is not null)
    {
        <div class="categories-modal-backdrop"
             @onclick="CloseStatusDialog">

            <div class="categories-confirm-dialog"
                 @onclick:stopPropagation="true">

                <div class="categories-confirm-icon @(selectedCategory.IsActive ? "warning" : "success")">

                    <i class="bi @(selectedCategory.IsActive
                        ? "bi-pause-circle"
                        : "bi-play-circle")">
                    </i>

                </div>

                <h2>
                    @(selectedCategory.IsActive
                        ? "Deactivate Category?"
                        : "Activate Category?")
                </h2>

                <p>
                    You are about to
                    <strong>
                        @(selectedCategory.IsActive
                            ? "deactivate"
                            : "activate")
                    </strong>
                    the category
                    <strong>
                        @selectedCategory.CategoryName
                    </strong>.
                </p>

                @if (selectedCategory.AdvertisementCount > 0 &&
                     selectedCategory.IsActive)
                {
                    <div class="categories-confirm-note">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            This category currently contains
                            <strong>
                                @selectedCategory.AdvertisementCount
                            </strong>
                            advertisement@(selectedCategory.AdvertisementCount == 1 ? "" : "s").
                            Deactivating it will not delete existing advertisements.
                        </span>

                    </div>
                }

                <div class="categories-confirm-actions">

                    <button type="button"
                            class="categories-confirm-cancel"
                            @onclick="CloseStatusDialog"
                            disabled="@isStatusSaving">

                        Cancel

                    </button>

                    <button type="button"
                            class="@GetConfirmButtonClass(selectedCategory.IsActive)"
                            @onclick="ConfirmStatusChangeAsync"
                            disabled="@isStatusSaving">

                        @if (isStatusSaving)
                        {
                            <span class="categories-button-spinner"></span>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <i class="bi @(selectedCategory.IsActive
                                ? "bi-pause-circle"
                                : "bi-play-circle")">
                            </i>

                            <span>
                                @(selectedCategory.IsActive
                                    ? "Deactivate"
                                    : "Activate")
                            </span>
                        }

                    </button>

                </div>

            </div>

        </div>
    }

</div>


    <!-- CATEGORY FEATURES DIALOG -->
@if (showFeaturesDialog)
{
    <div class="categories-modal-backdrop" @onclick="CloseFeaturesDialog">
        <div class="categories-modal" @onclick:stopPropagation="true">
            <div class="categories-modal-header">
                <div class="categories-modal-title">
                    <div class="categories-modal-icon"><i class="bi bi-sliders"></i></div>
                    <div>
                        <h2>Category Features</h2>
                        <p>@featuresCategoryName</p>
                    </div>
                </div>
                <button type="button" class="categories-modal-close"
                        title="Close" @onclick="CloseFeaturesDialog"
                        disabled="@isSavingFeature">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="categories-modal-body">
                @if (!string.IsNullOrWhiteSpace(featuresErrorMessage))
                {
                    <div class="categories-error">@featuresErrorMessage</div>
                }

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
                    <span class="text-muted">@categoryFeatures.Count feature(s)</span>
                    <button type="button" class="btn btn-primary btn-sm"
                            @onclick="StartCreateFeature" disabled="@(isSavingFeature || isLoadingFeatures)">
                        <i class="bi bi-plus-lg me-1"></i> Add feature
                    </button>
                </div>

                @if (showFeatureEditor)
                {
                    <div class="border rounded p-3 mb-4">
                        <h5>@(editingFeatureId.HasValue ? "Edit feature" : "New feature")</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Feature name *</label>
                                <input class="form-control" @bind="featureForm.FeatureName" maxlength="200" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Arabic feature name</label>
                                <input class="form-control" @bind="featureForm.FeatureNameAr" dir="rtl" maxlength="200" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Data type *</label>
                                <select class="form-select" @bind="featureForm.DataType">
                                    <option value="Text">Text</option>
                                    <option value="Number">Number</option>
                                    <option value="Integer">Integer</option>
                                    <option value="Date">Date</option>
                                    <option value="Boolean">Boolean</option>
                                    <option value="Select">Select</option>
                                    <option value="Radio">Radio</option>
                                    <option value="MultiSelect">MultiSelect</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Display order</label>
                                <input class="form-control" type="number" @bind="featureForm.DisplayOrder" />
                            </div>
                            <div class="col-md-4 d-flex flex-column justify-content-center gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="featureRequired" @bind="featureForm.IsRequired" />
                                    <label class="form-check-label" for="featureRequired">Required</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="featureSearchable" @bind="featureForm.IsSearchable" />
                                    <label class="form-check-label" for="featureSearchable">Searchable</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="featureFilterable" @bind="featureForm.IsFilterable" />
                                    <label class="form-check-label" for="featureFilterable">Filterable</label>
                                </div>
                                @if (editingFeatureId.HasValue)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="featureActive" @bind="featureIsActive" />
                                        <label class="form-check-label" for="featureActive">Active</label>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Help text</label>
                                <textarea class="form-control" rows="2" @bind="featureForm.HelpText"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Arabic help text</label>
                                <textarea class="form-control" rows="2" dir="rtl" @bind="featureForm.HelpTextAr"></textarea>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Minimum value</label>
                                <input class="form-control" type="number" step="any" @bind="featureForm.MinValue" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Maximum value</label>
                                <input class="form-control" type="number" step="any" @bind="featureForm.MaxValue" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Minimum length</label>
                                <input class="form-control" type="number" min="0" @bind="featureForm.MinLength" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Maximum length</label>
                                <input class="form-control" type="number" min="0" @bind="featureForm.MaxLength" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Validation pattern (regular expression)</label>
                                <input class="form-control" @bind="featureForm.ValidationPattern" maxlength="1000" />
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button type="button" class="btn btn-primary"
                                    @onclick="SaveCategoryFeatureAsync" disabled="@isSavingFeature">
                                @(isSavingFeature ? "Saving..." : "Save feature")
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="CancelFeatureEditor" disabled="@isSavingFeature">
                                Cancel
                            </button>
                        </div>
                    </div>
                }

                @if (isLoadingFeatures)
                {
                    <p>Loading category features...</p>
                }
                else if (categoryFeatures.Count == 0)
                {
                    <p>No features have been configured for this category yet.</p>
                }
                else
                {
                    @foreach (var feature in categoryFeatures.OrderBy(f => f.DisplayOrder))
                    {
                        <div class="border rounded p-3 mb-3" @key="feature.AdvertisementFeatureID">
                            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-start">
                                <div>
                                    <strong>@feature.FeatureName</strong>
                                    @if (!string.IsNullOrWhiteSpace(feature.FeatureNameAr))
                                    {
                                        <div dir="rtl">@feature.FeatureNameAr</div>
                                    }
                                    <div class="small text-muted">
                                        Type: @feature.DataType · Order: @feature.DisplayOrder
                                    </div>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        @if (feature.IsRequired) { <span class="badge bg-warning text-dark">Required</span> }
                                        @if (feature.IsSearchable) { <span class="badge bg-info text-dark">Searchable</span> }
                                        @if (feature.IsFilterable) { <span class="badge bg-primary">Filterable</span> }
                                        <span class="badge @(feature.IsActive ? "bg-success" : "bg-secondary")">
