            var request = new CreateCategoryFeatureRequest
            {
                FeatureName = featureForm.FeatureName.Trim(),
                FeatureNameAr = featureForm.FeatureNameAr,
                DataType = featureForm.DataType,
                IsRequired = featureForm.IsRequired,
