    if (string.IsNullOrWhiteSpace(featureForm.FeatureName))
    {
        featuresErrorMessage = "Feature name is required.";
        return;
    }

    if (string.IsNullOrWhiteSpace(featureForm.DataType))
    {
        featuresErrorMessage = "Select a data type.";
        return;
    }

    if (featureForm.MinValue.HasValue && featureForm.MaxValue.HasValue &&
        featureForm.MinValue.Value > featureForm.MaxValue.Value)
    {
        featuresErrorMessage = "Minimum value cannot exceed maximum value.";
        return;
    }

    if (featureForm.MinLength.HasValue && featureForm.MaxLength.HasValue &&
        featureForm.MinLength.Value > featureForm.MaxLength.Value)
    {
        featuresErrorMessage = "Minimum length cannot exceed maximum length.";
        return;
    }

    isSavingFeature = true;
    try
    {
        if (editingFeatureId.HasValue)
        {
            var request = new UpdateCategoryFeatureRequest
            {
                FeatureName = featureForm.FeatureName.Trim(),
                FeatureNameAr = featureForm.FeatureNameAr,
                DataType = featureForm.DataType,
                IsRequired = featureForm.IsRequired,
                HelpText = featureForm.HelpText,
                HelpTextAr = featureForm.HelpTextAr,
                MinValue = featureForm.MinValue,
                MaxValue = featureForm.MaxValue,
                MinLength = featureForm.MinLength,
                MaxLength = featureForm.MaxLength,
                ValidationPattern = featureForm.ValidationPattern,
                IsSearchable = featureForm.IsSearchable,
                IsFilterable = featureForm.IsFilterable,
                DisplayOrder = featureForm.DisplayOrder,
                IsActive = featureIsActive
            };

            await CategoryManagementApiService.UpdateCategoryFeatureAsync(
                featuresCategoryId, editingFeatureId.Value, request);
        }
        else
