                            request);

                if (!updated)
                {
                    dialogErrorMessage =
                        "The category could not be updated.";

                    return;
                }
            }
            else
            {
                var request =
                    new CreateCategoryRequest
                    {
                        CategoryName =
                            categoryForm.CategoryName,

                        CategoryNameAr =
                            categoryForm.CategoryNameAr,

                        Description =
                            categoryForm.Description,

                        IsActive =
                            categoryForm.IsActive,

                        DisplayOrder =
                            categoryForm.DisplayOrder
                    };

                var categoryId =
                    await CategoryManagementApiService
                        .CreateCategoryAsync(
