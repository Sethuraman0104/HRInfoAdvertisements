                GetApiErrorMessage(
                    ex,
                    "Unable to update the category status.");
        }
        finally
        {
            isStatusSaving = false;
        }
    }


    // ============================================================
    // DISPLAY HELPERS
    // ============================================================

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchText) ||
        !string.IsNullOrWhiteSpace(statusFilter);

    private int FirstRecordNumber =>
        totalRecords == 0
            ? 0
            : ((pageNumber - 1) * pageSize) + 1;

    private int LastRecordNumber =>
        Math.Min(
            pageNumber * pageSize,
            totalRecords);

    private string GetResultsDescription()
    {
        if (totalRecords == 0)
        {
            return HasActiveFilters
                ? "No categories match the selected search criteria."
                : "There are currently no advertisement categories.";
        }

        if (HasActiveFilters)
        {
            return "Categories matching your current search and filter criteria.";
        }

        return "All advertisement categories available on the platform.";
    }

    private string GetEmptyMessage()
    {
        if (HasActiveFilters)
        {
            return "Try changing your search terms or clearing the filters.";
        }

        return "Advertisement categories will appear here.";
    }

    private static string GetStatusClass(
        bool isActive)
    {
        return isActive
            ? "categories-status active"
            : "categories-status inactive";
    }

    private static string GetStatusActionClass(
        bool isActive)
    {
        return isActive
            ? "categories-action-button deactivate"
            : "categories-action-button activate";
    }

    private static string GetConfirmButtonClass(
        bool isActive)
    {
        return isActive
            ? "categories-confirm-danger"
            : "categories-confirm-success";
    }

    private static string GetApiErrorMessage(
        Exception ex,
        string fallback)
    {
        if (ex is HttpRequestException &&
            !string.IsNullOrWhiteSpace(ex.Message))
        {
            if (ex.Message.Contains(
                    "already exist",
                    StringComparison.OrdinalIgnoreCase) ||
                ex.Message.Contains(
                    "already in use",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "A category with this name already exists.";
            }
        }

        return fallback;
    }


