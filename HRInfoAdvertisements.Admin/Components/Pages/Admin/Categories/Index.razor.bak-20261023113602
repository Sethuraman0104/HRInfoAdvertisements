    private async Task LoadCategoriesAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            bool? activeFilter =
                statusFilter switch
                {
                    "ACTIVE" => true,
                    "INACTIVE" => false,
                    _ => null
                };

            var result =
                await CategoryManagementApiService
                    .GetCategoriesAsync(
                        search: searchText,
                        isActive: activeFilter,
                        pageNumber: pageNumber,
                        pageSize: pageSize);

            if (result == null)
            {
                categories = new();
                totalRecords = 0;
                totalPages = 0;

                errorMessage =
                    "The category information could not be retrieved. " +
                    "Your session may have expired or you may not have permission to view categories.";

                return;
            }

            categories =
                result.Items ??
                new List<CategoryListItemResponse>();

            pageNumber = result.PageNumber;
            pageSize = result.PageSize;

            totalRecords = result.TotalRecords;
            totalPages = result.TotalPages;

            hasLoaded = true;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/admin",
                replace: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"CATEGORY MANAGEMENT ERROR: {ex}");

            categories = new();

            errorMessage =
                "The category information could not be loaded. " +
                "Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }


