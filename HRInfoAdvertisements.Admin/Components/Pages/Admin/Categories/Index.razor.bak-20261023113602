                ValidationPattern = featureForm.ValidationPattern,
                IsSearchable = featureForm.IsSearchable,
                IsFilterable = featureForm.IsFilterable,
                DisplayOrder = featureForm.DisplayOrder
            };

            var createdId = await CategoryManagementApiService
                .CreateCategoryFeatureAsync(featuresCategoryId, request);

            if (!createdId.HasValue)
            {
                featuresErrorMessage = "The feature could not be created. The API did not return a feature ID.";
                return;
