        }

        ClearMessages();

        var accessToken =
            PublicAuthStateProvider.AccessToken;

        if (string.IsNullOrWhiteSpace(accessToken))
        {
            errorMessage =
                "Your session has expired. Please sign in again.";

            PublicAuthStateProvider.SignOut();

            isAuthenticated = false;

            return;
        }

        isSavingNotificationPreferences = true;

        try
        {
            var request =
                new UpdateNotificationPreferenceRequest
                {
                    EmailNotificationsEnabled =
                        emailNotifications,

                    AdvertisementUpdatesEnabled =
                        advertisementNotifications,

                    FavoriteAdvertisementUpdatesEnabled =
                        favoriteNotifications
                };

            var client =
                HttpClientFactory.CreateClient(
                    "HRInfoAdvertisementsAPI");

            using var httpRequest =
                new HttpRequestMessage(
