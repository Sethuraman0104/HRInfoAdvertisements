    // ================================================================
    // SAVE PROFILE
    // ================================================================

    private async Task SaveProfile()
    {
        if (isSavingProfile)
        {
            return;
        }

        ClearMessages();

        profileErrorMessage = null;

        // ------------------------------------------------------------
        // Client-side validation
        // ------------------------------------------------------------

        firstName =
            firstName?.Trim() ?? string.Empty;

        lastName =
            lastName?.Trim() ?? string.Empty;

        nationality =
            nationality?.Trim() ?? string.Empty;

        preferredLanguage =
            preferredLanguage?.Trim() ?? "en";

        companyName =
            companyName?.Trim() ?? string.Empty;


        if (string.IsNullOrWhiteSpace(firstName))
        {
            profileErrorMessage =
                "First name is required.";

            return;
        }

        if (firstName.Length > 100)
        {
            profileErrorMessage =
                "First name cannot exceed 100 characters.";

            return;
        }

        if (lastName.Length > 100)
        {
            profileErrorMessage =
                "Last name cannot exceed 100 characters.";

            return;
        }

        if (nationality.Length > 100)
        {
            profileErrorMessage =
                "Nationality cannot exceed 100 characters.";

            return;
        }

        if (preferredLanguage.Length > 10)
        {
            profileErrorMessage =
                "Preferred language cannot exceed 10 characters.";

            return;
        }

        if (isBusinessAccount &&
            string.IsNullOrWhiteSpace(companyName))
        {
            profileErrorMessage =
                "Company name is required for a business account.";

            return;
        }

        if (companyName.Length > 250)
        {
            profileErrorMessage =
                "Company name cannot exceed 250 characters.";

            return;
        }


        var accessToken =
            PublicAuthStateProvider.AccessToken;

        if (string.IsNullOrWhiteSpace(accessToken))
        {
            profileErrorMessage =
                "Your session has expired. Please sign in again.";

            PublicAuthStateProvider.SignOut();

            isAuthenticated = false;

            return;
        }


        isSavingProfile = true;

        try
        {
            var request =
                new UpdateUserProfileRequest
                {
                    FirstName = firstName,

                    LastName =
                        string.IsNullOrWhiteSpace(lastName)
                            ? null
                            : lastName,

                    ProfilePhotoURL = null,

                    Nationality =
                        string.IsNullOrWhiteSpace(nationality)
                            ? null
                            : nationality,

                    PreferredLanguage =
                        string.IsNullOrWhiteSpace(
                            preferredLanguage)
                            ? "en"
                            : preferredLanguage,

                    IsBusinessAccount =
                        isBusinessAccount,

                    CompanyName =
                        isBusinessAccount &&
                        !string.IsNullOrWhiteSpace(companyName)
                            ? companyName
                            : null
                };


            var client =
                HttpClientFactory.CreateClient(
                    "HRInfoAdvertisementsAPI");

            using var httpRequest =
                new HttpRequestMessage(
                    HttpMethod.Put,
                    "api/v1/profile");

            httpRequest.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    accessToken);

            httpRequest.Content =
                JsonContent.Create(request);


            var response =
                await client.SendAsync(httpRequest);


            if (response.StatusCode ==
                System.Net.HttpStatusCode.Unauthorized)
            {
                PublicAuthStateProvider.SignOut();

                isAuthenticated = false;

                profileErrorMessage =
                    "Your session has expired. Please sign in again.";

                return;
            }


            var responseBody =
                await response.Content
                    .ReadAsStringAsync();


            if (!response.IsSuccessStatusCode)
            {
                profileErrorMessage =
                    ExtractApiErrorMessage(
                        responseBody,
                        "Unable to save your profile.");

                return;
            }


            var updatedProfile =
                JsonSerializer.Deserialize<
                    UserProfileResponse>(
                        responseBody,
                        new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });


            if (updatedProfile != null)
            {
                firstName =
                    updatedProfile.FirstName ?? string.Empty;

                lastName =
                    updatedProfile.LastName ?? string.Empty;

                nationality =
                    updatedProfile.Nationality ?? string.Empty;

                preferredLanguage =
                    string.IsNullOrWhiteSpace(
                        updatedProfile.PreferredLanguage)
                        ? "en"
                        : updatedProfile.PreferredLanguage;

                isBusinessAccount =
                    updatedProfile.IsBusinessAccount;

                companyName =
                    updatedProfile.CompanyName ?? string.Empty;
            }


            displayName =
                string.Join(
                    " ",
                    new[]
                    {
                        firstName,
                        lastName
                    }
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x)));


            if (string.IsNullOrWhiteSpace(displayName))
            {
                displayName =
                    DefaultDisplayName;
            }

            BuildProfileInitials();


            successMessage =
                "Your profile information has been saved successfully.";
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(
                $"PROFILE SAVE ERROR: {ex.Message}");

            profileErrorMessage =
                "Unable to save your profile. Please try again.";
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"PROFILE SAVE ERROR: {ex}");

            profileErrorMessage =
                "Unable to save your profile. Please try again.";
        }
        finally
        {
            isSavingProfile = false;
        }
    }


