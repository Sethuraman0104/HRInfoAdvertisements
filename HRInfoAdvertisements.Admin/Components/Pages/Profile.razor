@page "/profile"

@using System.Security.Claims
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.Profile.DTOs
@using HRInfoAdvertisements.Application.NotificationPreferences.DTOs
@using HRInfoAdvertisements.Application.DTOs.Authentication
@using HRInfoAdvertisements.Application.DTOs.SystemSettings

@layout HRInfoAdvertisements.Admin.Components.Layout.PublicLayout

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PublicAuthenticationStateProvider PublicAuthStateProvider
@inject AuthApiService AuthApiService
@inject SiteSettingsService SiteSettingsService
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>My Profile | @Site.SiteName</PageTitle>

<div class="profile-page">

    <PublicTopBar />

    <!-- ============================================================
         PROFILE CONTEXT BAR
         ============================================================ -->

    <section class="profile-context">

        <div class="profile-context-inner">

            <div class="profile-context-left">

                <div class="profile-context-icon">
                    <i class="bi bi-person-circle"></i>
                </div>

                <div>
                    <span class="profile-context-eyebrow">
                        ACCOUNT
                    </span>

                    <h1>
                        My Profile
                    </h1>

                    <p>
                        Manage your personal information, account details and preferences.
                    </p>
                </div>

            </div>

            <div class="profile-context-right">

                <button type="button" class="profile-back-button" @onclick="GoToAccount">

                    <i class="bi bi-arrow-left"></i>

                    <span>Account</span>

                </button>

            </div>

        </div>

    </section>


    <!-- ============================================================
         MAIN PROFILE CONTENT
         ============================================================ -->

    <main class="profile-container">

        @if (isLoading)
        {
            <section class="profile-loading">

                <div class="profile-loading-icon">
                    <i class="bi bi-person"></i>
                </div>

                <strong>Loading your profile...</strong>

                <span>
                    Please wait while we load your account information.
                </span>

            </section>
        }
        else if (!isAuthenticated)
        {
            <section class="profile-auth-required">

                <div class="profile-auth-icon">
                    <i class="bi bi-person-lock"></i>
                </div>

                <h2>
                    Sign in required
                </h2>

                <p>
                    Please sign in to manage your profile and account settings.
                </p>

                <button type="button" class="profile-primary-button" @onclick="OpenLogin">

                    <i class="bi bi-box-arrow-in-right"></i>

                    <span>Sign In</span>

                </button>

            </section>
        }
        else
        {
            <!-- ====================================================
                 GLOBAL PROFILE MESSAGE
                 ==================================================== -->

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="profile-alert profile-alert-success">
                    <i class="bi bi-check-circle"></i>

                    <span>
                        @successMessage
                    </span>

                    <button type="button" class="profile-alert-close" @onclick="ClearMessages">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="profile-alert profile-alert-error">
                    <i class="bi bi-exclamation-circle"></i>

                    <span>
                        @errorMessage
                    </span>

                    <button type="button" class="profile-alert-close" @onclick="ClearMessages">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }


            <!-- ====================================================
                 PROFILE HEADER CARD
                 ==================================================== -->

            <section class="profile-header-card">

                <div class="profile-avatar">

                    @if (!string.IsNullOrWhiteSpace(profileInitials))
                    {
                        <span>@profileInitials</span>
                    }
                    else
                    {
                        <i class="bi bi-person"></i>
                    }

                </div>

                <div class="profile-header-content">

                    <span class="profile-eyebrow">
                        MY ACCOUNT
                    </span>

                    <h2>
                        @displayName
                    </h2>

                    <p>
                        @email
                    </p>

                    <div class="profile-status-row">

                        <span class="profile-status active">
                            <span class="profile-status-dot"></span>
                            Active Account
                        </span>

                        <span class="profile-member-label">
                            @Site.SiteName Member
                        </span>

                    </div>

                </div>

                <div class="profile-header-action">

                    <button type="button" class="profile-secondary-button" disabled="@isRefreshing"
                            @onclick="RefreshProfile">

                        @if (isRefreshing)
                        {
                            <span class="profile-button-spinner"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-clockwise"></i>
                        }

                        <span>
                            @(isRefreshing ? "Refreshing..." : "Refresh")
                        </span>

                    </button>

                </div>

            </section>


            <!-- ====================================================
                 PROFILE GRID
                 ==================================================== -->

            <div class="profile-grid">

                <!-- ================================================
                     PERSONAL INFORMATION
                     ================================================ -->

                <section class="profile-card">

                    <div class="profile-card-header">

                        <div class="profile-card-icon personal">
                            <i class="bi bi-person-vcard"></i>
                        </div>

                        <div>

                            <span class="profile-card-eyebrow">
                                PERSONAL
                            </span>

                            <h2>
                                Personal Information
                            </h2>

                        </div>

                    </div>

                    <p class="profile-card-description">
                        Keep your personal information up to date so your
                        account information remains accurate.
                    </p>


                    @if (!string.IsNullOrWhiteSpace(profileErrorMessage))
                    {
                        <div class="profile-inline-alert profile-inline-alert-error">
                            <i class="bi bi-exclamation-circle"></i>

                            <span>
                                @profileErrorMessage
                            </span>
                        </div>
                    }


                    <div class="profile-form-grid">

                        <div class="profile-form-group">

                            <label for="firstName">
                                First Name
                                <span class="profile-required">*</span>
                            </label>

                            <input id="firstName" class="profile-form-input" type="text" maxlength="100" @bind="firstName"
                                   placeholder="Enter your first name" />

                        </div>


                        <div class="profile-form-group">

                            <label for="lastName">
                                Last Name
                            </label>

                            <input id="lastName" class="profile-form-input" type="text" maxlength="100" @bind="lastName"
                                   placeholder="Enter your last name" />

                        </div>


                        <div class="profile-form-group">

                            <label for="nationality">
                                Nationality
                            </label>

                            <input id="nationality" class="profile-form-input" type="text" maxlength="100"
                                   @bind="nationality" placeholder="Enter your nationality" />

                        </div>


                        <div class="profile-form-group">

                            <label for="preferredLanguage">
                                Preferred Language
                            </label>

                            <select id="preferredLanguage" class="profile-form-input" @bind="preferredLanguage">

                                <option value="en">
                                    English
                                </option>

                                <option value="ar">
                                    Arabic
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- ============================================
                         BUSINESS ACCOUNT
                         ============================================ -->

                    <div class="profile-business-section">

                        <label class="profile-preference-option">

                            <input type="checkbox" @bind="isBusinessAccount" />

                            <span class="profile-check-box">
                                <i class="bi bi-check"></i>
                            </span>

                            <span class="profile-preference-content">

                                <strong>
                                    Business Account
                                </strong>

                                <small>
                                    Enable this option if this account represents
                                    a business or company.
                                </small>

                            </span>

                        </label>


                        @if (isBusinessAccount)
                        {
                            <div class="profile-form-group profile-business-company">

                                <label for="companyName">
                                    Company Name
                                    <span class="profile-required">*</span>
                                </label>

                                <input id="companyName" class="profile-form-input" type="text" maxlength="250"
                                       @bind="companyName" placeholder="Enter company name" />

                            </div>
                        }

                    </div>


                    <!-- SUPPORT_EMAIL -->
                    <div class="profile-readonly-note">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            Email address and mobile number are managed separately
                            from your public profile information.
                            @if (!string.IsNullOrWhiteSpace(Site.SupportEmail))
                            {
                                <text>To change them, contact </text>
                                <a href="@($"mailto:{Site.SupportEmail}")">@Site.SupportEmail</a>
                                <text>.</text>
                            }
                        </span>

                    </div>


                    <div class="profile-card-footer">

                        <button type="button" class="profile-primary-button" disabled="@isSavingProfile"
                                @onclick="SaveProfile">

                            @if (isSavingProfile)
                            {
                                <span class="profile-button-spinner"></span>

                                <span>
                                    Saving...
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-check2"></i>

                                <span>
                                    Save Changes
                                </span>
                            }

                        </button>

                    </div>

                </section>


                <!-- ================================================
                     ACCOUNT INFORMATION
                     ================================================ -->

                <section class="profile-card">

                    <div class="profile-card-header">

                        <div class="profile-card-icon account">
                            <i class="bi bi-person-badge"></i>
                        </div>

                        <div>

                            <span class="profile-card-eyebrow">
                                ACCOUNT
                            </span>

                            <h2>
                                Account Information
                            </h2>

                        </div>

                    </div>

                    <p class="profile-card-description">
                        Your account information is managed securely and is used
                        to identify your @Site.SiteName account.
                    </p>

                    <div class="profile-information-list">

                        <div class="profile-information-row">

                            <div class="profile-information-label">

                                <i class="bi bi-envelope"></i>

                                <span>Email Address</span>

                            </div>

                            <strong>
                                @email
                            </strong>

                        </div>


                        <div class="profile-information-row">

                            <div class="profile-information-label">

                                <i class="bi bi-person"></i>

                                <span>Account Name</span>

                            </div>

                            <strong>
                                @displayName
                            </strong>

                        </div>


                        <div class="profile-information-row">

                            <div class="profile-information-label">

                                <i class="bi bi-briefcase"></i>

                                <span>Account Type</span>

                            </div>

                            <strong>
                                @(isBusinessAccount
                                    ? "Business Account"
                                    : "Personal Account")
                            </strong>

                        </div>


                        @if (isBusinessAccount &&
                             !string.IsNullOrWhiteSpace(companyName))
                        {
                            <div class="profile-information-row">

                                <div class="profile-information-label">

                                    <i class="bi bi-building"></i>

                                    <span>Company</span>

                                </div>

                                <strong>
                                    @companyName
                                </strong>

                            </div>
                        }


                        <div class="profile-information-row">

                            <div class="profile-information-label">

                                <i class="bi bi-shield-check"></i>

                                <span>Account Status</span>

                            </div>

                            <span class="profile-badge enabled">
                                Active
                            </span>

                        </div>


                        <div class="profile-information-row">

                            <div class="profile-information-label">

                                <i class="bi bi-calendar3"></i>

                                <span>Membership</span>

                            </div>

                            <strong>
                                @Site.SiteName Member
                            </strong>

                        </div>

                    </div>

                </section>


                <!-- ================================================
                     PASSWORD
                     ================================================ -->

                <section class="profile-card">

                    <div class="profile-card-header">

                        <div class="profile-card-icon security">
                            <i class="bi bi-shield-lock"></i>
                        </div>

                        <div>

                            <span class="profile-card-eyebrow">
                                SECURITY
                            </span>

                            <h2>
                                Password &amp; Security
                            </h2>

                        </div>

                    </div>

                    <p class="profile-card-description">
                        Change your password regularly to help keep your account
                        secure.
                    </p>


                    @if (!string.IsNullOrWhiteSpace(passwordErrorMessage))
                    {
                        <div class="profile-inline-alert profile-inline-alert-error">
                            <i class="bi bi-exclamation-circle"></i>

                            <span>
                                @passwordErrorMessage
                            </span>
                        </div>
                    }


                    <div class="profile-form-group">

                        <label for="currentPassword">
                            Current Password
                            <span class="profile-required">*</span>
                        </label>

                        <div class="profile-password-input">

                            <input id="currentPassword" class="profile-form-input" type="@currentPasswordType"
                                   @bind="currentPassword" autocomplete="current-password"
                                   placeholder="Enter current password" />

                            <button type="button" class="profile-password-toggle" @onclick="ToggleCurrentPassword"
                                    aria-label="Show or hide current password">

                                <i class="bi @(showCurrentPassword
                                    ? "bi-eye-slash"
                                    : "bi-eye")"></i>

                            </button>

                        </div>

                    </div>


                    <div class="profile-form-grid">

                        <div class="profile-form-group">

                            <label for="newPassword">
                                New Password
                                <span class="profile-required">*</span>
                            </label>

                            <div class="profile-password-input">

                                <input id="newPassword" class="profile-form-input" type="@newPasswordType"
                                       @bind="newPassword" autocomplete="new-password" placeholder="Enter new password" />

                            </div>

                        </div>


                        <div class="profile-form-group">

                            <label for="confirmPassword">
                                Confirm Password
                                <span class="profile-required">*</span>
                            </label>

                            <div class="profile-password-input">

                                <input id="confirmPassword" class="profile-form-input" type="@confirmPasswordType"
                                       @bind="confirmPassword" autocomplete="new-password"
                                       placeholder="Confirm new password" />

                            </div>

                        </div>

                    </div>


                    <div class="profile-security-note">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            Your new password must contain at least 8 characters.
                            Use a combination of letters, numbers and special
                            characters for better security.
                        </span>

                    </div>


                    <div class="profile-card-footer">

                        <button type="button" class="profile-primary-button" disabled="@isChangingPassword"
                                @onclick="ChangePassword">

                            @if (isChangingPassword)
                            {
                                <span class="profile-button-spinner"></span>

                                <span>
                                    Changing Password...
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-key"></i>

                                <span>
                                    Change Password
                                </span>
                            }

                        </button>

                    </div>

                </section>


                <!-- ================================================
                     PREFERENCES
                     ================================================ -->

                <!-- ================================================
     PREFERENCES
     ================================================ -->

                <section class="profile-card">

                    <div class="profile-card-header">

                        <div class="profile-card-icon preferences">
                            <i class="bi bi-sliders"></i>
                        </div>

                        <div>

                            <span class="profile-card-eyebrow">
                                PREFERENCES
                            </span>

                            <h2>
                                Notification Preferences
                            </h2>

                        </div>

                    </div>

                    <p class="profile-card-description">
                        Choose how you would like @Site.SiteName to keep you
                        informed about your account and advertisements.
                    </p>


                    @if (isLoadingNotificationPreferences)
                    {
                        <div class="profile-preference-not-available">

                            <div class="profile-preference-not-available-icon">
                                <i class="bi bi-arrow-repeat"></i>
                            </div>

                            <div>

                                <strong>
                                    Loading notification preferences...
                                </strong>

                                <p>
                                    Please wait while your notification settings
                                    are loaded.
                                </p>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="profile-preference-list">

                            <!-- EMAIL NOTIFICATIONS -->

                            <label class="profile-preference-option">

                                <input type="checkbox" @bind="emailNotifications" />

                                <span class="profile-check-box">
                                    <i class="bi bi-check"></i>
                                </span>

                                <span class="profile-preference-content">

                                    <strong>
                                        Email Notifications
                                    </strong>

                                    <small>
                                        Receive important account and marketplace
                                        notifications by email.

                                        @if (!Site.EmailEnabled)
                                        {
                                            <text>
                                                Email delivery is currently turned off
                                                by the site administrator.
                                            </text>
                                        }
                                    </small>

                                </span>

                            </label>


                            <!-- ADVERTISEMENT UPDATES -->

                            <label class="profile-preference-option">

                                <input type="checkbox" @bind="advertisementNotifications" />

                                <span class="profile-check-box">
                                    <i class="bi bi-check"></i>
                                </span>

                                <span class="profile-preference-content">

                                    <strong>
                                        Advertisement Updates
                                    </strong>

                                    <small>
                                        Receive updates related to your posted
                                        advertisements and account activity.
                                    </small>

                                </span>

                            </label>


                            <!-- FAVORITE ADVERTISEMENT UPDATES -->

                            <label class="profile-preference-option">

                                <input type="checkbox" @bind="favoriteNotifications" />

                                <span class="profile-check-box">
                                    <i class="bi bi-check"></i>
                                </span>

                                <span class="profile-preference-content">

                                    <strong>
                                        Favorite Advertisement Updates
                                    </strong>

                                    <small>
                                        Stay informed about changes to advertisements
                                        you have saved.
                                    </small>

                                </span>

                            </label>

                        </div>


                        <div class="profile-card-footer">

                            <button type="button" class="profile-primary-button profile-full-button"
                                    disabled="@isSavingNotificationPreferences" @onclick="SaveNotificationPreferences">

                                @if (isSavingNotificationPreferences)
                                {
                                    <span class="profile-button-spinner"></span>

                                    <span>
                                        Saving...
                                    </span>
                                }
                                else
                                {
                                    <i class="bi bi-check2"></i>

                                    <span>
                                        Save Notification Preferences
                                    </span>
                                }

                            </button>

                        </div>
                    }

                </section>

            </div>


            <!-- ====================================================
                 ACCOUNT ACTIONS
                 ==================================================== -->

            <section class="profile-account-actions">

                <div class="profile-account-actions-content">

                    <div class="profile-account-actions-icon">
                        <i class="bi bi-person-gear"></i>
                    </div>

                    <div>

                        <span class="profile-card-eyebrow">
                            ACCOUNT MANAGEMENT
                        </span>

                        <h2>
                            Manage Your Account
                        </h2>

                        <p>
                            Review your account information or return to your
                            account dashboard.
                        </p>

                    </div>

                </div>

                <div class="profile-account-actions-buttons">

                    <button type="button" class="profile-secondary-button" @onclick="GoToFavorites">

                        <i class="bi bi-heart"></i>

                        <span>
                            My Favorites
                        </span>

                    </button>

                    <button type="button" class="profile-primary-button" @onclick="GoToAccount">

                        <i class="bi bi-grid"></i>

                        <span>
                            Account Dashboard
                        </span>

                    </button>

                </div>

            </section>

        }

    </main>


    <!-- ============================================================
         AUTH MODAL
         ============================================================ -->

    <PublicAuthModal IsOpen="@showAuthModal" IsOpenChanged="@OnAuthModalVisibilityChanged" Mode="@authMode"
                     ModeChanged="@OnAuthModalModeChanged" OnAuthenticated="@OnAuthenticated" />

</div>


@code {

    // ================================================================
    // SITE SETTINGS
    // ================================================================
    //
    // Loaded from /api/v1/system-settings/public (cached).
    // Defaults are used if the API is unavailable.
    // ================================================================

    private PublicSiteSettingsResponse Site { get; set; } = new();

    private string DefaultDisplayName =>
        $"{Site.SiteName} User";


    // ================================================================
    // PAGE STATE
    // ================================================================

    private bool isLoading = true;
    private bool isRefreshing;

    private bool isAuthenticated;

    private bool showAuthModal;

    private PublicAuthModal.AuthMode authMode =
        PublicAuthModal.AuthMode.SignIn;


    // ================================================================
    // USER DISPLAY INFORMATION
    // ================================================================

    private string displayName = string.Empty;

    private string email = string.Empty;

    private string firstName = string.Empty;

    private string lastName = string.Empty;

    private string nationality = string.Empty;

    private string preferredLanguage = "en";

    private bool isBusinessAccount;

    private string companyName = string.Empty;

    private string profileInitials = "U";


    // ================================================================
    // PASSWORD
    // ================================================================

    private string currentPassword = string.Empty;

    private string newPassword = string.Empty;

    private string confirmPassword = string.Empty;

    private bool showCurrentPassword;

    private bool isChangingPassword;


    // ================================================================
    // NOTIFICATION PREFERENCES
    // ================================================================

    private bool emailNotifications = true;

    private bool advertisementNotifications = true;

    private bool favoriteNotifications = true;

    private bool isLoadingNotificationPreferences;

    private bool isSavingNotificationPreferences;


    // ================================================================
    // SAVE STATES
    // ================================================================

    private bool isSavingProfile;

    private string? successMessage;

    private string? errorMessage;

    private string? profileErrorMessage;

    private string? passwordErrorMessage;


    // ================================================================
    // PASSWORD INPUT TYPES
    // ================================================================

    private string currentPasswordType =>
        showCurrentPassword
            ? "text"
            : "password";

    private string newPasswordType =>
        "password";

    private string confirmPasswordType =>
        "password";


    // ================================================================
    // INITIALIZATION
    // ================================================================

    protected override async Task OnInitializedAsync()
    {
        // Settings first, so the fallback display name is correct.
        Site = await SiteSettingsService.GetAsync();

        displayName = DefaultDisplayName;

        await LoadProfile();
    }


    // ================================================================
    // LOAD PROFILE
    // ================================================================

    private async Task LoadProfile()
    {
        isLoading = true;

        ClearMessages();

        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user =
                authenticationState.User;

            isAuthenticated =
                user.Identity?.IsAuthenticated == true;

            if (!isAuthenticated)
            {
                return;
            }


            // --------------------------------------------------------
            // Read identity information from the authentication state.
            // --------------------------------------------------------

            email =
                user.FindFirst(ClaimTypes.Email)?.Value
                ?? user.FindFirst("email")?.Value
                ?? string.Empty;

            displayName =
                user.FindFirst(ClaimTypes.Name)?.Value
                ?? user.FindFirst("name")?.Value
                ?? user.FindFirst("unique_name")?.Value
                ?? DefaultDisplayName;


            // --------------------------------------------------------
            // Load the actual profile from the API.
            // --------------------------------------------------------

            var profile =
                await GetProfileAsync();

            if (profile != null)
            {
                firstName =
                    profile.FirstName ?? string.Empty;

                lastName =
                    profile.LastName ?? string.Empty;

                nationality =
                    profile.Nationality ?? string.Empty;

                preferredLanguage =
                    string.IsNullOrWhiteSpace(
                        profile.PreferredLanguage)
                        ? "en"
                        : profile.PreferredLanguage;

                isBusinessAccount =
                    profile.IsBusinessAccount;

                companyName =
                    profile.CompanyName ?? string.Empty;


                // ----------------------------------------------------
                // Build display name from actual profile information.
                // ----------------------------------------------------

                var profileDisplayName =
                    string.Join(
                        " ",
                        new[]
                        {
                            firstName,
                            lastName
                        }
                        .Where(x =>
                            !string.IsNullOrWhiteSpace(x)));

                if (!string.IsNullOrWhiteSpace(
                        profileDisplayName))
                {
                    displayName =
                        profileDisplayName;
                }
            }
            else
            {
                // ----------------------------------------------------
                // Fallback to authentication claims if the profile
                // record does not exist yet.
                // ----------------------------------------------------

                if (string.IsNullOrWhiteSpace(firstName))
                {
                    firstName =
                        GetFirstName(displayName);
                }

                if (string.IsNullOrWhiteSpace(lastName))
                {
                    lastName =
                        GetLastName(displayName);
                }
            }

            await LoadNotificationPreferences();

            BuildProfileInitials();
        }
        catch (HttpRequestException ex)
        {
            // Log details on the server; show a safe message to the user.
            Console.WriteLine(
                $"PROFILE LOAD ERROR: {ex.Message}");

            errorMessage =
                "Unable to load your profile. Please try again.";
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"PROFILE LOAD ERROR: {ex}");

            errorMessage =
                "Unable to load your profile. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ================================================================
    // GET NOTIFICATION PREFERENCES API
    // ================================================================

    private async Task LoadNotificationPreferences()
    {
        if (isLoadingNotificationPreferences)
        {
            return;
        }

        var accessToken =
            PublicAuthStateProvider.AccessToken;

        if (string.IsNullOrWhiteSpace(accessToken))
        {
            return;
        }

        isLoadingNotificationPreferences = true;

        try
        {
            var client =
                HttpClientFactory.CreateClient(
                    "HRInfoAdvertisementsAPI");

            using var request =
                new HttpRequestMessage(
                    HttpMethod.Get,
                    "api/v1/profile/notification-preferences");

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    accessToken);

            var response =
                await client.SendAsync(request);

            if (response.StatusCode ==
                System.Net.HttpStatusCode.Unauthorized)
            {
                PublicAuthStateProvider.SignOut();

                isAuthenticated = false;

                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var responseBody =
                    await response.Content.ReadAsStringAsync();

                Console.WriteLine(
                    $"NOTIFICATION PREFERENCES LOAD ERROR: " +
                    $"HTTP {(int)response.StatusCode} " +
                    $"{responseBody}");

                return;
            }

            var preferences =
                await response.Content
                    .ReadFromJsonAsync<NotificationPreferenceResponse>();

            if (preferences == null)
            {
                return;
            }

            emailNotifications =
                preferences.EmailNotificationsEnabled;

            advertisementNotifications =
                preferences.AdvertisementUpdatesEnabled;

            favoriteNotifications =
                preferences.FavoriteAdvertisementUpdatesEnabled;
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(
                $"NOTIFICATION PREFERENCES LOAD ERROR: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"NOTIFICATION PREFERENCES LOAD ERROR: {ex}");
        }
        finally
        {
            isLoadingNotificationPreferences = false;
        }
    }

