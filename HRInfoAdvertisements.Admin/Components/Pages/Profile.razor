                    "api/v1/profile/notification-preferences");

            httpRequest.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    accessToken);

            httpRequest.Content =
                JsonContent.Create(request);

