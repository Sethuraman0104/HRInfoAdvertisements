    // ================================================================
    // CHANGE PASSWORD
    // ================================================================

    private async Task ChangePassword()
    {
        if (isChangingPassword)
        {
            return;
        }

        ClearMessages();

        passwordErrorMessage = null;


        // Passwords are NOT trimmed: leading/trailing spaces
        // may be part of a valid password.
        currentPassword =
            currentPassword ?? string.Empty;

        newPassword =
            newPassword ?? string.Empty;

        confirmPassword =
            confirmPassword ?? string.Empty;


        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            passwordErrorMessage =
                "Current password is required.";

            return;
        }


        if (string.IsNullOrWhiteSpace(newPassword))
        {
            passwordErrorMessage =
                "New password is required.";

            return;
        }


        if (newPassword.Length < 8)
        {
            passwordErrorMessage =
                "New password must contain at least 8 characters.";

            return;
        }


        if (string.IsNullOrWhiteSpace(confirmPassword))
        {
            passwordErrorMessage =
                "Please confirm your new password.";

            return;
        }


        if (!string.Equals(
                newPassword,
                confirmPassword,
                StringComparison.Ordinal))
        {
            passwordErrorMessage =
                "New password and confirmation password do not match.";

            return;
        }


        if (string.Equals(
                currentPassword,
                newPassword,
                StringComparison.Ordinal))
        {
            passwordErrorMessage =
                "The new password must be different from your current password.";

            return;
        }


        var accessToken =
            PublicAuthStateProvider.AccessToken;

        if (string.IsNullOrWhiteSpace(accessToken))
        {
            passwordErrorMessage =
                "Your session has expired. Please sign in again.";

            PublicAuthStateProvider.SignOut();

            isAuthenticated = false;

            return;
        }


        isChangingPassword = true;

        try
        {
            var request =
                new ChangePasswordRequest
                {
                    CurrentPassword =
                        currentPassword,

                    NewPassword =
                        newPassword,

                    ConfirmPassword =
                        confirmPassword
                };


            var changed =
                await AuthApiService.ChangePasswordAsync(
                    accessToken,
                    request);


            if (!changed)
            {
                passwordErrorMessage =
                    "The current password is incorrect, " +
                    "the new password is invalid, " +
                    "or the password could not be changed.";

                return;
            }


            // --------------------------------------------------------
            // ChangePasswordAsync on the API revokes all active
            // refresh tokens. Therefore this browser session must
            // also be cleared.
            // --------------------------------------------------------

            currentPassword = string.Empty;

            newPassword = string.Empty;

            confirmPassword = string.Empty;

            showCurrentPassword = false;


            PublicAuthStateProvider.SignOut();

            isAuthenticated = false;

            successMessage =
                "Your password was changed successfully. " +
                "Please sign in again using your new password.";

            authMode =
                PublicAuthModal.AuthMode.SignIn;

            showAuthModal = true;

            await InvokeAsync(
                StateHasChanged);
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(
                $"CHANGE PASSWORD ERROR: {ex.Message}");

            passwordErrorMessage =
                "Unable to change your password. Please try again.";
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"CHANGE PASSWORD ERROR: {ex}");

            passwordErrorMessage =
                "Unable to change your password. Please try again.";
        }
        finally
        {
            isChangingPassword = false;
        }
    }


