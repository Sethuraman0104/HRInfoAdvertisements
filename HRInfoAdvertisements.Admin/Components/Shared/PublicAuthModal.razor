@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using HRInfoAdvertisements.Admin.Services
@using HRInfoAdvertisements.Application.DTOs.Authentication
@using HRInfoAdvertisements.Application.DTOs.SystemSettings

@inject AuthApiService AuthApiService
@inject PublicAuthenticationStateProvider PublicAuthenticationStateProvider
@inject SiteSettingsService SiteSettingsService

@* ============================================================
   AUTHENTICATION MODAL
   Same design and behaviour as the home page modal.
   Usage:
     <PublicAuthModal IsOpen="@showAuthModal"
                      IsOpenChanged="@(v => showAuthModal = v)"
                      Mode="@authMode"
                      ModeChanged="@(m => authMode = m)"
                      OnAuthenticated="@OnAuthenticated" />
   ============================================================ *@

@if (IsOpen)
{
    <div class="auth-overlay" @onclick="CloseAuthModal">

        <section class="auth-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="auth-modal-title"
                 @onclick:stopPropagation="true">

            <!-- ====================================================
                 BRAND PANEL - DESKTOP
                 ==================================================== -->
            <aside class="auth-aside" aria-hidden="true">

                <div class="auth-aside-glow"></div>

                <!-- LOGO -->
                <div class="auth-aside-brand">

                    <div class="auth-logo-glow"></div>

                    <div class="auth-logo-glow-secondary"></div>

                    <div class="auth-logo-stage">

                        <img src="/images/logo/admind_logo_transparent.png"
                             alt="@Site.SiteName"
                             class="auth-aside-logo" />

                    </div>

                </div>


                <!-- BRAND MESSAGE -->
                <div class="auth-aside-copy">

                    <h3>
                        Your marketplace,<br />
                        one account.
                    </h3>

                    <p>
                        Buy, sell and promote with trusted advertisers.
                    </p>

                </div>


                <!-- BENEFITS -->
                <ul class="auth-aside-list">

                    <li>
                        <span>✓</span>
                        <span>Post and manage your advertisements</span>
                    </li>

                    <li>
                        <span>✓</span>
                        <span>Save favourites across devices</span>
                    </li>

                    <li>
                        <span>✓</span>
                        <span>Contact advertisers instantly</span>
                    </li>

                </ul>

            </aside>


            <!-- ====================================================
                 MAIN COLUMN
                 ==================================================== -->
            <div class="auth-main">

                <div class="auth-accent"></div>


                <!-- CLOSE -->
                <button type="button"
                        class="auth-close"
                        title="Close"
                        aria-label="Close"
                        @onclick="CloseAuthModal">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12" />
                        <path d="M18 6 6 18" />
                    </svg>

                </button>


                <!-- ====================================================
                     AUTH HEADER
                     ==================================================== -->
                <div class="auth-header">

                    <!-- BRAND - MOBILE / TABLET -->
                    <div class="auth-brand">

                        <img src="/images/logo/admind_logo_transparent.png"
                             alt="@Site.SiteName"
                             class="auth-brand-logo-image" />

                    </div>


                    <!-- WELCOME -->
                    <div class="auth-welcome">

                        <div class="auth-welcome-icon">

                            @if (authStep == AuthStep.VerifyEmail)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2" />

                                    <path d="m3 7 9 6 9-6" />

                                    <path d="M16 16h.01" />
                                </svg>
                            }
                            else if (authMode == AuthMode.SignIn)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M15 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9" />
                                    <path d="M10 12h10" />
                                    <path d="m17 8 4 4-4 4" />
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                    <path d="M19 8v6" />
                                    <path d="M22 11h-6" />
                                </svg>
                            }

                        </div>


                        <div>

                            <h2 id="auth-modal-title">

                                @if (authStep == AuthStep.VerifyEmail)
                                {
                                    @:Verify your email
                                }
                                else if (authMode == AuthMode.SignIn)
                                {
                                    @:Welcome back
                                }
                                else
                                {
                                    @:Create your account
                                }

                            </h2>


                            <p>

                                @if (authStep == AuthStep.VerifyEmail)
                                {
                                    @:Enter the verification code sent to your email address.
                                }
                                else if (authMode == AuthMode.SignIn)
                                {
                                    @:Sign in to manage your advertisements and account.
                                }
                                else
                                {
                                    @($"Join {Site.SiteName} and start managing your advertisements.")
                                }

                            </p>

                        </div>

                    </div>

                </div>


                <!-- ====================================================
                     AUTH TABS
                     ==================================================== -->
                @if (authStep != AuthStep.VerifyEmail)
                {
                    <div class="auth-tabs">

                        <button type="button"
                                class="auth-tab @(authMode == AuthMode.SignIn ? "active" : "")"
                                @onclick="ShowSignIn">

                            Sign In

                        </button>


                        <button type="button"
                                class="auth-tab @(authMode == AuthMode.SignUp ? "active" : "")"
                                @onclick="ShowSignUp">

                            Sign Up

                        </button>

                    </div>
                }


                <!-- ====================================================
                     SCROLLABLE BODY
                     ==================================================== -->
                <div class="auth-scroll">


                    <!-- =================================================
                         SIGN IN
                         ================================================= -->
                    @if (authStep == AuthStep.SignIn &&
                         authMode == AuthMode.SignIn)
                    {
                        <EditForm Model="@loginModel"
                                  OnValidSubmit="@HandleLogin"
                                  FormName="PublicLoginForm">

                            <DataAnnotationsValidator />

                            <div class="auth-form">

                                <div class="auth-field">

                                    <label for="auth-email">
                                        Email Address
                                    </label>

                                    <div class="auth-input-box">

                                        <span class="auth-input-icon">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <rect x="3"
                                                      y="5"
                                                      width="18"
                                                      height="14"
                                                      rx="2" />

                                                <path d="m3 7 9 6 9-6" />

                                            </svg>

                                        </span>

                                        <InputText id="auth-email"
                                                   class="auth-input"
                                                   @bind-Value="loginModel.Email"
                                                   autocomplete="username"
                                                   placeholder="Enter your email address" />

                                    </div>

                                    <ValidationMessage For="@(() => loginModel.Email)" />

                                </div>


                                <div class="auth-field">

                                    <div class="auth-label-row">

                                        <label for="auth-password">
                                            Password
                                        </label>

                                        <button type="button"
                                                class="auth-forgot"
                                                @onclick="ForgotPassword">

                                            Forgot password?

                                        </button>

                                    </div>


                                    <div class="auth-input-box">

                                        <span class="auth-input-icon">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <rect x="4"
                                                      y="10"
                                                      width="16"
                                                      height="11"
                                                      rx="2" />

                                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                                            </svg>

                                        </span>


                                        <InputText id="auth-password"
                                                   class="auth-input"
                                                   type="@(showPassword ? "text" : "password")"
                                                   @bind-Value="loginModel.Password"
                                                   autocomplete="current-password"
                                                   placeholder="Enter your password" />


                                        <button type="button"
                                                class="auth-password-toggle"
                                                title="Show / hide password"
                                                aria-label="Show / hide password"
                                                @onclick="TogglePassword">

                                            @if (showPassword)
                                            {
                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />

                                                    <circle cx="12"
                                                            cy="12"
                                                            r="3" />

                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="m3 3 18 18" />

                                                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />

                                                    <path d="M9.9 5.2A10.9 10.9 0 0 1 12 5c6.5 0 10 7 10 7a18.3 18.3 0 0 1-3.1 4.1" />

                                                    <path d="M6.2 6.2C3.6 8.2 2 12 2 12s3.5 7 10 7a10.8 10.8 0 0 0 4.1-.8" />

                                                </svg>
                                            }

                                        </button>

                                    </div>

                                    <ValidationMessage For="@(() => loginModel.Password)" />

                                </div>


                                @if (!string.IsNullOrWhiteSpace(errorMessage))
                                {
                                    <div class="auth-error" role="alert">

                                        <div class="auth-error-icon">
                                            !
                                        </div>

                                        <div class="auth-error-content">

                                            <strong>
                                                Sign in failed
                                            </strong>

                                            <span>
                                                @errorMessage
                                            </span>

                                        </div>

                                        <button type="button"
                                                class="auth-error-close"
                                                aria-label="Close error"
                                                @onclick="ClearError">

                                            ×

                                        </button>

                                    </div>
                                }


                                <button type="submit"
                                        class="btn-primary auth-submit"
                                        disabled="@isLoginLoading">

                                    @if (isLoginLoading)
                                    {
                                        <span class="spinner"></span>

                                        <span>
                                            Signing in...
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Sign In
                                        </span>

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M5 12h13" />
                                            <path d="m13 6 6 6-6 6" />

                                        </svg>
                                    }

                                </button>


                                <div class="auth-security">

                                    <div class="auth-security-icon">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M12 3l8 3v5c0 5-3.4 8.7-8 10-4.6-1.3-8-5-8-10V6l8-3Z" />

                                            <path d="m9 12 2 2 4-4" />

                                        </svg>

                                    </div>

                                    <div>

                                        <strong>
                                            Secure account access
                                        </strong>

                                        <span>
                                            Your credentials are transmitted securely.
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </EditForm>
                    }


                    <!-- =================================================
                         SIGN UP
                         ================================================= -->
                    @if (authStep == AuthStep.SignIn &&
                         authMode == AuthMode.SignUp)
                    {
                        <EditForm Model="@signupModel"
                                  OnValidSubmit="@HandleRegistration"
                                  FormName="PublicSignupForm">

                            <DataAnnotationsValidator />

                            <div class="auth-form signup">

                                <div class="signup-info">

                                    <div class="auth-security-icon">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M12 2l9 4v6c0 5-3.8 9.3-9 10-5.2-.7-9-5-9-10V6l9-4Z" />

                                            <path d="M12 8v5" />

                                            <circle cx="12"
                                                    cy="16.5"
                                                    r=".8" />

                                        </svg>

                                    </div>

                                    <div>

                                        <strong>
                                            Advertiser registration
                                        </strong>

                                        <p>
                                            Create an account to publish and manage your advertisements.
                                        </p>

                                    </div>

                                </div>


                                <!-- FULL NAME -->
                                <div class="auth-field full">

                                    <label for="signup-full-name">
                                        Full Name
                                    </label>

                                    <div class="auth-input-box">

                                        <span class="auth-input-icon">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <circle cx="12"
                                                        cy="8"
                                                        r="4" />

                                                <path d="M4 21c.8-4 3.4-6 8-6s7.2 2 8 6" />

                                            </svg>

                                        </span>

                                        <InputText id="signup-full-name"
                                                   class="auth-input"
                                                   @bind-Value="signupModel.FullName"
                                                   autocomplete="name"
                                                   placeholder="Enter your full name" />

                                    </div>

                                    <ValidationMessage For="@(() => signupModel.FullName)" />

                                </div>


                                <!-- EMAIL -->
                                <div class="auth-field">

                                    <label for="signup-email">
                                        Email Address
                                    </label>

                                    <div class="auth-input-box">

                                        <span class="auth-input-icon">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <rect x="3"
                                                      y="5"
                                                      width="18"
                                                      height="14"
                                                      rx="2" />

                                                <path d="m3 7 9 6 9-6" />

                                            </svg>

                                        </span>

                                        <InputText id="signup-email"
                                                   class="auth-input"
                                                   @bind-Value="signupModel.Email"
                                                   autocomplete="email"
                                                   placeholder="Enter your email address" />

                                    </div>

                                    <ValidationMessage For="@(() => signupModel.Email)" />

                                </div>


                                <!-- MOBILE -->
                                <div class="auth-field">

                                    <label for="signup-mobile">
                                        Mobile Number
                                    </label>

                                    <div class="auth-input-box">

                                        <span class="auth-input-icon">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <rect x="6"
                                                      y="2"
                                                      width="12"
                                                      height="20"
                                                      rx="2" />

                                                <path d="M10 18h4" />

                                            </svg>

                                        </span>

                                        <InputText id="signup-mobile"
                                                   class="auth-input"
                                                   @bind-Value="signupModel.MobileNo"
                                                   autocomplete="tel"
                                                   placeholder="Enter your mobile number" />

                                    </div>

                                    <ValidationMessage For="@(() => signupModel.MobileNo)" />

                                </div>


                                <!-- PASSWORD -->
                                <div class="auth-field">

                                    <label for="signup-password">
                                        Password
                                    </label>

                                    <div class="auth-input-box">

                                        <span class="auth-input-icon">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <rect x="4"
                                                      y="10"
                                                      width="16"
                                                      height="11"
                                                      rx="2" />

                                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                                            </svg>

                                        </span>

                                        <InputText id="signup-password"
                                                   class="auth-input"
                                                   type="@(showSignupPassword ? "text" : "password")"
                                                   @bind-Value="signupModel.Password"
                                                   autocomplete="new-password"
                                                   placeholder="Create a password" />

                                        <button type="button"
                                                class="auth-password-toggle"
                                                title="Show / hide password"
                                                aria-label="Show / hide password"
                                                @onclick="ToggleSignupPassword">

                                            @if (showSignupPassword)
                                            {
                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />

                                                    <circle cx="12"
                                                            cy="12"
                                                            r="3" />

                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="m3 3 18 18" />

                                                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />

                                                    <path d="M9.9 5.2A10.9 10.9 0 0 1 12 5c6.5 0 10 7 10 7a18.3 18.3 0 0 1-3.1 4.1" />

                                                    <path d="M6.2 6.2C3.6 8.2 2 12 2 12s3.5 7 10 7a10.8 10.8 0 0 0 4.1-.8" />

                                                </svg>
                                            }

                                        </button>

                                    </div>

                                    <ValidationMessage For="@(() => signupModel.Password)" />

                                </div>


                                <!-- CONFIRM PASSWORD -->
                                <div class="auth-field">

                                    <label for="signup-confirm-password">
                                        Confirm Password
                                    </label>

                                    <div class="auth-input-box">

                                        <span class="auth-input-icon">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <rect x="4"
                                                      y="10"
                                                      width="16"
                                                      height="11"
                                                      rx="2" />

                                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                                            </svg>

                                        </span>

                                        <InputText id="signup-confirm-password"
                                                   class="auth-input"
                                                   type="@(showConfirmPassword ? "text" : "password")"
                                                   @bind-Value="signupModel.ConfirmPassword"
                                                   autocomplete="new-password"
                                                   placeholder="Confirm your password" />

                                        <button type="button"
                                                class="auth-password-toggle"
                                                title="Show / hide password"
                                                aria-label="Show / hide password"
                                                @onclick="ToggleConfirmPassword">

                                            @if (showConfirmPassword)
                                            {
                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />

                                                    <circle cx="12"
                                                            cy="12"
                                                            r="3" />

                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="m3 3 18 18" />

                                                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />

                                                    <path d="M9.9 5.2A10.9 10.9 0 0 1 12 5c6.5 0 10 7 10 7a18.3 18.3 0 0 1-3.1 4.1" />

                                                    <path d="M6.2 6.2C3.6 8.2 2 12 2 12s3.5 7 10 7a10.8 10.8 0 0 0 4.1-.8" />

                                                </svg>
                                            }

                                        </button>

                                    </div>

                                    <ValidationMessage For="@(() => signupModel.ConfirmPassword)" />

                                </div>


                                @if (!string.IsNullOrWhiteSpace(signupErrorMessage))
                                {
                                    <div class="auth-error" role="alert">

                                        <div class="auth-error-icon">
                                            !
                                        </div>

                                        <div class="auth-error-content">

                                            <strong>
                                                Registration failed
                                            </strong>

                                            <span>
                                                @signupErrorMessage
                                            </span>

                                        </div>

                                        <button type="button"
                                                class="auth-error-close"
                                                aria-label="Close error"
                                                @onclick="ClearSignupError">

                                            ×

                                        </button>

                                    </div>
                                }


                                <button type="submit"
                                        class="btn-primary auth-submit"
                                        disabled="@isSignupLoading">

                                    @if (isSignupLoading)
                                    {
                                        <span class="spinner"></span>

                                        <span>
                                            Creating account...
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Create Account
                                        </span>

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M5 12h13" />
                                            <path d="m13 6 6 6-6 6" />

                                        </svg>
                                    }

                                </button>


                                <!-- REQUIRE_EMAIL_VERIFICATION -->
                                @if (Site.RequireEmailVerification)
                                {
                                    <div class="auth-security">

                                        <div class="auth-security-icon">

                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">

                                                <path d="M12 3l8 3v5c0 5-3.4 8.7-8 10-4.6-1.3-8-5-8-10V6l8-3Z" />

                                                <path d="m9 12 2 2 4-4" />

                                            </svg>

                                        </div>

                                        <div>

                                            <strong>
                                                Email verification required
                                            </strong>

                                            <span>
                                                We will send a verification code to your email.
                                            </span>

                                        </div>

                                    </div>
                                }


                                <div class="auth-signup-note">

                                    Already have an account?

                                    <button type="button"
                                            @onclick="ShowSignIn">

                                        Sign In

                                    </button>

                                </div>

                            </div>

                        </EditForm>
                    }


                    <!-- =================================================
                         EMAIL OTP VERIFICATION
                         ================================================= -->
                    @if (authStep == AuthStep.VerifyEmail)
                    {
                        <div class="auth-form">

                            <div class="signup-info">

                                <div class="auth-security-icon">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <rect x="3"
                                              y="5"
                                              width="18"
                                              height="14"
                                              rx="2" />

                                        <path d="m3 7 9 6 9-6" />

                                        <path d="M8 12h.01" />
                                        <path d="M12 12h.01" />
                                        <path d="M16 12h.01" />

                                    </svg>

                                </div>

                                <div>

                                    <strong>
                                        Check your email
                                    </strong>

                                    <p>
                                        We sent a 6-digit verification code to
                                        <strong>@verificationEmail</strong>.
                                    </p>

                                </div>

                            </div>


                            <div class="auth-field">

                                <label for="email-otp">
                                    Verification Code
                                </label>

                                <div class="auth-input-box">

                                    <span class="auth-input-icon">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <rect x="3"
                                                  y="5"
                                                  width="18"
                                                  height="14"
                                                  rx="2" />

                                            <path d="M7 10h10" />
                                            <path d="M7 14h6" />

                                        </svg>

                                    </span>

                                    <input id="email-otp"
                                           class="auth-input"
                                           type="text"
                                           inputmode="numeric"
                                           maxlength="6"
                                           autocomplete="one-time-code"
                                           @bind="otpCode"
                                           placeholder="000000" />

                                </div>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(otpInfoMessage))
                            {
                                <div class="auth-info"
                                     role="status">

                                    <span>
                                        @otpInfoMessage
                                    </span>

                                </div>
                            }


                            @if (!string.IsNullOrWhiteSpace(otpErrorMessage))
                            {
                                <div class="auth-error"
                                     role="alert">

                                    <div class="auth-error-icon">
                                        !
                                    </div>

                                    <div class="auth-error-content">

                                        <strong>
                                            Verification failed
                                        </strong>

                                        <span>
                                            @otpErrorMessage
                                        </span>

                                    </div>

                                    <button type="button"
                                            class="auth-error-close"
                                            aria-label="Close error"
                                            @onclick="ClearOtpError">

                                        ×

                                    </button>

                                </div>
                            }


                            <button type="button"
                                    class="btn-primary auth-submit"
                                    @onclick="HandleVerifyEmailOtp"
                                    disabled="@isOtpLoading">

                                @if (isOtpLoading)
                                {
                                    <span class="spinner"></span>

                                    <span>
                                        Verifying...
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Verify Email
                                    </span>

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M5 12h13" />
                                        <path d="m13 6 6 6-6 6" />

                                    </svg>
                                }

                            </button>


                            <!-- EMAIL_ENABLED -->
                            @if (Site.EmailEnabled)
                            {
                                <div class="auth-otp-actions">

                                    <button type="button"
                                            class="auth-forgot"
                                            @onclick="HandleResendEmailOtp"
                                            disabled="@isResendOtpLoading">

                                        @if (isResendOtpLoading)
                                        {
                                            <span>
                                                Sending...
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Resend verification code
                                            </span>
                                        }

                                    </button>

                                </div>
                            }


                            <div class="auth-security">

                                <div class="auth-security-icon">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M12 3l8 3v5c0 5-3.4 8.7-8 10-4.6-1.3-8-5-8-10V6l8-3Z" />

                                        <path d="M12 8v4" />

                                        <path d="M12 16h.01" />

                                    </svg>

                                </div>

                                <div>

                                    <!-- EMAIL_OTP_EXPIRY_MINUTES -->
                                    <strong>
                                        Verification code expires in @Site.EmailOtpExpiryMinutes minutes
                                    </strong>

                                    <span>
                                        If you do not receive the email, check your spam or junk folder.
                                    </span>

                                </div>

                            </div>


                            <div class="auth-signup-note">

                                <button type="button"
                                        @onclick="BackFromVerification">

                                    ← Back

                                </button>

                            </div>

                        </div>
                    }

                </div>
                <!-- /auth-scroll -->


                <!-- ====================================================
                     AUTH FOOTER
                     ==================================================== -->
                <div class="auth-footer">

                    <span>
                        © @DateTime.Now.Year @Site.SiteName
                    </span>

                    <span class="dot-sep">
                        •
                    </span>

                    <button type="button"
                            @onclick="CloseAuthModal">

                        Return to marketplace

                    </button>

                </div>

            </div>
            <!-- /auth-main -->

        </section>

    </div>
}


@code {

    // ============================================================
    // PUBLIC CONTRACT (same names the existing pages already use)
    // ============================================================

    public enum AuthMode
    {
        SignIn,
        SignUp
    }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public AuthMode Mode { get; set; } = AuthMode.SignIn;

    [Parameter]
    public EventCallback<AuthMode> ModeChanged { get; set; }

    // Raised after a successful sign in / email verification.
    [Parameter]
    public EventCallback OnAuthenticated { get; set; }


    // ============================================================
    // SITE SETTINGS
    // ============================================================

    private PublicSiteSettingsResponse Site { get; set; } = new();


    // ============================================================
    // STATE
    // ============================================================

    private enum AuthStep
    {
        SignIn,
        VerifyEmail
    }

    private AuthMode authMode = AuthMode.SignIn;

    private AuthStep authStep = AuthStep.SignIn;

    private bool wasOpen;

    private bool isLoginLoading;

    private bool isSignupLoading;

    private bool isOtpLoading;

    private bool isResendOtpLoading;

    private bool showPassword;

    private bool showSignupPassword;

    private bool showConfirmPassword;

    private string? errorMessage;

    private string? signupErrorMessage;

    private string? otpErrorMessage;

    private string? otpInfoMessage;

    private string verificationEmail = string.Empty;

    private string otpCode = string.Empty;

    private readonly LoginModel loginModel = new();

    private readonly SignupModel signupModel = new();


    // ============================================================
    // LIFECYCLE
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        Site = await SiteSettingsService.GetAsync();
    }

    protected override void OnParametersSet()
    {
        // Each time the modal opens, start from a clean state.
        if (IsOpen && !wasOpen)
        {
            ResetState();
            authMode = Mode;
        }
        else if (IsOpen)
        {
            // Parent changed the mode while the modal is open.
            authMode = Mode;
        }

        wasOpen = IsOpen;
    }

    private bool IsBusy =>
        isLoginLoading ||
        isSignupLoading ||
        isOtpLoading ||
        isResendOtpLoading;

    private void ResetState()
    {
        authStep = AuthStep.SignIn;

        errorMessage = null;
        signupErrorMessage = null;
        otpErrorMessage = null;
        otpInfoMessage = null;

        showPassword = false;
        showSignupPassword = false;
        showConfirmPassword = false;

        otpCode = string.Empty;
        verificationEmail = string.Empty;

        loginModel.Password = string.Empty;
        signupModel.Password = string.Empty;
        signupModel.ConfirmPassword = string.Empty;
    }


    // ============================================================
    // OPEN / CLOSE / MODE
    // ============================================================

    private async Task CloseAuthModal()
    {
        // Do not allow the modal to close while an operation is active.
        if (IsBusy)
        {
            return;
        }

        ResetState();

        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task SetModeAsync(AuthMode mode)
    {
        authMode = mode;
        authStep = AuthStep.SignIn;

        errorMessage = null;
        signupErrorMessage = null;
        otpErrorMessage = null;
        otpInfoMessage = null;

        showPassword = false;
        showSignupPassword = false;
        showConfirmPassword = false;

        await ModeChanged.InvokeAsync(mode);
    }

    private Task ShowSignIn() =>
        SetModeAsync(AuthMode.SignIn);

    private Task ShowSignUp() =>
        SetModeAsync(AuthMode.SignUp);

    private void TogglePassword() =>
        showPassword = !showPassword;

    private void ToggleSignupPassword() =>
        showSignupPassword = !showSignupPassword;

    private void ToggleConfirmPassword() =>
        showConfirmPassword = !showConfirmPassword;


    // ============================================================
    // COMPLETE SIGN IN (shared by login and OTP verification)
    // ============================================================

    private async Task CompleteSignInAsync(AuthResponse result)
{
    PublicAuthenticationStateProvider.SignIn(
        result.UserID,
        result.UserName,
        result.Email,
        result.Roles,
        result.Permissions,
        result.AccessToken,
        result.RefreshToken,
        result.ExpiresAt);

    ResetState();

    await IsOpenChanged.InvokeAsync(false);

    await OnAuthenticated.InvokeAsync();
}


    // ============================================================
    // LOGIN
    // ============================================================

    private async Task HandleLogin()
    {
        errorMessage = null;
        otpErrorMessage = null;
        otpInfoMessage = null;

        isLoginLoading = true;

        try
        {
            var result =
                await AuthApiService.LoginAsync(
                    loginModel.Email,
                    loginModel.Password);

            if (result is null)
            {
                errorMessage =
                    "Invalid email address or password.";

                return;
            }

            // Existing account but email has not yet been verified.
            // AuthService generates/sends the OTP during LoginAsync.
            if (result.RequiresEmailVerification)
            {
                verificationEmail =
                    string.IsNullOrWhiteSpace(result.Email)
                        ? loginModel.Email
                        : result.Email;

                otpCode = string.Empty;
                otpErrorMessage = null;
                otpInfoMessage = null;

                authStep = AuthStep.VerifyEmail;

                return;
            }

            if (!result.Success)
            {
                errorMessage =
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Login failed. Please check your credentials."
                        : result.Message;

                return;
            }

            isLoginLoading = false;

            await CompleteSignInAsync(result);
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Unable to connect to the authentication service. Please try again.";
        }
        catch
        {
            errorMessage =
                "An unexpected error occurred while signing in.";
        }
        finally
        {
            isLoginLoading = false;
        }
    }


    // ============================================================
    // REGISTRATION
    // ============================================================

    private async Task HandleRegistration()
    {
        signupErrorMessage = null;
        otpErrorMessage = null;
        otpInfoMessage = null;

        isSignupLoading = true;

        try
        {
            var fullName =
                (signupModel.FullName ?? string.Empty)
                    .Trim();

            var nameParts =
                fullName.Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);

            var firstName =
                nameParts.Length > 0
                    ? nameParts[0]
                    : string.Empty;

            var lastName =
                nameParts.Length > 1
                    ? string.Join(
                        " ",
                        nameParts.Skip(1))
                    : string.Empty;

            var result =
                await AuthApiService.RegisterAsync(
                    new HRInfoAdvertisements.Application.DTOs.Authentication.RegisterRequest
                    {
                        UserName = fullName,
                        Email = signupModel.Email.Trim(),
                        MobileNo = signupModel.MobileNo?.Trim(),
                        Password = signupModel.Password,
                        FirstName = firstName,
                        LastName = lastName
                    });

            if (result is null)
            {
                signupErrorMessage =
                    "Unable to create your account. Please try again.";

                return;
            }

            if (!result.Success)
            {
                signupErrorMessage =
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Registration failed. Please check your information and try again."
                        : result.Message;

                return;
            }

            // Registration does not authenticate the user.
            // User must verify email through OTP.
            verificationEmail =
                string.IsNullOrWhiteSpace(result.Email)
                    ? signupModel.Email.Trim()
                    : result.Email;

            otpCode = string.Empty;

            otpErrorMessage = null;
            otpInfoMessage = null;
            signupErrorMessage = null;

            authStep = AuthStep.VerifyEmail;
        }
        catch (HttpRequestException)
        {
            signupErrorMessage =
                "Unable to connect to the authentication service. Please try again.";
        }
        catch
        {
            signupErrorMessage =
                "An unexpected error occurred while creating your account.";
        }
        finally
        {
            isSignupLoading = false;
        }
    }


    // ============================================================
    // VERIFY EMAIL OTP
    // ============================================================

    private async Task HandleVerifyEmailOtp()
    {
        otpErrorMessage = null;
        otpInfoMessage = null;

        var email =
            (verificationEmail ?? string.Empty)
                .Trim();

        var otp =
            (otpCode ?? string.Empty)
                .Trim();

        if (string.IsNullOrWhiteSpace(email))
        {
            otpErrorMessage =
                "Email address is missing. Please return to Sign Up and try again.";

            return;
        }

        if (string.IsNullOrWhiteSpace(otp))
        {
            otpErrorMessage =
                "Please enter the 6-digit verification code.";

            return;
        }

        if (otp.Length != 6 ||
            !otp.All(char.IsDigit))
        {
            otpErrorMessage =
                "Please enter a valid 6-digit verification code.";

            return;
        }

        isOtpLoading = true;

        try
        {
            var result =
                await AuthApiService.VerifyEmailOtpAsync(
                    email,
                    otp);

            if (result is null)
            {
                otpErrorMessage =
                    "Unable to verify the email address. Please try again.";

                return;
            }

            if (!result.Success)
            {
                otpErrorMessage =
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "The verification code is invalid or has expired."
                        : result.Message;

                return;
            }

            // Successful email verification also authenticates the user.
            isOtpLoading = false;

            await CompleteSignInAsync(result);
        }
        catch (HttpRequestException)
        {
            otpErrorMessage =
                "Unable to connect to the authentication service. Please try again.";
        }
        catch
        {
            otpErrorMessage =
                "An unexpected error occurred while verifying your email.";
        }
        finally
        {
            isOtpLoading = false;
        }
    }


    // ============================================================
    // RESEND EMAIL OTP
    // ============================================================

    private async Task HandleResendEmailOtp()
    {
        otpErrorMessage = null;
        otpInfoMessage = null;

        var email =
            (verificationEmail ?? string.Empty)
                .Trim();

        if (string.IsNullOrWhiteSpace(email))
        {
            otpErrorMessage =
                "Email address is missing. Please return to Sign Up and try again.";

            return;
        }

        isResendOtpLoading = true;

        try
        {
            var sent =
                await AuthApiService.ResendEmailVerificationAsync(
                    email);

            if (!sent)
            {
                otpErrorMessage =
                    "Unable to resend the verification code. Please try again.";

                return;
            }

            otpCode = string.Empty;

            otpInfoMessage =
                "A new verification code has been sent to your email.";
        }
        catch (HttpRequestException)
        {
            otpErrorMessage =
                "Unable to connect to the authentication service. Please try again.";
        }
        catch
        {
            otpErrorMessage =
                "An unexpected error occurred while resending the verification code.";
        }
        finally
        {
            isResendOtpLoading = false;
        }
    }


    // ============================================================
    // MESSAGES / NAVIGATION INSIDE THE MODAL
    // ============================================================

    private void ClearError() =>
        errorMessage = null;

    private void ClearSignupError() =>
        signupErrorMessage = null;

    private void ClearOtpError() =>
        otpErrorMessage = null;

    private void BackFromVerification()
    {
        otpCode = string.Empty;

        otpErrorMessage = null;
        otpInfoMessage = null;

        authStep = AuthStep.SignIn;

        // Registration verification returns to Sign Up.
        // Login verification returns to Sign In.
        authMode =
            !string.IsNullOrWhiteSpace(signupModel.Email) &&
            string.Equals(
                verificationEmail,
                signupModel.Email,
                StringComparison.OrdinalIgnoreCase)
                ? AuthMode.SignUp
                : AuthMode.SignIn;
    }

    // SUPPORT_EMAIL
    private void ForgotPassword()
    {
        errorMessage =
            string.IsNullOrWhiteSpace(Site.SupportEmail)
                ? $"Please contact the {Site.SiteName} administrator to reset your password."
                : $"Please contact {Site.SupportEmail} to reset your password.";
    }


    // ============================================================
    // MODELS
    // ============================================================

    private sealed class LoginModel
    {
        [Required(
            ErrorMessage =
                "Email address is required.")]
        [EmailAddress(
            ErrorMessage =
                "Please enter a valid email address.")]
        public string Email { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Password is required.")]
        public string Password { get; set; } =
            string.Empty;
    }


    private sealed class SignupModel
    {
        [Required(
            ErrorMessage =
                "Full name is required.")]
        [MinLength(
            2,
            ErrorMessage =
                "Please enter your full name.")]
        public string FullName { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage =
                "Email address is required.")]
        [EmailAddress(
            ErrorMessage =
                "Please enter a valid email address.")]
        public string Email { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage =
                "Mobile number is required.")]
        public string MobileNo { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage =
                "Password is required.")]
        [MinLength(
            6,
            ErrorMessage =
                "Password must be at least 6 characters.")]
        public string Password { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage =
                "Please confirm your password.")]
        [Compare(
            nameof(Password),
            ErrorMessage =
                "Passwords do not match.")]
        public string ConfirmPassword { get; set; } =
            string.Empty;
    }
}
