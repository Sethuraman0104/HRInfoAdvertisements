@using System.ComponentModel.DataAnnotations
@using HRInfoAdvertisements.Admin.Services
@using Microsoft.AspNetCore.Components.Forms

@inject AuthApiService AuthApiService
@inject PublicAuthenticationStateProvider AuthenticationStateProvider

@if (IsOpen)
{
    <div class="public-auth-overlay"
         @onclick="HandleOverlayClick">

        <div class="public-auth-modal"
             @onclick:stopPropagation="true">

            <!-- ============================================================
                 TOP ACCENT
                 ============================================================ -->

            <div class="public-auth-accent"></div>


            <!-- ============================================================
                 HEADER
                 ============================================================ -->

            <div class="public-auth-header">

                <div class="public-auth-brand">

                    <div class="public-auth-brand-mark">
                        <i class="bi bi-megaphone-fill"></i>
                    </div>

                    <div class="public-auth-brand-text">

                        <div class="public-auth-brand-title">
                            HR INFO ADs
                        </div>

                        <div class="public-auth-brand-subtitle">
                            Your marketplace for everything
                        </div>

                    </div>

                </div>

                <button type="button"
                        class="public-auth-close"
                        @onclick="CloseModal"
                        aria-label="Close">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <!-- ============================================================
                 INTRODUCTION
                 ============================================================ -->

            <div class="public-auth-intro">

                @if (Mode == AuthMode.SignIn)
                {
                    <h2>Welcome back</h2>

                    <p>
                        Sign in to manage your advertisements,
                        favorites and account.
                    </p>
                }
                else
                {
                    <h2>Create your account</h2>

                    <p>
                        Registration is currently handled by the
                        HR INFO ADs administration team.
                    </p>
                }

            </div>


            <!-- ============================================================
                 AUTHENTICATION TABS
                 ============================================================ -->

            <div class="public-auth-tabs">

                <button type="button"
                        class="public-auth-tab @(Mode == AuthMode.SignIn ? "active" : "")"
                        @onclick="() => ChangeMode(AuthMode.SignIn)">

                    <i class="bi bi-box-arrow-in-right"></i>

                    <span>Sign In</span>

                </button>

                <button type="button"
                        class="public-auth-tab @(Mode == AuthMode.SignUp ? "active" : "")"
                        @onclick="() => ChangeMode(AuthMode.SignUp)">

                    <i class="bi bi-person-plus"></i>

                    <span>Sign Up</span>

                </button>

            </div>


            <!-- ============================================================
                 SIGN IN
                 ============================================================ -->

            @if (Mode == AuthMode.SignIn)
            {
                <EditForm Model="@loginModel"
                          OnValidSubmit="@HandleLogin">

                    <DataAnnotationsValidator />

                    <div class="public-auth-form">

                        <!-- ====================================================
                             EMAIL
                             ==================================================== -->

                        <div class="public-auth-field">

                            <label for="auth-email">
                                Email Address
                            </label>

                            <div class="public-auth-input-wrapper">

                                <i class="bi bi-envelope"></i>

                                <InputText id="auth-email"
                                           class="public-auth-input"
                                           @bind-Value="loginModel.Email"
                                           autocomplete="email"
                                           placeholder="Enter your email address" />

                            </div>

                            <ValidationMessage
                                For="@(() => loginModel.Email)" />

                        </div>


                        <!-- ====================================================
                             PASSWORD
                             ==================================================== -->

                        <div class="public-auth-field">

                            <div class="public-auth-label-row">

                                <label for="auth-password">
                                    Password
                                </label>

                                <button type="button"
                                        class="public-auth-forgot"
                                        @onclick="ForgotPassword">

                                    Forgot password?

                                </button>

                            </div>

                            <div class="public-auth-input-wrapper">

                                <i class="bi bi-lock"></i>

                                <InputText id="auth-password"
                                           class="public-auth-input password-input"
                                           type="@PasswordInputType"
                                           @bind-Value="loginModel.Password"
                                           autocomplete="current-password"
                                           placeholder="Enter your password" />

                                <button type="button"
                                        class="public-auth-password-toggle"
                                        @onclick="TogglePassword"
                                        aria-label="Toggle password visibility">

                                    <i class="bi @(showPassword
                                        ? "bi-eye-slash"
                                        : "bi-eye")"></i>

                                </button>

                            </div>

                            <ValidationMessage
                                For="@(() => loginModel.Password)" />

                        </div>


                        <!-- ====================================================
                             ERROR MESSAGE
                             ==================================================== -->

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="public-auth-error">

                                <i class="bi bi-exclamation-circle-fill"></i>

                                <span>
                                    @errorMessage
                                </span>

                            </div>
                        }


                        <!-- ====================================================
                             SIGN IN BUTTON
                             ==================================================== -->

                        <button type="submit"
                                class="public-auth-submit"
                                disabled="@isSubmitting">

                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm"
                                      aria-hidden="true"></span>

                                <span>Signing in...</span>
                            }
                            else
                            {
                                <i class="bi bi-box-arrow-in-right"></i>

                                <span>Sign In</span>
                            }

                        </button>


                        <!-- ====================================================
                             SECURITY MESSAGE
                             ==================================================== -->

                        <div class="public-auth-security">

                            <i class="bi bi-shield-check"></i>

                            <span>
                                Your account information is securely protected.
                            </span>

                        </div>

                    </div>

                </EditForm>
            }
            else
            {
                <!-- ============================================================
                     SIGN UP INFORMATION
                     ============================================================ -->

                <div class="public-auth-signup-info">

                    <div class="public-auth-signup-icon">

                        <i class="bi bi-person-plus-fill"></i>

                    </div>

                    <h3>
                        Registration Request
                    </h3>

                    <p>
                        New account registration is currently handled
                        by the HR INFO ADs administration team.
                    </p>

                    <button type="button"
                            class="public-auth-submit"
                            @onclick="RequestRegistration">

                        <i class="bi bi-envelope"></i>

                        <span>
                            Request Registration
                        </span>

                    </button>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="public-auth-error">

                            <i class="bi bi-info-circle-fill"></i>

                            <span>
                                @errorMessage
                            </span>

                        </div>
                    }

                </div>
            }

        </div>

    </div>
}


@code {

    // ============================================================
    // PARAMETERS
    // ============================================================

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public AuthMode Mode { get; set; } = AuthMode.SignIn;

    [Parameter]
    public EventCallback<AuthMode> ModeChanged { get; set; }

    [Parameter]
    public EventCallback OnAuthenticated { get; set; }


    // ============================================================
    // STATE
    // ============================================================

    private LoginModel loginModel = new();

    private bool isSubmitting;

    private bool showPassword;

    private string? errorMessage;


    // ============================================================
    // PASSWORD INPUT TYPE
    // ============================================================

    private string PasswordInputType =>
        showPassword ? "text" : "password";


    // ============================================================
    // LOGIN
    // ============================================================

    private async Task HandleLogin()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await AuthApiService.LoginAsync(
                loginModel.Email,
                loginModel.Password);

            if (result == null)
            {
                errorMessage =
                    "Invalid email address or password.";

                return;
            }

            AuthenticationStateProvider.SignIn(
                result.UserID,
                result.UserName,
                result.Email,
                result.Roles,
                result.Permissions,
                result.AccessToken,
                result.RefreshToken,
                result.ExpiresAt);

            await CloseModal();

            await OnAuthenticated.InvokeAsync();
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                string.IsNullOrWhiteSpace(ex.Message)
                    ? "Unable to sign in. Please try again."
                    : ex.Message;
        }
        catch (Exception)
        {
            errorMessage =
                "An unexpected error occurred while signing in. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }


    // ============================================================
    // CHANGE AUTHENTICATION MODE
    // ============================================================

    private async Task ChangeMode(AuthMode mode)
    {
        errorMessage = null;

        Mode = mode;

        await ModeChanged.InvokeAsync(mode);
    }


    // ============================================================
    // CLOSE MODAL
    // ============================================================

    private async Task CloseModal()
    {
        errorMessage = null;
        showPassword = false;

        await IsOpenChanged.InvokeAsync(false);
    }


    // ============================================================
    // OVERLAY CLICK
    // ============================================================

    private async Task HandleOverlayClick()
    {
        await CloseModal();
    }


    // ============================================================
    // PASSWORD VISIBILITY
    // ============================================================

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }


    // ============================================================
    // FORGOT PASSWORD
    // ============================================================

    private void ForgotPassword()
    {
        errorMessage =
            "Password recovery is not available yet. Please contact the HR INFO ADs administration team.";
    }


    // ============================================================
    // REGISTRATION REQUEST
    // ============================================================

    private void RequestRegistration()
    {
        errorMessage =
            "Account registration is currently handled by the HR INFO ADs administration team.";
    }


    // ============================================================
    // LOGIN MODEL
    // ============================================================

    public class LoginModel
    {
        [Required(
            ErrorMessage = "Email address is required.")]
        [EmailAddress(
            ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;


        [Required(
            ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }


    // ============================================================
    // AUTHENTICATION MODE
    // ============================================================

    public enum AuthMode
    {
        SignIn,
        SignUp
    }
}