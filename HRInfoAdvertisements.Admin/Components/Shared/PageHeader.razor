@using HRInfoAdvertisements.Admin.Services
@inject SiteSettingsService SiteSettingsService

@if (SetBrowserTitle)
{
    <PageTitle>@Title · @siteName</PageTitle>
}

<header class="hr-page-header">

    <div class="hr-page-header-main">

        <div class="hr-page-header-icon">
            <i class="bi @Icon"></i>
        </div>

        <div class="hr-page-header-text">

            @if (!string.IsNullOrWhiteSpace(EyebrowText))
            {
                <span class="hr-page-header-eyebrow">
                    @EyebrowText
                </span>
            }

            <h1>@Title</h1>

            @if (DescriptionContent is not null)
            {
                <div class="hr-page-header-description">
                    @DescriptionContent
                </div>
            }

        </div>

    </div>

    @if (ActionContent is not null)
    {
        <div class="hr-page-header-actions">
            @ActionContent
        </div>
    }

</header>

@code {

    [Parameter]
    public string Icon { get; set; } = "bi-grid-1x2-fill";

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? DescriptionContent { get; set; }

    [Parameter]
    public RenderFragment? ActionContent { get; set; }

    /// <summary>
    /// When true and no Eyebrow is supplied, the site name
    /// (SITE_NAME) is shown above the title.
    /// </summary>
    [Parameter]
    public bool UseSiteNameAsEyebrow { get; set; }

    /// <summary>
    /// When true, sets the browser tab title to "Title · SiteName".
    /// Leave false on pages that already have their own PageTitle.
    /// </summary>
    [Parameter]
    public bool SetBrowserTitle { get; set; }

    private string siteName = "AdMind";

    private string? EyebrowText =>
        !string.IsNullOrWhiteSpace(Eyebrow)
            ? Eyebrow
            : UseSiteNameAsEyebrow
                ? siteName
                : null;

    protected override async Task OnInitializedAsync()
    {
        // Skip the call entirely when neither feature is used.
        if (!UseSiteNameAsEyebrow && !SetBrowserTitle)
        {
            return;
        }

        try
        {
            // Cached inside SiteSettingsService.
            var settings = await SiteSettingsService.GetAsync();

            if (settings is not null &&
                !string.IsNullOrWhiteSpace(settings.SiteName))
            {
                siteName = settings.SiteName;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PAGE HEADER SETTINGS ERROR: {ex.Message}");
        }
    }
}
