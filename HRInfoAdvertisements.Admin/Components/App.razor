@using HRInfoAdvertisements.Application.DTOs.SystemSettings
@using HRInfoAdvertisements.Admin.Services

@inject SiteSettingsService SiteSettingsService

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <base href="/" />


    <!-- =====================================================
         SITE METADATA (SITE_NAME / SITE_TAGLINE)
         ===================================================== -->

    <title>@Site.SiteName</title>

    <meta name="description"
          content="@Site.SiteTagline" />

    <meta property="og:site_name"
          content="@Site.SiteName" />


    <!-- =====================================================
         APPLICATION CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="@Assets["app.css"]" />


    <!-- =====================================================
         ADMIN COMPONENT CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="@Assets["HRInfoAdvertisements.Admin.styles.css"]" />


    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="lib/bootstrap-icons/bootstrap-icons.css" />


    <!-- =====================================================
         FAVICON
         ===================================================== -->

    <link rel="icon"
          type="image/png"
          href="favicon.png" />


    <ImportMap />

    <HeadOutlet />

</head>


<body>

    <Routes />
    <script src="js/hr-info-ads.js"></script>
    <script src="_framework/blazor.web.js"></script>

</body>

</html>

@code
{
    // Defaults are used if the API is unavailable.
    private PublicSiteSettingsResponse Site { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Site =
            await SiteSettingsService
                .GetAsync();
    }
}